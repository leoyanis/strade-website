          if (side && ko) all.push([side, ko]);
          faded ||= f;
          // cut at the colour's edge: the mark's patch is cut there, the word (its outline cannot be cut) goes without.
          // A top or bottom cut counts once it reaches into the outline's 10px: with only the side cuts counted, the
          // orange outline of "Strade" hung over youcook's purple while the sections' boundary crossed the logo.
          const q = ko?.[0];
          side?.toggleAttribute('data-ko-cut', !!q && (ko!.length > 1 || q.l != null || q.r != null || (q.t ?? -99) > -10 || (q.b ?? -99) > -10));
        }
