---
import StradeMark from '../components/StradeMark.astro';
import '../styles/global.css';
import '../styles/portfolio.css';
import '../styles/nav.css';
import { type Locale } from '../i18n/utils';
import { SITE } from '../data/site';
import { abs, person, website, breadcrumbList, PERSON_ID, WEBSITE_ID, type Crumb } from '../data/seo';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  path?: string;
  ogImage?: string;
  /** Alt text for the link-preview image. Defaults to the title. */
  ogImageAlt?: string;
  /** Extra schema.org nodes, merged into the site-wide JSON-LD graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Breadcrumb trail for search results, e.g. Home > Work > Vaultt. */
  crumbs?: Crumb[];
  /** 'article' for case studies and resources, 'profile' for the homepage. */
  pageType?: 'website' | 'article' | 'profile';
  /** Keep the page out of search results (404, previews). */
  noindex?: boolean;
  hideFooter?: boolean;
  /** Branded case-study pages: no night sky behind the page, so the page owns its look (the footer still sits on it). */
  bare?: boolean;
  /** Nav colours for light-background pages. */
  navTheme?: 'dark' | 'light';
  /**
   * Sections whose lightness differs from navTheme but live in a shared component, so the page cannot put
   * data-nav-theme on them itself: CSS selector -> 'light' | 'dark', 'auto' to read it from the element's
   * background colour, or 'busy' for a picture that should only make the nav's pool stronger as it passes.
   * The nav script tags each match with data-nav-theme. Sections written in the page itself carry
   * data-nav-theme directly (the same four values).
   * For a band no element outlines (a pseudo-element paints it, or only part of a picture is light), pass
   * { tone, inset }: the script puts an invisible box with that CSS inset first in the match (which must be its
   * containing block) and tags the box. Add media: '(max-width: ...)' to either form for a band that only counts
   * while that media query matches. Add hides: true for a band a script hides and shows (GSAP autoAlpha leaves its
   * box on the page while it is invisible): it counts only while it is visible and 90% opaque or more, and the script
   * dispatches 'nav:moved' on the frames it fades it (an opacity change moves nothing an observer sees).
   */
  navBands?: Record<string, 'light' | 'dark' | 'auto' | 'busy' | 'bare' | 'none' | { tone: 'light' | 'dark' | 'auto' | 'busy' | 'bare'; inset?: string; media?: string; surface?: string; hides?: boolean }>;
}

const {
  title,
  description,
  locale = 'en',
  path = '/',
  ogImage = '/og/default.png',
  ogImageAlt,
  schema,
  crumbs,
  pageType = 'website',
  noindex = false,
  hideFooter = false,
  bare = false,
  navTheme = 'dark',
  navBands,
} = Astro.props;
const navPath = Astro.url.pathname;
const year = new Date().getFullYear();
// The night sky (src/components/space/page-sky.ts): the homepage's sky as one still frame. Regular pages get it behind
// the whole page; case studies (bare) keep their own look and get it behind the footer only. The homepage draws its own
// moving sky behind its footer (index.astro, home.css), so it gets neither.
const sky: 'page' | 'footer' | 'none' = navPath === '/' ? 'none' : !bare ? 'page' : hideFooter ? 'none' : 'footer';

const canonical = abs(path);
const ogImageUrl = abs(ogImage);

const webPage = {
  '@type': pageType === 'profile' ? 'ProfilePage' : 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: locale,
  isPartOf: { '@id': WEBSITE_ID },
  primaryImageOfPage: ogImageUrl,
  ...(pageType === 'profile' ? { mainEntity: { '@id': PERSON_ID } } : { author: { '@id': PERSON_ID } }),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    website,
    webPage,
    ...(crumbs ? [breadcrumbList(crumbs)] : []),
    ...(schema ? [schema].flat() : []),
  ],
};
---

<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <!-- viewport-fit=cover: in landscape on a notched iPhone the worlds run edge to edge instead of between black bars;
       the nav and the footer keep their content inside the safe area (nav.css, global.css env(safe-area-inset-*)) -->
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="author" content={SITE.name} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

  <!-- Open Graph -->
  <meta property="og:type" content={pageType === 'website' ? 'website' : pageType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt ?? title} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAlt ?? title} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
  <link rel="stylesheet" href="https://fonts.bunny.net/css?family=inter:400,500,600,700,800&display=swap" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0a0a0a" />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary" />
  <slot name="head" />
</head>
<body data-nav={navTheme} class:list={[bare && 'is-bare']}>

  <!-- Scroll progress bar -->
  <div id="scroll-progress"></div>

  {sky === 'page' && (
    <Fragment>
  <!-- The night sky, fixed behind the page (page-sky.ts draws it, portfolio.css places it). It replaced the old
       atmosphere: the dot and blueprint grids, the glows, the particle canvas and the cursor glow. -->
  <div id="page-sky" class="page-sky" aria-hidden="true"></div>
    </Fragment>
  )}

  <!-- Nav: no bar, a soft pool behind each corner (src/styles/nav.css). data-tone on each side is the tone of
       the section under its text, and on Book a call the tone under the pill itself; each text link carries one
       too, its corner's unless a card's edge runs between the links. The nav script below writes them (with
       data-cut, the pool edges pulled in to the text); the server renders the page's navTheme. -->
  <nav id="site-nav" aria-label="Site navigation" data-bands={navBands ? JSON.stringify(navBands) : undefined} data-nav-auto={navPath === '/' ? undefined : ''} data-nav-full={process.env.STRADE_NAV_FULL === '1' ? '' : undefined}>
    <div class="nav-side nav-side--l" data-tone={navTheme}>
      <span class="nav-pool" aria-hidden="true"><i class="nav-pool__tint nav-pool__tint--dark"></i><i class="nav-pool__tint nav-pool__tint--light"></i></span>
      <a href="/" class="nav-brand" aria-label="Strade, home">
        <StradeMark class="nav-brand-mark" />
        <span>Strade</span>
        <!-- a phone's tap target round the mark (nav.css .nav-hit): positioned, so the logo's box stays the mark's -->
        <i class="nav-hit" aria-hidden="true"></i>
      </a>
    </div>
    <div class="nav-side nav-side--r" data-tone={navTheme}>
      <span class="nav-pool" aria-hidden="true"><i class="nav-pool__tint nav-pool__tint--dark"></i><i class="nav-pool__tint nav-pool__tint--light"></i></span>
      <div class="nav-links">
        <a href="/work" aria-current={navPath.startsWith('/work') ? 'page' : undefined} data-tone={navTheme}>Results</a>
        <a href="/free" class="nav-free" aria-current={navPath.startsWith('/free') ? 'page' : undefined} data-tone={navTheme}>Free stuff</a>
        <a href={SITE.instagram} class="nav-icon" target="_blank" rel="noopener" aria-label="Instagram" data-tone={navTheme}>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href={SITE.booking} class="nav-book" target="_blank" rel="noopener" data-tone={navTheme}>Book a call</a>
      </div>
    </div>
  </nav>

  <!-- Page content -->
  <main style="position:relative;z-index:2;">
    <slot />
  </main>

  {!hideFooter && (
    <footer id="site-footer" data-nav-theme="dark">
      <!-- case studies: the night sky behind the footer alone (page-sky.ts; the footer clips it, portfolio.css) -->
      {sky === 'footer' && <div class="sf-sky" aria-hidden="true"></div>}
      <div class="container">
        <div class="sf-top">
          <div class="sf-about">
            <div class="sf-brand">
              <img src={SITE.avatar} alt="Yanis Schweizer" width="40" height="40" loading="lazy" />
              <div><strong>Yanis Schweizer</strong><span>Builder. Apps, automations and AI tools.</span></div>
            </div>
            <p class="sf-tagline">{SITE.tagline}</p>
            <div class="social-row">
              <a class="social-btn is-ig" href={SITE.instagram} target="_blank" rel="noopener">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
                {SITE.instagramHandle}
              </a>
              <a class="social-btn" href={SITE.linkedin} target="_blank" rel="noopener">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                LinkedIn
              </a>
            </div>
          </div>
          <div class="sf-col">
            <h4>Explore</h4>
            <a href="/work">Results</a>
            <a href="/free">Free stuff</a>
            <a href="/#about">About</a>
          </div>
          <div class="sf-col">
            <h4>Get in touch</h4>
            <a href={SITE.booking} target="_blank" rel="noopener">Book a call</a>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <a href={SITE.instagram} target="_blank" rel="noopener">DM on Instagram</a>
          </div>
        </div>
        <div class="sf-bottom">
          <span>&copy; 2023–{year} {SITE.company}</span>
          <span>Made by Yanis, and yes, I am a real human.</span>
        </div>
      </div>
    </footer>
  )}

  <!-- ============================================================
       NAV: which tone each corner sits on, how far its pool may reach, and the scrolled state that shows the pools
       ============================================================ -->
  <script>
    type Tone = 'light' | 'dark';
    type Key = 'l' | 'r';
    // The nav's content line: the centre of its 64px row. A band is "under" a corner's text while it spans this
    // line there. The homepage's stripes wipe uses the same line (index.astro).
    const NAV_LINE = 32;
    // how far down a pool reaches: its tint ends at 80px, its frost at 96px (nav.css)
    const POOL_FOOT = 96;

    const nav = document.getElementById('site-nav');
    if (nav) {
      const body = document.body;
      const sideL = nav.querySelector<HTMLElement>('.nav-side--l');
      const sideR = nav.querySelector<HTMLElement>('.nav-side--r');
      const pill = nav.querySelector<HTMLElement>('.nav-book');
      const asTone = (v?: string | null): Tone | null => (v === 'light' || v === 'dark' ? v : null);
      // the page's navTheme, as the server rendered it: what the nav shows when no band is under it
      const pageTone: Tone = asTone(body.dataset.nav) ?? 'dark';
      // From the observers below: the band under each corner's text (null: no band, the page's tone), whether
      // that text sits partly on the other tone or on a busy picture (the pool then runs stronger, nav.css), and
      // the band under Book a call, which carries its own fill and so takes its own tone.
      const banded: Record<Key, Tone | null> = { l: null, r: null };
      const mixed: Record<Key, boolean> = { l: false, r: false };
      // the pool colour of the band under both ends of a corner's text, when that band has an opaque background
      const colour: Record<Key, string | null> = { l: null, r: null };
      const colourBand: Record<Key, Element | null> = { l: null, r: null };
      const written: Record<Key, string> = { l: '', r: '' };
      let pillBand: Tone | null = null;
      // A text link's own tone where a card's edge runs between the links (null: its corner's), from the observers:
      // the words on the other side take their own ink and the corner's pool stops short of them.
      const linkEls = Array.from(nav.querySelectorAll<HTMLElement>('.nav-links a:not(.nav-book)'));
      // the words of each text link, for the copy of them its knockout draws behind it (::before, nav.css)
      linkEls.forEach((a) => { if (!a.querySelector('svg')) a.dataset.label = (a.textContent ?? '').trim(); });
      let linkTone: (Tone | null)[] = linkEls.map(() => null);
      // A text link that an edge runs through (a card's side, a wipe's front): each glyph takes the ink of the tone
      // behind it (data-split="light-dark" and --split-at, nav.css), so no pool has to reach across the edge for it.
      // From the same sampling as linkTone (wordTones, below).
      // `flat`: the glyphs on the dark side all lie on a flat colour (no accent there); `full`: every glyph does, on
      // one colour each side (both inks full strength, nav.css)
      // `mid`, `at2`: a middle stretch in another tone between `at` and `at2` (a phone's bezel ring, wordTones)
      // `ang`, `off`: a slanted edge (a script's paint: the free act's dome), the gradient's angle in degrees and the
      // split's place along its line from the box's centre, in px (slantOf, wordTones; `at` unused then). From the centre,
      // so the icon's own SVG, a smaller box on the same centre, takes the same stop (nav.css)
      // (`cover`: a corner, an upright edge and a level one meeting under the link: the rows past the level edge, `y`
      // down from the link's top for `h`, all take the ink of the split's side `side`, nav.css --cover-*)
      // (`shape`: two or more bands' edges under the link at once, each band drawn in its own ink as background layers,
      // the link's own ink beneath them: nav.css data-shape, --shape-bg; shapesUnder, below. `dir` and `at` unused then)
      let linkSplit: ({ at: number; dir: string; flat: boolean; full: boolean; mid?: Tone; at2?: number; ang?: number; off?: number; cover?: { y: number; h: number; side: 'a' | 'b' }; shape?: string } | null)[] = linkEls.map(() => null);
      const linkSplitWas: string[] = linkEls.map(() => '');
      // The logo's split by a slanted edge under a script's paint (the free act's dome, its left flank): as a link's
      // (off, ang, dir), with offM the same edge measured from the mark's own centre (markOff: the mark's centre from the
      // logo's, read in watch()). Written on the logo's side (data-split, --split-*, nav.css)
      let brandSplit: { off: number; ang: number; dir: string; offM: number } | null = null;
      let brandSplitWas = '';
      let markOff = { x: 0, y: 0 };
      // the mark's own box on screen (the nav is fixed: read in watch()), for the logo over shapes (below)
      let markBox = { left: 0, top: 0, right: 0, bottom: 0 };
      // The logo over shapes (shapesUnder, wordTones): the layers in the mark's box (drawn by the logo's ::after through
      // the mark's own file as its mask) and in the logo's box (the word, clipped to its text), each band in its own ink
      // over the logo's (the side's tone, set to the one outside the shapes). Written on the logo's side (data-shape,
      // --shape-bg-m, --shape-bg-w, nav.css)
      let brandShape: { m: string; w: string } | null = null;
      let brandShapeWas = '';
      // Over a flat, saturated colour (flatTone, below; data-flat, nav.css): whether each corner's pool would lie only
      // on such a colour (it is hidden then), and whether each text link sits mostly on one (its ink is then full
      // strength, with no glow and no accent)
      const flat: Record<Key, boolean> = { l: false, r: false };
      // a corner on a thin strip of something else with a flat colour both above and below it (the cream between two
      // side quest tiles on a phone): its pool would only show as a pale fog over the two colours' edges, so it goes too
      const squeezed: Record<Key, boolean> = { l: false, r: false };
      // A corner busy only with pictures the page marks bare (navBands 'bare': kleus's turning ring of cards, the quest
      // covers on /work, youcook's hero phones): no pool, which lay over them as a white haze band, and the links' own
      // full-strength ink with a glow tight to the glyphs instead (nav.css data-bare; 2026-11-09 final check)
      const bareAt: Record<Key, boolean> = { l: false, r: false };
      // the logo over shapes (logoShapes) off any busy picture: every part of the mark has its own ink, so no pool backs it
      // (a dark pool over the white App Store button's end smeared it grey round the mark, vaultt 390 at 5760, 2026-11-09)
      const shaped: Record<Key, boolean> = { l: false, r: false };
      let linkFlat: boolean[] = linkEls.map(() => false);
      // The knockout (data-ko, --ko "r g b", nav.css): a link lying wholly on a flat colour, and the logo, wear an outline
      // of that very colour round each glyph, so whatever the colour carries past the links (a side quest tile's title
      // and text, youcook's headlines) is cut away round the letters, and the outline cannot be seen on the colour
      // itself. `band` is the flat band under the text; `grad` when that band is a gradient, whose colour is read at `x`
      // on the nav line (koColour, with the band observers). A text link reaching off the colour (a tile's edge under
      // Free stuff) is knocked out only over the colour: `l` and `r` cut the knockout that far in from the link's left
      // and right edges, at the band's own edge (--ko-l, --ko-r). From wordTones, below.
      // `t` and `b` cut it the same way at the band's top and bottom edges while one crosses the text (a section's
      // boundary passing the nav line: the orange knockout lay over the purple below it, youcook 1440).
      // `shade`: the casters whose drop shadow lies evenly over the part (trim): the knockout wears the paper as that
      // shadow darkens it there, read each time its colour is (koShade)
      // `rad`: the band's own corner radii (top left, top right, bottom right, bottom left) where the cut is its rounded
      // box (a link over two bands, shapesUnder: vaultt's store badges): the copy is clipped to the rounded box, not the square
      type KoPart = { band: Element; x: number; grad: boolean; l: number | null; r: number | null; t: number | null; b: number | null; shade?: Element[]; rad?: number[] };
      // One part, or two where the text sits on two colours either side of an edge (Free stuff over a side quest
      // tile's edge, with the cream beside it a declared surface, data-nav-surface): the first part is drawn from
      // ::before (--ko, --ko-l/r/t/b, data-ko), the second from ::after (--ko2..., data-ko2), each cut at the edge.
      type Ko = KoPart[] | null;
      let linkKo: Ko[] = linkEls.map(() => null);
      const sideKo: Record<Key, Ko> = { l: null, r: null };
      let koColour: (p: KoPart) => string | null = () => null;
      const setVar = (el: HTMLElement, prop: string, v: string | null) => {
        if ((el.style.getPropertyValue(prop) || null) !== v) {
          if (v) el.style.setProperty(prop, v);
          else el.style.removeProperty(prop);
        }
      };
      // whether the last colour worked out went through a band part way faded (koColour, the fade watch, below),
      // and whether one went through a tint (tinted, the tint watch)
      let koFaded = false;
      let koTinted = false;
      // (returns whether a colour went through a band part way faded: koColour, the fade watch)
      const writeKo = (el: HTMLElement | null, ko: Ko): boolean => {
        if (!el) return false;
        koFaded = false;
        for (let i = 0; i < 2; i++) {
          const p = ko?.[i] ?? null;
          const rgb = p ? koColour(p) : null;
          const pre = i ? '--ko2' : '--ko';
          setVar(el, pre, rgb);
          for (const k of ['l', 'r', 't', 'b'] as const) {
            const v = p ? p[k] : null;
            setVar(el, `${pre}-${k}`, rgb && v != null ? `${Math.round(v)}px` : null);
          }
          setVar(el, `${pre}-rad`, rgb && p?.rad?.some((r) => r > 0) ? p.rad.map((r) => `${r.toFixed(1)}px`).join(' ') : null);
          el.toggleAttribute(i ? 'data-ko2' : 'data-ko', !!rgb);
        }
        // (a colour read through a tint keeps the tint watch going from any pass, a scroll frame's included: one read
        // only there, after the last full pass, was never read again once the scroll stopped)
        if (koTinted) tintWatch();
        return koFaded;
      };
      // the knockouts on a gradient, whose colour follows the scroll (the scroll listener after the band observers)
      let koLive: [HTMLElement, Ko][] = [];
      // every knockout the last resolve wrote, and the watch that rewrites them while a band under one fades (below)
      let koAll: [HTMLElement, Ko][] = [];
      let fadeWatch: () => void = () => {};
      // whether the last resolve read a colour through a band part way faded (a phone's rest passes go on while one is)
      let lastFaded = false;
      // and the watch on the bands near the nav that do not show yet (hiddenWatch, below)
      let hiddenWatch: () => void = () => {};
      // the tone under Book a call's middle on the nav line, band or paint (set by the band observers)
      let pillUnder: () => Tone | null = () => null;
      // A tint drifts on its own clock (kleus's hero glows, an 18s loop) or rides on a card a script moves after the
      // scroll has stopped (the quest cards' shade on /work, which reveal as they arrive): while one colours a
      // knockout, the words are read again every 200ms (sync: their tone can follow a tint too, toneIn). Writing the
      // knockouts alone left Results in dark ink on the card's dark shade, read while the card was still rising
      // (1440 at 2000, 2026-11-09).
      let tintT = 0;
      let tintSync: () => void = () => { for (const [el, ko] of koAll) writeKo(el, ko); };
      // (not on a phone: a tint drifting on its own clock is read again at the next scroll, the observers' next report or
      // the next rest, not every 200ms; perf round 2026-11-09)
      const tintWatch = () => {
        if (tintT || lite) return;
        tintT = window.setTimeout(() => {
          tintT = 0;
          koTinted = false;
          tintSync();
          if (koTinted) tintWatch();
        }, 200);
      };
      // set by the band observers: the links' own tones worked out again from what a page script paints (nav.toneAt),
      // which can change on every scroll update without any band moving, and each corner's pool tone under that paint
      let paintedWords: (() => void) | null = null;
      const paintTone: Record<Key, Tone | null> = { l: null, r: null };
      // each corner's force (per-corner, else whole-nav), as resolve last read it: under a script's paint it is also
      // what that script says lies where it paints nothing and no band is (toneIn, below)
      const forceOf: Record<Key, Tone | null> = { l: null, r: null };
      // Which edges of a corner's pool to pull in to its text, for the tone the corner shows (data-cut, nav.css).
      // The band observers replace this once they exist; until then nothing is cut.
      let cutsFor: (key: Key, tone: Tone, own: Element | null) => string = () => '';
      // how far down a top cut moves, in px (0 to 16): cutsFor writes it with each cut, resolve hands it to nav.css as
      // --cut-t-at (see topShift, below)
      const cutAt: Record<Key, number> = { l: 0, r: 0 };
      // counts the passes (each resolve, each sync): what is read from layout once per pass (the shadow casters' boxes,
      // trim) is read again on the next
      let navPass = 0;
      /* Phones: no layout or style read inside a scrolled frame (perf round, audit P1, B07, VE-14, 2026-11-09). On a phone
         at 4x the nav's frame callback was the largest script item of most sections: every frame it read the box of each
         band near the nav after the page's own writes, a forced layout each time. So on phones (the nav's phone layout,
         under 768px) every box the nav asks for inside a frame comes from a cache: read once per measure with the scroll it
         was read at and moved by the scroll since (a fixed layer's does not move), and computed styles (opacity,
         visibility, a turn) are read once per measure too. A measure is a new epoch: a rebuild, a resize, the document
         changing size, a page script's nav:moved, a band the hidden-band poll sees come or go, and the scroll coming to
         rest, where the nav also reads every box live once, as a laptop does every frame, so what a phone shows at rest is
         what it showed before. In between, the observers' reports (worked out by the browser, no forced layout) are
         gathered into one pass a frame, and only the bands that keep still in the page are carried by the scroll; those a
         page script moves are left to the observers and to the rest. A laptop reads live boxes every frame, as before.
         (STRADE_NAV_FULL=1 at build time keeps the laptop path on phones: the perf round's before/after.) */
      const liteMq = matchMedia('(max-width: 767px)');
      const liteOff = nav.hasAttribute('data-nav-full');
      let lite = !liteOff && liteMq.matches;
      let geoEpoch = 0;
      // the scroll at this frame, read in the first scroll listener of the page's nav script, before its writes
      let liteY = window.scrollY;
      // and the last frames' scrolls, [time, scrollY]: an observer's report is of the frame it was measured in, which a
      // report delivered late is not (scrollAt; null when it is older than all of them)
      const scrolls: [number, number][] = [];
      window.addEventListener('scroll', () => {
        liteY = window.scrollY;
        scrolls.push([performance.now(), liteY]);
        if (scrolls.length > 8) scrolls.shift();
      }, { passive: true });
      const scrollAt = (t: number): number | null => {
        for (let i = scrolls.length - 1; i >= 0; i--) if (scrolls[i][0] <= t) return scrolls[i][1];
        return scrolls.length ? null : liteY;
      };
      // a cache's pass: each resolve or sync on a laptop, each measure on a phone
      const passOf = () => (lite ? -1 - geoEpoch : navPass);
      // how an element moves with the scroll, read once a measure: 'fixed' in a fixed layer (it does not), 'sticky' in
      // a sticky one (it may stop), else with the page
      const layerNow = new Map<Element, 'fixed' | 'sticky' | 'flow'>();
      let layerEpoch = -1;
      const scrollLayer = (el: Element | null): 'fixed' | 'sticky' | 'flow' => {
        if (!el || el === document.body || el === document.documentElement) return 'flow';
        if (layerEpoch !== geoEpoch) { layerEpoch = geoEpoch; layerNow.clear(); }
        let v = layerNow.get(el);
        if (v === undefined) {
          // (a ScrollTrigger pin's content stops in the page while the pin holds, as a sticky one does)
          const p = getComputedStyle(el).position;
          v = p === 'fixed' ? 'fixed' : p === 'sticky' || el.classList.contains('pin-spacer') ? 'sticky' : scrollLayer(el.parentElement);
          layerNow.set(el, v);
        }
        return v;
      };
      // an element's box: live on a laptop; on a phone the one read this measure, moved by the scroll since
      const vboxes = new Map<Element, { r: DOMRectReadOnly; y: number; fixed: boolean; tick: number }>();
      let vboxEpoch = -1;
      // (a phone) the bands that move in the page by themselves (the band observers' `moving`: a scrub, a timer), each
      // band's box as its last observer report gave it (the browser's own, no layout read) with the scroll it was
      // measured at, and the observers in whose root it lay then (noteReport, below)
      const selfMoving = new Set<Element>();
      const seenBox = new Map<Element, { r: DOMRectReadOnly; y: number; tick: number }>();
      const onRoots = new Map<Element, Set<IntersectionObserver>>();
      let seenTick = 0;
      const shifted = (r: DOMRectReadOnly, y: number) => (y === liteY ? r : new DOMRectReadOnly(r.x, r.y + y - liteY, r.width, r.height));
      const vbox = (el: Element): DOMRectReadOnly => {
        if (!lite) return el.getBoundingClientRect();
        if (vboxEpoch !== geoEpoch) { vboxEpoch = geoEpoch; vboxes.clear(); }
        let m = vboxes.get(el);
        // A band that moves by itself, or rides in a pin or a sticky layer (stopped while it holds), does not follow
        // the scroll: its box is its last report's when that is newer than the measure. While it lies in an observer's
        // root each move it makes is reported (the thresholds there are a pixel or two apart), so the last box stands as
        // it is; outside every root it is taken to move with the page. Moved by the scroll, a scrubbed or pinned band's
        // box ran ahead of it: the knockout round Results and Free stuff went for 1000px of atlas's scroll while a
        // caster's shadow was taken to lie under them, and kleus's ring left the logo without its glow (390, 2026-11-09).
        if (selfMoving.has(el) || scrollLayer(el) === 'sticky') {
          const s = seenBox.get(el);
          const inRoot = !!onRoots.get(el)?.size;
          if (s && (!m || s.tick > m.tick)) return inRoot ? s.r : shifted(s.r, s.y);
          if (m && inRoot) return m.r;
        }
        if (!m) { m = { r: el.getBoundingClientRect(), y: window.scrollY, fixed: scrollLayer(el) === 'fixed', tick: ++seenTick }; vboxes.set(el, m); }
        return m.fixed ? m.r : shifted(m.r, m.y);
      };
      // the box read live now, newer than any report: the rest's measure (liteRest), so at rest no box is a report's
      const vmeasure = (el: Element) => {
        if (vboxEpoch !== geoEpoch) { vboxEpoch = geoEpoch; vboxes.clear(); }
        vboxes.set(el, { r: el.getBoundingClientRect(), y: window.scrollY, fixed: scrollLayer(el) === 'fixed', tick: ++seenTick });
      };
      // What a band observer's report (on a phone) says of its band: whether the band lies in that observer's root, its
      // box, and whether that box is where the measure (or its last report), moved by the scroll, put it. One that is
      // not moves in the page by itself (a scrub, a pin, a timer: kleus's ring, the finale's pill rising, youcook's
      // swipe cards) and counts as moving from then on, left to the observers until the scroll rests and it is found
      // still (edgeTick). Read off the report alone: no layout read.
      const noteReport = (e: IntersectionObserverEntry, io: IntersectionObserver, first: boolean) => {
        const el = e.target;
        let on = onRoots.get(el);
        if (!on) { on = new Set(); onRoots.set(el, on); }
        if (e.isIntersecting) on.add(io);
        else on.delete(io);
        const y = scrollAt(e.time);
        if (y === null) return;
        const r = e.boundingClientRect;
        if (!first && !selfMoving.has(el) && scrollLayer(el) === 'flow') {
          const m = vboxEpoch === geoEpoch ? vboxes.get(el) : undefined;
          const s = seenBox.get(el);
          const ref = m && (!s || m.tick > s.tick) ? m : s;
          if (ref && (Math.abs(r.top - (ref.r.top + ref.y - y)) > 1 || Math.abs(r.left - ref.r.left) > 1 || Math.abs(r.width - ref.r.width) > 1 || Math.abs(r.height - ref.r.height) > 1)) selfMoving.add(el);
        }
        seenBox.set(el, { r, y, tick: ++seenTick });
      };
      // what a page script paints under the nav, if it says (see 'nav:paint' below)
      // (or the circle it paints, as its geometry: `paintCircle`, below the band observers)
      const painted = nav as HTMLElement & { toneAt?: ((x: number, y: number) => string | Element | null) | null; paintCircle?: { cx: number; cy: number; r: (scrollY: number) => number } | null };

      /* Resolve each corner's tone and write it where the CSS reads it: data-tone on the two sides (ink and
         pool, nav.css) and on Book a call, data-cut on the sides, and body[data-nav] (the scroll progress line
         and older page CSS, which follow the logo's corner). Order of precedence: a per-corner force
         (body[data-nav-force-l|r], the homepage stripes wipe), then a whole-nav force (body[data-nav-force], the
         homepage finale's circle wipe), then the band under that corner's text, then the page's navTheme. Book a
         call follows its own force (body[data-nav-force-p]), then a force on its corner, otherwise the band under
         itself. Writes only what changed: each write restyles the nav. */
      const resolve = () => {
        navPass++;
        const force = asTone(body.dataset.navForce);
        const forcedL0 = asTone(body.dataset.navForceL) ?? force;
        const forcedR0 = asTone(body.dataset.navForceR) ?? force;
        forceOf.l = forcedL0;
        forceOf.r = forcedR0;
        // A force with no paint that only says what a corner's bands already say (the finale's night, forced dark by its
        // circle and declared as its own flat near-black, once the stage has let go and the section itself lies under the
        // links) is no force there: the corner follows its bands, so it shows no pool on the flat night and each link keeps
        // its own ink and knockout. Held as a force, the dark pool smeared the white headline grey under the whole nav
        // row, "Let's talk." went murky teal and the finale's white Book a call pill chrome grey (390 at 18230 to 18450,
        // and in reduced motion at 1440 and 390, 2026-11-09 final check).
        const said = (k: Key, f: Tone | null) => !!f && !painted.toneAt && banded[k] === f && (flat[k] || (k === 'l' && shaped.l));
        const forcedL = said('l', forcedL0) ? null : forcedL0;
        const forcedR = said('r', forcedR0) ? null : forcedR0;
        // Under a script's paint (nav.toneAt: the stripes wipe's front, the free act's dome) each link takes the tone
        // painted under it even while its corner is forced, and each corner's pool the tone most of its glyphs sit
        // on (paintedWords): the pool then covers only those glyphs, and the others keep their own ink without one.
        // Without that, the links over the dome's black edge kept dark ink on a white pool until the dome had
        // covered the whole corner, 400 to 600px of scroll at 1440 (2026-11-08, scripted nav sweep). A force with no
        // paint (the finale's circle) still holds its whole corner.
        const paint = !!(painted.toneAt && paintedWords);
        if (paint) paintedWords!();
        const l = (paint ? paintTone.l : null) ?? forcedL ?? banded.l ?? pageTone;
        const r = (paint ? paintTone.r : null) ?? forcedR ?? banded.r ?? pageTone;
        // a wipe can hold the pill apart from its corner (body[data-nav-force-p], the stripes wipe); under a paint
        // with no such hold the pill takes what lies under its own middle, a band or the paint, as a link does: it
        // followed its corner's force, and in reduced motion the free act's dome forced the corner dark while the pill
        // still sat on the cream (cyan on cream, 1440 at 7935 to 7991, 2026-11-09 re-check)
        const p = asTone(body.dataset.navForceP) ?? (paint ? pillUnder() : null) ?? forcedR ?? pillBand ?? pageTone;
        if (sideL && sideL.dataset.tone !== l) sideL.dataset.tone = l;
        if (sideR && sideR.dataset.tone !== r) sideR.dataset.tone = r;
        if (pill && pill.dataset.tone !== p) pill.dataset.tone = p;
        const live: [HTMLElement, Ko][] = [];
        const all: [HTMLElement, Ko][] = [];
        let faded = false;
        koTinted = false;
        linkEls.forEach((a, i) => {
          // under a paint, r is already the tone most of the corner's glyphs sit on (paintTone), not the force
          const v = paint ? (linkTone[i] ?? r) : (forcedR ?? linkTone[i] ?? r);
          if (a.dataset.tone !== v) a.dataset.tone = v;
          a.toggleAttribute('data-flat', (!forcedR || paint) && linkFlat[i]);
          // the knockout goes with the colour under the words, not with the link's ink: a link half on a tile keeps
          // the ink of its majority and still has its tile half cut clear
          // (and under a force that holds the very tone of the colour under the link: the finale's night, forced dark
          // by its circle and declared as its own near-black, cuts the white headline away round the links)
          const ko = !forcedR || paint || (linkKo[i]?.every((q) => bandTone(q.band) === forcedR) ?? false) ? linkKo[i] : null;
          const f = writeKo(a, ko);
          if (ko?.some((q) => q.grad) || f) live.push([a, ko]);
          if (ko) all.push([a, ko]);
          faded ||= f;
          const sh = (!forcedR || painted.toneAt) && linkSplit[i]?.shape ? linkSplit[i]!.shape! : '';
          const s = (!forcedR || painted.toneAt) && linkSplit[i] && !sh ? linkSplit[i] : null;
          const key = s ? `${s.dir}@${s.off != null ? `c${s.off.toFixed(1)}` : Math.round(s.at)}${s.mid ? `+${s.mid}@${Math.round(s.at2 ?? 0)}` : ''}${s.ang != null ? `/${Math.round(s.ang)}` : ''}${s.cover ? `#${s.cover.side}${Math.round(s.cover.y)},${Math.round(s.cover.h)}` : ''}` : sh;
          if (key !== linkSplitWas[i]) {
            linkSplitWas[i] = key;
            // (the bands' shapes, nav.css data-shape: the layers, then the link's own ink under them)
            if (sh) {
              a.dataset.shape = '';
              a.style.setProperty('--shape-bg', `${sh},linear-gradient(currentColor,currentColor)`);
            } else if (a.hasAttribute('data-shape')) {
              delete a.dataset.shape;
              a.style.removeProperty('--shape-bg');
            }
            if (s?.cover) {
              a.dataset.splitCover = s.cover.side;
              a.style.setProperty('--cover-y', `${Math.round(s.cover.y)}px`);
              a.style.setProperty('--cover-h', `${Math.round(s.cover.h)}px`);
            } else if (a.dataset.splitCover) {
              delete a.dataset.splitCover;
              a.style.removeProperty('--cover-y');
              a.style.removeProperty('--cover-h');
            }
            if (s) {
              a.dataset.split = s.dir;
              a.style.setProperty('--split-at', s.off != null ? `calc(50% + ${s.off.toFixed(1)}px)` : `${Math.round(s.at)}px`);
            } else {
              delete a.dataset.split;
              a.style.removeProperty('--split-at');
            }
            if (s?.ang != null) a.style.setProperty('--split-ang', `${Math.round(s.ang)}deg`);
            else a.style.removeProperty('--split-ang');
            if (s?.mid) {
              a.dataset.splitMid = s.mid;
              a.style.setProperty('--split-at2', `${Math.round(s.at2 ?? 0)}px`);
            } else if (a.dataset.splitMid) {
              delete a.dataset.splitMid;
              a.style.removeProperty('--split-at2');
            }
          }
          a.toggleAttribute('data-split-flat', !!s?.flat);
          a.toggleAttribute('data-split-full', !!s?.full);
        });
        if (sideL) {
          // (a slant only exists under a paint: once the paint ends, the words are read again from the bands; an
          // upright split comes from the bands themselves)
          const b = brandSplit;
          const key = b ? `${b.dir}@${b.off.toFixed(1)}/${b.offM.toFixed(1)}/${Math.round(b.ang)}` : '';
          if (key !== brandSplitWas) {
            brandSplitWas = key;
            if (b) {
              sideL.dataset.split = b.dir;
              sideL.style.setProperty('--split-ang', `${Math.round(b.ang)}deg`);
              sideL.style.setProperty('--split-at', `calc(50% + ${b.off.toFixed(1)}px)`);
              sideL.style.setProperty('--split-at-m', `calc(50% + ${b.offM.toFixed(1)}px)`);
            } else {
              delete sideL.dataset.split;
              for (const k of ['--split-ang', '--split-at', '--split-at-m']) sideL.style.removeProperty(k);
            }
          }
        }
        if (sideL) {
          // the logo over shapes (brandShape, nav.css data-shape): not on a forced corner, as a link's
          const bs = !forcedL ? brandShape : null;
          const key = bs ? `${bs.m}|${bs.w}` : '';
          if (key !== brandShapeWas) {
            brandShapeWas = key;
            if (bs) {
              sideL.dataset.shape = '';
              sideL.style.setProperty('--shape-bg-m', bs.m || 'none');
              sideL.style.setProperty('--shape-bg-w', `${bs.w ? `${bs.w},` : ''}linear-gradient(currentColor,currentColor)`);
            } else if (sideL.hasAttribute('data-shape')) {
              delete sideL.dataset.shape;
              sideL.style.removeProperty('--shape-bg-m');
              sideL.style.removeProperty('--shape-bg-w');
            }
          }
        }
        // toggleAttribute with a force argument leaves the DOM alone when nothing changes
        sideL?.toggleAttribute('data-mixed', !forcedL && mixed.l);
        sideR?.toggleAttribute('data-mixed', !forcedR && mixed.r);
        sideL?.toggleAttribute('data-bare', !forcedL && bareAt.l);
        sideR?.toggleAttribute('data-bare', !forcedR && bareAt.r);
        // Over a flat colour, no pool (nav.css). On a forced corner only under a script's paint, which says where it
        // paints and leaves the bands to decide everywhere else (wordTones reads both): the free act forces both
        // corners light while its dome rises, which is while the side quest tiles pass under the nav at 1460x920,
        // and the forced corners kept a dark pool over the blue tile (2026-11-08 fix round). A force with no paint
        // (the finale's circle) still holds its whole corner.
        sideL?.toggleAttribute('data-flat', (!forcedL || paint) && (flat.l || squeezed.l || shaped.l));
        sideR?.toggleAttribute('data-flat', (!forcedR || paint) && (flat.r || squeezed.r));
        const agree = (k: Key, f: Tone | null) => !!f && (sideKo[k]?.every((q) => bandTone(q.band) === f) ?? false);
        for (const [side, key, on] of [[sideL, 'l', (!forcedL || paint || agree('l', forcedL)) && (flat.l || shaped.l)], [sideR, 'r', (!forcedR || paint) && flat.r]] as const) {
          // only the logo's side: the right side has no brand, and its knockout's variables reached its links' copies
          // by inheritance, so a link with no cut of its own took the side's (Results lost its knockout on the west
          // slip to the side's 64px right cut while the finale's circle opened, 1440, 2026-11-09 re-check)
          const ko = on && key === 'l' ? sideKo[key] : null;
          const f = writeKo(side, ko);
