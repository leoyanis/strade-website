---
import '../styles/global.css';
import '../styles/portfolio.css';
import { type Locale } from '../i18n/utils';
import { SITE } from '../data/site';
import { abs, person, website, breadcrumbList, PERSON_ID, WEBSITE_ID, type Crumb } from '../data/seo';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  path?: string;
  ogImage?: string;
  /** Alt text for the link-preview image. Defaults to the title. */
  ogImageAlt?: string;
  /** Extra schema.org nodes, merged into the site-wide JSON-LD graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Breadcrumb trail for search results, e.g. Home > Work > Vaultt. */
  crumbs?: Crumb[];
  /** 'article' for case studies and resources, 'profile' for the homepage. */
  pageType?: 'website' | 'article' | 'profile';
  /** Keep the page out of search results (404, previews). */
  noindex?: boolean;
  hideFooter?: boolean;
  /** Branded case-study pages: drop the starfield/grid atmosphere so the page owns its look. */
  bare?: boolean;
  /** Nav colours for light-background pages. */
  navTheme?: 'dark' | 'light';
}

const {
  title,
  description,
  locale = 'en',
  path = '/',
  ogImage = '/og/default.png',
  ogImageAlt,
  schema,
  crumbs,
  pageType = 'website',
  noindex = false,
  hideFooter = false,
  bare = false,
  navTheme = 'dark',
} = Astro.props;
const navPath = Astro.url.pathname;
const year = new Date().getFullYear();

const canonical = abs(path);
const ogImageUrl = abs(ogImage);

const webPage = {
  '@type': pageType === 'profile' ? 'ProfilePage' : 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: locale,
  isPartOf: { '@id': WEBSITE_ID },
  primaryImageOfPage: ogImageUrl,
  ...(pageType === 'profile' ? { mainEntity: { '@id': PERSON_ID } } : { author: { '@id': PERSON_ID } }),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    website,
    webPage,
    ...(crumbs ? [breadcrumbList(crumbs)] : []),
    ...(schema ? [schema].flat() : []),
  ],
};
---

<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="author" content={SITE.name} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

  <!-- Open Graph -->
  <meta property="og:type" content={pageType === 'website' ? 'website' : pageType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt ?? title} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAlt ?? title} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
  <link rel="stylesheet" href="https://fonts.bunny.net/css?family=inter:400,500,600,700,800&display=swap" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0a0a0a" />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary" />
  <slot name="head" />
</head>
<body data-nav={navTheme} class:list={[bare && 'is-bare']}>

  <!-- Scroll progress bar -->
  <div id="scroll-progress"></div>

  {!bare && (
    <Fragment>
  <!-- Cursor glow (desktop) -->
  <div id="cursor-glow"></div>

  <!-- Particle canvas -->
  <canvas id="particle-canvas" aria-hidden="true"></canvas>

  <!-- Atmosphere background layers -->
  <div id="atmosphere" aria-hidden="true">
    <div id="dot-grid"></div>
    <div id="blueprint-grid">
      <svg id="blueprint-inner" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <defs>
          <pattern id="bp-grid" width="60" height="60" patternUnits="userSpaceOnUse">
            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#00e5ff" stroke-width="0.5" opacity="0.2"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#bp-grid)"/>
      </svg>
    </div>
    <div id="radial-glows"></div>
    <div id="warm-overlay"></div>
    <div id="gradient-mesh">
      <div style="position:absolute;inset:0;background:radial-gradient(ellipse 800px 600px at 20% 50%, #00e5ff, transparent);opacity:0.12;animation:mesh-drift-1 20s ease-in-out infinite;"></div>
      <div style="position:absolute;inset:0;background:radial-gradient(ellipse 600px 800px at 80% 50%, #7b2fff, transparent);opacity:0.12;animation:mesh-drift-2 20s ease-in-out infinite;"></div>
    </div>
  </div>

    </Fragment>
  )}

  <!-- Nav -->
  <nav id="site-nav" aria-label="Site navigation">
    <a href="/" class="nav-brand" aria-label="Yanis Schweizer, home">
      <img src={SITE.avatar} alt="" width="28" height="28" />
      <span>Yanis Schweizer</span>
    </a>
    <div class="nav-links">
      <a href="/work" aria-current={navPath.startsWith('/work') ? 'page' : undefined}>Work</a>
      <a href="/free" class="nav-free" aria-current={navPath.startsWith('/free') ? 'page' : undefined}>Free stuff</a>
      <a href={SITE.instagram} class="nav-icon" target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href={SITE.booking} class="nav-book" target="_blank" rel="noopener">Book a call</a>
    </div>
  </nav>

  <!-- Page content -->
  <main style="position:relative;z-index:2;">
    <slot />
  </main>

  {!hideFooter && (
    <footer id="site-footer">
      <div class="container">
        <div class="sf-top">
          <div class="sf-about">
            <div class="sf-brand">
              <img src={SITE.avatar} alt="Yanis Schweizer" width="40" height="40" loading="lazy" />
              <div><strong>Yanis Schweizer</strong><span>Builder. Apps, automations and AI tools.</span></div>
            </div>
            <p class="sf-tagline">{SITE.tagline} I make the decisions, AI does the typing.</p>
            <div class="social-row">
              <a class="social-btn is-ig" href={SITE.instagram} target="_blank" rel="noopener">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
                {SITE.instagramHandle}
              </a>
              <a class="social-btn" href={SITE.linkedin} target="_blank" rel="noopener">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                LinkedIn
              </a>
            </div>
          </div>
          <div class="sf-col">
            <h4>Explore</h4>
            <a href="/work">Work</a>
            <a href="/free">Free stuff</a>
            <a href="/#about">About</a>
          </div>
          <div class="sf-col">
            <h4>Get in touch</h4>
            <a href={SITE.booking} target="_blank" rel="noopener">Book a call</a>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <a href={SITE.instagram} target="_blank" rel="noopener">DM on Instagram</a>
          </div>
        </div>
        <div class="sf-bottom">
          <span>&copy; 2023–{year} {SITE.company}</span>
          <span>Made by Yanis, steered by hand.</span>
        </div>
      </div>
    </footer>
  )}

  <!-- ============================================================
       PARTICLE SYSTEM
       ============================================================ -->
  <script>
    (function() {
      const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let mouseX = -9999, mouseY = -9999;
      const isMobile = window.innerWidth < 768;
      const isTablet = window.innerWidth < 1024;
      const COUNT = isMobile ? 22 : isTablet ? 44 : 65;

      type Particle = {
        x: number; y: number;
        vx: number; vy: number;
        size: number;
        isCyan: boolean;
        pulsePhase: number;
        pulseSpeed: number;
      };

      const particles: Particle[] = [];
      let w = 0, h = 0;
      let t = 0;

      function resize() {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize, { passive: true });

      for (let i = 0; i < COUNT; i++) {
        // ~1 in 8 particles has a subtle cyan tint
        const isCyan = (i % 8 === 3);
        particles.push({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          size: 1.8,
          isCyan,
          pulsePhase: Math.random() * Math.PI * 2,
          pulseSpeed: 0.008 + Math.random() * 0.006,
        });
      }

      if (!isMobile) {
        window.addEventListener('mousemove', (e: MouseEvent) => {
          mouseX = e.clientX; mouseY = e.clientY;
        }, { passive: true });
      }

      let lastTime = 0;
      function draw(now: number) {
        if (document.hidden) { requestAnimationFrame(draw); return; }
        const delta = now - lastTime;
        if (delta < 16) { requestAnimationFrame(draw); return; }
        lastTime = now;
        t++;

        ctx!.clearRect(0, 0, w, h);

        for (const p of particles) {
          p.x += p.vx;
          p.y += p.vy;
          p.pulsePhase += p.pulseSpeed;

          if (!isMobile) {
            const dx = p.x - mouseX, dy = p.y - mouseY;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 150 && dist > 0) {
              p.x += (dx / dist) * 0.5;
              p.y += (dy / dist) * 0.5;
            }
          }
          if (p.x < 0) p.x = w;
          if (p.x > w) p.x = 0;
          if (p.y < 0) p.y = h;
          if (p.y > h) p.y = 0;

          if (p.isCyan) {
            // Subtle cyan-tinted dot (same size, slight color shift + tiny glow)
            const pulse = 0.5 + 0.5 * Math.sin(p.pulsePhase);
            const alpha = 0.18 + pulse * 0.12;
            // Subtle glow halo
            const grd = ctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size * 4);
            grd.addColorStop(0, `rgba(0,229,255,${alpha * 0.15})`);
            grd.addColorStop(1, 'rgba(0,229,255,0)');
            ctx!.beginPath();
            ctx!.arc(p.x, p.y, p.size * 4, 0, Math.PI * 2);
            ctx!.fillStyle = grd;
            ctx!.fill();
            // Core dot (same size as white)
            ctx!.beginPath();
            ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx!.fillStyle = `rgba(0,229,255,${alpha})`;
            ctx!.fill();
          } else {
            // White dot, slightly more visible
            ctx!.beginPath();
            ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx!.fillStyle = 'rgba(255,255,255,0.18)';
            ctx!.fill();
          }
        }

        // Connection lines
        const CONNECT_DIST = 130;
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < CONNECT_DIST) {
              const factor = 1 - dist / CONNECT_DIST;
              // Same line thickness everywhere, subtle cyan tint if near cyan node
              const eitherCyan = particles[i].isCyan || particles[j].isCyan;
              if (eitherCyan) {
                ctx!.strokeStyle = `rgba(0,229,255,${0.05 * factor})`;
              } else {
                ctx!.strokeStyle = `rgba(255,255,255,${0.06 * factor})`;
              }
              ctx!.lineWidth = 0.5;
              ctx!.beginPath();
              ctx!.moveTo(particles[i].x, particles[i].y);
              ctx!.lineTo(particles[j].x, particles[j].y);
              ctx!.stroke();
            }
          }
        }

        requestAnimationFrame(draw);
      }
      requestAnimationFrame(draw);
    })();
  </script>

  <!-- ============================================================
       SCROLL PROGRESS + CURSOR GLOW
       ============================================================ -->
  <script>
    const nav = document.getElementById('site-nav');
    const onNavScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 24);
    onNavScroll();
    window.addEventListener('scroll', onNavScroll, { passive: true });

    const bar = document.getElementById('scroll-progress');
    if (bar) {
      window.addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
      }, { passive: true });
    }

    const glow = document.getElementById('cursor-glow');
    if (glow && window.matchMedia('(pointer: fine)').matches) {
      let cx = 0, cy = 0, tx = 0, ty = 0;
      window.addEventListener('mousemove', (e: MouseEvent) => { tx = e.clientX; ty = e.clientY; }, { passive: true });
      function lerpGlow() {
        cx += (tx - cx) * 0.12;
        cy += (ty - cy) * 0.12;
        (glow as HTMLElement).style.left = cx + 'px';
        (glow as HTMLElement).style.top = cy + 'px';
        requestAnimationFrame(lerpGlow);
      }
      requestAnimationFrame(lerpGlow);
    }
  </script>

  <!-- ============================================================
       ATMOSPHERE MOOD SYSTEM
       ============================================================ -->
  <script>
    (async () => {
      try {
        const { gsap } = await import('gsap');
        const { ScrollTrigger } = await import('gsap/ScrollTrigger');
        gsap.registerPlugin(ScrollTrigger);

        const dotGrid = document.getElementById('dot-grid');
        const blueprintGrid = document.getElementById('blueprint-grid');
        const gradientMesh = document.getElementById('gradient-mesh');
        const warmOverlay = document.getElementById('warm-overlay');
        const radialGlows = document.getElementById('radial-glows');

        let currentMood = '';

        function setMood(mood: string) {
          if (mood === currentMood) return;
          currentMood = mood;

          if (dotGrid) dotGrid.style.opacity = '0';
          if (blueprintGrid) blueprintGrid.style.opacity = '0';
          if (gradientMesh) gradientMesh.style.opacity = '0';
          if (warmOverlay) warmOverlay.style.opacity = '0';
          if (radialGlows) radialGlows.innerHTML = '';

          switch (mood) {
            case 'void':
              if (dotGrid) dotGrid.style.opacity = '1';
              if (radialGlows) radialGlows.innerHTML = `
                <div style="position:absolute;width:600px;height:600px;top:50%;left:50%;
                  background:radial-gradient(circle,rgba(0,229,255,0.06) 0%,transparent 70%);
                  border-radius:50%;animation:breathe-cyan 4s ease-in-out infinite;
                  transform:translate(-50%,-50%);pointer-events:none"></div>`;
              break;
            case 'blueprint':
              if (blueprintGrid) blueprintGrid.style.opacity = '0.04';
              break;
            case 'warm-amber':
              if (radialGlows) radialGlows.innerHTML = `
                <div style="position:absolute;width:800px;height:600px;top:40%;left:60%;
                  background:radial-gradient(ellipse,rgba(255,160,60,0.04) 0%,transparent 70%);
                  border-radius:50%;transform:translate(-50%,-50%);pointer-events:none"></div>`;
              break;
            case 'process':
              if (dotGrid) dotGrid.style.opacity = '0.3';
              break;
            case 'warm':
              if (warmOverlay) warmOverlay.style.opacity = '0.12';
              break;
            case 'gradient':
              if (gradientMesh) gradientMesh.style.opacity = '1';
              break;
          }
        }

        const sectionMoods = [
          { id: 'hero',     mood: 'void' },
          { id: 'services', mood: 'void' },
          { id: 'sv-section', mood: 'blueprint' },
          { id: 'testimonial', mood: 'void' },
          { id: 'youcook',  mood: 'void' },
          { id: 'capabilities', mood: 'void' },
          { id: 'process',  mood: 'void' },
          { id: 'founder',  mood: 'warm' },
          { id: 'cta',      mood: 'gradient' },
        ];

        sectionMoods.forEach(({ id, mood }) => {
          const el = document.getElementById(id);
          if (!el) return;
          ScrollTrigger.create({
            trigger: el,
            start: 'top center',
            end: 'bottom center',
            onEnter: () => setMood(mood),
            onEnterBack: () => setMood(mood),
          });
        });

        setMood('void');
        window.addEventListener('load', () => ScrollTrigger.refresh());
      } catch {
        // atmosphere is cosmetic, silent fail
      }
    })();
  </script>

  <!-- ============================================================
       SCROLL REVEAL (IntersectionObserver)
       ============================================================ -->
  <script>
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal-section, .reveal-left, .reveal-right').forEach(el => io.observe(el));
  </script>

</body>
</html>
