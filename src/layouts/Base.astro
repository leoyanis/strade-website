        koAll = all;
        lastFaded = faded;
        if (faded) fadeWatch();
        if (koTinted) tintWatch();
        hiddenWatch();
        // A forced corner sits over colours a script paints (a wipe), which no band describes: it keeps its whole
        // pool, unless that script also tells the nav what it paints where (nav.toneAt, below). Tried measuring
        // cuts against the bands anyway: under the stripes wipe every edge was cut and each pool shrank to a
        // pale box around its text on the cream.
        const sides: [HTMLElement | null, Key, Tone, boolean][] = [[sideL, 'l', l, !!forcedL], [sideR, 'r', r, !!forcedR]];
        for (const [side, key, tone, forced] of sides) {
          if (!side) continue;
          const cut = forced && !painted.toneAt ? '' : cutsFor(key, tone, forced ? null : colourBand[key]);
          if ((side.dataset.cut ?? '') !== cut) {
            if (cut) side.dataset.cut = cut;
            else delete side.dataset.cut;
          }
          // (a flat corner shows no pool: nothing to move)
          const at = cut.includes('t') && cutAt[key] > 0 && !side.hasAttribute('data-flat') ? `${cutAt[key]}px` : '';
          if (side.style.getPropertyValue('--cut-t-at') !== at) {
            if (at) side.style.setProperty('--cut-t-at', at);
            else side.style.removeProperty('--cut-t-at');
          }
          // a coloured band's pool colour, on this side only (a forced corner keeps the page's pools)
          const col = forced || flat[key] ? '' : colour[key] ?? '';
          const want = col ? `${tone}:${col}` : '';
          if (written[key] !== want) {
            written[key] = want;
            side.style.removeProperty('--pool-dark');
            side.style.removeProperty('--pool-light');
            if (col) side.style.setProperty(tone === 'dark' ? '--pool-dark' : '--pool-light', col);
            side.toggleAttribute('data-coloured', !!col);
          }
        }
        if (body.dataset.nav !== l) body.dataset.nav = l;
      };
      // page scripts set or remove the force attributes whenever they like; this picks them up in the same task
      new MutationObserver(resolve).observe(body, { attributeFilter: ['data-nav-force', 'data-nav-force-l', 'data-nav-force-r', 'data-nav-force-p'] });
      // A script that paints a full-screen layer under the nav (the homepage stripes wipe, the free act's dome, the
      // finale's circle) can say what it paints where: nav.toneAt = (x, y) => 'light' | 'dark' | Element | null, then
      // dispatch 'nav:paint' on the nav whenever it changes, and set it back to null when the layer is gone. A tone is
      // painted over everything there; an element is a surface under the page's bands, whose tone and surface the
      // point takes where no band lies (toneIn); null: no paint there, the bands decide. It is called a few hundred
      // times per change, so it must be plain arithmetic.
      nav.addEventListener('nav:paint', () => resolve());
      resolve();

      /* Bands: every [data-nav-theme] element, plus those a page names through Base's navBands prop (sections
         that live in a shared component), plus the shared case-study ending that CaseNext renders on every
         /work page: its "next quest" panel takes the next project's colours ('auto'), its booking strip is dark.
         The cyan primary button ('auto', light) spans a phone's width, and passed under the links as a grey
         band. 'auto' reads the background once, here: light when dark ink has the better contrast against it. */
      /* A band's pool colour (an RGB triplet for nav.css's --pool-dark / --pool-light), from its own opaque
         background: a shade deeper under light ink, a touch paler under dark ink, so that over a flat coloured
         section or card the pool reads as a shadow in that colour instead of a black smudge or a white fog. 'auto'
         bands also take their tone from it: light when dark ink has the better contrast. A band tagged dark keeps
         its tag and gets the deeper shade: a section tagged dark for its white type can be a light colour (youcook's
         orange), and the soft link ink must still read on the shade (4.5:1 and up). */
      const bandColour = new WeakMap<Element, string>();
      // A computed colour's numbers as rgb() gives them (0 to 255, then alpha): rgb() and rgba(), and color(srgb r g b
      // / a), which Chromium writes for a colour mixed or given in another space (0 to 1). Any other form: null, as if
      // no colour. Read as plain numbers, playivity's pastel legend pills (color(srgb 0.92 0.97 0.85)) passed for black
      // and took black knockouts round the links (390 at 6400, 2026-11-09).
      const colourNums = (c: string): string[] | null => {
        const m = c.match(/^color\(srgb\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)(?:\s*\/\s*([\d.]+))?\)/);
        if (m) return [m[1], m[2], m[3]].map((v) => String(+v * 255)).concat(m[4] !== undefined ? [m[4]] : []);
        if (!/^rgba?\(/.test(c)) return null;
        return c.match(/[\d.]+/g);
      };
      const readColour = (el: HTMLElement, tagged: Tone | null): Tone | null => {
        const m = colourNums(getComputedStyle(el).backgroundColor);
        if (!m || (m[3] !== undefined && +m[3] < 0.5)) return tagged;
        const lin = (c: number) => ((c /= 255) <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
        const y = 0.2126 * lin(+m[0]) + 0.7152 * lin(+m[1]) + 0.0722 * lin(+m[2]);
        // the luminance where #f0f0f0 and #1b1a18 ink have equal contrast against the background
        const tone: Tone = tagged ?? (y > 0.187 ? 'light' : 'dark');
        const f = tone === 'dark' ? (tagged ? 0.5 : 0.65) : 0.85;
        const c = [+m[0], +m[1], +m[2]].map((v) => Math.round(tone === 'dark' ? v * f : 255 - (255 - v) * f));
        bandColour.set(el, c.join(' '));
        return tone;
      };
      /* Flat, saturated colour: a coloured section or card (youcook's orange, purple and teal, the homepage's side-quest
         tiles). A corner over one shows no pool, only the ink that reads on that colour, dark on a light colour and
         light on a deep one, whatever the band's tag says (youcook tags its orange dark, for its own white type). A
         pool there read as a smear in a shade of the colour under it, dark brown on youcook's orange, dark blue on the
         blue tiles, white on the green one (2026-11-08 site check). Read once per band, from its opaque background
         colour or, failing that, the stops of its base gradient (youcook paints its sections as gradients). Counts as
         flat when not dark (luminance 0.03 and up: dark sections keep their pools) and saturated (chroma 0.25 and up:
