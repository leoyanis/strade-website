            if (!(tl || tr || br || bl)) return line;
            // as CSS uses them: scaled down together where two on one side would overlap (a pill's 999px is half its
            // height). Unscaled, the Sound off pill's ends swallowed the whole pill and the links took the cream's dark
            // ink on it (390, reduced motion, 6540, 2026-11-09)
            const f = Math.min(1, box.width / ((tl + tr) || 1), box.width / ((bl + br) || 1), box.height / ((tl + bl) || 1), box.height / ((tr + br) || 1));
