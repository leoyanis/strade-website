            // 2026-11-08). Over the strip a band's rectangle is the strip itself for as long as the band spans it.
            const lineRects = c.lineRects;
            c.line.io = observe(c.line, toned, margin(c.pool0, c.pool1, NAV_LINE - 4, NAV_LINE + 4, vw, vh), DENSE, (e) => {
              const r = e.isIntersecting ? lineCut(e.target, e.boundingClientRect, e.intersectionRect) : null;
              if (r) lineRects.set(e.target, r);
              else lineRects.delete(e.target);
              noteGrad(e);
            });
            // What a ringed band draws over its own ring moves without any band moving: the cook-mode phone's step cards
            // slide out over its bezel on a timer, and the F of Free stuff kept the bezel's white ink on a white card
            // until the next scroll. Its content is watched over the words' line, so each move samples the words again
            // (ringAt only takes a ring where nothing covers it). Only bands with a ring (youcook's phones) get this.
            const kids = toned.filter((el) => ringOf(el)).flatMap((el) => Array.from(el.querySelectorAll('*')));
            if (kids.length) {
              const rio: IntersectionObserver = new IntersectionObserver(() => { if (c.ring.io === rio) sync(); }, { rootMargin: margin(c.pool0, c.pool1, NAV_LINE - 4, NAV_LINE + 4, vw, vh), threshold: DENSE });
              kids.forEach((k) => rio.observe(k));
              c.ring.io = rio;
            }
          });
          if (book && book.width) watchPoint(pillPoint, Math.round((book.left + book.right) / 2 - 2), vw, vh);
          else unwatch(pillPoint);
        };
        watch();
        /* Band edges every frame while the page scrolls. The observers report after the frame they measured has been
           painted, so the nav wore the band it had just left for a frame or two at each edge: the previous colour's
           knockout under Results on a side quest tile, a coloured square behind the logo (390 at 700 px/s, 2026-11-09
           re-check). So on each scroll frame, and for half a second after the last (a scrub catches up after the scroll
           stops), the bands near the nav are read where they are now, after the page's own scripts have moved them for
           this frame (this frame callback is asked for from the scroll event, after theirs), clipped by their ancestors'
           overflow as the observers clip them, and the corners' rectangles and points are brought up to date before
           that frame is painted. Near: within 240px of the nav in the document as last seen, or seen to move at the last
           read (read every frame while it moves), or in a corner already. The observers still report after; what they
           add is a frame old, and the next scroll frame corrects it before it is painted. */
        const docBox = new Map<Element, { t: number; b: number; l: number; r: number }>();
        const moving = selfMoving;
        const clipMemo = new WeakMap<Element, [Element, boolean, boolean][]>();
        const clipsOf = (el: Element) => {
          let v = clipMemo.get(el);
          if (v) return v;
          v = [];
          for (let e = el.parentElement; e && e !== document.body && e !== document.documentElement; e = e.parentElement) {
            const cs = getComputedStyle(e);
            const cx = cs.overflowX !== 'visible';
            const cy = cs.overflowY !== 'visible';
            if (cx || cy) v.push([e, cx, cy]);
            if (cs.position === 'fixed') break;
          }
          clipMemo.set(el, v);
          return v;
        };
        let lastScroll = 0;
        let edgeRaf = 0;
        // (`live`: read every box now, as a laptop does each frame; on a phone only at rest, liteRest. A phone's frame takes
        // the boxes from the measure, moved by the scroll, and leaves the bands that move in the page or sit in a fixed or
        // sticky layer to the observers: their boxes do not follow the scroll)
        const edgeTick = (now = !lite): boolean => {
          edgeRaf = 0;
          if (!corners.some((c) => c.io)) return false;
          const sy = now ? window.scrollY : liteY;
          const lo = sy - 240;
          const hi = sy + POOL_FOOT + 240;
          const near = new Set<Element>();
          for (const el of bands) {
            const d = docBox.get(el);
            if (!d || moving.has(el) || (d.b > lo && d.t < hi)) near.add(el);
          }
          for (const c of corners) { c.rects.forEach((_, el) => near.add(el)); c.lineRects.forEach((_, el) => near.add(el)); c.ends.forEach((p) => p.under.forEach((el) => near.add(el))); }
          pillPoint.under.forEach((el) => near.add(el));
          const anc = new Map<Element, DOMRectReadOnly>();
          const boxOf = (e: Element) => { let r = anc.get(e); if (!r) { r = now ? e.getBoundingClientRect() : vbox(e); anc.set(e, r); } return r; };
          let changed = false;
          let regions = false;
          const pts: Point[] = [...corners.flatMap((c) => c.ends), pillPoint].filter((p) => p.io && p.x >= 0);
          near.forEach((el) => {
            const own = !now && (moving.has(el) || scrollLayer(el) !== 'flow');
            const r = now ? el.getBoundingClientRect() : vbox(el);
            // A drop shadow coming into the nav's strip or leaving it: the knockouts are cut again (trim, castNow), which
            // no region's rectangles changing asks for while the caster's own box stays above or below the strip. They
            // were cut where the shadow had been at the last pass: on atlas the knockout round Results and Free stuff
            // stayed off for 1000px of scroll after a card's shadow had passed, at rest too (390, both paths, 2026-11-09).
            const reach = castReach(el);
            if (reach) {
              const inStrip = r.bottom + reach.b > 0 && r.top - reach.t < POOL_FOOT;
              if (inStrip !== (castIn.get(el) ?? false)) { castIn.set(el, inStrip); changed = true; }
            }
            if (own) return;
            const d = docBox.get(el);
            const t = r.top + sy;
            // (a band that slides sideways moves too: youcook's week of meals drifts across the page as it scrolls)
            if (now) {
              if (d && (Math.abs(d.t - t) > 1 || Math.abs(d.b - (r.bottom + sy)) > 1 || Math.abs(d.l - r.left) > 1 || Math.abs(d.r - r.right) > 1)) moving.add(el);
              else moving.delete(el);
            }
            docBox.set(el, { t, b: r.bottom + sy, l: r.left, r: r.right });
            if (flatGrad.has(el) || flatStain.has(el)) gradDoc.set(el, { left: r.left, top: t, width: r.width, height: r.height });
            // the box as the observers see it: inside every ancestor that clips its overflow
            let l = r.left, tp = r.top, rt = r.right, bt = r.bottom;
            for (const [a, cx, cy] of clipsOf(el)) {
              const q = boxOf(a);
              if (cx) { l = Math.max(l, q.left); rt = Math.min(rt, q.right); }
              if (cy) { tp = Math.max(tp, q.top); bt = Math.min(bt, q.bottom); }
            }
            const has = rt > l && bt > tp;
            for (const p of pts) {
              const inside = has && rt > p.x && l < p.x + 4 && bt > NAV_LINE && tp < NAV_LINE + 4 && !!lineCut(el, r, new DOMRectReadOnly(p.x, NAV_LINE, 4, 4));
              if (inside !== p.under.has(el)) { changed = true; if (inside) p.under.add(el); else p.under.delete(el); }
            }
            if (!asTone((el as HTMLElement).dataset.navTheme)) return;
            for (const c of corners) {
              if (!c.io) continue;
              const clip = (y0: number, y1: number) => {
                const x0 = Math.max(l, c.pool0);
                const t0 = Math.max(tp, y0);
                const w = Math.min(rt, c.pool1) - x0;
                const h = Math.min(bt, y1) - t0;
                return has && w > 0 && h > 0 ? new DOMRectReadOnly(x0, t0, w, h) : null;
              };
              const same = (a: DOMRectReadOnly | undefined, b: DOMRectReadOnly | null) =>
                !a ? !b : !!b && Math.abs(a.left - b.left) < 0.5 && Math.abs(a.top - b.top) < 0.5 && Math.abs(a.right - b.right) < 0.5 && Math.abs(a.bottom - b.bottom) < 0.5;
              const reg = clip(0, POOL_FOOT);
              if (!same(c.rects.get(el), reg)) { changed = regions = true; if (reg) c.rects.set(el, reg); else c.rects.delete(el); }
              if (c.line.io) {
                const l0 = clip(NAV_LINE - 4, NAV_LINE + 4);
                const line = l0 && lineCut(el, r, l0);
                if (!same(c.lineRects.get(el), line)) { changed = true; if (line) c.lineRects.set(el, line); else c.lineRects.delete(el); }
              }
            }
          });
          if (regions) corners.forEach((c) => c.reports++);
          if (changed && !(lite && now)) sync();
          if (!(lite && now) && (changed || performance.now() - lastScroll < 500)) edgeRaf = requestAnimationFrame(() => edgeTick());
          return changed;
        };
        /* A circle a page paints under the nav, given as its geometry once per layout instead of an event a frame (the
           finale's night: nav.paintCircle = { cx, cy, r(scrollY) }, its centre on the screen and its radius as a function
           of the scroll, then a 'nav:circle' event; null to end it). Worked out here on the nav's own scroll frame from
           the scroll value it already has: dark inside the circle, the bands elsewhere, as a toneAt paint, while the
           circle is open and has not yet taken the screen's top corners (the page's force holds the nav from there). A
           corner only sees a change while the circle's edge is inside the nav's strip, so the nav is told only then. */
        let circleR = -1;
        let circleIn = false;
        const circleToneAt = (x: number, y: number) => {
          const pc = painted.paintCircle;
          return pc && Math.hypot(x - pc.cx, pc.cy - y) <= circleR ? 'dark' : null;
        };
        let circleQ = 0;
        const circleTick = () => {
          circleQ = 0;
          const pc = painted.paintCircle;
          const R = pc ? pc.r(lite ? liteY : window.scrollY) : 0;
          if (!pc || !(R > 0) || R >= Math.hypot(pc.cx, pc.cy)) {
            if (painted.toneAt === circleToneAt) {
              painted.toneAt = null;
              circleR = -1;
              circleIn = false;
              nav.dispatchEvent(new Event('nav:paint'));
            }
            return;
          }
          const mine = painted.toneAt === circleToneAt;
          // (another script's paint holds the nav: it says when it ends)
          if (!mine && painted.toneAt) return;
          if (mine && R === circleR) return;
          circleR = R;
          const inStrip = R >= pc.cy - POOL_FOOT - 8;
          if (!mine || inStrip || inStrip !== circleIn) {
            circleIn = inStrip;
            painted.toneAt = circleToneAt;
            nav.dispatchEvent(new Event('nav:paint'));
          }
        };
        const circleSoon = () => { if (!circleQ) circleQ = requestAnimationFrame(circleTick); };
        nav.addEventListener('nav:circle', circleSoon);
        circleSoon();
        // On a phone, once the scroll has rested 150ms: a new measure, every band's box read live once (the moved ones
        // found), and the words read again, so the nav at rest is exactly what it is on the laptop path
        // (and again every 150ms for the next 450ms, then for as long as one finds anything moved or a colour read through
        // a fade: a scrub catches up for about half a second after the scroll stops and a reveal fades in, and the last
        // read must come after them; the laptop path goes on reading for half a second after the scroll too)
        let restT = 0;
        let rests = 0;
        const liteRest = () => {
          restT = 0;
          if (!lite) return;
          geoEpoch++;
          liteY = window.scrollY;
          const moved = edgeTick(true);
          // (each band's box now, while the layout is clean, so the frames of the next scroll read none; read live even
          // for a band followed from its reports, whose last report can be older than where it has come to rest)
          for (const el of bands) { vmeasure(el); for (const [a] of clipsOf(el)) vmeasure(a); }
          sync();
          if ((moved || lastFaded || rests < 3) && ++rests < 12) restT = window.setTimeout(liteRest, 150);
        };
        // The laptop path reads every box each frame while the page scrolls and for half a second after, but works the
        // knockouts out again only when a region changes: so one more pass 700ms after the scroll stops, and what it shows
        // at rest is read at rest (a scrub that caught up after its last frame, a drop shadow that moved inside the strip).
        // Without it, at rest, atlas's knockout round Results and Free stuff stayed off and outreach's logo kept a light
        // knockout on the dark (390 on the laptop path, the perf round's state diff, 2026-11-09).
        const lapRest = () => { restT = 0; if (!lite) sync(); };
        window.addEventListener('scroll', () => {
          lastScroll = performance.now();
          if (!edgeRaf) edgeRaf = requestAnimationFrame(() => edgeTick());
          clearTimeout(restT);
          if (lite) { rests = 0; restT = window.setTimeout(liteRest, 150); }
          else restT = window.setTimeout(lapRest, 700);
          if (painted.paintCircle) circleSoon();
        }, { passive: true });
        // a document that changes size (a pin's spacer, an image landing, a section opening) moves the bands under the
        // phone's measure: measure again
        if (window.ResizeObserver) {
          let roT = 0;
          new ResizeObserver(() => {
            if (!lite) return;
            clearTimeout(roT);
            roT = window.setTimeout(() => { geoEpoch++; syncSoon(); }, 100);
          }).observe(document.documentElement);
        }
        // A page script that slides bands sideways says so on each frame it moves them:
        // nav.dispatchEvent(new CustomEvent('nav:moved', { detail: el })), el holding the bands. The observers miss a
        // sideways slide (a band's share of a region stays the same while it moves inside it), so those bands' rectangles
        // are read again here, one layout read for all, and the words sampled again. Youcook's store rail drifts with the
        // scroll and goes on drifting for its scrub's 0.6s after the scroll stops: the amber card's top was still read
        // 60px right of where the card had gone, and Results took the teal page's light ink and a teal knockout over its
        // first letters on the amber (1440 at 8940, 2026-11-09 re-check).
        nav.addEventListener('nav:moved', (e) => {
          const host = (e as CustomEvent<Element | null>).detail;
          if (!host) return;
          if (lite) geoEpoch++;
          const moved = toned.filter((b) => host.contains(b));
          if (!moved.length) return;
          const boxes = moved.map((b) => b.getBoundingClientRect());
          for (const c of corners) {
            if (!c.io) continue;
            const clip = (r: DOMRect, y0: number, y1: number) => {
              const l = Math.max(r.left, c.pool0);
              const t = Math.max(r.top, y0);
              const w = Math.min(r.right, c.pool1) - l;
              const h = Math.min(r.bottom, y1) - t;
              return w > 0 && h > 0 ? new DOMRectReadOnly(l, t, w, h) : null;
            };
            moved.forEach((b, i) => {
              const reg = clip(boxes[i], 0, POOL_FOOT);
              const l0 = clip(boxes[i], NAV_LINE - 4, NAV_LINE + 4);
              const line = l0 && lineCut(b, boxes[i], l0);
              if (reg) c.rects.set(b, reg);
              else c.rects.delete(b);
              if (line) c.lineRects.set(b, line);
              else c.lineRects.delete(b);
            });
            c.reports++;
          }
          sync();
        });
        // A page script may switch a band's tone (playivity's theme screenshot flips light and dark): re-read its
        // colour and resync. Without this the nav only noticed at the next crossing.
        new MutationObserver((records) => {
          records.forEach((r) => { const el = r.target as HTMLElement; bandColour.delete(el); flatTone.delete(el); flatRgb.delete(el); flatGrad.delete(el); flatShade.delete(el); flatStain.delete(el); plainBand.delete(el); const t = asTone(el.dataset.navTheme); if (t) { readColour(el, t); readFlat(el); } });
          toneEpoch++;
          sync();
        }).observe(document.body, { attributeFilter: ['data-nav-theme'], subtree: true });
        let rebuild = 0;
        window.addEventListener('resize', () => {
          cancelAnimationFrame(rebuild);
          rebuild = requestAnimationFrame(watch);
        }, { passive: true });
        // the brand's width settles once its web font lands
        document.fonts?.ready.then(() => { cancelAnimationFrame(rebuild); rebuild = requestAnimationFrame(watch); });
      }

      /* Scrolled: the pools appear past 24px. Read in the scroll event, written in the next frame, and only
         when it flips: a class written inside the event would leave style dirty for every scroll listener after
         this one (README, performance rule 3). */
      let scrolled = false;
      let queued = 0;
      const paint = () => { queued = 0; nav.classList.toggle('is-scrolled', scrolled); };
      const onScroll = () => {
        const s = window.scrollY > 24;
        if (s === scrolled) return;
        scrolled = s;
        if (!queued) queued = requestAnimationFrame(paint);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      // a restored scroll position (reload, back/forward cache) can land without a scroll event reaching here
      window.addEventListener('load', onScroll);
      window.addEventListener('pageshow', onScroll);
    }
  </script>

  <!-- ============================================================
       SCROLL PROGRESS
       ============================================================ -->
  <script>
    const bar = document.getElementById('scroll-progress');
    if (bar) {
      // The same numbers as always, read in the scroll event (layout is clean there, before any handler has
      // written), but the width is written in the next rAF of the same frame. Writing it inside the event left
      // layout dirty for every scroll listener after this one, so ScrollTrigger's and the sky's scroll reads each
      // ran a forced style recalc and layout, on every page. Tried caching the scroll range from a
      // ResizeObserver: the bar then came out up to 2px longer than before (the range it reads here can lag the
      // page's final height by a moment), so it stays a live read.
      let pct = 0;
      let queued = 0;
      const paint = () => { queued = 0; bar.style.width = pct + '%'; };
      window.addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        pct = max > 0 ? (window.scrollY / max) * 100 : 0;
        if (!queued) queued = requestAnimationFrame(paint);
      }, { passive: true });
    }
  </script>

  <!-- ============================================================
       SCROLLTRIGGER TIMING: all that is left of the old atmosphere's mood switcher
       ============================================================ -->
  <script>
    (async () => {
      // The atmosphere this drove (the dot and blueprint grids, the glows, a mood per section) is gone: the night
      // sky replaced it (page-sky.ts). Its ScrollTrigger setup stays, on every page: in the performance pass,
      // returning early on bare pages (the homepage and every case study, which never had those layers) dropped
      // these triggers and the load-time ScrollTrigger.refresh() below, and that changed where the homepage's card
      // wheel comes to rest on a phone at 4x CPU (.scratch/perf/st-b-p4 against st-a-p4). So every page keeps the
      // ScrollTrigger timing it was tuned with. The triggers draw nothing: their callbacks only ever set the mood.
      try {
        const { gsap } = await import('gsap');
        const { ScrollTrigger } = await import('gsap/ScrollTrigger');
        gsap.registerPlugin(ScrollTrigger);
        ['hero', 'services', 'sv-section', 'testimonial', 'youcook', 'capabilities', 'process', 'founder', 'cta'].forEach((id) => {
          const el = document.getElementById(id);
          if (el) ScrollTrigger.create({ trigger: el, start: 'top center', end: 'bottom center' });
        });
        window.addEventListener('load', () => ScrollTrigger.refresh());
      } catch {
        // timing only: nothing on the page depends on it loading
      }
    })();
  </script>

  <!-- ============================================================
       NIGHT SKY: the homepage's sky as one still frame, fixed behind a regular page or seen through a case study's
       footer (src/components/space/page-sky.ts). The homepage has neither mount: it draws its own sky.
       ============================================================ -->
  <script>
    import { mountPageSky } from '../components/space/page-sky';
    mountPageSky();
  </script>

  <!-- ============================================================
       OFF-SCREEN PAUSE: an infinite CSS animation keeps the page rendering every frame even out of view, so
       anything marked data-offscreen-pause stops its subtree's CSS animations while it is out of view (global.css).
       The margin keeps them running a little beyond the edges, so nothing is seen starting or stopping; they pick
       up where they paused, which no looping animation shows.
       ============================================================ -->
  <script>
    const pausable = document.querySelectorAll('[data-offscreen-pause]');
    if (pausable.length) {
      const pauseIO = new IntersectionObserver((entries) => {
        entries.forEach((e) => e.target.classList.toggle('is-offscreen', !e.isIntersecting));
      }, { rootMargin: '120px 0px' });
      pausable.forEach((el) => pauseIO.observe(el));
    }
  </script>

  <!-- ============================================================
       SCROLL REVEAL (IntersectionObserver)
       ============================================================ -->
  <script>
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal-section, .reveal-left, .reveal-right').forEach(el => io.observe(el));
  </script>

</body>
</html>
