---
import { t, type Locale } from '../i18n/utils';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---

<div class="metrics-bar reveal-section">
  <div class="container metrics-inner">
    <div class="metric">
      <div class="metric-num" data-target="10000" data-suffix="+">{t(locale, 'case_study_page.metric1_num')}</div>
      <div class="metric-label">{t(locale, 'case_study_page.metric1_label')}</div>
    </div>
    <div class="metric-divider"></div>
    <div class="metric">
      <div class="metric-num">{t(locale, 'case_study_page.metric2_num')}</div>
      <div class="metric-label">{t(locale, 'case_study_page.metric2_label')}</div>
    </div>
    <div class="metric-divider"></div>
    <div class="metric">
      <div class="metric-num">{t(locale, 'case_study_page.metric3_num')}</div>
      <div class="metric-label">{t(locale, 'case_study_page.metric3_label')}</div>
    </div>
  </div>
</div>

<style>
  .metrics-bar { padding: 64px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .metrics-inner { display: flex; align-items: center; justify-content: center; gap: 64px; flex-wrap: wrap; }
  .metric { text-align: center; }
  .metric-num { font-size: 40px; font-weight: 700; color: var(--cyan); letter-spacing: -0.02em; }
  .metric-label { font-size: 14px; color: var(--text-secondary); margin-top: 8px; }
  .metric-divider { width: 1px; height: 60px; background: var(--border); }
  @media (max-width: 600px) { .metric-divider { display: none; } }
</style>
