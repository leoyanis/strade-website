---
// StudentVenture → Vaultt. Desktop: pinned, the name morphs letter by letter while the page shifts
// from v1 charcoal to Vaultt navy, then the v1 site wipes into today's site.
// Mobile / no JS: both names and both screens, stacked.
const from = 'StudentVenture'.split('');
const to = 'Vaultt'.split('');
const base = '/images/work/vaultt/';
---

<section class="vt-rb" id="vt-rebrand">
  <div class="vt-rb__stage">
    <div class="vt-wrap vt-rb__inner">
      <div class="vt-rb__top">
        <p class="vt-tag vt-rb__tag"><span class="no">04</span> The rebrand</p>
        <p class="vt-rb__years">
          <span class="vt-rb__y is-from">2025 · StudentVenture</span>
          <span class="vt-rb__y-arrow" aria-hidden="true">→</span>
          <span class="vt-rb__y is-to">2026 · Vaultt</span>
        </p>
      </div>

      <div class="vt-rb__mid">
        <div class="vt-morph" id="vt-morph" role="img" aria-label="StudentVenture became Vaultt">
          <span class="vt-morph__from" aria-hidden="true">{from.map((c) => <span class="ch">{c}</span>)}</span>
          <span class="vt-morph__to" aria-hidden="true">{to.map((c) => <span class="ch">{c}</span>)}<img class="vt-morph__icon" src={`${base}icon.webp`} alt="" width="256" height="256" loading="lazy" /></span>
        </div>
        <p class="vt-rb__copy">
          The platform outgrew its name. StudentVenture is still the initiative behind it, and the product became
          <strong>Vaultt</strong>: a home for real work, for anyone who builds.
        </p>
      </div>

      <div class="vt-ba" id="vt-ba">
        <div class="vt-ba__frames">
          <figure class="vt-ba__frame is-before">
            <div class="vt-ba__bar">
              <span class="vt-ba__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="vt-ba__url">platform.studentventure.io</span>
              <span class="vt-ba__badge">v1 · 2025</span>
            </div>
            <div class="vt-ba__screen">
              <img src={`${base}v1-foryou.webp`} width="1440" height="859" loading="lazy" decoding="async"
                alt="StudentVenture v1: the For You page, with jobs, projects and events picked for each student" />
            </div>
          </figure>
          <figure class="vt-ba__frame is-after">
            <div class="vt-ba__bar">
              <span class="vt-ba__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="vt-ba__url">vaultt.io</span>
              <span class="vt-ba__badge is-now">Today</span>
            </div>
            <div class="vt-ba__screen">
              <img src={`${base}now-site.webp`} width="1440" height="859" loading="lazy" decoding="async"
                alt="vaultt.io today: Build in public. Connect. Get hired." />
            </div>
          </figure>
          <span class="vt-ba__handle" aria-hidden="true"><i></i></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .vt-rb {
    --rb-v1: #14181B;
    --rb-green: #19D83A;
    position: relative;
    background: linear-gradient(180deg, var(--rb-v1) 0%, var(--rb-v1) 30%, var(--vt-navy) 62%);
  }
  .vt-rb__stage { position: relative; padding: clamp(96px, 12vw, 150px) 0 clamp(80px, 10vw, 130px); }
  .vt-rb__inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .vt-rb__top { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .vt-rb__years {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center;
    font-family: var(--vt-mono); font-size: 11.5px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .vt-rb__y.is-from { color: var(--rb-green); }
  .vt-rb__y.is-to { color: var(--vt-blue); }
  .vt-rb__y-arrow { color: var(--vt-faint); }

  .vt-rb__mid { display: flex; flex-direction: column; align-items: center; width: 100%; }
  .vt-morph {
    --fs: clamp(40px, 9.2vw, 150px);
    position: relative; margin-top: 30px;
    display: flex; flex-direction: column; align-items: center; gap: 0.12em;
    font-family: var(--vt-display); font-weight: 800; font-size: var(--fs);
    line-height: 0.95; letter-spacing: -0.045em; color: var(--vt-light);
    white-space: nowrap; max-width: 100%;
  }
  .vt-morph .ch { display: inline-block; }
  .vt-morph__from { position: relative; font-size: 0.62em; color: rgba(232, 241, 255, 0.36); }
  .vt-morph__from::after {
    content: ''; position: absolute; left: -3%; right: -3%; top: 54%; height: 0.07em; border-radius: 99px;
    background: var(--rb-green); opacity: 0.9;
  }
  .vt-morph__to { display: inline-flex; align-items: flex-start; }
  .vt-morph__icon { display: inline-block; width: 0.52em; height: 0.52em; margin: 0.06em 0 0 0.07em; }

  /* JS morph mode: both words share one grid cell, centred */
  .vt-morph.is-morph { display: grid; justify-items: center; align-items: center; gap: 0; }
  .vt-morph.is-morph > span { grid-area: 1 / 1; }
  .vt-morph.is-morph .vt-morph__from { position: static; font-size: 1em; color: var(--vt-light); }
  .vt-morph.is-morph .vt-morph__from::after { display: none; }

  .vt-rb__copy { margin-top: 26px; max-width: 600px; font-size: 18px; line-height: 1.6; color: var(--vt-soft); text-wrap: balance; }
  .vt-rb__copy strong { color: var(--vt-light); font-weight: 600; }

  /* before / after */
  .vt-ba { width: 100%; margin-top: clamp(48px, 6vw, 72px); }
  .vt-ba__frames { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; text-align: left; }
  .vt-ba__frame {
    position: relative; display: flex; flex-direction: column; margin: 0;
    border-radius: 14px; overflow: hidden; border: 1px solid var(--vt-line-2);
    box-shadow: 0 50px 100px -50px rgba(0, 0, 0, 0.9);
  }
  .vt-ba__frame.is-before { background: #1d2125; border-color: rgba(255, 255, 255, 0.12); }
  .vt-ba__frame.is-after { background: var(--vt-navy-2); }
  .vt-ba__bar { display: flex; align-items: center; gap: 12px; height: 36px; padding: 0 12px; flex-shrink: 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .vt-ba__dots { display: flex; gap: 6px; }
  .vt-ba__dots i { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.18); }
  .vt-ba__url {
    flex: 1; min-width: 0; text-align: center;
    font-family: var(--vt-mono); font-size: 11px; letter-spacing: 0.02em; color: rgba(232, 241, 255, 0.7);
    background: rgba(255, 255, 255, 0.06); border-radius: 7px; padding: 5px 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .vt-ba__badge {
    font-family: var(--vt-mono); font-size: 9.5px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--rb-green); border: 1px solid currentColor; border-radius: 99px; padding: 4px 8px; white-space: nowrap;
  }
  .vt-ba__badge.is-now { color: var(--vt-blue); }
  .vt-ba__screen { position: relative; flex: 1; min-height: 0; overflow: hidden; aspect-ratio: 1440 / 859; }
  .vt-ba__screen img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .vt-ba__handle { display: none; }

  /* pinned desktop mode (class added by JS) */
  .vt-rb.is-pinned { background: var(--rb-v1); }
  .vt-rb.is-pinned .vt-rb__stage { height: 100vh; max-height: 1100px; min-height: 620px; padding: 88px 0 28px; overflow: hidden; }
  .vt-rb.is-pinned .vt-rb__inner { height: 100%; }
  .vt-rb.is-pinned .vt-rb__years .vt-rb__y-arrow { display: none; }
  .vt-rb.is-pinned .vt-rb__years { position: relative; display: grid; }
  .vt-rb.is-pinned .vt-rb__y { grid-area: 1 / 1; }
  .vt-rb.is-pinned .vt-morph { --fs: min(9vw, 16vh, 148px); margin-top: 2.2vh; }
  .vt-rb.is-pinned .vt-rb__copy { margin-top: 1.6vh; font-size: 17px; }
  .vt-rb.is-pinned .vt-ba { flex: none; margin-top: 3.2vh; display: flex; justify-content: center; }
  .vt-rb.is-pinned .vt-ba__frames {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0;
    width: min(100%, calc((min(100vh, 1100px) - 410px) * 1.6)); aspect-ratio: 1440 / 900;
  }
  .vt-rb.is-pinned .vt-ba__frame { grid-area: 1 / 1; height: 100%; min-height: 0; }
  .vt-rb.is-pinned .vt-ba__screen { aspect-ratio: auto; }
  .vt-rb.is-pinned .vt-ba__screen img { position: absolute; inset: 0; }
  .vt-rb.is-pinned .vt-ba__handle {
    display: block; position: absolute; top: -10px; bottom: -10px; left: 100%; width: 2px; margin-left: -1px; z-index: 3;
    background: var(--vt-blue); box-shadow: 0 0 24px rgba(111, 168, 255, 0.9); opacity: 0; pointer-events: none;
  }
  .vt-rb.is-pinned .vt-ba__handle i {
    position: absolute; top: 50%; left: 50%; width: 34px; height: 34px; margin: -17px 0 0 -17px; border-radius: 50%;
    background: var(--vt-blue); box-shadow: 0 0 0 6px rgba(111, 168, 255, 0.25);
  }
  .vt-rb.is-pinned .vt-ba__handle i::before, .vt-rb.is-pinned .vt-ba__handle i::after {
    content: ''; position: absolute; top: 50%; width: 7px; height: 7px; margin-top: -4px;
    border: solid var(--vt-navy); border-width: 0 2px 2px 0;
  }
  .vt-rb.is-pinned .vt-ba__handle i::before { left: 9px; transform: rotate(135deg); }
  .vt-rb.is-pinned .vt-ba__handle i::after { right: 9px; transform: rotate(-45deg); }

  @media (max-width: 767px) {
    .vt-ba__frames { grid-template-columns: 1fr; gap: 18px; }
    .vt-morph { --fs: 11.4vw; }
    .vt-rb__copy { font-size: 16px; }
    .vt-ba__bar { height: 30px; gap: 8px; padding: 0 9px; }
    .vt-ba__dots i { width: 7px; height: 7px; }
    .vt-ba__url { font-size: 9.5px; padding: 4px 8px; }
    .vt-ba__badge { font-size: 8px; padding: 3px 6px; }
  }
</style>
