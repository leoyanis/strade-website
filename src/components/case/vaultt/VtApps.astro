---
/**
 * VtApps: the native apps, side by side. The iPhone runs the Network tab with Apple's Liquid Glass tab bar,
 * the Android phone the same tab with its frosted pill (builder 1's PhoneFrame, NetworkScreen and bars,
 * both maps live while on screen). Under them the tab bar up close, over a feed of project stills passing
 * underneath, so the glass reads as glass: it blurs and bends what is behind it, the highlight follows the
 * pointer and the capsule glides to whatever you hover (LiquidGlassBar's own liquid stretch).
 * The phones lean toward the pointer (case-apps.ts). Reduced motion or ?still: still maps, a still feed.
 */
import PhoneFrame from '../../vaultt/PhoneFrame.astro';
import NetworkScreen from '../../vaultt/NetworkScreen.astro';
import LiquidGlassBar from '../../vaultt/LiquidGlassBar.astro';
import StoreButtons from '../../vaultt/StoreButtons.astro';

// project stills for the feed under the glass (drawn, nobody's real work). At rest (reduced motion, ?still)
// the second still sits under Explore: the film one, not the game, whose green ground glowed like a capsule
const stills = ['dusk', 'reel', 'paper', 'code', 'neon', 'arcade', 'garden', 'synth'];
---

<section class="vt-apps vt-section" id="vt-apps" aria-labelledby="vt-apps-h">
  <div class="vt-wrap vt-apps__grid">
    <header class="vt-apps__head">
      <p class="vt-tag">The apps</p>
      <h2 class="vt-h2" id="vt-apps-h">Native on iPhone <span class="lt">and Android.</span></h2>
      <p class="vt-lede">The iPhone app uses Apple's own Liquid Glass tab bar. Android gets a frosted bar of its own.</p>
      <div class="vt-apps__stores"><StoreButtons /></div>
    </header>
    <div class="vt-apps__stage" aria-hidden="true">
      <div class="vt-apps__tilt">
        <PhoneFrame platform="android" class="vt-apps__android"><NetworkScreen platform="android" seed={13} connections={64} following={7} /></PhoneFrame>
        <PhoneFrame platform="ios" class="vt-apps__iphone"><NetworkScreen platform="ios" seed={5} /></PhoneFrame>
      </div>
    </div>
  </div>

  <div class="vt-wrap">
    <div class="vt-glass" aria-hidden="true">
      <div class="vt-glass__view">
        <div class="vt-glass__strip">
          {[0, 1].map(() => (
            <div class="vt-glass__set">{stills.map((s) => <span class:list={['vt-still', `vt-still--${s}`]}><i></i></span>)}</div>
          ))}
        </div>
        <div class="vt-glass__shade"></div>
        <div class="vt-glass__bar"><LiquidGlassBar selected="network" initials="S" /></div>
      </div>
      <p class="vt-glass__cap vt-note">The tab bar, up close<span class="vt-glass__hover"> <b>·</b> hover it</span></p>
    </div>
  </div>
</section>

<style is:global>
  /* navy into the v1 charcoal at the bottom: the rebrand below starts in StudentVenture's colours, with no edge */
  .vt-apps { background: linear-gradient(180deg, var(--vt-navy) 0%, var(--vt-navy-2) 34%, #0F1C2E 72%, #14181B 100%); overflow: hidden; }
  .vt-apps__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 40px; align-items: center; }
  .vt-apps__head { display: flex; flex-direction: column; gap: 22px; max-width: 520px; }
  .vt-apps__stores { margin-top: 10px; }

  /* the phones: the iPhone in front, the Android a step behind and to the right */
  .vt-apps__stage { --apw: clamp(240px, 22vw, 300px); position: relative; height: calc(var(--apw) * 2.17 + 40px); perspective: 1600px; }
  .vt-apps__tilt { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
  /* .vt .vt-apps__tilt: PhoneFrame's own scoped rule sets position: relative at the same weight as a single class */
  .vt .vt-apps__tilt .vt-apps__iphone, .vt .vt-apps__tilt .vt-apps__android { position: absolute; top: 20px; }
  .vt .vt-apps__tilt .vt-apps__iphone { --phone-w: var(--apw); left: 8%; z-index: 2; }
  .vt .vt-apps__tilt .vt-apps__android { --phone-w: calc(var(--apw) * 0.9); left: calc(8% + var(--apw) * 0.74); top: calc(20px + var(--apw) * 0.16); z-index: 1; transform: rotate(5deg); transform-origin: 30% 90%; }
  .vt-apps__android::after { content: ''; position: absolute; inset: 0; z-index: 60; border-radius: inherit; background: rgba(5, 16, 32, 0.22); pointer-events: none; }

  /* the glass up close: a slice of the app (its charcoal) with a feed sliding under the bar */
  .vt-glass { margin-top: clamp(64px, 8vw, 110px); }
  .vt-glass__view {
    --u: 2.15px;
    position: relative; height: calc(var(--u) * 60 + 236px); border-radius: 28px; overflow: hidden;
    background: #131517; isolation: isolate;
    box-shadow: inset 0 0 0 1px rgba(232, 241, 255, 0.08), 0 40px 90px -50px rgba(0, 0, 0, 0.9);
  }
  .vt-glass__strip { position: absolute; left: 0; top: 26px; bottom: 26px; display: flex; width: max-content; will-change: transform; }
  .vt-glass__set { display: flex; gap: 14px; padding-right: 14px; height: 100%; }
  .vt-still { position: relative; flex: none; width: 210px; height: 100%; border-radius: 18px; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08); }
  .vt-still i { position: absolute; display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .vt-glass.is-run .vt-glass__strip { animation: vt-strip 38s linear infinite; }
  }
  @keyframes vt-strip { to { transform: translate3d(-50%, 0, 0); } }
  /* the app's page fades in from the edges, as a scrolling feed does under a floating bar */
  .vt-glass__shade { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, #131517 0, rgba(19, 21, 23, 0) 12%, rgba(19, 21, 23, 0) 88%, #131517 100%); }
  .vt-glass__bar { position: absolute; z-index: 2; left: 50%; bottom: 34px; width: calc(var(--u) * 351); max-width: calc(100% - 32px); translate: -50% 0; }
  /* up close the bar wears the app's dark-mode glass: a smoky tint under the highlights, a softer blur and a
     milder saturation. With the phone-size recipe (saturate 1.9, no tint) the green of a still passing under
     it glowed mint and read as a second capsule, and the selected blue label washed out on it */
  .vt .vt-glass__bar .lg .lg__glass {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.03) 55%, rgba(255, 255, 255, 0.06)), rgba(24, 26, 29, 0.56);
    -webkit-backdrop-filter: blur(calc(var(--u) * 7)) saturate(1.2) brightness(0.9);
    backdrop-filter: blur(calc(var(--u) * 7)) saturate(1.2) brightness(0.9);
  }
  .vt .vt-glass__bar .lg.lg--lens .lg__glass {
    -webkit-backdrop-filter: url(#vx-lg-lens) blur(calc(var(--u) * 6)) saturate(1.2) brightness(0.9);
    backdrop-filter: url(#vx-lg-lens) blur(calc(var(--u) * 6)) saturate(1.2) brightness(0.9);
  }
  .vt-glass__cap { margin-top: 18px; text-align: center; }
  .vt-glass__cap b { font-weight: 500; color: var(--vt-blue); margin: 0 5px; }
  @media (hover: none), (pointer: coarse) { .vt-glass__hover { display: none; } }

  /* the stills: soft colour fields with one shape each */
  .vt-still--dusk { background: radial-gradient(circle at 62% 58%, #FFE2B0 0 16px, rgba(255, 210, 150, 0.35) 18px, transparent 42px), radial-gradient(130% 60% at 20% 105%, #2A1640 0 50%, transparent 51%), linear-gradient(180deg, #F7769E, #FFAE7A 60%, #FF8A6E); }
  .vt-still--arcade { background: linear-gradient(#24A57E, #1B7F62) 0 100% / 100% 22% no-repeat, linear-gradient(#2FD4C1, #23B3A3) 18% 60% / 40% 7% no-repeat, linear-gradient(180deg, #23165A, #4A2FD0 64%, #7A5CFF); }
  .vt-still--arcade i { left: 28%; top: 42%; width: 22px; height: 24px; border-radius: 5px; background: #FFCF4A; box-shadow: inset -4px -4px 0 rgba(160, 90, 0, 0.35); }
  .vt-still--paper { background: radial-gradient(40% 46% at 32% 42%, #FF5FA2 0 60%, transparent 63%), radial-gradient(30% 36% at 68% 62%, #FFB37A 0 58%, transparent 62%), radial-gradient(22% 26% at 62% 24%, #A27BFF 0 56%, transparent 60%), linear-gradient(160deg, #2A1E3F, #1B1430); }
  .vt-still--code { background-color: #0F1E36; background-image: linear-gradient(90deg, #4C8DFF 0 46%, transparent 46%), linear-gradient(90deg, transparent 0 12%, #8BE04E 12% 58%, transparent 58%), linear-gradient(90deg, transparent 0 12%, #8EBBFF 12% 40%, transparent 40% 46%, #FF9A3D 46% 70%, transparent 70%), linear-gradient(90deg, #A27BFF 0 30%, transparent 30%), linear-gradient(90deg, transparent 0 12%, #8EBBFF 12% 64%, transparent 64%); background-size: 100% 6px; background-repeat: no-repeat; background-position: 22px 40px, 22px 58px, 22px 76px, 22px 94px, 22px 112px; }
  .vt-still--neon { background: radial-gradient(circle at 50% 46%, transparent 0 34px, #FF5FA2 35px 39px, transparent 40px), radial-gradient(circle at 50% 46%, rgba(255, 95, 162, 0.35), transparent 70%), linear-gradient(160deg, #1A0E3A, #3B1D8F); }
  .vt-still--reel { background: linear-gradient(#05070C 0 13%, transparent 13% 87%, #05070C 87%), radial-gradient(90% 70% at 70% 100%, #0B1F3E 0 45%, transparent 46%), linear-gradient(180deg, #3D7FD6, #1C4FB8 70%, #13308A); }
  .vt-still--garden { background: radial-gradient(60% 40% at 30% 100%, #1F7A52 0 60%, transparent 62%), radial-gradient(50% 36% at 76% 100%, #4E9A2E 0 58%, transparent 60%), radial-gradient(circle at 70% 30%, #FFF1C2 0 12px, rgba(255, 241, 194, 0.25) 14px, transparent 30px), linear-gradient(180deg, #13305A, #2F5E8F); }
  .vt-still--synth { background: repeating-linear-gradient(90deg, rgba(232, 241, 255, 0.78) 0 16px, #0B1220 16px 18px) 0 100% / 100% 34% no-repeat, linear-gradient(160deg, #C2621C, #E09A1E); }
  .vt-still--synth i { left: 16px; top: 18px; width: 54px; height: 54px; border-radius: 50%; background: radial-gradient(circle at 40% 40%, #fff 0 4px, #0B1220 5px 100%); box-shadow: 70px 0 0 0 #0B1220; }

  @media (max-width: 1023px) {
    .vt-apps__grid { grid-template-columns: 1fr; gap: 56px; }
    .vt-apps__stage { --apw: min(46vw, 280px); max-width: 640px; width: 100%; margin: 0 auto; }
    .vt .vt-apps__tilt .vt-apps__iphone { left: calc(50% - var(--apw) * 0.86); }
    .vt .vt-apps__tilt .vt-apps__android { left: calc(50% - var(--apw) * 0.12); }
  }
  @media (max-width: 767px) {
    .vt-apps__stage { --apw: min(47vw, 220px); height: calc(var(--apw) * 2.17 + 46px); }
    .vt-glass__view { --u: 0.98px; height: calc(var(--u) * 60 + 170px); border-radius: 22px; }
    .vt-glass__strip { top: 18px; bottom: 18px; }
    .vt-still { width: 120px; border-radius: 14px; }
    .vt-glass__bar { bottom: 20px; }
  }
</style>
