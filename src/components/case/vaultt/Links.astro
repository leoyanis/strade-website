---
// Go and look: the website, the web app, the App Store and Google Play (both apps live, no beta).
// Links come from VAULTT_LINKS in src/data/work.ts, so a URL changes in one place.
// The thumbs are drawn tiles: the old vaultt.io screenshot showed real members' names and faces.
import { VAULTT_LINKS } from '../../../data/work';
import VaulttMark from '../../vaultt/VaulttMark.astro';
const rows = [
  { href: VAULTT_LINKS.web, k: 'Website', name: 'vaultt.io', thumb: 'site', label: 'Open vaultt.io' },
  { href: VAULTT_LINKS.app, k: 'In your browser', name: 'Web app', thumb: 'web', label: 'Open the Vaultt web app' },
  { href: VAULTT_LINKS.appStore, k: 'iPhone', name: 'App Store', thumb: 'apple', label: 'Download Vaultt on the App Store' },
  { href: VAULTT_LINKS.playStore, k: 'Android', name: 'Google Play', thumb: 'play', label: 'Get Vaultt on Google Play' },
];
---

<section class="vt-links vt-section" id="vt-links" aria-labelledby="vt-links-h">
  <div class="vt-wrap">
    <header class="vt-head">
      <p class="vt-tag">See it live</p>
      <h2 class="vt-h2" id="vt-links-h">Go and look. <span class="lt">It's all real.</span></h2>
    </header>

    <div class="vt-links__list">
      {rows.map((r) => (
        <a class="vt-link" href={r.href} target="_blank" rel="noopener" aria-label={r.label} data-rise>
          {r.thumb === 'site' && (
            <span class="vt-link__thumb is-app is-site"><VaulttMark class="vt-link__mark" /></span>
          )}
          {r.thumb === 'web' && (
            <span class="vt-link__thumb is-app is-web">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.6" y="4" width="18.8" height="15.4" rx="2.6" /><path d="M2.6 8.4h18.8" /><circle cx="5.5" cy="6.2" r="0.6" fill="currentColor" stroke="none" /><circle cx="7.6" cy="6.2" r="0.6" fill="currentColor" stroke="none" /><circle cx="9.7" cy="6.2" r="0.6" fill="currentColor" stroke="none" /><path d="m12 13.9-5-2.2M12 13.9l5.2-2.4M12 13.9l-3.5 3.3M12 13.9l3.6 3.4" stroke-width="1.1" /><circle cx="12" cy="13.9" r="1.6" fill="currentColor" stroke="none" /><circle cx="6.8" cy="11.6" r="1.05" fill="currentColor" stroke="none" /><circle cx="17.4" cy="11.4" r="1.05" fill="currentColor" stroke="none" /><circle cx="8.3" cy="17.3" r="1.05" fill="currentColor" stroke="none" /><circle cx="15.8" cy="17.4" r="1.05" fill="currentColor" stroke="none" /></svg>
            </span>
          )}
          {r.thumb === 'apple' && (
            <span class="vt-link__thumb is-app">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.365 1.43c0 1.14-.42 2.2-1.12 2.98-.76.86-2 1.52-3.02 1.44-.13-1.1.44-2.27 1.1-3 .74-.83 2.03-1.45 3.04-1.42zM20.5 17.2c-.55 1.27-.82 1.84-1.53 2.97-.99 1.57-2.39 3.53-4.11 3.54-1.53.01-1.92-.99-4-1-2.08-.01-2.51.98-4.04.99-1.72.02-3.03-1.79-4.02-3.36C-.02 16.9-.3 11.7 1.9 8.98 2.92 7.7 4.52 6.9 6.24 6.9c1.75 0 2.85 1 4.29 1 1.4 0 2.25-1 4.28-1 1.53 0 3.16.83 4.32 2.27-3.8 2.08-3.18 7.5.37 8.05z" /></svg>
            </span>
          )}
          {r.thumb === 'play' && (
            <span class="vt-link__thumb is-app is-play">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#00D2FF" d="M3.6 2.1C3.4 2.3 3.3 2.6 3.3 3v18c0 .4.1.7.3.9l10.1-9.9L3.6 2.1z" />
                <path fill="#00E676" d="M3.6 2.1 14.8 8.6l2.8-2.8L5.9 1.3C5 .8 4.2 1 3.6 2.1z" />
                <path fill="#FFC400" d="m17.6 5.8-2.8 2.8 2.9 2.9 3.6-2c1-.6 1-2.1 0-2.7l-3.7-1z" />
                <path fill="#FF3D00" d="m3.6 21.9 11.2-6.5-2.9-2.9L3.6 21.9z" />
              </svg>
            </span>
          )}
          <span class="vt-link__txt">
            <span class="vt-link__k">{r.k}</span>
            <strong>{r.name}</strong>
          </span>
          <span class="vt-link__go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9" /></svg></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .vt-links { background: var(--vt-navy); padding-bottom: clamp(72px, 9vw, 110px); }
  .vt-links__list { display: flex; flex-direction: column; border-top: 1px solid var(--vt-line-2); }
  .vt-link {
    position: relative; display: grid; grid-template-columns: 180px minmax(0, 1fr) auto; align-items: center; gap: 32px;
    padding: 24px 8px; border-bottom: 1px solid var(--vt-line-2);
    transition: background 0.35s var(--vt-out), padding 0.35s var(--vt-out);
  }
  .vt-link:hover { background: rgba(111, 168, 255, 0.07); padding-left: 20px; padding-right: 20px; }
  .vt-link:focus-visible { outline: 2px solid var(--vt-blue); outline-offset: -2px; }
  .vt-link__thumb { width: 180px; aspect-ratio: 16 / 10; border-radius: 12px; overflow: hidden; border: 1px solid var(--vt-line-2); display: grid; place-items: center; }
  .vt-link__thumb.is-app { background: radial-gradient(circle at 50% 40%, #1d4a8a, var(--vt-navy-2)); color: #fff; }
  .vt-link__thumb.is-play { background: radial-gradient(circle at 50% 40%, #173f73, var(--vt-navy-2)); }
  .vt-link__thumb.is-site { background: radial-gradient(circle at 50% 42%, #1A4380, var(--vt-navy-2) 72%); }
  .vt-link__thumb.is-web { color: var(--vt-blue); background: radial-gradient(circle at 50% 40%, #16386A, var(--vt-navy-2)); }
  .vt-link__thumb.is-app svg { width: 44px; height: 44px; display: block; transition: transform 0.6s var(--vt-out); }
  .vt-link:hover .vt-link__thumb.is-app svg { transform: scale(1.1); }
  .vt-link__txt { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .vt-link__k { font-family: var(--vt-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--vt-blue); }
  .vt-link__txt strong { font-family: var(--vt-display); font-size: clamp(34px, 5vw, 68px); font-weight: 800; letter-spacing: -0.045em; line-height: 1; }
  .vt-link__go {
    width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center;
    border: 1px solid var(--vt-line-2); color: var(--vt-light);
    transition: background 0.3s, color 0.3s, transform 0.4s var(--vt-out), border-color 0.3s;
  }
  .vt-link__go svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .vt-link:hover .vt-link__go { background: var(--vt-blue); border-color: var(--vt-blue); color: var(--vt-navy); transform: rotate(45deg); }

  @media (max-width: 700px) {
    .vt-link { grid-template-columns: 88px minmax(0, 1fr) auto; gap: 16px; padding: 18px 0; }
    .vt-link:hover { padding-left: 0; padding-right: 0; }
    .vt-link__thumb { width: 88px; border-radius: 10px; }
    .vt-link__thumb.is-app svg { width: 28px; height: 28px; }
    .vt-link__txt strong { font-size: 30px; }
    .vt-link__go { width: 44px; height: 44px; }
    .vt-link__go svg { width: 18px; height: 18px; }
  }
</style>
