---
import { SPARK } from './hat';
interface Props { appStore: string; playStore: string; site: string; year: string }
const { appStore, playStore, site, year } = Astro.props;

// Ingredient chips straight from youcookapp.com, floating around the phones.
const chips = [
  { e: '🥦', t: 'Broccoli', x: 2, y: 20, r: -9, d: 0.55 },
  { e: '🍋', t: 'Lemon', x: 70, y: 3, r: 7, d: 0.7 },
  { e: '🌶️', t: 'Chilli', x: 80, y: 47, r: 10, d: 0.85 },
  { e: '🍗', t: 'Chicken', x: 0, y: 63, r: 6, d: 1.0 },
  { e: '🍚', t: 'Rice', x: 32, y: 88, r: -6, d: 1.15 },
  { e: '🥕', t: 'Carrot', x: 74, y: 82, r: -10, d: 1.3 },
];
---

<section class="hero" id="yc-hero">
  <script is:inline>
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var h = document.documentElement;
      h.classList.add('yc-intro');
      setTimeout(function () { h.classList.remove('yc-intro'); }, 2500);
    })();
  </script>
  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__quest"><span class="hero__quest-tier">Side quest</span><span>My product</span></p>
      <img class="hero__logo" src="/images/work/youcook/logo.webp" alt="YouCook" width="440" height="90" />
      <h1 class="hero__title">
        Delicious meals<br />
        <span class="hero__accent">in seconds
          <svg class="hero__swash" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 17 C 70 6, 160 4, 296 12" /></svg>
        </span>
      </h1>
      <p class="hero__lede">
        My own AI cooking app. Snap your fridge, say what you have or type it in, and YouCook hands you the perfect recipe.
        Then it plans your week and writes the shopping list. I designed, built, published and marketed it myself.
      </p>
      <ul class="hero__chips" aria-label="Status">
        <li class="hchip hchip--live"><i aria-hidden="true"></i>Live on iOS</li>
        <li class="hchip hchip--live"><i aria-hidden="true"></i>Live on Android</li>
        <li class="hchip">{year}</li>
      </ul>
      <div class="hero__stores">
        <a href={appStore} target="_blank" rel="noopener" class="badge">
          <img src="/images/work/youcook/badge-appstore.webp" alt="Download YouCook on the App Store" width="402" height="120" />
        </a>
        <a href={playStore} target="_blank" rel="noopener" class="badge">
          <img src="/images/work/youcook/badge-play.webp" alt="Get YouCook on Google Play" width="401" height="120" />
        </a>
        <a href={site} target="_blank" rel="noopener" class="hero__site">youcookapp.com <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__blob" aria-hidden="true"></div>
      <svg class="hero__spark hero__spark--1" viewBox="0 0 24 24" aria-hidden="true"><path d={SPARK} /></svg>
      <svg class="hero__spark hero__spark--2" viewBox="0 0 24 24" aria-hidden="true"><path d={SPARK} /></svg>
      <svg class="hero__spark hero__spark--3" viewBox="0 0 24 24" aria-hidden="true"><path d={SPARK} /></svg>
      <div class="hero__phone hero__phone--back">
        <img src="/images/work/youcook/phone-menu.webp" alt="YouCook main menu with favourite recipes" width="560" height="1103" fetchpriority="high" />
      </div>
      <div class="hero__phone hero__phone--front">
        <img src="/images/work/youcook/phone-home.webp" alt="YouCook home screen with tonight's dinner: chicken and vegetable curry at 6 PM" width="560" height="1103" fetchpriority="high" />
      </div>
      {chips.map((c) => (
        <span class="fchip" style={`--x:${c.x}%;--y:${c.y}%;--r:${c.r}deg;--d:${c.d}s`} aria-hidden="true">
          <span class="fchip__in"><span class="fchip__e">{c.e}</span>{c.t}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<script>
  import { loadMotion } from './motion';

  (async () => {
    const hero = document.getElementById('yc-hero');
    const html = document.documentElement;
    const m = hero ? await loadMotion() : null;
    // No GSAP, or the safety timeout already revealed the hero: leave it as it is.
    if (!hero || !m || !html.classList.contains('yc-intro')) { html.classList.remove('yc-intro'); return; }
    const { gsap } = m;
    const q = (s: string) => Array.from(hero.querySelectorAll<HTMLElement>(s));
    const chips = q('.fchip').sort((a, b) => parseFloat(a.style.getPropertyValue('--d')) - parseFloat(b.style.getPropertyValue('--d')));
    // Drop the pre-hide class first (same task, so no paint in between); the from() tweens
    // below immediately set their own start states and read the real end values.
    html.classList.remove('yc-intro');
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    tl.from(q('.hero__copy > *'), { y: 26, opacity: 0, duration: 0.9, stagger: 0.07 }, 0)
      .from(q('.hero__swash path'), { strokeDashoffset: 320, duration: 1.1, ease: 'power3.out' }, 0.6)
      .from(q('.hero__blob'), { scale: 0.6, opacity: 0, duration: 1.2 }, 0.1)
      .from(q('.hero__phone'), { y: 90, rotate: 0, scale: 0.92, opacity: 0, duration: 1.2, stagger: 0.15 }, 0.15)
      .from(chips, { scale: 0.3, y: 20, opacity: 0, duration: 0.7, stagger: 0.15, ease: 'back.out(2.2)' }, 0.55);

    // Desktop depth: as the hero scrolls away the blob lags, the phones and chips float up at
    // different speeds. Uses yPercent so it never fights the intro's y/scale tweens.
    gsap.matchMedia().add('(min-width: 901px)', () => {
      const st = () => ({ trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.6 });
      gsap.to(q('.hero__blob'), { yPercent: 14, ease: 'none', scrollTrigger: st() });
      gsap.to(q('.hero__phone--back'), { yPercent: -6, ease: 'none', scrollTrigger: st() });
      gsap.to(q('.hero__phone--front'), { yPercent: -14, ease: 'none', scrollTrigger: st() });
      chips.forEach((c, i) => gsap.to(c, { yPercent: -(120 + (i % 3) * 90), ease: 'none', scrollTrigger: st() }));
    });
    m.refresh();
  })();
</script>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding: 108px 0 64px;
    background: #fff;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--yc-pattern);
    background-size: clamp(380px, 38vw, 560px);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 100%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--yc-gutter);
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    min-height: min(800px, calc(100svh - 140px));
  }

  /* ---------- copy ---------- */
  .hero__quest {
    display: inline-flex;
    align-items: stretch;
    border-radius: 999px;
    border: 1.5px solid var(--yc-ink-strong);
    overflow: hidden;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--yc-ink-strong);
    background: #fff;
    margin-bottom: 26px;
  }
  .hero__quest span { padding: 7px 14px; }
  .hero__quest-tier { background: var(--yc-coral); color: #fff; }
  .hero__logo { display: block; width: clamp(170px, 17vw, 220px); height: auto; margin-bottom: 18px; }
  .hero__title {
    font-family: var(--yc-font);
    font-size: clamp(46px, 5.1vw, 76px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.035em;
    color: var(--yc-ink);
    margin: 0 0 22px;
  }
  .hero__accent { position: relative; display: inline-block; color: var(--yc-coral); }
  .hero__swash {
    position: absolute;
    left: 2%;
    bottom: -0.16em;
    width: 96%;
    height: 0.26em;
    overflow: visible;
  }
  .hero__swash path {
    fill: none;
    stroke: var(--yc-coral);
    stroke-width: 6;
    stroke-linecap: round;
    opacity: 0.35;
    stroke-dasharray: 320;
    stroke-dashoffset: 0;
  }
  .hero__lede {
    font-size: clamp(17px, 1.45vw, 19.5px);
    font-weight: 500;
    line-height: 1.6;
    color: #555;
    max-width: 540px;
    margin: 0 0 24px;
  }
  .hero__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 26px; padding: 0; }
  .hchip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    color: var(--yc-ink-strong);
    background: var(--yc-surface);
    border: 1px solid #ffd9d2;
  }
  .hchip--live { background: #effaf3; border-color: #c9eed6; color: #166534; }
  .hchip i { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
  .hero__stores { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; }
  .badge { display: block; border-radius: 10px; transition: transform 0.3s var(--yc-ease); }
  .badge:hover { transform: translateY(-2px); }
  .badge img { display: block; height: 50px; width: auto; }
  .hero__site {
    margin-left: 6px;
    font-weight: 700;
    font-size: 15px;
    color: var(--yc-teal-deep);
    padding: 10px 4px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.25s;
  }
  .hero__site:hover { border-color: currentColor; }

  /* ---------- visual ---------- */
  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 580px;
    aspect-ratio: 1 / 1.06;
    justify-self: end;
  }
  .hero__blob {
    position: absolute;
    left: 9%;
    top: 9%;
    width: 84%;
    aspect-ratio: 1;
    border-radius: 47% 53% 42% 58% / 52% 41% 59% 48%;
    background:
      radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 38%),
      radial-gradient(circle at 50% 50%, #ffc2b8 0%, #ff9d91 58%, #ff8378 100%);
  }
  .hero__spark { position: absolute; width: 30px; height: 30px; }
  .hero__spark path { fill: var(--yc-salmon); }
  .hero__spark--1 { left: 13%; top: 6%; width: 34px; height: 34px; }
  .hero__spark--2 { right: 4%; top: 30%; width: 20px; height: 20px; }
  .hero__spark--2 path { fill: var(--yc-teal); }
  .hero__spark--3 { left: 52%; bottom: 3%; width: 18px; height: 18px; }

  .hero__phone { position: absolute; }
  .hero__phone img { display: block; width: 100%; height: auto; }
  .hero__phone--back { left: 6%; top: 3%; width: 45%; --r: -8deg; transform: rotate(var(--r)); }
  .hero__phone--front { left: 43%; top: 12%; width: 47%; --r: 6deg; transform: rotate(var(--r)); }
  .hero__phone--back img { filter: drop-shadow(0 26px 34px rgba(150, 50, 35, 0.22)); }
  .hero__phone--front img { filter: drop-shadow(0 34px 44px rgba(150, 50, 35, 0.3)); }

  .fchip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 3;
  }
  .fchip__in {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    padding: 7px 13px 7px 10px;
    border-radius: 999px;
    background: #fff;
    border: 1.5px solid rgba(34, 34, 34, 0.85);
    box-shadow: 0 10px 24px -8px rgba(80, 30, 20, 0.35);
    font-size: 14px;
    font-weight: 700;
    color: var(--yc-ink-strong);
    transform: rotate(var(--r));
  }
  .fchip__e { font-size: 16px; line-height: 1; }

  /* The entrance is played by GSAP (see script). The inline script sets .yc-intro on <html>
     before first paint so nothing flashes; it removes itself if GSAP never arrives. */
  :global(html.yc-intro) .hero__copy > *,
  :global(html.yc-intro) .hero__phone,
  :global(html.yc-intro) .hero__blob,
  :global(html.yc-intro) .fchip { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .hero__blob { animation: yc-morph 16s 1.3s ease-in-out infinite; }
    .hero__phone img { animation: yc-bob 7s ease-in-out infinite; animation-delay: 1.6s; }
    .hero__phone--back img { animation-duration: 8s; animation-delay: 2.2s; }
    .fchip__in { animation: yc-chip-bob 5s ease-in-out infinite; animation-delay: calc(var(--d) + 0.8s); }
    .fchip:nth-of-type(2n) .fchip__in { animation-duration: 6.2s; }
    .hero__spark { animation: yc-twinkle 3.2s ease-in-out infinite; }
    .hero__spark--2 { animation-delay: 1.1s; }
    .hero__spark--3 { animation-delay: 2s; }
    .hchip--live i { animation: yc-live 2s ease-out infinite; }
  }
  @keyframes yc-morph {
    0%, 100% { border-radius: 47% 53% 42% 58% / 52% 41% 59% 48%; }
    33% { border-radius: 58% 42% 55% 45% / 44% 58% 42% 56%; }
    66% { border-radius: 41% 59% 47% 53% / 57% 46% 54% 43%; }
  }
  @keyframes yc-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
  @keyframes yc-chip-bob {
    0%, 100% { transform: rotate(var(--r)) translateY(0); }
    50% { transform: rotate(calc(var(--r) * -0.4)) translateY(-8px); }
  }
  @keyframes yc-twinkle { 0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; } 50% { transform: scale(0.6) rotate(45deg); opacity: 0.6; } }
  @keyframes yc-live { 0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55); } 80%, 100% { box-shadow: 0 0 0 9px rgba(34, 197, 94, 0); } }

  @media (max-width: 900px) {
    .hero { padding: 96px 0 40px; }
    .hero__inner { grid-template-columns: minmax(0, 1fr); min-height: 0; gap: 18px; }
    .hero__visual { justify-self: center; max-width: 460px; aspect-ratio: 1 / 1.04; }
  }
  @media (max-width: 520px) {
    .hero__title { font-size: clamp(44px, 12.6vw, 58px); }
    .hero__lede { font-size: 16.5px; }
    .badge img { height: 44px; }
    .hero__site { margin-left: 0; }
    .fchip__in { font-size: 12px; padding: 5px 10px 5px 8px; gap: 5px; }
    .fchip__e { font-size: 14px; }
  }
</style>
