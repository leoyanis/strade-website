---
// The chat presets are the app's real quick prompts (also on youcookapp.com).
// side: which edge of the phone the sticker hugs on desktop; ov: how far it tucks over the phone.
// mx/my: phone layout (only the four with mx/my show there).
const stickers = [
  { t: 'What does sauté mean?', side: 'l', ov: 64, y: 7, mx: 0, my: 2.5, r: -6 },
  { t: 'I need help', side: 'r', ov: 44, y: 2.5, mx: 70, my: 5, r: 5 },
  { t: 'Explain step nr...', side: 'l', ov: 16, y: 33, r: 8 },
  { t: 'I need a dipping sauce', side: 'r', ov: 16, y: 25, r: -5, wide: true },
  { t: 'Explain how to...', side: 'l', ov: 16, y: 57, r: -7 },
  { t: 'Can you help me with...', side: 'r', ov: 16, y: 61, r: 7, wide: true },
  { t: 'Suggest a replacement for butter', side: 'r', ov: 150, y: 77, mx: 0, my: 89.5, r: 4 },
  { t: 'I request a chef’s tip', side: 'l', ov: 46, y: 84, mx: 52, my: 95, r: -4, tap: true },
];
---

<section class="chat" id="yc-chat">
  <div class="chat__grid">
    <div class="chat__stage">
      {stickers.map((s) => (
        <span
          class:list={['stk', `stk--${s.side}`, s.tap && 'stk--tap', s.mx === undefined && 'stk--desk', s.wide && 'stk--wide']}
          style={`--ov:${s.ov}px;--y:${s.y}%;--mx:${s.mx ?? 0}%;--my:${s.my ?? 0}%;--r:${s.r}deg`}
          aria-hidden="true"
        >
          <span class="stk__in">{s.t}</span>
        </span>
      ))}

      <div class="xphone" role="img" aria-label="YouCook AI chef chat: asking for a chef's tip on a chicken and vegetable curry">
        <div class="xphone__island" aria-hidden="true"></div>
        <div class="xphone__status" aria-hidden="true"><span>17:00</span><span class="xphone__icons">●●● ᯤ ▮</span></div>
        <div class="cc" aria-hidden="true">
          <div class="cc__head">
            <span class="cc__back">←</span>
            <span class="cc__name">🍛 Chicken and Vegetable Curry</span>
            <img class="cc__thumb" src="/images/work/youcook/curry.webp" alt="" width="680" height="462" loading="lazy" />
          </div>
          <div class="cc__tools"><span class="cc__bin">🗑</span><span class="cc__presets">Show presets ⌄</span></div>
          <div class="cc__body">
            <p class="cc__me">I request a chef’s tip.</p>
            <div class="cc__typing"><i></i><i></i><i></i></div>
            <div class="cc__answer">
              <p class="cc__chef"><span class="cc__avatar"><img src="/images/work/youcook/hat.webp" alt="" width="200" height="200" loading="lazy" /></span>Chef’s Tip</p>
              <p class="cc__p">To take your Chicken and Vegetable Curry with Basmati Rice to the next level, here’s a valuable tip:</p>
              <p class="cc__p cc__p--li"><span class="cc__bullet">•</span><b>Layering Flavors:</b> When cooking the curry, add the aromatics (in this case, garlic) first and sauté until fragrant. This will help to release the natural oils and intensify the flavor. Then, add the curry powder and cook for a minute, allowing the spices to bloom and blend with the garlic.</p>
            </div>
          </div>
          <div class="cc__input"><span class="cc__ph">Your prompt here...</span><span class="cc__typed"></span><span class="cc__mic">🎙</span></div>
        </div>
      </div>
    </div>

    <div class="chat__copy" data-yc-reveal>
      <p class="yc-eyebrow yc-eyebrow--light">AI chef chat</p>
      <h2 class="chat__title">Out of eggs?<br />We’ve got you.</h2>
      <p class="chat__lede">Substitutions, adjustments and answers on demand. The recipe adapts to you.</p>
      <p class="chat__body">
        Every recipe comes with its own chef to talk to. Ask what sauté means, swap the butter or ask for a tip,
        without leaving the step you’re on.
      </p>
    </div>
  </div>
</section>

<style>
  .chat {
    position: relative;
    overflow: clip;
    color: #fff;
    background:
      var(--yc-pattern-light),
      linear-gradient(165deg, #9c63d8 0%, #8e4fcd 45%, #6a31a3 100%);
    background-size: clamp(380px, 38vw, 560px), auto;
    padding: clamp(80px, 10vw, 140px) 0;
  }
  .chat__grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--yc-gutter);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .chat__title {
    font-size: clamp(42px, 5.4vw, 74px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.035em;
    margin: 0 0 20px;
    color: #fff;
    text-shadow: 0 2px 0 rgba(60, 10, 100, 0.2);
  }
  .chat__lede { font-size: clamp(19px, 1.7vw, 23px); font-weight: 600; line-height: 1.45; margin: 0 0 16px; }
  .chat__body { font-size: 17px; font-weight: 500; line-height: 1.65; color: rgba(255, 255, 255, 0.86); max-width: 460px; margin: 0; }

  .chat__stage {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 10px 0;
    min-height: 640px;
    align-items: center;
  }
  .stk { position: absolute; top: var(--y); z-index: 3; --ph: min(160px, 37vw); }
  .stk--l { right: calc(50% + var(--ph) - var(--ov)); }
  .stk--r { left: calc(50% + var(--ph) - var(--ov)); }
  .stk__in {
    display: inline-block;
    white-space: nowrap;
    padding: 9px 16px;
    border-radius: 14px;
    background: #f8b44a;
    color: #1d1d1d;
    border: 1.5px solid rgba(29, 29, 29, 0.85);
    font-size: 15.5px;
    font-weight: 600;
    box-shadow: 0 14px 24px -10px rgba(40, 0, 70, 0.55);
    transform: rotate(var(--r));
  }
  .stk--tap .stk__in { background: #ffd27a; }

  .xphone {
    position: relative;
    width: min(320px, 74vw);
    aspect-ratio: 9 / 19;
    border-radius: 48px;
    background: #f4f4f4;
    box-shadow:
      0 0 0 10px #1c1c1e,
      0 0 0 11.5px #4a4a4c,
      0 50px 90px -30px rgba(40, 0, 70, 0.7);
    container-type: inline-size;
    color: #222;
    z-index: 2;
    overflow: hidden;
  }
  .xphone__island { position: absolute; top: 3.8cqw; left: 50%; width: 30%; height: 8.6cqw; border-radius: 99px; background: #000; transform: translateX(-50%); z-index: 2; }
  .xphone__status { display: flex; justify-content: space-between; padding: 5.4cqw 9cqw 0 10cqw; font-size: 4.6cqw; font-weight: 700; color: #111; }
  .xphone__icons { font-size: 3cqw; opacity: 0.8; }
  .cc {
    position: absolute;
    inset: 15cqw 0 0;
    display: flex;
    flex-direction: column;
    background-image: var(--yc-pattern);
    background-size: 90cqw;
    font-size: 3.9cqw;
  }
  .cc__head {
    display: flex;
    align-items: center;
    gap: 2.6cqw;
    padding: 1cqw 4cqw 3cqw;
    border-bottom: 1px solid #ddd;
    background: #f4f4f4;
  }
  .cc__back { font-size: 5.6cqw; }
  .cc__name { flex: 1; font-size: 4.6cqw; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cc__thumb { width: 10cqw; height: 10cqw; border-radius: 50%; object-fit: cover; }
  .cc__tools { display: flex; justify-content: space-between; align-items: center; padding: 2.6cqw 4cqw; }
  .cc__bin { width: 8cqw; height: 8cqw; border-radius: 50%; border: 1px solid #333; display: grid; place-items: center; font-size: 3.6cqw; background: #fff; }
  .cc__presets { font-size: 3.4cqw; border: 1px solid #333; border-radius: 99px; padding: 1cqw 3cqw; background: #fff; }
  .cc__body { flex: 1; padding: 1cqw 4.5cqw 0; overflow: hidden; }
  .cc__me {
    margin: 0 0 3cqw auto;
    width: max-content;
    max-width: 80%;
    padding: 2.4cqw 4cqw;
    border-radius: 6cqw;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    font-size: 4cqw;
  }
  .cc__typing { display: none; gap: 1.4cqw; padding: 3cqw 4cqw; width: max-content; border-radius: 6cqw; background: #fff; margin-bottom: 3cqw; }
  .cc__typing i { width: 2cqw; height: 2cqw; border-radius: 50%; background: #999; }
  .cc__chef { display: flex; align-items: center; gap: 2.4cqw; margin: 0 0 1.6cqw; font-size: 6.6cqw; font-weight: 500; }
  .cc__avatar { width: 8.6cqw; height: 8.6cqw; border-radius: 50%; background: var(--yc-teal); display: grid; place-items: center; flex: none; }
  .cc__avatar img { width: 72%; height: auto; }
  .cc__p { margin: 0 0 2cqw; font-size: 3.9cqw; line-height: 1.45; }
  .cc__p--li { padding-left: 5cqw; position: relative; }
  .cc__p--li > .cc__bullet { position: absolute; left: 1cqw; top: 0; }
  .cc__input {
    display: flex;
    align-items: center;
    gap: 2cqw;
    margin: 2cqw 3.4cqw 7cqw;
    padding: 1.4cqw 1.4cqw 1.4cqw 4.4cqw;
    border-radius: 99px;
    border: 1px solid #555;
    background: #fff;
    font-size: 4cqw;
  }
  .cc__ph { flex: 1; color: #888; }
  .cc__typed { flex: 1; display: none; white-space: nowrap; overflow: hidden; }
  .cc__mic { width: 9cqw; height: 9cqw; border-radius: 50%; display: grid; place-items: center; background: var(--yc-teal); color: #fff; font-size: 4cqw; flex: none; }

  @media (prefers-reduced-motion: no-preference) {
    .stk__in { animation: yc-stk 6s ease-in-out infinite; }
    .stk:nth-child(2n) .stk__in { animation-duration: 7.4s; animation-delay: -2s; }
    .stk:nth-child(3n) .stk__in { animation-duration: 5.2s; animation-delay: -1s; }
    .cc__typing i { animation: yc-dot 1s ease-in-out infinite; }
    .cc__typing i:nth-child(2) { animation-delay: 0.15s; }
    .cc__typing i:nth-child(3) { animation-delay: 0.3s; }
  }
  @keyframes yc-stk {
    0%, 100% { transform: rotate(var(--r)) translateY(0); }
    50% { transform: rotate(calc(var(--r) * -0.5)) translateY(-9px); }
  }
  @keyframes yc-dot { 0%, 100% { transform: translateY(0); opacity: 0.5; } 50% { transform: translateY(-1.2cqw); opacity: 1; } }

  /* Wide screens: stickers hug the phone's edges. */
  @media (min-width: 1300px) {
    .chat__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 120px; }
    .chat__stage { padding-right: 24px; }
    .chat__title { font-size: clamp(42px, 4.6vw, 66px); }
  }
  /* Narrower: two stickers above the phone, two below, clear of the chat. */
  @media (max-width: 1299px) {
    .chat__stage { min-height: 0; padding: 44px 0 78px; }
    .stk { left: var(--mx); right: auto; top: var(--my); }
    .stk--desk { display: none; }
    .stk__in { font-size: 14px; padding: 8px 13px; }
  }
  @media (max-width: 900px) {
    .chat__grid { grid-template-columns: minmax(0, 1fr); }
    .chat__copy { order: -1; }
    .chat__stage { margin-top: 8px; }
    .stk__in { font-size: 13px; padding: 7px 12px; }
  }
</style>

<script>
  import { loadMotion } from './motion';

  (async () => {
    const root = document.getElementById('yc-chat');
    if (!root) return;
    const m = await loadMotion();
    if (!m) return;
    const { gsap, ScrollTrigger } = m;

    const me = root.querySelector<HTMLElement>('.cc__me')!;
    const typing = root.querySelector<HTMLElement>('.cc__typing')!;
    const answer = root.querySelector<HTMLElement>('.cc__answer')!;
    const chef = root.querySelector<HTMLElement>('.cc__chef')!;
    const ph = root.querySelector<HTMLElement>('.cc__ph')!;
    const typed = root.querySelector<HTMLElement>('.cc__typed')!;
    const mic = root.querySelector<HTMLElement>('.cc__mic')!;
    const tap = root.querySelector<HTMLElement>('.stk--tap .stk__in');

    // Split the answer into words so it can stream in like the real thing.
    const words: HTMLElement[] = [];
    answer.querySelectorAll<HTMLElement>('.cc__p').forEach((p) => {
      const frag = document.createDocumentFragment();
      p.childNodes.forEach((n) => {
        if (n instanceof HTMLElement && n.classList.contains('cc__bullet')) {
          const b = n.cloneNode(true) as HTMLElement;
          words.push(b);
          frag.appendChild(b);
          return;
        }
        const isBold = n.nodeName === 'B';
        (n.textContent || '').split(/(\s+)/).forEach((w) => {
          if (!w) return;
          if (/^\s+$/.test(w)) { frag.appendChild(document.createTextNode(w)); return; }
          const s = document.createElement(isBold ? 'b' : 'span');
          s.textContent = w;
          words.push(s);
          frag.appendChild(s);
        });
      });
      p.replaceChildren(frag);
    });

    const msg = 'I request a chef’s tip.';
    const typer = { n: 0 };
    const tl = gsap.timeline({ paused: true, repeat: -1, repeatDelay: 0.4 });
    tl.set([me, chef], { autoAlpha: 0 })
      .set(words, { autoAlpha: 0 })
      .set(typing, { display: 'none' })
      .set(ph, { display: 'block' })
      .set(typed, { display: 'none' })
      .call(() => { typed.textContent = ''; })
      .set(typer, { n: 0 });
    if (tap && getComputedStyle(tap.parentElement!).display !== 'none') {
      tl.to(tap, { scale: 1.12, duration: 0.2, yoyo: true, repeat: 1, ease: 'power1.inOut' }, 0.4);
    }
    tl.set(ph, { display: 'none' }, 0.8)
      .set(typed, { display: 'block' }, 0.8)
      .to(typer, { n: msg.length, duration: 0.9, ease: 'none', onUpdate: () => { typed.textContent = msg.slice(0, Math.round(typer.n)); } }, 0.8)
      .to(mic, { scale: 0.85, duration: 0.12, yoyo: true, repeat: 1 }, 1.85)
      .set(typed, { display: 'none' }, 2.05)
      .set(ph, { display: 'block' }, 2.05)
      .fromTo(me, { autoAlpha: 0, y: 14, scale: 0.9, transformOrigin: '100% 100%' }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.4, ease: 'back.out(2)' }, 2.05)
      .set(typing, { display: 'flex' }, 2.5)
      .set(typing, { display: 'none' }, 3.7)
      .fromTo(chef, { autoAlpha: 0, x: -10 }, { autoAlpha: 1, x: 0, duration: 0.35 }, 3.7)
      .to(words, { autoAlpha: 1, duration: 0.05, stagger: 0.045, ease: 'none' }, 3.95)
      .to({}, { duration: 3 })
      .to([me, chef, ...words], { autoAlpha: 0, duration: 0.4 });

    ScrollTrigger.create({
      trigger: root,
      start: 'top 70%',
      end: 'bottom 20%',
      onToggle: (self) => (self.isActive ? tl.play() : tl.pause()),
    });
    m.refresh();
  })();
</script>
