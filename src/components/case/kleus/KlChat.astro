---
// The check-in, rebuilt from kleus.ai's chat window (same script, same WhatsApp and Telegram
// paint). The section is split at the phone's middle: morning on paper, evening after dark.
// With JS the conversation types itself once it scrolls into view; without JS it is all there.
import KlMark from './KlMark.astro';
import KlLogo from './KlLogo.astro';

type Line =
  | { kind: 'msg'; from: 'kleus' | 'you'; text: string; time: string; link?: string; beat: number; clock?: string }
  | { kind: 'chip'; chip: string; beat: number; clock?: string };

// Kleus's own beats from the live site, verbatim.
const SCRIPT: Line[] = [
  { kind: 'msg', from: 'kleus', text: "Morning. Today's one is How revolutionaries crowned an emperor, about 15 minutes.", time: '8:30', link: 'app.kleus.ai/a/how-revolutionaries-crowned-an-emperor', beat: 0, clock: '8:30' },
  { kind: 'msg', from: 'you', text: "I'll do it in the evening", time: '8:41', beat: 1, clock: '8:41' },
  { kind: 'msg', from: 'kleus', text: "Cool. I'll check in with you then.", time: '8:41', beat: 1 },
  { kind: 'chip', chip: '5:00 PM', beat: 2, clock: '17:00' },
  { kind: 'msg', from: 'kleus', text: "Hey, reminder for you. It's only 15 minutes.", time: '17:00', beat: 2 },
  { kind: 'msg', from: 'you', text: 'just finished it, how did I do?', time: '18:12', beat: 3, clock: '18:12' },
  { kind: 'msg', from: 'kleus', text: "82 out of 100. Strong on the money problem, thin on why the nobles wouldn't budge. Wanna go over that bit?", time: '18:13', beat: 3, clock: '18:13' },
];
// Tail on the last bubble of a run.
const tail = (i: number) => {
  const a = SCRIPT[i];
  const b = SCRIPT[i + 1];
  if (a.kind !== 'msg') return false;
  if (!b || b.kind !== 'msg') return true;
  return a.from !== b.from;
};

const BEATS = [
  { t: '8:30', h: 'The lesson comes to you.', p: 'One link in the chat, about 15 minutes. Nothing to install, nothing to remember to open.' },
  { t: '8:41', h: 'Later is allowed.', p: 'Push it to the evening and it simply agrees. Then it holds you to it.' },
  { t: '17:00', h: 'One short reminder.', p: 'At the time you agreed. Not a stream of notifications.' },
  { t: '18:13', h: 'A score, then a question.', p: 'It grades what you wrote, names the weak spot and offers to go over it.' },
];
---

<section class="ch" id="kl-checkin" data-kl-chat>
  <div class="kl-wrap ch__head">
    <KlMark n="III" label="The check-in" />
    <h2 class="ch__title" data-kl-reveal>It lives in the chat you <span>already open.</span></h2>
    <p class="ch__sub" data-kl-reveal>
      Nobody abandons WhatsApp. So Kleus doesn't ask you to build a new habit around a new app. It sends the
      lesson, takes “later” for an answer, and comes back when you said it should.
    </p>
  </div>

  <div class="kl-wrap">
  <div class="ch__grid">
    <ol class="beats beats--am">
      {BEATS.slice(0, 2).map((b, i) => (
        <li class="beat" data-beat={i}>
          <span class="beat__t">{b.t}</span>
          <span class="beat__h">{b.h}</span>
          <span class="beat__p">{b.p}</span>
        </li>
      ))}
    </ol>

      <div class="ch__anchor">
        <div class="phone" data-chat-phone>
          <div class="phone__screen wa" data-wa role="group" aria-label="Example conversation with Kleus on WhatsApp">
            <div class="wa__status" aria-hidden="true">
              <span class="wa__clock" data-chat-clock>18:13</span>
              <span class="wa__island"></span>
              <span class="wa__sys">
                <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
                <svg viewBox="0 0 16 12"><path d="M8 11.2 5.6 8.6a3.4 3.4 0 0 1 4.8 0zM3.4 6.4a6.6 6.6 0 0 1 9.2 0l-1.4 1.5a4.6 4.6 0 0 0-6.4 0zM1 4a10 10 0 0 1 14 0l-1.4 1.5a8 8 0 0 0-11.2 0z" /></svg>
                <svg viewBox="0 0 27 12"><rect x="0.5" y="0.5" width="22" height="11" rx="3.2" fill="none" stroke="currentColor" opacity=".45" /><rect x="2.2" y="2.2" width="16" height="7.6" rx="1.8" /><path d="M24.2 4.2v3.6a1.9 1.9 0 0 0 0-3.6z" opacity=".5" /></svg>
              </span>
            </div>
            <div class="wa__top" aria-hidden="true">
              <span class="wa__pill wa__round">
                <svg viewBox="0 0 24 24"><path d="M15 5 8 12l7 7" /></svg>
              </span>
              <span class="wa__pill wa__name"><b>Kleus</b><i data-chat-presence>online</i></span>
              <span class="wa__avatar"><KlLogo variant="phi" /></span>
            </div>
            <div class="wa__body" data-chat-body>
              {SCRIPT.map((l, i) =>
                l.kind === 'chip' ? (
                  <div class="wa__chiprow" data-step={i} data-from="chip" data-beat={l.beat} data-clock={l.clock}>
                    <span class="wa__chip">{l.chip}</span>
                  </div>
                ) : (
                  <div class:list={['wa__line', l.from === 'you' && 'wa__line--you']} data-step={i} data-from={l.from} data-beat={l.beat} data-clock={l.clock}>
                    <span class:list={['wa__bub', l.from === 'you' && 'wa__bub--you', tail(i) && 'wa__bub--tail']}>
                      <span class="wa__who">{l.from === 'you' ? 'You' : 'Kleus'}: </span>
                      {l.text}
                      {l.link && <span class="wa__link">{l.link}</span>}
                      <span class="wa__stamp">
                        {l.time}
                        {l.from === 'you' && (
                          <svg class="wa__ticks" viewBox="0 0 18 12" aria-hidden="true"><path d="M1 6.5 4.2 10 10.6 2.4" /><path d="M7.6 8.6 8.8 10l6.4-7.6" /></svg>
                        )}
                      </span>
                    </span>
                  </div>
                ),
              )}
              <div class="wa__line wa__typing" data-chat-typing aria-hidden="true">
                <span class="wa__bub wa__bub--tail"><span class="wa__dots"><i></i><i></i><i></i></span></span>
              </div>
            </div>
            <div class="wa__bottom" aria-hidden="true">
              <span class="wa__pill wa__round">
                <svg viewBox="0 0 24 24"><path d="M20 10.5 11.2 19.3a4.5 4.5 0 0 1-6.4-6.4l8.9-8.8a3 3 0 0 1 4.2 4.2l-8.8 8.9a1.5 1.5 0 0 1-2.1-2.1l8.1-8.1" /></svg>
              </span>
              <span class="wa__pill wa__field">Message</span>
              <span class="wa__pill wa__round">
                <svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.6 11.6a6.4 6.4 0 0 0 12.8 0M12 18v3" /></svg>
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="ch__controls">
        <div class="sw" data-mode="wa" data-chat-switch role="group" aria-label="Chat app">
          <span class="sw__knob" aria-hidden="true"></span>
          <button type="button" class="sw__btn" aria-pressed="true" data-chat-mode="wa" aria-label="Show it on WhatsApp">
            <svg viewBox="0 0 24 24" fill="#25d366"><path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.45 9.45 0 01-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.4 9.4 0 01-1.45-5.03c0-5.2 4.24-9.43 9.45-9.43 2.52 0 4.89.98 6.67 2.77a9.37 9.37 0 012.76 6.67c0 5.2-4.24 9.43-9.44 9.43z" /></svg>
          </button>
          <button type="button" class="sw__btn" aria-pressed="false" data-chat-mode="tg" aria-label="Show it on Telegram">
            <svg viewBox="0 0 24 24" fill="#229ed9"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z" /></svg>
          </button>
        </div>
        <span class="ch__hint">WhatsApp or Telegram, your pick</span>
        <button type="button" class="ch__replay" data-chat-replay hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 1 0 2.3-5.4L4.5 8.8" /><path d="M4.5 4.5v4.3h4.3" /></svg>
          Replay the day
        </button>
      </div>

    <ol class="beats beats--pm" start="3">
      {BEATS.slice(2).map((b, i) => (
        <li class="beat" data-beat={i + 2}>
          <span class="beat__t">{b.t}</span>
          <span class="beat__h">{b.h}</span>
          <span class="beat__p">{b.p}</span>
        </li>
      ))}
    </ol>
  </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-kl-chat]');
  if (root) {
    // WhatsApp / Telegram paint switch.
    const wa = root.querySelector<HTMLElement>('[data-wa]')!;
    const sw = root.querySelector<HTMLElement>('[data-chat-switch]')!;
    root.querySelectorAll<HTMLButtonElement>('[data-chat-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.chatMode!;
        sw.dataset.mode = mode;
        wa.classList.toggle('is-tg', mode === 'tg');
        wa.setAttribute('aria-label', `Example conversation with Kleus on ${mode === 'tg' ? 'Telegram' : 'WhatsApp'}`);
        root.querySelectorAll<HTMLButtonElement>('[data-chat-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      });
    });

    // The day, typed out once the phone scrolls into view.
    // No typing for reduced motion, or when the viewport is tall enough to show the whole page.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.innerHeight > 1500;
    if (!reduce) {
      (async () => {
        try {
          const { gsap } = await import('gsap');
          const { ScrollTrigger } = await import('gsap/ScrollTrigger');
          gsap.registerPlugin(ScrollTrigger);

          const phone = root.querySelector<HTMLElement>('[data-chat-phone]')!;
          const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
          const typing = root.querySelector<HTMLElement>('[data-chat-typing]')!;
          const clock = root.querySelector<HTMLElement>('[data-chat-clock]')!;
          const presence = root.querySelector<HTMLElement>('[data-chat-presence]')!;
          const beats = Array.from(root.querySelectorAll<HTMLElement>('[data-beat]')).filter((el) => el.tagName === 'LI');
          const replay = root.querySelector<HTMLButtonElement>('[data-chat-replay]')!;

          const setBeat = (n: number) => beats.forEach((b) => {
            const k = Number(b.dataset.beat);
            b.classList.toggle('is-on', k === n);
            b.classList.toggle('is-done', k < n);
          });
          const reset = () => {
            steps.forEach((s) => { s.classList.add('is-off'); gsap.set(s, { clearProps: 'all' }); });
            typing.classList.remove('is-on');
            clock.textContent = '8:30';
            presence.textContent = 'online';
            beats.forEach((b) => b.classList.remove('is-on', 'is-done'));
            root.classList.remove('is-complete');
          };
          const build = () => {
            const tl = gsap.timeline({ paused: true, onComplete: () => { replay.hidden = false; } });
            let t = 0.25;
            steps.forEach((s) => {
              const from = s.dataset.from;
              const beat = Number(s.dataset.beat);
              const clk = s.dataset.clock;
              if (from === 'kleus') {
                tl.call(() => { typing.classList.add('is-on'); presence.textContent = 'typing…'; setBeat(beat); if (clk) clock.textContent = clk; }, [], t);
                t += beat === 3 ? 1.1 : 0.8;
                tl.call(() => { typing.classList.remove('is-on'); presence.textContent = 'online'; }, [], t);
              }
              tl.call(() => { s.classList.remove('is-off'); setBeat(beat); if (clk) clock.textContent = clk; }, [], t);
              tl.fromTo(s, { opacity: 0, y: 12, scale: 0.94 }, { opacity: 1, y: 0, scale: 1, duration: 0.42, ease: 'back.out(1.7)' }, t);
              t += from === 'you' ? 0.7 : from === 'chip' ? 0.45 : 0.85;
            });
            tl.call(() => root.classList.add('is-complete'), [], t + 0.6);
            return tl;
          };

          root.classList.add('is-armed');
          reset();
          let tl = build();
          ScrollTrigger.create({ trigger: phone, start: 'top 70%', once: true, onEnter: () => tl.play() });
          replay.addEventListener('click', () => {
            tl.kill();
            replay.hidden = true;
            reset();
            tl = build();
            tl.play();
          });
        } catch {
          /* the full conversation is already on screen */
        }
      })();
    }
  }
</script>

<style>
  /* ---------- the split section ---------- */
  .ch {
    position: relative; isolation: isolate; overflow: clip;
    padding: clamp(96px, 11vw, 160px) 0 clamp(72px, 8vw, 120px);
    background: transparent;
  }
  .ch__head { position: relative; z-index: 1; }
  .ch__title {
    margin: 0; max-width: 15ch;
    font-size: clamp(36px, 5.2vw, 72px); font-weight: 600; letter-spacing: -0.035em; line-height: 1.02; color: #1B1A18;
    text-wrap: balance;
  }
  .ch__title span { color: #8A8781; font-weight: 500; }
  .ch__sub { margin: 24px 0 0; max-width: 54ch; font-size: clamp(17px, 1.45vw, 19px); line-height: 1.6; color: #575652; }

  /* Rows one and two each hold exactly half the phone, so the morning beats sit above
     the split and the evening beats below it, whatever the text wraps to. */
  .ch__grid {
    position: relative; z-index: 1;
    margin-top: clamp(56px, 7vw, 104px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-rows: 1fr 1fr auto;
    grid-template-areas:
      'am phone .'
      '. phone pm'
      '. ctrl .';
    column-gap: clamp(32px, 5vw, 80px);
  }
  .beats--am { grid-area: am; }
  .beats--pm { grid-area: pm; }
  .ch__anchor { grid-area: phone; position: relative; }
  .ch__controls { grid-area: ctrl; }
  /* the evening: everything below the phone's middle goes dark, edge to edge */
  .ch__anchor::before {
    content: ''; position: absolute; z-index: -1;
    top: 50%; left: -200vw; right: -200vw; bottom: -6000px;
    background: #181716;
  }

  /* ---------- beats ---------- */
  .beats { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 32px; }
  .beats--am { align-self: end; padding-bottom: 44px; text-align: right; align-items: flex-end; }
  .beats--pm { align-self: start; padding-top: 44px; }
  .beat { display: flex; flex-direction: column; max-width: 320px; transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .beat__t { font-family: 'Fraunces', Georgia, serif; font-weight: 400; font-size: 34px; line-height: 1; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; color: #B8741B; }
  .beat__h { margin-top: 12px; font-size: 19px; font-weight: 600; letter-spacing: -0.015em; color: #1B1A18; }
  .beat__p { margin-top: 6px; font-size: 15.5px; line-height: 1.55; color: #575652; }
  .beats--pm .beat__t { color: #C4913F; }
  .beats--pm .beat__h { color: #E5E4E2; }
  .beats--pm .beat__p { color: #9C9A97; }
  .ch.is-armed .beat { opacity: 0.32; }
  .ch.is-armed .beat.is-done { opacity: 0.75; }
  .ch.is-armed .beat.is-on { opacity: 1; }
  .ch.is-armed .beats--am .beat.is-on { transform: translateX(-6px); }
  .ch.is-armed .beats--pm .beat.is-on { transform: translateX(6px); }
  .ch.is-complete .beat { opacity: 1 !important; transform: none !important; }

  /* ---------- the phone ---------- */
  .phone {
    position: relative;
    width: min(330px, calc(100vw - 48px)); padding: 10px; border-radius: 52px;
    background: linear-gradient(160deg, #3A3835, #1B1A18 40%, #0E0D0C);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.08), inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 2px 4px rgb(0 0 0 / 0.2), 0 50px 90px -40px rgb(0 0 0 / 0.55), 0 30px 60px -30px rgb(52 40 24 / 0.4);
  }
  .phone__screen { position: relative; aspect-ratio: 9 / 19.2; border-radius: 42px; overflow: hidden; }

  /* ---------- WhatsApp paint (default) ---------- */
  .wa {
    --wa-t: 0.5s;
    background-color: #efeae2;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    transition: background-color var(--wa-t) ease;
  }
  .wa::before, .wa::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-size: 100% 100%, 100% 100%, 22px 22px;
    transition: opacity var(--wa-t) ease;
  }
  .wa::before {
    background-image:
      radial-gradient(circle at 22% 18%, rgb(255 255 255 / 35%) 0%, transparent 55%),
      radial-gradient(circle at 78% 82%, rgb(0 0 0 / 3%) 0%, transparent 55%),
      radial-gradient(circle, rgb(0 0 0 / 6%) 1px, transparent 1.2px);
  }
  .wa::after {
    opacity: 0;
    background-image:
      radial-gradient(circle at 22% 18%, rgb(255 255 255 / 4%) 0%, transparent 55%),
      radial-gradient(circle at 78% 82%, rgb(255 255 255 / 3%) 0%, transparent 55%),
      radial-gradient(circle, rgb(255 255 255 / 4%) 1px, transparent 1.2px);
  }
  .wa * { transition: background-color var(--wa-t) ease, color var(--wa-t) ease; }

  .wa__status {
    position: absolute; z-index: 3; top: 0; left: 0; right: 0; height: 46px;
    display: flex; align-items: center; justify-content: space-between; padding: 4px 26px 0 34px;
    color: #111b21; font-size: 14.5px; font-weight: 600; letter-spacing: -0.01em;
  }
  .wa__clock { font-variant-numeric: tabular-nums; min-width: 42px; }
  .wa__island { position: absolute; left: 50%; top: 11px; width: 92px; height: 27px; border-radius: 20px; background: #000; transform: translateX(-50%); }
  .wa__sys { display: inline-flex; align-items: center; gap: 5px; }
  .wa__sys svg { height: 11px; width: auto; fill: currentColor; }

  .wa__top, .wa__bottom { position: absolute; z-index: 2; left: 10px; right: 10px; display: flex; align-items: center; gap: 7px; }
  .wa__top { top: 50px; }
  .wa__bottom { bottom: 14px; }
  .wa__pill {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 5px 12px; border-radius: 999px;
    background: rgb(255 255 255 / 88%);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    color: rgb(17 27 33 / 88%); font-size: 12px; line-height: 1.15;
    box-shadow: 0 1px 2px rgb(0 0 0 / 8%);
  }
  .wa__round { flex: none; width: 34px; height: 34px; padding: 0; justify-content: center; }
  .wa__round svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .wa__name { margin: 0 auto; flex-direction: column; gap: 0; padding: 4px 16px; text-align: center; }
  .wa__name b { font-size: 12.5px; font-weight: 600; }
  .wa__name i { font-style: normal; font-size: 10px; color: rgb(17 27 33 / 50%); min-width: 44px; }
  .wa__avatar {
    flex: none; width: 32px; height: 32px; border-radius: 50%;
    display: grid; place-items: center;
    background: #F0EEE9; color: #1B1A18; box-shadow: 0 1px 2px rgb(0 0 0 / 10%);
  }
  .wa__avatar :global(.kl-logo) { width: 18px; height: 18px; }
  .wa__field { flex: 1; min-width: 0; height: 34px; padding: 0 14px; color: rgb(17 27 33 / 40%); font-size: 12.5px; }

  .wa__body {
    position: absolute; z-index: 1; inset: 0;
    padding: 96px 12px 62px;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 6px;
    overflow: hidden;
  }
  .wa__chiprow { display: flex; justify-content: center; margin: 4px 0; }
  .wa__chip { padding: 4px 10px; border-radius: 8px; background: rgb(255 255 255 / 92%); color: #54656f; font-size: 11px; line-height: 1.2; box-shadow: 0 1px 1px rgb(0 0 0 / 8%); }
  .wa__line { display: flex; transform-origin: 0% 100%; }
  .wa__line--you { justify-content: flex-end; transform-origin: 100% 100%; }
  .wa__bub {
    position: relative; max-width: 84%;
    padding: 6px 9px 6px 10px; border-radius: 12px;
    background: #ffffff; color: #111b21;
    font-size: 13px; line-height: 1.38; text-align: left;
    filter: drop-shadow(0 1px 0.6px rgb(11 20 26 / 13%));
  }
  .wa__bub--you { background: #d9fdd3; max-width: 92%; }
  .wa__who { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .wa__link { display: block; max-width: 200px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #027eb5; text-decoration: underline; text-underline-offset: 2px; }
  .wa__stamp { float: right; display: inline-flex; align-items: center; gap: 3px; margin: 6px 0 0 8px; font-size: 10px; line-height: 1; color: #667781; font-variant-numeric: tabular-nums; }
  .wa__ticks { width: 14px; height: 9px; fill: none; stroke: #53bdeb; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  /* the horn on the last bubble of a run */
  .wa__bub::before {
