---
// Every day since Kleus's first commit, as a heatmap. Real counts from the Kleus repository
// (git log across all branches), frozen on 7 October 2026. One hue, brighter means more commits.
const COUNTS: Record<string, number> = {"2026-06-10":2,"2026-06-13":7,"2026-06-14":7,"2026-06-15":3,"2026-06-18":2,"2026-06-19":15,"2026-06-20":7,"2026-06-22":17,"2026-06-23":13,"2026-06-24":33,"2026-06-25":19,"2026-06-26":25,"2026-06-27":14,"2026-06-28":10,"2026-06-30":15,"2026-07-01":12,"2026-07-04":11,"2026-07-05":16,"2026-07-06":12,"2026-07-07":3,"2026-07-09":20,"2026-07-10":23,"2026-07-11":16,"2026-07-12":8,"2026-07-13":15,"2026-07-15":1,"2026-07-16":26,"2026-07-17":11,"2026-07-18":17,"2026-07-19":14,"2026-07-20":12,"2026-07-21":22,"2026-07-22":2,"2026-07-23":1,"2026-07-25":34,"2026-07-26":8,"2026-07-27":5,"2026-07-29":1,"2026-07-31":1,"2026-08-02":1,"2026-08-03":8,"2026-08-06":9,"2026-08-07":5,"2026-08-08":13,"2026-08-09":2,"2026-08-10":15,"2026-08-11":8,"2026-08-12":20,"2026-08-13":23,"2026-08-14":1,"2026-08-15":6,"2026-08-16":6,"2026-08-17":12,"2026-08-19":2,"2026-08-20":5,"2026-08-21":5,"2026-08-22":1,"2026-08-23":10,"2026-08-25":12,"2026-08-26":73,"2026-08-27":13,"2026-08-28":8,"2026-08-29":3,"2026-08-30":1,"2026-09-01":22,"2026-09-02":44,"2026-09-03":24,"2026-09-04":71,"2026-09-05":23,"2026-09-06":95,"2026-09-07":80,"2026-09-08":1,"2026-09-09":15,"2026-09-10":9,"2026-09-11":19,"2026-09-12":36,"2026-09-13":41,"2026-09-14":50,"2026-09-15":31,"2026-09-16":11,"2026-09-17":17,"2026-09-18":16,"2026-09-19":1,"2026-09-20":49,"2026-09-21":21,"2026-09-22":21,"2026-09-25":2,"2026-09-26":2,"2026-09-27":2,"2026-09-29":7,"2026-09-30":44,"2026-10-01":4,"2026-10-02":6,"2026-10-04":199,"2026-10-05":66,"2026-10-06":4,"2026-10-07":1};
const START = Date.UTC(2026, 5, 10);
const END = Date.UTC(2026, 9, 7);
const DAY = 86400000;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const mon = (t: number) => (new Date(t).getUTCDay() + 6) % 7; // Monday = 0
const gridStart = START - mon(START) * DAY;
const gridEnd = END + (6 - mon(END)) * DAY;
const level = (n: number) => (n === 0 ? 0 : n < 5 ? 1 : n < 15 ? 2 : n < 35 ? 3 : 4);

const cells: { key: string; n: number; lv: number; out: boolean; label: string }[] = [];
for (let t = gridStart; t <= gridEnd; t += DAY) {
  const d = new Date(t);
  const key = d.toISOString().slice(0, 10);
  const n = COUNTS[key] ?? 0;
  cells.push({ key, n, lv: level(n), out: t < START || t > END, label: `${WD[d.getUTCDay()]} ${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}` });
}
const weeks = cells.length / 7;
const months: { col: number; label: string }[] = [];
for (let w = 0; w < weeks; w++) {
  const first = cells[w * 7];
  const d = new Date(first.key + 'T00:00:00Z');
  const hasFirst = cells.slice(w * 7, w * 7 + 7).some((c) => c.key.endsWith('-01'));
  if (w === 0) months.push({ col: 0, label: MONTHS[new Date(START).getUTCMonth()] });
  else if (hasFirst) months.push({ col: w, label: MONTHS[(d.getUTCMonth() + (d.getUTCDate() > 1 ? 1 : 0)) % 12] });
}
const active = Object.values(COUNTS).filter((n) => n > 0).length;
const span = Math.round((END - START) / DAY) + 1;
---

<figure class="cg" data-kl-commits>
  <div class="cg__months" style={`--weeks:${weeks}`} aria-hidden="true">
    {months.map((m) => <span style={`grid-column:${m.col + 1} / span 3`}>{m.label}</span>)}
  </div>
  <div class="cg__grid" style={`--weeks:${weeks}`} role="img" aria-label={`Commit activity on Kleus: ${active} of the ${span} days from 10 June to 7 October 2026 have at least one commit.`}>
    {cells.map((c) => (
      <span class:list={['cg__c', `cg__c--${c.lv}`, c.out && 'cg__c--out']} data-d={c.label} data-n={c.n} data-cg-cell></span>
    ))}
  </div>
  <figcaption class="cg__key">
    <span>One square is one day</span>
    <span class="cg__scale" aria-hidden="true">
      Fewer
      <i class="cg__c cg__c--0"></i><i class="cg__c cg__c--1"></i><i class="cg__c cg__c--2"></i><i class="cg__c cg__c--3"></i><i class="cg__c cg__c--4"></i>
      More commits
    </span>
  </figcaption>
  <div class="cg__tip" data-cg-tip hidden><b></b><span></span></div>
</figure>

<script>
  // One tooltip for every cell: the count leads, the date follows.
  const fig = document.querySelector<HTMLElement>('[data-kl-commits]');
  if (fig) {
    const tip = fig.querySelector<HTMLElement>('[data-cg-tip]')!;
    const strong = tip.querySelector('b')!;
    const date = tip.querySelector('span')!;
    const show = (cell: HTMLElement) => {
      if (cell.classList.contains('cg__c--out')) return hide();
      const n = Number(cell.dataset.n);
      strong.textContent = n === 0 ? 'No commits' : `${n} commit${n === 1 ? '' : 's'}`;
      date.textContent = cell.dataset.d ?? '';
      tip.hidden = false;
      const f = fig.getBoundingClientRect();
      const r = cell.getBoundingClientRect();
      const x = Math.min(Math.max(r.left + r.width / 2 - f.left, 60), f.width - 60);
      tip.style.transform = `translate(${x}px, ${r.top - f.top - 8}px) translate(-50%, -100%)`;
      fig.querySelectorAll('.is-hot').forEach((el) => el.classList.remove('is-hot'));
      cell.classList.add('is-hot');
    };
    const hide = () => {
      tip.hidden = true;
      fig.querySelectorAll('.is-hot').forEach((el) => el.classList.remove('is-hot'));
    };
    fig.addEventListener('pointerover', (e) => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>('[data-cg-cell]');
      if (cell) show(cell);
    });
    fig.addEventListener('pointerleave', hide);
  }
</script>

<style>
  .cg { position: relative; margin: 0; font-family: 'DM Sans', system-ui, sans-serif; }
  .cg__months, .cg__grid {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
    column-gap: 5px;
  }
  .cg__months { margin-bottom: 10px; font-size: 12px; color: #7E7B77; }
  .cg__months span { white-space: nowrap; }
  .cg__grid { grid-template-rows: repeat(7, auto); grid-auto-flow: column; row-gap: 5px; }
  .cg__c { display: block; aspect-ratio: 1; border-radius: 4px; background: #232120; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.04); transition: scale 0.15s ease, box-shadow 0.15s ease; }
  .cg__c--1 { background: #4A3820; }
  .cg__c--2 { background: #7A5826; }
  .cg__c--3 { background: #B07D35; }
  .cg__c--4 { background: #E6B467; box-shadow: 0 0 14px -2px rgb(230 180 103 / 0.45); }
  .cg__c--out { background: transparent; box-shadow: none; }
  .cg__grid .cg__c.is-hot { scale: 1.18; box-shadow: 0 0 0 2px #181716, 0 0 0 3.5px #E5E4E2; }
  .cg__key { margin-top: 16px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 20px; font-size: 13px; color: #9C9A97; }
  .cg__scale { display: inline-flex; align-items: center; gap: 5px; }
  .cg__scale .cg__c { width: 12px; border-radius: 3px; }
  .cg__scale .cg__c:first-of-type { margin-left: 4px; }
  .cg__scale .cg__c:last-of-type { margin-right: 4px; }
  .cg__tip {
    position: absolute; left: 0; top: 0; z-index: 5; pointer-events: none;
    display: flex; flex-direction: column; align-items: center; gap: 1px;
    padding: 7px 11px 8px; border-radius: 10px;
    background: #F0EEE9; color: #1B1A18; box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.6);
    white-space: nowrap;
  }
  .cg__tip[hidden] { display: none; }
  .cg__tip b { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .cg__tip span { font-size: 12px; color: #6F6A62; }
  @media (max-width: 600px) {
    .cg__months, .cg__grid { column-gap: 3px; }
    .cg__grid { row-gap: 3px; }
    .cg__c { border-radius: 3px; }
    .cg__months { font-size: 11px; }
  }
</style>
