---
import { t, type Locale } from '../i18n/utils';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const CALENDLY = 'https://calendly.com/yanis-schweizer';
---

<section id="hero" class="hero-section">
  <!-- Hero background glow -->
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-content">
    <span class="label" id="hero-label">{t(locale, 'hero.label')}</span>

    <h1 id="hero-h1">
      <span class="h1-line">{t(locale, 'hero.h1_line1')}</span><br/>
      <span class="h1-line h1-accent">{t(locale, 'hero.h1_line2')}</span>
    </h1>

    <p id="hero-body" class="hero-body">
      {t(locale, 'hero.body')}
    </p>

    <div id="hero-buttons" class="hero-buttons">
      <a href={CALENDLY} target="_blank" rel="noopener" class="btn-primary btn-lg">
        {t(locale, 'hero.cta_primary')} <span aria-hidden="true">&#8594;</span>
      </a>
      <a href="#case-study" class="btn-ghost btn-lg">
        {t(locale, 'hero.cta_secondary')} <span aria-hidden="true">&#8595;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    top: 50%; left: 50%;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(0,229,255,0.18) 0%, transparent 65%);
    transform: translate(-50%, -58%);
    pointer-events: none;
    animation: pulse-hero 4s ease-in-out infinite;
    z-index: 0;
  }
  .hero-content {
    position: relative; z-index: 2;
    padding-top: 96px;
    padding-bottom: 96px;
  }
  /* No opacity:0 here. global.css .gsap-ready guard handles the hide/show */
  h1 { color: var(--text-primary); }
  .h1-accent { color: var(--cyan); }
  #hero-h1 { margin: 16px 0 24px; }
  .hero-body {
    max-width: 540px;
    color: var(--text-secondary);
    font-size: 18px;
  }
  .hero-buttons {
    display: flex; gap: 16px; flex-wrap: wrap;
    margin-top: 32px;
  }
  .btn-lg { padding: 14px 28px; font-size: 16px; }
</style>

<script>
  // Hero animation. Adds gsap-ready to <html> so CSS hides elements before animating.
  // If this script fails, elements remain visible (CSS fallback in global.css).
  (async () => {
    try {
      const gsapModule = await import('gsap');
      const gsap = gsapModule.gsap;

      // Mark page as gsap-ready: CSS will now hide animated elements
      document.documentElement.classList.add('gsap-ready');

      const label = document.querySelector('#hero-label');
      const h1 = document.querySelector('#hero-h1');
      const body = document.querySelector('#hero-body');
      const buttons = document.querySelector('#hero-buttons');

      const tl = gsap.timeline({ delay: 0.05 });

      if (label) tl.to(label, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' });

      // Word-level stagger on H1 (use splitting.js if available, else word split)
      if (h1) {
        const words = h1.querySelectorAll('.word');
        if (words.length > 0) {
          tl.from(words, { opacity: 0, y: 15, duration: 0.6, stagger: 0.08, ease: 'power3.out' }, '-=0.1');
        } else {
          tl.to(h1, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' }, '-=0.1');
        }
      }

      if (body) tl.to(body, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.2');
      if (buttons) tl.to(buttons, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.3');
    } catch (e) {
      // GSAP failed -- ensure elements are visible
      document.documentElement.classList.remove('gsap-ready');
    }
  })();
</script>
