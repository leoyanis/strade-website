              <circle r="12" fill="#2A1810" />
              <circle r="5" fill="#4A2E1A" />
            </g>
          </svg>
        </div>
      </div>

      <!-- dust in the low sun, nearest of all: per depth a drifting strip (.w-dust__g) and its bob (.w-dust__b) -->
      <div class="w-dust">
        {['far', 'mid', 'near'].map((depth, i) => (
          <span class={`w-dust__g w-dust__g--${depth}`}><span class="w-dust__b">{dust[i].map((m) => <i class={m.x ? 'x' : undefined} style={m.style}></i>)}</span></span>
        ))}
      </div>
