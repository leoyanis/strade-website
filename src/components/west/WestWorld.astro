              <path d="M291 836 C312 840 342 840 363 836 L363 842 C342 846 312 846 291 842 Z M289 866 C312 870 342 870 365 866 L365 872 C342 876 312 876 289 872 Z M292 894 C312 897 342 897 362 894 L362 899 C342 902 312 902 292 899 Z" fill="#1A110B" />
              <path d="M338 837 C348 838 356 837 362 836" stroke="#A06A3C" stroke-width="1.4" fill="none" opacity="0.7" />
              <ellipse cx="327" cy="826" rx="33" ry="6" fill="#4A2E1A" />
              <path d="M300 824 C318 820 338 820 354 824" stroke="#B07840" stroke-width="1.6" fill="none" opacity="0.7" />
            </g>
            <!-- a wagon wheel leaning on the right post -->
            <g transform="translate(1078 846) rotate(-7) scale(0.86 1)">
              <g stroke="#2E1C12" stroke-width="5" stroke-linecap="round">
                <path d="M0 -55 L0 55 M-55 0 L55 0 M-39 -39 L39 39 M39 -39 L-39 39 M-21 -51 L21 51 M21 -51 L-21 51 M-51 -21 L51 21 M51 -21 L-51 21" />
