  <!-- the blueprint sheet's torn bottom edge: rides #act-west's top edge while the world is revealed (west.ts) -->
  <div class="w-tear">
    <svg width={TEAR_W} height="50" viewBox={`0 0 ${TEAR_W} 50`} focusable="false">
      <defs>
        <linearGradient id="w-tear-shadow" x1="0" y1={EDGE} x2="0" y2={EDGE + 26} gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#140A10" stop-opacity="0.42" />
          <stop offset="1" stop-color="#140A10" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d={shadowPath} fill="url(#w-tear-shadow)" />
      <path d={tearPath} fill="#FBFAF6" />
      <path d={fibrePath} fill="#F2F0EB" />
      <g fill="#111" fill-opacity="0.035">{gridX.filter((g) => !g.major).map((g) => <rect x={g.x} y="0" width="1" height={EDGE - 2} />)}</g>
      <g fill="#111" fill-opacity="0.08">{gridX.filter((g) => g.major).map((g) => <rect x={g.x} y="0" width="1" height={EDGE - 2} />)}</g>
    </svg>
  </div>
</div>
