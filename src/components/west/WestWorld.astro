---
/*
  The Wild West world behind #about (act IV in index.astro): a frontier town at sundown, drawn as layered inline
  SVG. It is a fixed theme layer like the others in index.astro's .themes, painted between the blueprint and the
  finale. west.ts moves it: a torn-paper edge that rides #act-west's top edge reveals it over the blueprint sheet,
  and while the act scrolls the camera tilts up (near layers sink faster than far ones), the sun sets behind the
  mesas and the sky darkens into the night the finale opens on.

  Every layer is drawn in one scene space, 1600 x 1000 units, ground at the bottom. Each layer's SVG only spans the
  rows it uses (its viewBox crops the scene vertically), so its box, and the GPU layer behind it, stays tight.
  .w-art sizes every layer from one scene height (--sh, west.css), so all of them line up at any screen size, and
  the HTML pieces laid over them (lit windows, the sign, the hawk) are placed in % of their layer's box.

  Detail that repeats (dentils, balusters, planks and their nails, sagebrush, the tumbleweed's twigs, the tear, the
  dust motes and the early stars) is generated here at build time from a seeded random, so it is the same on every
  build and costs the browser nothing. So are two loops' keyframes (the hawk's circle, the near tumbleweed's hops
  and spin), sampled so each runs as one CSS animation, and emitted in an inline <style> at the top of the layer.
*/

/** Park-Miller random, seeded: the same scene on every build. */
function rng(seed: number) {
  let s = seed;
  return () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
}
const f = (n: number) => Math.round(n * 10) / 10;

/** Left/top/width/height of a scene rectangle in % of a layer box whose viewBox starts at row y0 and is h tall. */
function box(x: number, y: number, w: number, hh: number, y0: number, h: number) {
  return `left:${f((x / 1600) * 1000) / 10}%;top:${f(((y - y0) / h) * 1000) / 10}%;width:${f((w / 1600) * 1000) / 10}%;height:${f((hh / h) * 1000) / 10}%`;
}

// ---- far layer: sagebrush on the desert floor, in perspective rows, kept off the road
const brush: { x: number; y: number; rx: number }[] = [];
{
  const r = rng(91);
  for (let i = 0; i < 90; i++) {
    const t = r();
    const y = 676 + t * t * 112;
    const x = r() * 1600;
    // the road runs from (1000, 670) to x 880..1120 at y 800
    const k = (y - 670) / 130;
    const half = 8 + 112 * k;
    if (Math.abs(x - 1000) < half + 14) continue;
    brush.push({ x, y, rx: 1.6 + 6.5 * k + r() * 2 });
  }
}

// ---- town layer: the saloon's dentils and balcony balusters, the store's dentils, the water tower's ladder
const dentils = (x0: number, x1: number, y: number, step: number) => {
  const out: number[] = [];
  for (let x = x0; x <= x1; x += step) out.push(x);
  return out.map((x) => ({ x, y }));
};
const saloonDentils = dentils(22, 414, 433, 13);
const storeDentils = dentils(1230, 1476, 531, 12);
const balusters: number[] = [];
for (let x = 24; x <= 416; x += 16) balusters.push(x);
const rungs: number[] = [];
for (let y = 462; y <= 780; y += 14) rungs.push(y);
const staves: number[] = [];
for (let x = 1492; x <= 1590; x += 9) staves.push(x);

// ---- near layer: the boardwalk's planks, where boards end (seams) and their nails
const rows = [
  [900, 920],
  [920, 944],
  [944, 972],
  [972, 1000],
];
const seams: { x: number; y0: number; y1: number }[] = [];
{
  const r = rng(7);
  for (const [y0, y1] of rows) {
    let x = 196 + r() * 160;
    while (x < 1410) {
      seams.push({ x, y0, y1 });
      x += 150 + r() * 130;
    }
  }
}

// ---- the tumbleweed: a tangle of thin arcs and a few twigs (one drawing, used by both)
const weed: { d: string; c: string; w: number }[] = [];
{
  const r = rng(4242);
  const cols = ['#8E6339', '#6B4527', '#B88A52', '#7A5230'];
  for (let i = 0; i < 26; i++) {
    const a = r() * Math.PI;
    const rx = 9 + r() * 19;
    const ry = 5 + r() * 15;
    const cx = (r() - 0.5) * 9;
    const cy = (r() - 0.5) * 9;
    // a partial ellipse (an arc from t0 to t1), rotated by a
    const t0 = r() * Math.PI * 2;
    const t1 = t0 + 1.6 + r() * 3.2;
    const pts: string[] = [];
    for (let k = 0; k <= 14; k++) {
      const t = t0 + ((t1 - t0) * k) / 14;
      const ex = Math.cos(t) * rx;
      const ey = Math.sin(t) * ry;
      pts.push(`${f(cx + ex * Math.cos(a) - ey * Math.sin(a))} ${f(cy + ex * Math.sin(a) + ey * Math.cos(a))}`);
    }
    weed.push({ d: `M${pts.join(' L')}`, c: cols[i % cols.length], w: f(0.9 + r() * 0.9) });
  }
  for (let i = 0; i < 9; i++) {
    const a = r() * Math.PI * 2;
    const r0 = 18 + r() * 6;
    const r1 = r0 + 4 + r() * 6;
    weed.push({ d: `M${f(Math.cos(a) * r0)} ${f(Math.sin(a) * r0)} L${f(Math.cos(a + 0.2) * r1)} ${f(Math.sin(a + 0.2) * r1)}`, c: '#6B4527', w: 1 });
  }
}

// ---- the torn edge of the blueprint sheet: a jagged lip with lighter torn fibres, and its shadow on the scene.
// 2600 px wide in CSS pixels (no scaling), so the tear never stretches and covers screens up to 2600 px wide.
// The sheet's grid is drawn into it as vertical lines only: they line up with .theme--blueprint's grid at any
// height (its tiles start at x = -1 px), and a missing horizontal line in a 22 px lip never shows.
const TEAR_W = 2600;
const EDGE = 22; // the act's top edge, in the strip's own pixels (west.ts places the strip by it)
let tearPath = '';
let fibrePath = '';
let shadowPath = '';
{
  const r = rng(1123);
  const lip: [number, number][] = [];
  let y = EDGE + 2;
  for (let x = 0; x <= TEAR_W; x += 4 + r() * 9) {
    y += (r() - 0.5) * 5;
    y = Math.max(EDGE - 3, Math.min(EDGE + 8, y));
    if (r() < 0.06) y += 3 + r() * 3; // now and then a deeper bite
    lip.push([x, y]);
  }
  lip.push([TEAR_W, EDGE + 2]);
  tearPath = `M0 0 L${lip.map(([x, yy]) => `${f(x)} ${f(yy)}`).join(' L')} L${TEAR_W} 0 Z`;
  // the fibres: the same line, 1.5 to 3.5 px higher, so a thin light band runs along the tear
  fibrePath = `M0 0 L${lip.map(([x, yy]) => `${f(x)} ${f(yy - 1.5 - r() * 2)}`).join(' L')} L${TEAR_W} 0 Z`;
  shadowPath = `M0 ${EDGE} L${lip.map(([x, yy]) => `${f(x)} ${f(yy - 1)}`).join(' L')} L${TEAR_W} ${EDGE + 26} L0 ${EDGE + 26} Z`;
}
const gridX: { x: number; major: boolean }[] = [];
for (let x = 23; x < TEAR_W; x += 24) gridX.push({ x, major: (x + 1) % 120 === 0 });

// ---- dust motes in the low sun: three depths (far: small, sharp, slow; near: big, soft, faster).
// Each depth is one strip two screens wide that drifts right by one screen width a cycle (west.css), with its motes
// drawn twice, a screen apart, so the loop has no seam; a second element bobs the strip. Two CSS animations per
// depth instead of one per mote (W6): on this page every running CSS animation is serviced on the main thread at
// every frame (see west.css, "Loops and their cost"). Motes past `phone` in a depth are left out on tall screens.
const dust: { style: string; x: boolean }[][] = [];
{
  const r = rng(77);
  const kinds = [
    { n: 5, phone: 3, s: [1.4, 2.4], o: [0.55, 0.85], y: [34, 72] },
    { n: 4, phone: 3, s: [2.4, 4], o: [0.45, 0.7], y: [28, 84] },
    { n: 3, phone: 2, s: [5, 9], o: [0.2, 0.36], y: [22, 92] },
  ];
  for (const k of kinds) {
    const out: { style: string; x: boolean }[] = [];
    for (let i = 0; i < k.n; i++) {
      // the same draws in the same order as when each mote had its own drift (its duration first, its delay last,
      // both unused now), so every mote keeps its height, size, brightness and resting place
      r();
      const y = f(k.y[0] + r() * (k.y[1] - k.y[0]));
      // left: where the mote sits on the strip; at rest (reduced motion, ?still) the strip does not move, so the
      // first copy is where it shows
      const left = f(3 + r() * 92);
      const s = f(k.s[0] + r() * (k.s[1] - k.s[0]));
      const o = f(k.o[0] + r() * (k.o[1] - k.o[0]));
      r();
      for (const copy of [0, 100]) out.push({ style: `left:${f(left + copy)}vw;top:${y}%;width:${s}px;height:${s}px;opacity:${o}`, x: i >= k.phone });
    }
    dust.push(out);
  }
}

// ---- keyframes sampled here, so a motion that took two or three nested CSS animations runs as one (W6). Linear
// timing between close samples traces the curve: 32 samples put the hawk's ellipse within half a pixel, and the
// tumbleweed's hops are sampled every 2.5% of a cycle plus their tops and landings.
const f2 = (n: number) => Math.round(n * 100) / 100;
/** CSS cubic-bezier(x1, y1, x2, y2) as a function of progress (bisection on x(t), then y(t)). */
function bezier(x1: number, y1: number, x2: number, y2: number) {
  const at = (a: number, b: number, t: number) => 3 * a * t * (1 - t) * (1 - t) + 3 * b * t * t * (1 - t) + t * t * t;
  return (x: number) => {
    let lo = 0;
    let hi = 1;
    for (let i = 0; i < 40; i++) {
      const m = (lo + hi) / 2;
      if (at(x1, x2, m) < x) lo = m;
      else hi = m;
    }
    return at(y1, y2, (lo + hi) / 2);
  };
}
// the hawk circles an ellipse over the sun once every 14 s: left to right low and near (bigger), back high and far,
// banking with its sideways swing. Before: x and y on two nested elements swinging a quarter turn apart (sine-like
// eases, alternating), and the bank on a third
const hawkKeys = Array.from({ length: 33 }, (_, k) => {
  const th = (k / 32) * Math.PI * 2;
  return `${f2((k / 32) * 100)}%{transform:translate(${f(-270 * Math.cos(th))}%,${f(170 * Math.sin(th))}%) scale(${f2(0.94 + 0.14 * Math.sin(th))}) rotate(${f(11 * Math.cos(th))}deg)}`;
}).join('');
// the near tumbleweed's three hops (rise eased out, fall eased in: the keyframes this replaces) with its spin, three
// turns a cycle (it was a turn every 1.15 s on the ball, its own animation)
const rise = bezier(0.2, 0.6, 0.4, 1);
const fall = bezier(0.6, 0, 0.8, 0.4);
const HOP: [number, number][] = [[0, 0], [15, -46], [31, 0], [42, -20], [53, 0], [76, -62], [100, 0]];
const hopY = (p: number) => {
  for (let i = 0; i < HOP.length - 1; i++) {
    const [p0, y0] = HOP[i];
    const [p1, y1] = HOP[i + 1];
    if (p <= p1) return y0 + (y1 - y0) * (i % 2 === 0 ? rise : fall)((p - p0) / (p1 - p0));
  }
  return 0;
};
const hopAt = [...new Set([...Array.from({ length: 41 }, (_, i) => i * 2.5), ...HOP.map(([p]) => p)])].sort((a, b) => a - b);
const hopKeys = hopAt.map((p) => `${p}%{transform:translateY(${f2(hopY(p))}%) rotate(${f((1080 * p) / 100)}deg)}`).join('');
const sampledKeyframes = `@keyframes w-hawk{${hawkKeys}}@keyframes w-hop-spin{${hopKeys}}`;

// ---- the first stars of the evening, in the night layer that darkens the sky as the act scrolls
const stars: string[] = [];
{
  const r = rng(2026);
  for (let i = 0; i < 34; i++) {
    const big = r() < 0.18;
    const sz = big ? 1.6 + r() * 0.8 : 0.8 + r() * 0.6;
    const a = big ? 0.85 + r() * 0.15 : 0.45 + r() * 0.4;
    const warm = r() < 0.2;
    stars.push(`radial-gradient(${f(sz)}px ${f(sz)}px at ${f(2 + r() * 96)}% ${f(2 + r() * 40)}%, rgba(${warm ? '255,232,200' : '235,240,255'},${f(a)}), transparent)`);
  }
}
const nightBg = `${stars.join(',')}`;
---

<div class="theme theme--west" aria-hidden="true">
  <!-- the hawk's and the near tumbleweed's sampled keyframes (frontmatter); used by west.css -->
  <style is:inline set:html={sampledKeyframes}></style>
  <div class="w-wipe">
    <div class="w-wipe__inner">
      <div class="w-sky"></div>

      <!-- the sun, low behind the mesas; it sinks faster than they do as the act scrolls -->
      <div class="w-l w-l--sun">
        <div class="w-art w-art--sun">
          <span class="w-sun__glow"></span>
          <span class="w-sun__disc"></span>
        </div>
      </div>

      <!-- far: lit clouds, three mesas in haze, the desert floor and the road out of town -->
      <div class="w-l w-l--far">
        <div class="w-art w-art--far">
          <svg viewBox="0 300 1600 700" preserveAspectRatio="none" focusable="false">
            <defs>
              <linearGradient id="w-cloudA" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#7A3E62" />
                <stop offset="1" stop-color="#F29A70" />
              </linearGradient>
              <linearGradient id="w-cloudB" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#6A3660" />
                <stop offset="1" stop-color="#E9826A" />
              </linearGradient>
              <linearGradient id="w-mesaA" x1="0" y1="560" x2="0" y2="680" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#B9727C" />
                <stop offset="1" stop-color="#A2626F" />
              </linearGradient>
              <linearGradient id="w-haze" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#FFB98A" stop-opacity="0" />
                <stop offset="0.6" stop-color="#FFB98A" stop-opacity="0.32" />
                <stop offset="1" stop-color="#FFB98A" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="w-floor" x1="0" y1="664" x2="0" y2="1000" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#8E5560" />
                <stop offset="0.07" stop-color="#6F3E4B" />
                <stop offset="0.36" stop-color="#4C2B37" />
                <stop offset="1" stop-color="#352029" />
              </linearGradient>
              <!-- the road: lit by the sky's glow far off, dusty brown near; its far end fades out into the haze, so it
                   runs into the horizon instead of ending in a lit tip -->
              <linearGradient id="w-road" x1="0" y1="664" x2="0" y2="800" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#E4A07E" stop-opacity="0" />
                <stop offset="0.1" stop-color="#D8937A" stop-opacity="0.5" />
                <stop offset="0.36" stop-color="#A9686A" stop-opacity="0.86" />
                <stop offset="1" stop-color="#714550" stop-opacity="0.96" />
              </linearGradient>
              <!-- wheel ruts and the darker verges, fading in from the horizon the same way -->
              <linearGradient id="w-rut" x1="0" y1="664" x2="0" y2="800" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#4A2A36" stop-opacity="0" />
                <stop offset="0.25" stop-color="#4A2A36" stop-opacity="0.45" />
                <stop offset="1" stop-color="#3C2230" stop-opacity="0.8" />
              </linearGradient>
              <!-- warm haze lying on the far floor, over the foot of the low ridges -->
              <linearGradient id="w-floor-haze" x1="0" y1="648" x2="0" y2="704" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#F2A882" stop-opacity="0" />
                <stop offset="0.3" stop-color="#F2A882" stop-opacity="0.34" />
                <stop offset="0.5" stop-color="#E8987A" stop-opacity="0.22" />
                <stop offset="1" stop-color="#E8987A" stop-opacity="0" />
              </linearGradient>
            </defs>
            <!-- clouds, lit from below by the low sun -->
            <path d="M262 380 C380 372 520 370 640 374 C560 382 440 386 262 380 Z" fill="#8A4A66" opacity="0.38" />
            <path d="M640 432 C760 420 900 418 1040 424 C1180 430 1320 428 1460 436 C1330 447 1180 449 1040 447 C900 445 760 447 640 432 Z" fill="url(#w-cloudA)" opacity="0.78" />
            <path d="M1180 404 C1260 398 1350 397 1440 400 C1500 402 1540 404 1570 408 C1500 413 1420 414 1340 413 C1270 412 1220 411 1180 404 Z" fill="url(#w-cloudB)" opacity="0.45" />
            <path d="M90 474 C200 466 330 462 470 466 C600 470 700 470 790 476 C690 485 580 487 470 485 C340 483 210 485 90 474 Z" fill="url(#w-cloudB)" opacity="0.62" />
            <path d="M860 512 C930 506 1010 505 1090 508 C1150 510 1190 512 1222 516 C1160 521 1090 522 1020 521 C950 520 900 520 860 512 Z" fill="#FFC78E" opacity="0.6" />
            <path d="M700 540 C760 536 820 535 880 537 C840 541 770 543 700 540 Z" fill="#FFD3A0" opacity="0.5" />
            <!-- mesa A, the farthest, in the most haze; its rim catches the sun -->
            <path d="M0 1000 L0 588 L48 586 L74 566 L82 558 L330 554 L346 562 L362 584 L410 592 L470 600 L540 602 L586 590 L604 570 L612 566 L742 564 L756 572 L770 594 L830 604 L900 606 L1180 598 L1196 580 L1210 572 L1418 568 L1434 580 L1450 598 L1520 602 L1600 600 L1600 1000 Z" fill="url(#w-mesaA)" />
            <path d="M770 594 L830 604 L900 606 L1180 598 L1196 580" fill="none" stroke="#FFD9A6" stroke-width="2" opacity="0.6" />
            <path d="M612 566 L742 564 L756 572" fill="none" stroke="#FFCB98" stroke-width="1.5" opacity="0.4" />
            <path d="M1210 572 L1418 568" fill="none" stroke="#FFCB98" stroke-width="1.5" opacity="0.35" />
            <rect x="0" y="580" width="1600" height="60" fill="url(#w-haze)" />
            <!-- mesa B -->
            <path d="M0 1000 L0 626 L36 624 L58 606 L66 600 L232 597 L246 606 L262 628 L330 640 L420 646 L520 642 L600 648 L700 650 L760 646 L820 652 L960 656 L1080 652 L1160 646 L1224 640 L1240 618 L1252 606 L1500 603 L1514 614 L1528 636 L1600 640 L1600 1000 Z" fill="#8B4C64" />
            <path d="M66 600 L232 597 M1252 606 L1500 603" fill="none" stroke="#E79A84" stroke-width="1.4" opacity="0.4" />
            <path d="M80 612 L226 610 M92 622 L240 620 M1262 616 L1496 613 M1270 626 L1510 624" fill="none" stroke="#7A4058" stroke-width="2" opacity="0.7" />
            <rect x="0" y="618" width="1600" height="44" fill="url(#w-haze)" opacity="0.8" />
            <!-- mesa C, low ridges -->
            <path d="M0 1000 L0 660 C120 652 220 648 330 656 C430 662 520 660 620 664 C720 668 820 666 900 668 C1000 670 1080 666 1180 662 C1280 658 1380 664 1480 660 C1540 658 1580 660 1600 662 L1600 1000 Z" fill="#663752" />
            <!-- the desert floor and the road out of town. The road runs to its vanishing point on the horizon (the
                 floor's far edge, y 664, under the sun) and fades into the haze there: with a flat, lit top 4 units
                 short of the horizon it read as a pyramid standing on the plain (W3). Darker verges and a pair of wheel
                 ruts, all converging on the same point, make it read as a track -->
            <rect x="0" y="664" width="1600" height="336" fill="url(#w-floor)" />
            <path d="M999.5 664 L1000.5 664 L1128 800 L872 800 Z" fill="url(#w-road)" />
            <path d="M999.5 664 L872 800 L856 800 Z M1000.5 664 L1128 800 L1144 800 Z" fill="url(#w-rut)" opacity="0.7" />
            <path d="M999.8 664 L944 800 M1000.2 664 L1056 800" fill="none" stroke="url(#w-rut)" stroke-width="2.4" />
            <path d="M999.9 664 L956 800 M1000.1 664 L1044 800" fill="none" stroke="#C88470" stroke-width="1" opacity="0.18" />
            <rect x="0" y="648" width="1600" height="56" fill="url(#w-floor-haze)" />
            {brush.map((b) => <ellipse cx={f(b.x)} cy={f(b.y)} rx={f(b.rx)} ry={f(b.rx * 0.42)} fill="#3B2230" opacity="0.75" />)}
          </svg>
          <!-- heat shimmer over the hot floor: two faint bands of lines that waver as one strip (transform only, no
               SVG filter) -->
          <span class="w-shimmer"></span>
          <!-- a hawk circling high over the sun (one animation, its sampled ellipse above) -->
          <span class="w-hawk">
            <span class="w-hawk__fly">
              <svg class="w-hawk__bird" viewBox="0 0 60 24" focusable="false"><path d="M30 8.6 C26.6 7.6 22.4 5.6 17.4 4.8 C12.2 4 7.4 5 2 8.2 L5.4 8.4 L3 10.4 L7.2 9.8 L5.8 12 L10 10.8 C15 10.2 20 10.6 24.2 12.2 C26.2 13.2 27.8 15 29 17.6 L27.4 21.6 L30 20.4 L32.6 21.6 L31 17.6 C32.2 15 33.8 13.2 35.8 12.2 C40 10.6 45 10.2 50 10.8 L54.2 12 L52.8 9.8 L57 10.4 L54.6 8.4 L58 8.2 C52.6 5 47.8 4 42.6 4.8 C37.6 5.6 33.4 7.6 30 8.6 Z M30 8.8 C29 8.8 28.4 7.8 28.8 6.6 C29.2 5.8 30.8 5.8 31.2 6.6 C31.6 7.8 31 8.8 30 8.8 Z" fill="#1E1118" /></svg>
            </span>
          </span>
          <!-- a small tumbleweed far out on the floor (not on phones) -->
          <span class="w-tumble w-tumble--far">
            <svg class="w-tumble__ball" viewBox="-32 -32 64 64" focusable="false">{weed.map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} fill="none" stroke-linecap="round" />)}</svg>
          </span>
        </div>
      </div>

      <!-- mid: buttes and the telegraph line running out along the road -->
      <div class="w-l w-l--mid">
        <div class="w-art w-art--mid">
          <svg viewBox="0 420 1600 380" preserveAspectRatio="none" focusable="false">
            <defs>
              <linearGradient id="w-butte" x1="0" y1="440" x2="0" y2="702" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#4E2C44" />
                <stop offset="0.82" stop-color="#4A2A40" />
                <stop offset="1" stop-color="#5A3443" />
              </linearGradient>
            </defs>
            <path d="M430 702 C468 692 490 676 498 652 C504 630 506 560 508 470 L516 452 L528 446 L596 442 L612 448 L620 462 C622 560 626 630 634 652 C644 676 668 692 706 702 Z" fill="url(#w-butte)" />
