              <path d="M268 821 C280 822 290 821 298 820 M272 854 C284 855 294 854 301 853" stroke="#A06A3C" stroke-width="1.4" fill="none" opacity="0.7" />
              <ellipse cx="257" cy="808" rx="39" ry="7" fill="#4A2E1A" />
