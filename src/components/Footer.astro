---
import { t, type Locale, getLocalizedPath } from '../i18n/utils';

interface Props { locale: Locale; }
const { locale } = Astro.props;

const CALENDLY = 'https://calendly.com/yanis-schweizer';
const LINKEDIN = 'https://linkedin.com/in/yanis-schweizer';
const EMAIL = 'yanis@strade.tech';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href={getLocalizedPath('/', locale)} class="footer-logo">Strade</a>
        <p class="caption" style="margin-top:12px;max-width:220px">
          AI consulting and development for startups.
        </p>
      </div>

      <!-- Services -->
      <div class="footer-col">
        <p class="footer-heading">{t(locale, 'footer.services')}</p>
        <ul>
          <li><a href={getLocalizedPath('/consulting', locale)} class="footer-link">{t(locale, 'footer.consulting')}</a></li>
          <li><a href={getLocalizedPath('/development', locale)} class="footer-link">{t(locale, 'footer.development')}</a></li>
          <li><a href={CALENDLY} target="_blank" rel="noopener" class="footer-link">{t(locale, 'footer.free_audit')}</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div class="footer-col">
        <p class="footer-heading">{t(locale, 'footer.connect')}</p>
        <ul>
          <li><a href={LINKEDIN} target="_blank" rel="noopener" class="footer-link">{t(locale, 'footer.linkedin')}</a></li>
          <li><a href={`mailto:${EMAIL}`} class="footer-link">{t(locale, 'footer.email')}</a></li>
          <li><a href={CALENDLY} target="_blank" rel="noopener" class="footer-link">{t(locale, 'footer.calendly')}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-divider"></div>
    <p class="caption footer-legal">&copy; {t(locale, 'footer.legal')}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 64px 0;
    border-top: 1px solid var(--border);
    position: relative; z-index: 1;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
  }
  .footer-logo {
    font-size: 20px; font-weight: 700; color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .footer-heading {
    font-size: 12px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--text-muted);
    margin-bottom: 16px;
  }
  ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .footer-link {
    font-size: 14px; color: var(--text-secondary);
    transition: color 0.3s;
  }
  .footer-link:hover { color: var(--text-primary); }
  .footer-divider {
    height: 1px; background: var(--border); margin: 32px 0;
  }
  .footer-legal { color: var(--text-muted); }

  @media (max-width: 768px) {
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
