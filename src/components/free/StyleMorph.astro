---
// "Styles it can do", pinned: one app screen morphs through every style as you scroll.
// The chips are real buttons, so it also works by tapping (and without any scroll motion).
import { pad } from './inline';

interface Props {
  heading: string;
  items: string[];
}
const { heading, items } = Astro.props;
const key = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section class="sk-sec sm" id="styles" data-fx="style-morph">
  <div class="sm__pin">
    <div class="container sm__grid">
      <div class="sm__side">
        <h2 class="sk-h sm__h"><span class="sk-h__t">{heading}</span></h2>
        <div class="sm__now" aria-hidden="true">
          <span class="sm__count"><b>01</b> / {pad(items.length)}</span>
          <span class="sm__name"><span>{items[0]}</span></span>
        </div>
        <ul class="sm__chips" aria-label={heading}>
          {items.map((it, i) => (
            <li><button type="button" class:list={['sm-chip', i === 0 && 'is-on']} data-i={i} data-style={key(it)} aria-pressed={i === 0 ? 'true' : 'false'}>{it}</button></li>
          ))}
        </ul>
        <div class="sm__bar" aria-hidden="true"><i></i></div>
      </div>

      <div class="sm__stage" aria-hidden="true">
        <div class="sm-fit">
          <div class="sm-phone" data-style={key(items[0])}>
            <div class="sm-screen">
              <span class="sm-wall sm-wall--liquid"></span>
              <span class="sm-wall sm-wall--glass"></span>
              <span class="sm-wall sm-wall--skeuo"></span>
              <span class="sm-wall sm-wall--play"></span>
              <div class="sm-status"><span>9:41</span><i class="sm-island"></i><span class="sm-bat"><i></i></span></div>
              <div class="sm-body">
                <header class="sm-head">
                  <div><small>Good morning</small><h4>Hi, Sam</h4></div>
                  <span class="sm-av">S</span>
                </header>
                <div class="sm-hero">
                  <small>This week</small>
                  <b>12 workouts</b>
                  <span class="sm-prog"><i></i></span>
                  <em class="sm-stk">🔥</em>
                </div>
                <div class="sm-tiles">
                  <div class="sm-tile"><small>Streak</small><b>9 days</b></div>
                  <div class="sm-tile"><small>Minutes</small><b>340</b></div>
                </div>
                <div class="sm-row sm-row--a"><span class="sm-ic"><em>💪</em></span><span class="sm-tx"><b>Upper body</b><small>Today · 40 min</small></span><i class="sm-chev"></i></div>
                <div class="sm-row sm-row--b"><span class="sm-ic"><em>🧘</em></span><span class="sm-tx"><b>Mobility</b><small>Tomorrow · 15 min</small></span><i class="sm-chev"></i></div>
                <span class="sm-btn">Start workout</span>
              </div>
              <nav class="sm-tabs"><i class="on"></i><i></i><i></i><i></i></nav>
            </div>
            <span class="sm-sheen"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ================================================================
     DESIGN SYSTEM INTERVIEWER: pinned style morph
     ================================================================ */
  .sm { padding: 64px 0 16px; }
  .sm__grid { display: grid; gap: 24px; grid-template-areas: 'side' 'stage'; }
  .sm__side { grid-area: side; min-width: 0; }
  .sm__stage { grid-area: stage; position: relative; height: 600px; }
  .sm__h { margin-bottom: 18px; }
  @media (min-width: 901px) {
    .sm__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); grid-template-areas: 'side stage'; column-gap: 56px; align-items: center; }
    .sm.is-pinned { padding: 0; }
    .sm.is-pinned .sm__pin { height: 100vh; display: flex; align-items: center; padding: 76px 0 16px; }
    .sm.is-pinned .sm__grid { width: 100%; }
    .sm.is-pinned .sm__stage { height: calc(100vh - 110px); max-height: 640px; }
  }
  @media (max-width: 900px) {
    .sm__grid { grid-template-areas: 'side' 'stage' 'chips'; }
    .sm__stage { height: 520px; }
  }

  .sm__now { display: flex; flex-direction: column; gap: 6px; margin-bottom: 22px; }
  .sm__count { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; color: var(--text-muted); letter-spacing: 0.08em; }
  .sm__count b { color: var(--acc); font-weight: 600; }
  .sm__name { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .sm__name > span { display: inline-block; font-size: clamp(38px, 5.4vw, 76px); font-weight: 700; letter-spacing: -0.045em; line-height: 1; white-space: nowrap; }
  .sm__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .sm-chip {
    font: inherit; font-size: 14px; font-weight: 500; padding: 9px 16px; border-radius: 999px; cursor: pointer; border: 0;
    background: rgba(255, 255, 255, 0.05); color: var(--text-secondary);
    transition: background 0.3s, color 0.3s, transform 0.45s var(--ease-out-expo), box-shadow 0.3s;
  }
  .sm-chip:hover { color: var(--text-primary); background: rgba(255, 255, 255, 0.1); transform: translateY(-2px); }
  .sm-chip.is-on { background: var(--acc); color: #050505; box-shadow: 0 10px 28px -10px var(--acc); }
  .sm-chip:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }
  .sm__bar { margin-top: 22px; height: 2px; background: rgba(255, 255, 255, 0.07); max-width: 420px; }
  .sm__bar i { display: block; height: 100%; width: 100%; background: var(--acc); box-shadow: 0 0 10px var(--acc); transform: scaleX(var(--p, 0.1)); transform-origin: left; }
  @media (max-width: 900px) {
    .sm__side { display: contents; }
    .sm__h { grid-area: side; }
    .sm__now { grid-area: side; margin: 64px 0 0; align-self: end; }
    .sm__h { align-self: start; }
    .sm__chips { grid-area: chips; justify-content: center; }
    .sm__bar { display: none; }
    .sm__name > span { font-size: 34px; }
  }

  /* ---------- the phone: designed at 280x578, scaled to fit by JS (--k) ---------- */
  .sm-fit { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) scale(var(--k, 1)); perspective: 1400px; }
  .sm-phone {
    --t: 0.65s cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative; width: 280px; height: 578px; padding: 10px; border-radius: 48px;
    background: linear-gradient(150deg, #34363a, #0c0d0f 60%, #232528);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12), inset 0 0 0 2px rgba(255, 255, 255, 0.06), 0 60px 120px -40px color-mix(in srgb, var(--acc) 55%, transparent), 0 30px 60px -30px #000;
    /* tokens: Apple native is the default */
    --bg: #f2f2f7; --ink: #000; --muted: #8a8a8e;
    --font: -apple-system, 'SF Pro Text', 'Helvetica Neue', Inter, system-ui, sans-serif; --title-font: var(--font);
    --title-w: 700; --title-size: 28px; --title-ls: -0.025em; --title-tt: none; --title-sh: none;
    --card: #fff; --bd: 0px solid transparent; --r: 12px; --r-lg: 18px; --sh: 0 0 0 transparent; --blur: 0px;
    --hero-bg: var(--acc); --hero-ink: #fff; --hero-bd: var(--bd); --hero-sh: var(--sh);
    --track: rgba(255, 255, 255, 0.35); --track-bd: 0px solid transparent; --track-sh: 0 0 0 transparent; --fill: #fff;
    --ic-bg: var(--acc); --ic-r: 8px; --ic-sh: 0 0 0 transparent; --ic-em: 0;
    --av-bg: color-mix(in srgb, var(--acc) 20%, #fff); --av-ink: var(--acc); --av-r: 50%; --av-sh: 0 0 0 transparent;
    --btn-bg: var(--acc); --btn-ink: #fff; --btn-r: 12px; --btn-bd: 0px solid transparent; --btn-sh: 0 0 0 transparent; --btn-w: 600; --btn-tt: none; --btn-ts: none;
    --tab-bg: rgba(249, 249, 249, 0.94); --tab-bd: 0px solid transparent; --tab-bt: rgba(0, 0, 0, 0.12); --tab-m: 0px; --tab-r: 0px; --tab-sh: 0 0 0 transparent; --tab-ic: #c4c4c8; --tab-on: var(--acc); --tab-blur: 18px;
    --row-bb: transparent; --tilt: 0deg; --stk: 0;
  }
  .sm-screen {
    position: relative; height: 100%; border-radius: 38px; overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column;
    background-color: var(--bg); color: var(--ink); font-family: var(--font);
  }
  .sm-screen, .sm-screen *, .sm-screen *::before, .sm-screen *::after {
    transition: background-color var(--t), color var(--t), border-color var(--t), border-width var(--t), border-radius var(--t),
      box-shadow var(--t), backdrop-filter var(--t), opacity var(--t), rotate var(--t), margin var(--t), letter-spacing var(--t), font-size var(--t), text-shadow var(--t);
  }
  .sm-wall { position: absolute; inset: 0; z-index: -1; opacity: 0; }
  .sm-wall--liquid { background: radial-gradient(60% 38% at 18% 16%, #ff9ac9, transparent 70%), radial-gradient(52% 36% at 88% 34%, #ffc36b, transparent 70%), radial-gradient(64% 46% at 74% 86%, #7fb8ff, transparent 70%), radial-gradient(52% 40% at 12% 74%, #8ff0d4, transparent 70%), #f4f1ff; }
  .sm-wall--glass { background: radial-gradient(46% 28% at 14% 22%, #ff4fa0, transparent 70%), radial-gradient(42% 30% at 92% 46%, #6b5bff, transparent 70%), radial-gradient(52% 34% at 28% 92%, #00c2ff, transparent 70%), #160c33; }
  .sm-wall--skeuo { background: repeating-linear-gradient(0deg, rgba(60, 35, 10, 0.05) 0 1px, transparent 1px 3px), repeating-linear-gradient(90deg, rgba(60, 35, 10, 0.05) 0 1px, transparent 1px 3px), radial-gradient(120% 80% at 50% 0%, #efe4cf, #d9c8a8); }
  .sm-wall--play { background: radial-gradient(circle at 12% 14%, #ff5ca8 0 6px, transparent 7px), radial-gradient(circle at 88% 9%, #7b5cff 0 5px, transparent 6px), radial-gradient(circle at 94% 58%, #2ec4b6 0 7px, transparent 8px), radial-gradient(circle at 5% 64%, #ffd23f 0 6px, transparent 7px), radial-gradient(circle at 58% 97%, #ff8a3d 0 5px, transparent 6px), radial-gradient(circle at 40% 6%, #2ec4b6 0 4px, transparent 5px), #fff3c9; }

  .sm-status { display: flex; justify-content: space-between; align-items: center; height: 44px; padding: 4px 26px 0 30px; font-size: 13px; font-weight: 600; font-family: -apple-system, Inter, system-ui, sans-serif; }
  .sm-island { position: absolute; left: 50%; top: 11px; width: 84px; height: 24px; margin-left: -42px; border-radius: 14px; background: #000; }
  .sm-bat { width: 22px; height: 11px; border-radius: 3px; box-shadow: 0 0 0 1.2px currentColor; opacity: 0.85; position: relative; }
  .sm-bat i { position: absolute; inset: 2px 5px 2px 2px; border-radius: 1px; background: currentColor; }

  .sm-body { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 6px 16px 10px; min-height: 0; }
  .sm-head { display: flex; justify-content: space-between; align-items: center; padding: 2px 2px 4px; }
  .sm-head small { display: block; font-size: 11.5px; color: var(--muted); }
  .sm-head h4 { font-family: var(--title-font); font-weight: var(--title-w); font-size: var(--title-size); letter-spacing: var(--title-ls); text-transform: var(--title-tt); text-shadow: var(--title-sh); line-height: 1.08; margin-top: 2px; }
  .sm-av { width: 36px; height: 36px; display: grid; place-items: center; font-size: 14px; font-weight: 700; border-radius: var(--av-r); background: var(--av-bg); color: var(--av-ink); border: var(--bd); box-shadow: var(--av-sh); }

  .sm-hero {
    position: relative; display: flex; flex-direction: column; gap: 2px; padding: 14px 16px 16px;
    background: var(--hero-bg); color: var(--hero-ink); border-radius: var(--r-lg); border: var(--hero-bd); box-shadow: var(--hero-sh);
    backdrop-filter: blur(var(--blur)) saturate(1.6); -webkit-backdrop-filter: blur(var(--blur)) saturate(1.6);
  }
  .sm-hero small { font-size: 11px; opacity: 0.8; }
  .sm-hero b { font-size: 22px; letter-spacing: -0.02em; font-family: var(--title-font); }
  .sm-prog { display: block; height: 7px; margin-top: 8px; border-radius: 99px; background: var(--track); border: var(--track-bd); box-shadow: var(--track-sh); overflow: hidden; }
  .sm-prog i { display: block; width: 72%; height: 100%; border-radius: inherit; background: var(--fill); }
  .sm-stk { position: absolute; right: 12px; top: -12px; font-style: normal; font-size: 26px; opacity: var(--stk); rotate: 14deg; }

  .sm-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .sm-tile, .sm-row {
    background: var(--card); border: var(--bd); border-radius: var(--r); box-shadow: var(--sh);
    backdrop-filter: blur(var(--blur)) saturate(1.6); -webkit-backdrop-filter: blur(var(--blur)) saturate(1.6);
  }
  .sm-tile { padding: 10px 12px; display: flex; flex-direction: column; }
  .sm-tile small { font-size: 10.5px; color: var(--muted); }
  .sm-tile b { font-size: 16px; letter-spacing: -0.01em; }
  .sm-row { display: flex; align-items: center; gap: 11px; padding: 9px 12px 9px 9px; border-bottom-color: var(--row-bb); }
  .sm-ic { position: relative; width: 34px; height: 34px; flex-shrink: 0; display: grid; place-items: center; border-radius: var(--ic-r); background: var(--ic-bg); box-shadow: var(--ic-sh); }
  .sm-ic::before { content: ''; width: 12px; height: 12px; border-radius: 4px; background: currentColor; color: #fff; opacity: calc(1 - var(--ic-em)); position: absolute; }
  .sm-ic em { font-style: normal; font-size: 17px; opacity: var(--ic-em); }
  .sm-tx { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .sm-tx b { font-size: 13.5px; }
  .sm-tx small { font-size: 10.5px; color: var(--muted); }
  .sm-chev { width: 7px; height: 7px; border-right: 2px solid var(--muted); border-top: 2px solid var(--muted); rotate: 45deg; margin-right: 4px; opacity: 0.7; }
  .sm-btn {
    margin-top: auto; text-align: center; padding: 12px; font-size: 14px; font-weight: var(--btn-w); text-transform: var(--btn-tt); text-shadow: var(--btn-ts);
    background: var(--btn-bg); color: var(--btn-ink); border-radius: var(--btn-r); border: var(--btn-bd); box-shadow: var(--btn-sh);
  }
  .sm-tabs {
    display: flex; justify-content: space-around; align-items: center; height: 58px; padding: 0 18px 8px; margin: var(--tab-m);
    background: var(--tab-bg); border: var(--tab-bd); border-top-color: var(--tab-bt); border-top-width: max(0.5px, var(--tab-btw, 0.5px)); border-top-style: solid;
    border-radius: var(--tab-r); box-shadow: var(--tab-sh);
    backdrop-filter: blur(var(--tab-blur)); -webkit-backdrop-filter: blur(var(--tab-blur));
  }
  .sm-tabs i { width: 22px; height: 22px; border-radius: 7px; background: var(--tab-ic); }
  .sm-tabs i.on { background: var(--tab-on); }
  .sm-sheen { position: absolute; inset: 10px; border-radius: 38px; overflow: hidden; pointer-events: none; }
  .sm-sheen::after { content: ''; position: absolute; top: -20%; bottom: -20%; width: 45%; left: -60%; rotate: 14deg; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent); opacity: 0; }
  .sm-phone.is-swap .sm-sheen::after { animation: sm-sheen 0.75s cubic-bezier(0.3, 0.6, 0.3, 1); }
  @keyframes sm-sheen { 0% { left: -60%; opacity: 1; } 100% { left: 120%; opacity: 1; } }

  /* ---------- Liquid Glass ---------- */
  .sm-phone[data-style='liquid-glass'] {
    --bg: #f4f1ff; --muted: rgba(0, 0, 0, 0.5);
    --card: rgba(255, 255, 255, 0.28); --bd: 1px solid rgba(255, 255, 255, 0.7); --r: 22px; --r-lg: 28px; --blur: 16px;
    --sh: inset 0 1px 0 rgba(255, 255, 255, 0.95), inset 0 -1px 1px rgba(255, 255, 255, 0.3), 0 10px 26px -10px rgba(40, 20, 80, 0.25);
    --hero-bg: rgba(255, 255, 255, 0.2); --hero-ink: #0b0b0c; --hero-bd: 1px solid rgba(255, 255, 255, 0.8);
    --track: rgba(0, 0, 0, 0.08); --fill: var(--acc);
    --ic-bg: rgba(255, 255, 255, 0.55); --ic-r: 50%; --ic-sh: inset 0 1px 0 #fff, 0 4px 10px -4px rgba(0, 0, 0, 0.2);
    --av-bg: rgba(255, 255, 255, 0.55); --av-sh: inset 0 1px 0 #fff, 0 4px 12px -4px rgba(0, 0, 0, 0.2);
    --btn-bg: color-mix(in srgb, var(--acc) 75%, transparent); --btn-r: 99px; --btn-bd: 1px solid rgba(255, 255, 255, 0.6); --btn-sh: inset 0 1px 0 rgba(255, 255, 255, 0.7), 0 12px 26px -10px var(--acc);
    --tab-bg: rgba(255, 255, 255, 0.32); --tab-bd: 1px solid rgba(255, 255, 255, 0.75); --tab-bt: rgba(255, 255, 255, 0.75); --tab-m: 0 12px 12px; --tab-r: 99px; --tab-blur: 18px;
    --tab-sh: inset 0 1px 0 #fff, 0 12px 30px -12px rgba(40, 20, 80, 0.35); --tab-ic: rgba(0, 0, 0, 0.18);
  }
  .sm-phone[data-style='liquid-glass'] .sm-wall--liquid { opacity: 1; }
  .sm-phone[data-style='liquid-glass'] .sm-ic::before { color: var(--acc); }

  /* ---------- Material 3 ---------- */
  .sm-phone[data-style='material-3'] {
    --bg: #fff8f8; --ink: #22191c; --muted: #6f5f64; --font: Roboto, 'Google Sans', Inter, system-ui, sans-serif;
    --title-w: 400; --title-size: 28px; --title-ls: 0em;
    --card: #f7e4ea; --r: 16px; --r-lg: 28px;
    --hero-bg: #ffd8e7; --hero-ink: #3d0023;
    --track: rgba(61, 0, 35, 0.14); --fill: #9b2f62;
    --ic-bg: #ffd8e7; --ic-r: 12px; --av-bg: #9b2f62; --av-ink: #fff;
    --btn-bg: #9b2f62; --btn-r: 99px; --btn-w: 500; --btn-sh: 0 1px 3px rgba(0, 0, 0, 0.25), 0 4px 8px 3px rgba(0, 0, 0, 0.08);
    --tab-bg: #f7e4ea; --tab-bt: transparent; --tab-ic: #b79aa4; --tab-on: #9b2f62; --tab-blur: 0px;
  }
  .sm-phone[data-style='material-3'] .sm-ic::before { color: #9b2f62; border-radius: 50%; }
  .sm-phone[data-style='material-3'] .sm-tabs i.on { box-shadow: 0 0 0 7px #ffd8e7, 0 0 0 7px #ffd8e7; border-radius: 50%; }

  /* ---------- Minimal ---------- */
  .sm-phone[data-style='minimal'] {
    --bg: #ffffff; --ink: #111; --muted: #a0a0a0; --font: Inter, system-ui, sans-serif;
    --title-w: 500; --title-size: 26px; --title-ls: -0.045em;
    --card: #fff; --bd: 0px solid transparent; --r: 0px; --r-lg: 6px; --row-bb: #ececec;
    --hero-bg: #fff; --hero-ink: #111; --hero-bd: 1px solid #ececec;
    --track: #eee; --fill: #111;
    --ic-bg: #f2f2f2; --ic-r: 6px; --av-bg: #111; --av-ink: #fff;
    --btn-bg: #111; --btn-r: 6px; --btn-w: 500;
    --tab-bg: #fff; --tab-bt: #ececec; --tab-ic: #d6d6d6; --tab-on: #111; --tab-blur: 0px;
  }
  .sm-phone[data-style='minimal'] .sm-row { border-bottom-width: 1px; border-bottom-style: solid; border-radius: 0; padding-left: 0; padding-right: 0; }
  .sm-phone[data-style='minimal'] .sm-tile { border: 1px solid #ececec; border-radius: 6px; }
  .sm-phone[data-style='minimal'] .sm-ic::before { color: #111; width: 8px; height: 8px; border-radius: 50%; }

  /* ---------- Soft physical ---------- */
  .sm-phone[data-style='soft-physical'] {
    --bg: #f3ede6; --ink: #2b2420; --muted: #9a8c80; --title-w: 800; --title-size: 27px;
    --card: #fbf7f2; --bd: 1px solid rgba(255, 255, 255, 0.95); --r: 20px; --r-lg: 24px;
    --sh: inset 0 1px 0 #fff, 0 12px 20px -10px rgba(110, 70, 40, 0.32), 0 2px 4px rgba(110, 70, 40, 0.12);
    --hero-bg: linear-gradient(160deg, #ff8cc0, #e2468e); --hero-bd: 1px solid rgba(255, 255, 255, 0.4);
    --hero-sh: inset 0 2px 0 rgba(255, 255, 255, 0.35), inset 0 -4px 0 rgba(0, 0, 0, 0.12), 0 16px 26px -12px rgba(226, 70, 142, 0.65);
    --track: rgba(0, 0, 0, 0.16); --track-sh: inset 0 1px 2px rgba(0, 0, 0, 0.3); --fill: #fff;
    --ic-bg: linear-gradient(#fff, #efe4d8); --ic-r: 12px; --ic-sh: inset 0 1px 0 #fff, 0 3px 6px -2px rgba(110, 70, 40, 0.35);
    --av-bg: linear-gradient(#fff, #efe4d8); --av-sh: 0 4px 8px -3px rgba(110, 70, 40, 0.4);
    --btn-bg: linear-gradient(#ff7cb8, #e8478f); --btn-r: 99px; --btn-w: 700;
    --btn-sh: 0 5px 0 #b8326c, 0 14px 22px -10px rgba(184, 50, 108, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.45);
    --tab-bg: #fbf7f2; --tab-bt: transparent; --tab-m: 0 12px 12px; --tab-r: 24px; --tab-blur: 0px; --tab-sh: 0 10px 22px -12px rgba(110, 70, 40, 0.45), inset 0 1px 0 #fff;
    --tab-ic: #e2d6ca;
  }
  .sm-phone[data-style='soft-physical'] .sm-ic::before { color: var(--acc); }

  /* ---------- Glassmorphism ---------- */
  .sm-phone[data-style='glassmorphism'] {
    --bg: #160c33; --ink: #fff; --muted: rgba(255, 255, 255, 0.62);
    --card: rgba(255, 255, 255, 0.1); --bd: 1px solid rgba(255, 255, 255, 0.24); --r: 18px; --r-lg: 22px; --blur: 14px;
    --sh: 0 10px 30px rgba(0, 0, 0, 0.3);
    --hero-bg: linear-gradient(135deg, rgba(255, 92, 168, 0.55), rgba(123, 107, 255, 0.45)); --hero-bd: 1px solid rgba(255, 255, 255, 0.32);
    --track: rgba(255, 255, 255, 0.2); --fill: #fff;
    --ic-bg: rgba(255, 255, 255, 0.14); --ic-r: 12px; --av-bg: rgba(255, 255, 255, 0.18); --av-ink: #fff;
