---
/**
 * AndroidPillBar: the Android app's floating nav pill (the app's CNavBarPillWidget): a frosted stadium
 * 62 points tall, page background at 42% under a 24-point blur with a 14% light border, four items with
 * no capsule behind the selected one; selected in Vaultt blue (#70A9FF), the rest in secondary text.
 *
 * Props
 * - selected?: 'explore' | 'network' (default) | 'work' | 'profile'
 * - initials?: the avatar's letters in the Profile slot (default 'S')
 * - class?:    extra classes
 *
 * Size: inside a PhoneFrame screen (points via --u); give it a width, the height is 62 points.
 */
interface Props {
  selected?: 'explore' | 'network' | 'work' | 'profile';
  initials?: string;
  class?: string;
}
const { selected = 'network', initials = 'S', class: cls = '' } = Astro.props;
const items = ['explore', 'network', 'work', 'profile'] as const;
const labels = { explore: 'Explore', network: 'Network', work: 'Work', profile: 'Profile' };
---

<div class:list={['ap', cls]} aria-hidden="true">
  {items.map((id) => (
    <span class:list={['ap__item', id === selected && 'is-on']}>
      {id === 'explore' && (
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.2" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M15.7 8.3 13.4 13.4 8.3 15.7 10.6 10.6Z" fill="currentColor" /></svg>
      )}
      {id === 'network' && (
        <svg viewBox="0 0 24 24"><path d="M12 12 5.4 7.1M12 12l7.2-3.7M12 12l-1.3 7.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><circle cx="12" cy="12" r="3.1" fill="currentColor" /><circle cx="5" cy="6.8" r="2.2" fill="currentColor" /><circle cx="19.4" cy="8.1" r="2.2" fill="currentColor" /><circle cx="10.6" cy="19.9" r="2.2" fill="currentColor" /></svg>
      )}
      {id === 'work' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3.2" y="7.2" width="17.6" height="12.6" rx="2.6" /><path d="M8.8 7.2V5.6a1.8 1.8 0 0 1 1.8-1.8h2.8a1.8 1.8 0 0 1 1.8 1.8v1.6M3.4 12.6h17.2" /></svg>
      )}
      {id === 'profile' && <span class="ap__avatar">{initials}</span>}
      <span class="ap__label">{labels[id]}</span>
    </span>
  ))}
</div>

<style>
  .ap {
    position: relative; height: calc(var(--u, 1px) * 62); border-radius: 999px; display: flex; align-items: center; justify-content: space-evenly;
    background: rgba(19, 21, 23, 0.42);
    -webkit-backdrop-filter: blur(calc(var(--u, 1px) * 24)); backdrop-filter: blur(calc(var(--u, 1px) * 24));
    box-shadow: inset 0 0 0 calc(var(--u, 1px) * 1) rgba(238, 240, 241, 0.14), 0 calc(var(--u, 1px) * 8) calc(var(--u, 1px) * 22) rgba(0, 0, 0, 0.45);
    font-family: Inter, Roboto, system-ui, sans-serif;
  }
  .ap__item { display: flex; flex-direction: column; align-items: center; gap: calc(var(--u, 1px) * 3); color: #CDD1D5; }
  .ap__item.is-on { color: #70A9FF; }
  .ap__item svg { width: calc(var(--u, 1px) * 22); height: calc(var(--u, 1px) * 22); display: block; }
  .ap__label { font-size: calc(var(--u, 1px) * 10); line-height: 1; }
  .ap__avatar {
    display: grid; place-items: center; width: calc(var(--u, 1px) * 22); height: calc(var(--u, 1px) * 22); border-radius: 50%;
    background: linear-gradient(140deg, #FFB37A, #E0567A); color: #fff; font-size: calc(var(--u, 1px) * 10); font-weight: 700;
    box-shadow: 0 0 0 calc(var(--u, 1px) * 1.5) currentColor;
  }
</style>
