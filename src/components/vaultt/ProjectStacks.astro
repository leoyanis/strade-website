---
/**
 * ProjectStacks: Vaultt's projects as tiles stacked by kind, one tile per 20 projects. The kinds are
 * VAULTT_KINDS (src/data/work.ts), the same grouping the case study's squares use, so "Art & film" is 294
 * on both pages: Art & film, Code and Games, then "Everything else" (the rest of the 1,270, which takes in
 * the case study's Science, Business and Other kinds), so the tallest stack says "all kinds".
 *
 * Props
 * - per?:   projects per tile (default 20)
 * - class?: extra classes
 *
 * Static by default (tiles in place). The homepage script flies each tile in from a builder on the
 * network (vaultt-home.ts reads `.vk__t`), so a page that wants motion animates the tiles' transforms.
 * Colours are the app's kind colours, the same as the case study's columns (art pink, code blue, games
 * teal); everything else mixes the other kinds' colours (violet, green, orange, yellow, grey).
 */
import { VAULTT_KINDS, VAULTT_NUMBERS } from '../../data/work';

interface Props { per?: number; class?: string }
const { per = 20, class: cls = '' } = Astro.props;
const kind = (id: string) => VAULTT_KINDS.find((k) => k.id === id)!;
const shown = ['art', 'code', 'games'].map(kind);
const rest = (VAULTT_NUMBERS.projects.exact ?? 0) - shown.reduce((s, k) => s + k.n, 0);
const stacks = [
  ...shown.map((k) => ({ id: k.id, label: k.label, n: Math.round(k.n / per) })),
  { id: 'more', label: 'Everything else', n: Math.round(rest / per) },
];
---

<div class:list={['vk', cls]} data-stacks aria-hidden="true">
  {stacks.map((s) => (
    <div class:list={['vk__stack', `vk__stack--${s.id}`]}>
      <div class="vk__tiles">
        {Array.from({ length: s.n }, (_, i) => <i class:list={['vk__t', `vk__t--${(i * 7) % 5}`]}></i>)}
      </div>
      <span class="vk__label">{s.label}</span>
    </div>
  ))}
</div>

<style>
  .vk { --t: 18px; --g: 3px; display: flex; align-items: flex-end; gap: clamp(16px, 2vw, 28px); margin-top: 28px; }
  .vk__stack { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .vk__tiles { display: flex; flex-wrap: wrap-reverse; gap: var(--g); width: calc(var(--t) * 4 + var(--g) * 3); }
  /* each tile: its kind's colour on a soft diagonal, a lit top edge and a hairline rim (the case study's square) */
  .vk__t {
    display: block; width: var(--t); height: var(--t); border-radius: 4.5px; will-change: transform;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 5px 12px -5px rgba(0, 0, 0, 0.55);
  }
  .vk__label { font-family: 'Hanken Grotesk', 'Inter', system-ui, sans-serif; font-size: 15px; font-weight: 600; letter-spacing: -0.005em; color: rgba(232, 241, 255, 0.78); white-space: nowrap; }

  .vk__stack--art .vk__t--0 { background: linear-gradient(135deg, #FF7DB4, #E0457F); }
  .vk__stack--art .vk__t--1 { background: linear-gradient(135deg, #FFA6C6, #F0679A); }
  .vk__stack--art .vk__t--2 { background: linear-gradient(135deg, #F0609A, #C2306A); }
  .vk__stack--art .vk__t--3 { background: linear-gradient(135deg, #FFC793, #F0907A); }
  .vk__stack--art .vk__t--4 { background: linear-gradient(135deg, #FF7DB4, #D84C8C); }
  /* code: the app's blue, with two pale lines of code across each tile */
  .vk__stack--code .vk__t {
    background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.78) 0 52%, transparent 52%), linear-gradient(90deg, rgba(255, 255, 255, 0.5) 0 34%, transparent 34%), linear-gradient(135deg, #5C9BFF, #2F6BE8);
    background-size: 100% 2px, 100% 2px, auto; background-repeat: no-repeat;
    background-position: 4px 6px, 4px 10px, 0 0;
  }
  .vk__stack--code .vk__t--1 { background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.78) 0 40%, transparent 40%), linear-gradient(90deg, rgba(255, 255, 255, 0.5) 0 58%, transparent 58%), linear-gradient(135deg, #8CC6FF, #3F86F5); }
  .vk__stack--code .vk__t--3 { background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.78) 0 30%, transparent 30%), linear-gradient(90deg, rgba(255, 255, 255, 0.5) 0 48%, transparent 48%), linear-gradient(135deg, #4C8DFF, #2556C9); }
  .vk__stack--games .vk__t--0 { background: linear-gradient(135deg, #46DCCB, #1FA593); }
  .vk__stack--games .vk__t--1 { background: linear-gradient(135deg, #7CEADC, #2FC2B0); }
  .vk__stack--games .vk__t--2 { background: linear-gradient(135deg, #2FD4C1, #16897C); }
  .vk__stack--games .vk__t--3 { background: linear-gradient(135deg, #5BE3D3, #23B3A3); }
  .vk__stack--games .vk__t--4 { background: linear-gradient(135deg, #36CDBB, #1C9C8C); }
  .vk__stack--more .vk__t--0 { background: linear-gradient(135deg, #B596FF, #7A55E6); }
  .vk__stack--more .vk__t--1 { background: linear-gradient(135deg, #9EE86A, #58B432); }
  .vk__stack--more .vk__t--2 { background: linear-gradient(135deg, #FFB45E, #F07F2A); }
  .vk__stack--more .vk__t--3 { background: linear-gradient(135deg, #FFDA6A, #F0B02A); }
  .vk__stack--more .vk__t--4 { background: linear-gradient(135deg, #D6DBE0, #8E99A3); }
  @media (max-width: 640px) {
    .vk { --t: 15px; gap: 14px; }
    .vk__label { font-size: 14px; }
    .vk__stack--code .vk__t { background-position: 3px 5px, 3px 8.5px, 0 0; }
  }
</style>
