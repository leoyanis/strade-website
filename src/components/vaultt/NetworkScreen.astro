---
/**
 * NetworkScreen: the app's Network tab as it looks on a phone, for a PhoneFrame screen (393 x 852 points).
 * Header with round glass buttons (keys, search, bell and chat with 9+ badges), the views row
 * (Map selected, Activity, Connections, Following), the floating counts line, the live map, the colour-key
 * button, the zoom capsule, Invite and Find people, and the tab bar (Liquid Glass on iPhone, the pill on Android).
 *
 * Props
 * - platform?:    'ios' (default) or 'android' (status bar, tab bar and home handle change)
 * - live?:        animate the map (default true); false paints a still frame (good for a second phone behind)
 * - connections?: the count in the views row and the counts line (default 90, an invented network)
 * - following?:   default 10
 * - seed?:        which invented network (default 7)
 * - managed?:     a page script runs the map itself (the homepage's Vaultt scene, vaultt-home.ts: it plays only while
 *                 the intro shows), so network-mount.ts leaves it alone (default false)
 */
import NetworkMap from './NetworkMap.astro';
import LiquidGlassBar from './LiquidGlassBar.astro';
import AndroidPillBar from './AndroidPillBar.astro';

interface Props {
  platform?: 'ios' | 'android';
  live?: boolean;
  connections?: number;
  following?: number;
  seed?: number;
  managed?: boolean;
}
const { platform = 'ios', live = true, connections = 90, following = 10, seed = 7, managed = false } = Astro.props;
const ios = platform === 'ios';
---

<div class:list={['vs', `vs--${platform}`]}>
  <NetworkMap look="app" live={live} seed={seed} hubY={432} topInset={170} managed={managed} class="vs__map" />
  <div class="vs__wash" aria-hidden="true"></div>

  <div class="vs__status" aria-hidden="true">
    <span class="vs__time">9:41</span>
    <span class="vs__sys">
      <svg viewBox="0 0 18 12" class="vs__signal"><rect x="0" y="8" width="3" height="4" rx="0.8" /><rect x="5" y="5.5" width="3" height="6.5" rx="0.8" /><rect x="10" y="3" width="3" height="9" rx="0.8" /><rect x="15" y="0" width="3" height="12" rx="0.8" /></svg>
      <svg viewBox="0 0 16 12" class="vs__wifi"><path d="M8 11.6 5.6 9.2a3.4 3.4 0 0 1 4.8 0L8 11.6ZM3.6 7.2a6.2 6.2 0 0 1 8.8 0l-1.3 1.3a4.4 4.4 0 0 0-6.2 0L3.6 7.2ZM1.4 5a9.3 9.3 0 0 1 13.2 0l-1.3 1.3a7.5 7.5 0 0 0-10.6 0L1.4 5Z" /></svg>
      <span class="vs__battery"><i></i></span>
    </span>
  </div>

  <div class="vs__head" aria-hidden="true">
    <span class="vs__title">Network</span>
    <span class="vs__tools">
      <span class="vs__glass vs__keys">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="15" r="4.2" /><path d="m11 12 8.5-8.5M16.5 6.5l2.5 2.5M14.5 8.5l2 2" /></svg>
        5
      </span>
      <span class="vs__glass vs__circ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg></span>
      <span class="vs__glass vs__circ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.6 1.8H4.4L6 16.5Z" /><path d="M10 20.5a2.2 2.2 0 0 0 4 0" stroke-linecap="round" /></svg><i class="vs__badge">9+</i></span>
      <span class="vs__glass vs__circ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><path d="M12 4.2c4.6 0 8.2 3 8.2 6.9s-3.6 6.9-8.2 6.9c-.9 0-1.8-.1-2.6-.3L5 19.6l1.1-3.6C4.6 14.7 3.8 13 3.8 11.1 3.8 7.2 7.4 4.2 12 4.2Z" /></svg><i class="vs__badge">9+</i></span>
    </span>
  </div>

  <div class="vs__tabs" aria-hidden="true">
    <span class="is-on">Map</span>
    <span>Activity</span>
    <span>Connections {connections}</span>
    <span>Following {following}</span>
  </div>

  <div class="vs__counts" aria-hidden="true">
    <span>{connections} connections</span>
    <span class="vs__ask">Ask your network <b>›</b></span>
  </div>

  <span class="vs__glass vs__legend" aria-hidden="true"><i style="--c:#4C8DFF"></i><i style="--c:#FF5FA2"></i><i style="--c:#FF9A3D"></i><i style="--c:#8BE04E"></i></span>
  <span class="vs__glass vs__zoom" aria-hidden="true"><b>+</b><i></i><b>−</b></span>

  <div class="vs__invite" aria-hidden="true">
    <span class="vs__pill vs__pill--blue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><circle cx="10" cy="8.5" r="3.6" /><path d="M3.6 19.5c.9-3.4 3.5-5.2 6.4-5.2s5.5 1.8 6.4 5.2M19 8v6M16 11h6" /></svg>
      Invite
    </span>
    <span class="vs__pill vs__pill--dark">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.8c.5 3.9 2.6 6.2 6.6 6.8-4 .7-6.1 2.9-6.6 6.8-.5-3.9-2.6-6.1-6.6-6.8 4-.6 6.1-2.9 6.6-6.8ZM18.6 14.4c.24 1.7 1.1 2.7 2.9 3-1.8.3-2.66 1.3-2.9 3-.25-1.7-1.1-2.7-2.9-3 1.8-.3 2.65-1.3 2.9-3Z" /></svg>
      Find people
    </span>
  </div>

  <div class="vs__tabbar">
    {ios ? <LiquidGlassBar selected="network" hop={live} /> : <AndroidPillBar selected="network" />}
  </div>
  <span class="vs__home" aria-hidden="true"></span>
</div>

<style>
  .vs {
    position: absolute; inset: 0; overflow: hidden; background: #131517; color: #EEF0F1;
    font-family: Inter, system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased;
  }
  .vs :global(.vs__map) { position: absolute; inset: 0; }
  /* the app's ambient blue wash at the top of the page, 11% to 3.5% to 0 */
  .vs__wash { position: absolute; inset: 0 0 auto; height: calc(var(--u) * 250); pointer-events: none; background: linear-gradient(180deg, rgba(112, 169, 255, 0.11), rgba(112, 169, 255, 0.035) 45%, rgba(112, 169, 255, 0)); }

  .vs__status { position: absolute; left: 0; right: 0; top: 0; height: calc(var(--u) * 54); display: flex; align-items: center; justify-content: space-between; padding: calc(var(--u) * 4) calc(var(--u) * 30) 0 calc(var(--u) * 46); pointer-events: none; }
  .vs__time { font-size: calc(var(--u) * 16.5); font-weight: 600; letter-spacing: -0.01em; }
  .vs__sys { display: flex; align-items: center; gap: calc(var(--u) * 6); }
  .vs__sys svg { fill: #EEF0F1; height: calc(var(--u) * 11.5); width: auto; }
  .vs__battery { position: relative; width: calc(var(--u) * 25); height: calc(var(--u) * 12); border-radius: calc(var(--u) * 3.6); box-shadow: inset 0 0 0 calc(var(--u) * 1) rgba(238, 240, 241, 0.45); }
  .vs__battery i { position: absolute; inset: calc(var(--u) * 2); right: calc(var(--u) * 5); border-radius: calc(var(--u) * 2); background: #EEF0F1; }
  .vs__battery::after { content: ''; position: absolute; right: calc(var(--u) * -2.6); top: 50%; width: calc(var(--u) * 1.6); height: calc(var(--u) * 4); translate: 0 -50%; border-radius: 0 2px 2px 0; background: rgba(238, 240, 241, 0.45); }

  .vs__head { position: absolute; left: calc(var(--u) * 16); right: calc(var(--u) * 16); top: calc(var(--u) * 58); height: calc(var(--u) * 42); display: flex; align-items: center; justify-content: space-between; pointer-events: none; }
  .vs__title { font-size: calc(var(--u) * 26); font-weight: 600; letter-spacing: -0.02em; }
  .vs__tools { display: flex; align-items: center; gap: calc(var(--u) * 7); }
  .vs__glass {
    position: relative; display: inline-flex; align-items: center; justify-content: center; color: #EEF0F1;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.05));
    -webkit-backdrop-filter: blur(calc(var(--u) * 8)) saturate(1.6); backdrop-filter: blur(calc(var(--u) * 8)) saturate(1.6);
    box-shadow: inset 0 calc(var(--u) * 0.8) 0 rgba(255, 255, 255, 0.3), inset 0 0 0 calc(var(--u) * 0.6) rgba(255, 255, 255, 0.12), 0 calc(var(--u) * 4) calc(var(--u) * 12) rgba(0, 0, 0, 0.35);
  }
  .vs__circ { width: calc(var(--u) * 36); height: calc(var(--u) * 36); border-radius: 50%; }
  .vs__circ svg { width: calc(var(--u) * 19); height: calc(var(--u) * 19); }
  .vs__keys { height: calc(var(--u) * 36); padding: 0 calc(var(--u) * 12) 0 calc(var(--u) * 10); gap: calc(var(--u) * 5); border-radius: 999px; font-size: calc(var(--u) * 14); font-weight: 600; }
  .vs__keys svg { width: calc(var(--u) * 16); height: calc(var(--u) * 16); color: #FFC107; }
  .vs__badge {
    position: absolute; top: calc(var(--u) * -3); right: calc(var(--u) * -5); min-width: calc(var(--u) * 19); height: calc(var(--u) * 16); padding: 0 calc(var(--u) * 4);
    border-radius: 999px; background: #F04438; color: #fff; font-style: normal; font-size: calc(var(--u) * 9.5); font-weight: 700; line-height: calc(var(--u) * 16); text-align: center;
    box-shadow: 0 0 0 calc(var(--u) * 1.5) #131517;
  }

  .vs__tabs { position: absolute; left: calc(var(--u) * 16); right: calc(var(--u) * 8); top: calc(var(--u) * 112); display: flex; gap: calc(var(--u) * 19); font-size: calc(var(--u) * 15); font-weight: 500; color: #959EA7; white-space: nowrap; pointer-events: none; }
  .vs__tabs .is-on { position: relative; color: #EEF0F1; font-weight: 600; text-shadow: 0 0 calc(var(--u) * 12) rgba(112, 169, 255, 0.75); }
  .vs__tabs .is-on::after { content: ''; position: absolute; left: 0; right: 0; bottom: calc(var(--u) * -8); height: calc(var(--u) * 2); border-radius: 2px; background: #70A9FF; box-shadow: 0 0 calc(var(--u) * 8) rgba(112, 169, 255, 0.8); }
  .vs__counts { position: absolute; left: calc(var(--u) * 16); right: calc(var(--u) * 16); top: calc(var(--u) * 146); display: flex; justify-content: space-between; font-size: calc(var(--u) * 13); color: #CDD1D5; pointer-events: none; text-shadow: 0 1px calc(var(--u) * 6) rgba(19, 21, 23, 0.9); }
  .vs__ask { color: #959EA7; }
  .vs__ask b { font-weight: 500; }

  .vs__legend { position: absolute; left: calc(var(--u) * 16); top: calc(var(--u) * 646); width: calc(var(--u) * 40); height: calc(var(--u) * 40); border-radius: 50%; display: grid; grid-template-columns: repeat(2, calc(var(--u) * 7)); gap: calc(var(--u) * 4); align-content: center; justify-content: center; pointer-events: none; }
  .vs__legend i { width: calc(var(--u) * 7); height: calc(var(--u) * 7); border-radius: 50%; background: var(--c); box-shadow: 0 0 calc(var(--u) * 5) var(--c); }
  .vs__zoom { position: absolute; right: calc(var(--u) * 16); top: calc(var(--u) * 606); width: calc(var(--u) * 40); height: calc(var(--u) * 80); border-radius: 999px; flex-direction: column; justify-content: space-around; pointer-events: none; }
  .vs__zoom b { font-size: calc(var(--u) * 21); font-weight: 400; line-height: 1; }
  .vs__zoom i { width: calc(var(--u) * 18); height: 1px; background: rgba(238, 240, 241, 0.18); }

  .vs__invite { position: absolute; left: calc(var(--u) * 16); right: calc(var(--u) * 16); top: calc(var(--u) * 702); height: calc(var(--u) * 46); display: grid; grid-template-columns: 1fr 1fr; gap: calc(var(--u) * 10); pointer-events: none; }
  .vs__pill { display: inline-flex; align-items: center; justify-content: center; gap: calc(var(--u) * 7); border-radius: 999px; font-size: calc(var(--u) * 15); font-weight: 600; }
  .vs__pill svg { width: calc(var(--u) * 18); height: calc(var(--u) * 18); }
  .vs__pill--blue { background: #70A9FF; color: #171A1C; box-shadow: 0 calc(var(--u) * 6) calc(var(--u) * 18) rgba(112, 169, 255, 0.28); }
  .vs__pill--dark { background: rgba(33, 38, 44, 0.86); color: #EEF0F1; box-shadow: inset 0 0 0 calc(var(--u) * 0.8) rgba(255, 255, 255, 0.08); -webkit-backdrop-filter: blur(calc(var(--u) * 10)); backdrop-filter: blur(calc(var(--u) * 10)); }
  .vs__pill--dark svg { color: #8CC6FF; }

  .vs__tabbar { position: absolute; left: calc(var(--u) * 21); right: calc(var(--u) * 21); top: calc(var(--u) * 764); }
  .vs__home { position: absolute; left: 50%; bottom: calc(var(--u) * 8); width: calc(var(--u) * 136); height: calc(var(--u) * 5); translate: -50% 0; border-radius: 999px; background: #EEF0F1; pointer-events: none; }

  /* Android: Material status bar, the pill nav over an 8 pt margin, a thin gesture handle */
  .vs--android .vs__status { padding: calc(var(--u) * 2) calc(var(--u) * 22) 0 calc(var(--u) * 22); height: calc(var(--u) * 40); }
  .vs--android .vs__time { font-size: calc(var(--u) * 14); font-weight: 500; }
  .vs--android .vs__head { top: calc(var(--u) * 50); }
  .vs--android .vs__tabbar { left: calc(var(--u) * 12); right: calc(var(--u) * 12); top: calc(var(--u) * 768); }
  .vs--android .vs__home { width: calc(var(--u) * 108); height: calc(var(--u) * 4); bottom: calc(var(--u) * 6); background: rgba(238, 240, 241, 0.7); }
</style>
