---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { getProject, SIDE_QUESTS, STATS } from '../data/work';
import { visibleResources } from '../data/resources';
import '../styles/home.css';

const vaultt = getProject('vaultt')!;
const youcook = getProject('youcook')!;
const kleus = getProject('kleus')!;
const freebie = visibleResources()[0];
const marquee = ['Vaultt', 'Kleus', 'YouCook', 'Endless Pursuit', 'Sequenced', 'Fallow', 'Outreach & CRM', 'Playivity', 'Noteless'];
const stat = (i: number) => STATS[i];
const fmt = (n: number, d: number) => n.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });

// Dark or light ink for a coloured tile.
const inkFor = (hex: string) => {
  const n = parseInt(hex.replace('#', ''), 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? '#111' : '#fff';
};

// Act II decoration: stark palette, scattered at random (seeded so it's stable
// between builds). Stripes are spaced far apart so they never stack into bands.
let seed = 23;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const PALETTE = ['#FF4F1F', '#1F3BFF', '#C8F23A', '#111111', '#FFB000'];
const stripes: { top: number; h: number; color: string; twin: boolean }[] = [];
for (let y = 3, last = -1; y < 97; y += 10 + rand() * 13) {
  let ci = Math.floor(rand() * PALETTE.length);
  if (ci === last) ci = (ci + 2) % PALETTE.length;
  last = ci;
  stripes.push({ top: y, h: [5, 9, 16, 30, 52][Math.floor(rand() * 5)], color: PALETTE[ci], twin: rand() < 0.3 });
}
const shapes = [
  { kind: 'ring', x: 4, y: 16, size: 150, color: '#111111', speed: 0.6 },
  { kind: 'dot', x: 86, y: 12, size: 74, color: '#C8F23A', speed: 1.4 },
  { kind: 'half', x: 80, y: 70, size: 170, color: '#1F3BFF', speed: 0.9 },
  { kind: 'squiggle', x: 3, y: 74, size: 200, color: '#FF4F1F', speed: 1.2 },
  { kind: 'plus', x: 46, y: 6, size: 40, color: '#FFB000', speed: 1.8 },
  { kind: 'tri', x: 93, y: 44, size: 56, color: '#111111', speed: 0.7 },
  { kind: 'dot', x: 24, y: 90, size: 24, color: '#1F3BFF', speed: 2 },
  { kind: 'ring', x: 62, y: 88, size: 60, color: '#FF4F1F', speed: 1.5 },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: SITE.name,
      url: SITE.url,
      image: `${SITE.url}${SITE.portrait}`,
      jobTitle: 'Builder: apps, automations and AI tools',
      knowsLanguage: ['en', 'de', 'es', 'ro'],
      sameAs: [SITE.instagram, SITE.linkedin],
      worksFor: { '@type': 'Organization', name: SITE.company, url: SITE.url },
    },
    { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  ],
};
---

<Base
  title="Yanis Schweizer: I build apps, automations and AI tools"
  description="Yanis Schweizer builds apps, automations and AI tools at a fixed price, and you own the code. Vaultt, Kleus, YouCook and more."
  locale="en"
  path="/"
  schema={schema}
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" />

  <!-- Fixed theme layers that wipe in act by act -->
  <div class="themes" aria-hidden="true">
    <div class="theme theme--stripes">
      <div class="wipe"><div class="wipe__inner">
      <div class="stripe-field">
        <div class="stripe-rot">
          {stripes.map((st) => (
            <span class="stripe" style={`top:${st.top.toFixed(2)}%;height:${st.h}px;background:${st.color}`}>
              {st.twin && <i style={`background:${st.color}`}></i>}
            </span>
          ))}
        </div>
      </div>
      {shapes.map((sh) => (
        <span class={`shape shape--${sh.kind}`} data-speed={sh.speed} style={`left:${sh.x}vw;top:${sh.y}vh;width:${sh.size}px;color:${sh.color}`}>
          {sh.kind === 'squiggle' && (
            <svg viewBox="0 0 200 40" fill="none"><path d="M2 20 Q 14 2 27 20 T 52 20 T 77 20 T 102 20 T 127 20 T 152 20 T 177 20 T 198 20" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg>
          )}
        </span>
      ))}
      </div></div>
    </div>
    <div class="theme theme--blueprint">
      <span class="bp-mark bp-mark--tl"></span><span class="bp-mark bp-mark--tr"></span>
      <span class="bp-mark bp-mark--bl"></span><span class="bp-mark bp-mark--br"></span>
      <span class="bp-scan"></span>
    </div>
    <div class="theme theme--finale"><div class="stars"></div><div class="stars--2"></div></div>
  </div>

  <!-- ============================================================
       ACT I — ASTRAL
       ============================================================ -->
  <section id="hero" class="act h-worlds" aria-label="Yanis Schweizer: four worlds, one builder">
    <div class="worlds">
      <a class="world world--astral" href="#mq-vaultt">
        <div class="world__art" aria-hidden="true">
          <span class="world__planet"></span>
          <img src="/images/work/vaultt/panel.webp" alt="" width="827" height="999" />
        </div>
        <div class="world__meta">
          <span class="world__kind"><span class="world__num">I</span>Astral · Client</span>
          <strong>Vaultt</strong>
          <small>12.4k users and climbing</small>
        </div>
      </a>
      <a class="world world--stripes" href="#mq-youcook">
        <div class="world__art" aria-hidden="true">
          <img src="/images/work/youcook/phone-home.webp" alt="" width="560" height="1103" />
        </div>
        <div class="world__meta">
          <span class="world__kind"><span class="world__num">II</span>Stripes · My product</span>
          <strong>YouCook</strong>
          <small>Dinner from your fridge</small>
        </div>
      </a>
      <a class="world world--blueprint" href="#mq-kleus">
        <div class="world__art" aria-hidden="true">
          <img src="/images/work/kleus/panel.webp" alt="" width="660" height="1362" />
        </div>
        <div class="world__meta">
          <span class="world__kind"><span class="world__num">III</span>Blueprint · My product</span>
          <strong><span class="bp-k__phi">Φ</span> Kleus</strong>
          <small>15-minute daily lessons</small>
        </div>
      </a>
      <a class="world world--finale" href={SITE.booking} target="_blank" rel="noopener">
        <div class="world__art" aria-hidden="true">
          <img src={SITE.portrait} alt="" width="1100" height="1467" />
        </div>
        <div class="world__meta">
          <span class="world__kind"><span class="world__num">IV</span>Finale · You</span>
          <strong>Your build</strong>
          <small class="world__cta">Book a call <i>↗</i></small>
        </div>
      </a>
    </div>

    <div class="hero-head">
    <div class="worlds__title">
      <h1 class="worlds__name" id="hero-h1">Yanis Schweizer</h1>
      <p class="worlds__line" id="hero-body">I build apps, automations and AI tools.</p>
    </div>

    <div class="hero-ctas" id="hero-cta">
      <a class="cta-call" href={SITE.booking} target="_blank" rel="noopener">
        <span class="cta-call__label">Book a call · 20 min · free</span>
        <strong>I can build you anything.</strong>
        <span class="cta-call__sub">Exhibit A: the site you're scrolling. Let's talk about yours.</span>
        <span class="cta-call__go" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17 17 7M8 7h9v9"/></svg></span>
      </a>
      <a class="cta-free" href="/free">
        <span class="cta-free__sheets" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="cta-free__body">
          <span class="cta-free__label">Free · from my DMs</span>
          <strong>Open free stuff</strong>
          <span class="cta-free__sub">Templates, prompts and tools I actually use.</span>
        </span>
      </a>
    </div>
    </div>
  </section>

  <section id="now" class="act act--astral h-now">
    <div class="h-band">
      <div class="h-marquee" aria-label={`Now building: ${marquee.join(', ')}`}>
        <div class="h-marquee__track" aria-hidden="true">
          {[...marquee, ...marquee].map((m) => <span class="h-marquee__item">{m}<i>✦</i></span>)}
        </div>
      </div>
    </div>
    <div class="container">
      <p class="h-now__line" data-reveal>
        Three main quests. A handful of side quests. <em>One rule: I decide, AI types.</em>
      </p>
    </div>
  </section>

  <section id="mq-vaultt" class="act act--astral h-mq h-mq--vaultt" style={`--accent:${vaultt.accent}`}>
    <div class="container h-mq__grid">
      <div class="h-mq__text">
        <span class="h-label h-mq__label" data-reveal>Main quest 01 · Client · Live</span>
        <h2 class="h-mq__name h-split" data-split>Vaultt</h2>
        <p class="h-mq__line" data-reveal>Where young talent gets hired on proof, not a CV. Built from zero with founder Liam Jeffery.</p>
        <div class="h-mq__stat" data-reveal>
          <strong data-count="12.4" data-decimals="1" data-suffix="k">12.4k</strong>
          <span>users, and we're still building.</span>
        </div>
        <a class="h-link" href="/work/vaultt" data-reveal>Open the case study <i>→</i></a>
      </div>
      <div class="h-v-visual" aria-hidden="true">
        <div class="h-planet"></div>
        <img class="h-v-cards" src="/images/work/vaultt/cards.webp" alt="" width="900" height="900" loading="lazy" />
        <img class="h-v-phone" src="/images/work/vaultt/app-phone.webp" alt="" width="700" height="1128" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ============================================================
       ACT II — STRIPES
       ============================================================ -->
  <section id="act-stripes" class="act act--stripes" data-nav-theme="light">
    <div id="mq-youcook" class="container h-yc__grid">
      <div class="h-yc__text knock">
        <span class="h-label" data-reveal>Main quest 02 · My product · iOS + Android</span>
        <h2 class="h-yc__name h-split" data-split>You<span class="yc-accent">Cook</span></h2>
        <p class="h-yc__line" data-reveal>Tell it what's in your fridge. Get dinner, a weekly plan and the shopping list.</p>
        <div class="h-chips" data-reveal>
          <span class="h-chip">🥚 Eggs</span><span class="h-chip">🧀 Parmesan</span><span class="h-chip">🍝 Pasta</span><span class="h-chip">🍋 Lemon</span>
        </div>
        <a class="h-btn-dark" href="/work/youcook" data-reveal>Open the case study <span aria-hidden="true">→</span></a>
      </div>
      <div class="h-yc__visual" aria-hidden="true">
        <span class="h-yc__blob"></span>
        <div class="h-phone h-phone--back"><img src="/images/work/youcook/g3.webp" alt="" width="736" height="1600" loading="lazy" /></div>
        <div class="h-phone h-phone--front"><img src="/images/work/youcook/g1.webp" alt="" width="736" height="1600" loading="lazy" /></div>
      </div>
    </div>

    <div class="container h-side" id="side">
      <div class="h-side__head">
        <h2 class="knock h-split" data-split>Side quests.</h2>
        <p class="knock" data-reveal>Client builds, design systems and my own apps. Shipped, shipping or in the forge right now.</p>
      </div>
      <div class="h-tiles">
        {SIDE_QUESTS.map((p) => (
          <a href={`/work/${p.slug}`} class="h-tile" style={`--tile:${p.accent};--ink:${inkFor(p.accent)}`}>
            <span class="h-tile__status">{p.status}</span>
            <span class="h-tile__arrow" aria-hidden="true">↗</span>
            <h3>{p.name}</h3>
            <p>{p.summary}</p>
          </a>
        ))}
      </div>
      <div class="h-tiles__all"><a href="/work">See all my work →</a></div>
    </div>

    {freebie && (
      <div class="container h-free" id="free-teaser">
        <div class="h-free__box">
          <div>
            <span class="h-label">Came from Instagram?</span>
            <h2>Your free stuff lives here.</h2>
            <p>Everything I give away in my DMs, in one place. Templates, prompts and tools I actually use.</p>
            <a class="h-link" href="/free" style="color:#F5F1E8">All free stuff <i>→</i></a>
          </div>
          <a class="h-free__res" href={`/free/${freebie.slug}`}>
            <small>{freebie.kind} · Free</small>
            <h3>{freebie.title}</h3>
            <p>{freebie.summary}</p>
            <span>Get it free →</span>
          </a>
        </div>
      </div>
    )}
  </section>

  <!-- ============================================================
       ACT III — BLUEPRINT
       ============================================================ -->
  <section id="act-blueprint" class="act act--blueprint" data-nav-theme="light">
    <div class="container">
      <div class="bp-sec bp-k" id="mq-kleus">
        <div class="bp-k__grid">
          <div>
            <span class="bp-fig" data-reveal>Fig. 03 · Main quest · My product</span>
            <h2 class="bp-k__name h-split" data-split><span class="bp-k__phi">Φ</span>Kleus</h2>
            <p class="bp-k__line" data-reveal>Turns the videos, books and podcasts you keep saving into <em>15-minute lessons</em>, then checks in until you actually finish.</p>
            <a class="h-link" href="/work/kleus" data-reveal>Open the case study <i>→</i></a>
          </div>
          <div class="bp-drawing" data-reveal>
            <span class="bp-dim bp-dim--top"><span>15 MIN / DAY</span></span>
            <span class="bp-dim bp-dim--right"><span>1,400+ COMMITS</span></span>
            <div class="bp-drawing__img">
              <img src="/images/work/kleus/cover.webp" alt="Kleus homepage: learn the content you keep saving with 15 minute daily lessons" width="1600" height="822" loading="lazy" />
            </div>
            <span class="bp-callout bp-callout--a">Any material in</span>
            <span class="bp-callout bp-callout--b">Coach checks in</span>
          </div>
        </div>
      </div>

      <div class="bp-sec bp-method" id="method">
        <span class="bp-fig" data-reveal>Fig. 04 · How I work</span>
        <h2 class="h-split" data-split>The decisions are mine. <em>The typing isn't.</em></h2>
        <div class="bp-flow">
          <svg aria-hidden="true"><path class="bp-flow__path" fill="none" stroke="#111" stroke-width="1.5" /></svg>
          <div class="bp-flow__steps">
            <div class="bp-step" data-reveal><span class="bp-step__node">01</span><h3>You bring the problem</h3><p>A process that eats your week, an app idea, a tool your team keeps asking for.</p></div>
            <div class="bp-step bp-step--me" data-reveal><span class="bp-step__node">02</span><h3>I make every call</h3><p>Scope, architecture, design, and what not to build. The decisions stay human.</p></div>
            <div class="bp-step" data-reveal><span class="bp-step__node">03</span><h3>AI does the typing</h3><p>I steer Claude Code through the build. Fast, but never unsupervised.</p></div>
            <div class="bp-step" data-reveal><span class="bp-step__node">04</span><h3>You own all of it</h3><p>The code, the accounts, the IP. No black boxes and no lock-in.</p></div>
          </div>
        </div>
        <p class="bp-note" data-reveal>Fixed price · You own the code · No black boxes</p>
      </div>

      <div class="bp-sec bp-stats" id="numbers">
        <span class="bp-fig" data-reveal>Fig. 05 · Measurements</span>
        <h2 class="h-split" data-split>Hours logged.</h2>
        <div class="bp-measures">
          {STATS.map((s, i) => (
            <div class="bp-measure" data-reveal>
              <strong data-count={s.value} data-decimals={s.decimals} data-prefix={s.prefix ?? ''} data-suffix={s.suffix}>{s.prefix ?? ''}{fmt(s.value, s.decimals)}{s.suffix}</strong>
              <span>{s.label}</span>
              {i === STATS.length - 1 && <i class="bp-measure__end" aria-hidden="true"></i>}
            </div>
          ))}
        </div>
      </div>

      <div class="bp-sec bp-about" id="about">
        <span class="bp-fig" data-reveal>Fig. 06 · Spec sheet</span>
        <h2 class="h-split" data-split>The guy <em>behind</em> the quests.</h2>
        <div class="bp-about__grid">
          <div class="bp-photo" data-reveal>
            <img src={SITE.portrait} alt="Yanis Schweizer" width="1100" height="1467" loading="lazy" />
            <span class="bp-cross" aria-hidden="true"></span>
            <span class="bp-photo__tag">SUBJECT 01 · Y. SCHWEIZER</span>
          </div>
          <div data-reveal>
            <table class="bp-spec">
              <tbody>
                <tr><th scope="row">Name</th><td>Yanis Schweizer</td></tr>
                <tr><th scope="row">Class</th><td>Builder. Apps, automations and AI tools.</td></tr>
                <tr><th scope="row">Based</th><td>Europe, working with teams everywhere</td></tr>
                <tr><th scope="row">Speaks</th><td>English, German, Spanish, Romanian</td></tr>
                <tr><th scope="row">Rule</th><td>I decide. AI types. You own it.</td></tr>
                <tr><th scope="row">Claude Code</th><td>{fmt(stat(1).value, 0)} hours and counting</td></tr>
                <tr><th scope="row">Find me</th><td><a href={SITE.instagram} target="_blank" rel="noopener">{SITE.instagramHandle}</a> · <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></td></tr>
              </tbody>
            </table>
            {vaultt.testimonial && (
              <figure class="bp-quote">
                <small>Field note · from a client</small>
                <blockquote>"Working with Yanis has been game-changing for the success of StudentVenture. From design to development, his quick understanding and execution have turned ideas into reality within months. It's truly unbelievable what he can accomplish."</blockquote>
                <cite><img src={vaultt.testimonial.photo} alt="" width="40" height="40" loading="lazy" /><span><strong>{vaultt.testimonial.name}</strong>, {vaultt.testimonial.role}</span></cite>
              </figure>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FINALE — the same CTA as the top
       ============================================================ -->
  <section id="finale" class="act act--finale">
    <div class="hero-inner">
      <h2 class="hero-h1" id="final-h1" aria-label="Got something to build? Let's talk.">
        <span class="hero-line">Got something to build?</span><br />
        <span class="hero-line hero-line--accent">Let's talk.</span>
      </h2>
      <p class="hero-body" data-reveal>
        I build apps, automations and AI tools for founders and teams. Fast, fixed price, and you own every line.
      </p>
      <div class="hero-actions" data-reveal>
        <a href={SITE.booking} class="btn-primary hero-cta" target="_blank" rel="noopener">
          Book a call
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/work" class="btn-ghost">See my work</a>
      </div>
      <div class="social-row" data-reveal>
        <a class="social-btn is-ig" href={SITE.instagram} target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          Follow {SITE.instagramHandle}
        </a>
        <a class="social-btn" href="/free">Free stuff</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.documentElement.classList.add('has-themes');

  /** Split a headline into words and characters so it can be animated. */
  function splitChars(root: HTMLElement): HTMLElement[] {
    const chars: HTMLElement[] = [];
    const targets = root.querySelectorAll<HTMLElement>('.hero-line').length
      ? Array.from(root.querySelectorAll<HTMLElement>('.hero-line'))
      : [root];
    targets.forEach((t) => {
      // keep nested elements (e.g. the Φ span) as single units
      const parts = Array.from(t.childNodes);
      t.innerHTML = '';
      parts.forEach((node) => {
        if (node.nodeType === Node.TEXT_NODE) {
          const words = (node.textContent ?? '').split(/(\s+)/);
          words.forEach((w) => {
            if (!w) return;
            if (/^\s+$/.test(w)) { t.appendChild(document.createTextNode(' ')); return; }
            const word = document.createElement('span');
            word.className = 'word';
            word.style.display = 'inline-block';
            word.style.whiteSpace = 'nowrap';
            [...w].forEach((ch) => {
              const c = document.createElement('span');
              c.className = 'char';
              c.style.display = 'inline-block';
              c.textContent = ch;
              word.appendChild(c);
              chars.push(c);
            });
            t.appendChild(word);
          });
        } else if (node instanceof HTMLElement) {
          node.style.display = 'inline-block';
          t.appendChild(node);
          chars.push(node);
        }
      });
    });
    return chars;
  }

  (async () => {
    let gsap: typeof import('gsap').gsap;
    let ScrollTrigger: typeof import('gsap/ScrollTrigger').ScrollTrigger;
    try {
      ({ gsap } = await import('gsap'));
      ({ ScrollTrigger } = await import('gsap/ScrollTrigger'));
      gsap.registerPlugin(ScrollTrigger);
    } catch {
      document.documentElement.classList.remove('has-themes');
      return;
    }

    /* ---------- nav ink follows the act under it ---------- */
    const lightActs = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-theme="light"]'));
    let navTriggers: ScrollTrigger[] = [];
    navTriggers = lightActs.map((act) =>
      ScrollTrigger.create({ trigger: act, start: 'top 40px', end: 'bottom 40px', onToggle: () => syncNav() })
    );
    function syncNav() {
      document.body.dataset.nav = navTriggers.some((t) => t.isActive) ? 'light' : 'dark';
    }

    /* ---------- theme wipes ---------- */
    /* Stripes: the original diagonal wipe, done with transforms instead of
       clip-path so it stays on the compositor and tracks the scroll 1:1.
       .wipe is rotated so its top edge is the diagonal; .wipe__inner undoes
       that transform exactly, so the stripes themselves never move. */
    const wipe = document.querySelector<HTMLElement>('.wipe')!;
    const wipeInner = document.querySelector<HTMLElement>('.wipe__inner')!;
    const wipeState = { p: 0 };
    const paintWipe = () => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      const theta = Math.atan2(h * 0.3, w);
      // left end of the edge travels from the bottom to 30% above the top
      const yL = h * (1 - 1.3 * wipeState.p);
      // oversized on purpose: it must still cover the bottom-right corner once
      // the edge has passed the top of the screen
      wipe.style.width = `${w + h}px`;
      wipe.style.height = `${h * 2}px`;
      wipeInner.style.width = `${w}px`;
      wipeInner.style.height = `${h}px`;
      wipe.style.transform = `translate3d(0, ${yL}px, 0) rotate(${theta}rad)`;
      wipeInner.style.transform = `rotate(${-theta}rad) translate3d(0, ${-yL}px, 0)`;
    };
    paintWipe();
    if (reduce) {
      ScrollTrigger.create({
        trigger: '#act-stripes', start: 'top 55%',
        onToggle: (self) => { wipeState.p = self.isActive || self.progress === 1 ? 1 : 0; paintWipe(); },
        end: 'bottom top',
      });
    } else {
      gsap.to(wipeState, {
        p: 1, ease: 'none', onUpdate: paintWipe,
        scrollTrigger: { trigger: '#act-stripes', start: 'top bottom', end: 'top 12%', scrub: true, onRefresh: paintWipe },
      });
    }
    window.addEventListener('resize', paintWipe);

    // Blueprint is glued to the top edge of its act; the scan line rides that edge.
    const bpLayer = document.querySelector<HTMLElement>('.theme--blueprint')!;
    const bpAct = document.getElementById('act-blueprint')!;
    const paintBlueprint = () => {
      const top = Math.min(Math.max(bpAct.getBoundingClientRect().top, 0), window.innerHeight);
      bpLayer.style.clipPath = `inset(${top}px 0 0 0)`;
    };
    ScrollTrigger.create({ trigger: bpAct, start: 'top bottom', end: 'top top', onUpdate: paintBlueprint, onRefresh: paintBlueprint, onLeave: paintBlueprint, onLeaveBack: paintBlueprint });
    paintBlueprint();
    const finaleFrom = 'circle(0% at 50% 100%)';
    const finaleTo = 'circle(150% at 50% 100%)';
    if (reduce) {
      gsap.set('.theme--finale', { clipPath: finaleFrom });
      ScrollTrigger.create({
        trigger: '#finale', start: 'top 55%',
        onEnter: () => gsap.set('.theme--finale', { clipPath: finaleTo }),
        onLeaveBack: () => gsap.set('.theme--finale', { clipPath: finaleFrom }),
      });
    } else {
      gsap.fromTo('.theme--finale', { clipPath: finaleFrom }, {
        clipPath: finaleTo, ease: 'none',
        scrollTrigger: { trigger: '#finale', start: 'top bottom', end: 'top 12%', scrub: 0.5 },
      });
    }
    if (!reduce) {
      // the scan line rides the edge of the blueprint sheet
      gsap.fromTo('.bp-scan', { opacity: 1 }, {
        opacity: 0, ease: 'none',
        scrollTrigger: {
          trigger: '#act-blueprint', start: 'top bottom', end: 'top top', scrub: true,
          onUpdate: () => {
            const top = document.getElementById('act-blueprint')!.getBoundingClientRect().top;
            gsap.set('.bp-scan', { top: Math.max(0, top) });
          },
        },
      });
      document.querySelectorAll<HTMLElement>('.shape').forEach((el) => {
        const sp = Number(el.dataset.speed ?? 1);
        gsap.to(el, {
          y: -sp * 260, rotate: sp * 50, ease: 'none',
          scrollTrigger: { trigger: '#act-stripes', start: 'top bottom', end: 'bottom top', scrub: true },
        });
      });
      gsap.to('.stripe-field', {
        yPercent: -14, xPercent: 5, ease: 'none',
        scrollTrigger: { trigger: '#act-stripes', start: 'top bottom', end: 'bottom top', scrub: true },
      });
    }

    if (reduce) { syncNav(); return; }

    /* ---------- hero: four worlds rise, then fall away into act I ---------- */
    const worlds = gsap.utils.toArray<HTMLElement>('.world');
    const nameChars = splitChars(document.getElementById('hero-h1')!);
    gsap.timeline({ delay: 0.1 })
      .from(worlds, { clipPath: 'inset(100% 0% 0% 0%)', duration: 1.2, ease: 'expo.out', stagger: 0.09 }, 0)
      .from(worlds.map((w) => w.querySelector('.world__art')), { yPercent: 18, scale: 1.08, duration: 1.6, ease: 'expo.out', stagger: 0.09, clearProps: 'transform' }, 0.1)
      .from(nameChars, { yPercent: 110, duration: 1, ease: 'power4.out', stagger: 0.03 }, 0.45)
      .from(['#hero-body', '#hero-cta', '.world__meta'], { opacity: 0, y: 16, duration: 0.7, ease: 'power2.out', stagger: 0.04 }, 0.9);
    // On phones the panels sit below the CTAs and simply scroll past.
    gsap.matchMedia().add('(min-width: 768px)', () => {
      gsap.timeline({ scrollTrigger: { trigger: '#hero', start: 'top top', end: '70% top', scrub: 0.5 } })
        .to(worlds.slice(1), { yPercent: 100, ease: 'power1.in', stagger: 0.1 }, 0)
        .to('.world--astral .world__art', { yPercent: -20, opacity: 0, ease: 'none' }, 0)
        // Labels go first, so they don't ride down the screen with the panels.
        // Explicit start values: the intro animates these too, and a scroll that
        // begins mid-intro must not capture a half-faded state.
        .fromTo('.world__meta', { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.2, immediateRender: false }, 0)
        .fromTo(['.worlds__title', '#hero-cta'], { y: 0, opacity: 1 }, { y: -120, opacity: 0, ease: 'none', immediateRender: false }, 0);
    });

    /* ---------- the project band: starts tilted and sticking up out of the
       bottom of the hero (so it's obvious the page goes on), then straightens
       and settles into place as you scroll ---------- */
    gsap.matchMedia().add({ desktop: '(min-width: 768px)', mobile: '(max-width: 767px)' }, (ctx) => {
      const { desktop } = ctx.conditions as { desktop: boolean };
      const band = document.querySelector<HTMLElement>('.h-band')!;
      // how far to lift it so roughly two thirds of it shows above the fold
      const lift = () => -(parseFloat(getComputedStyle(document.getElementById('now')!).paddingTop) + band.offsetHeight * 0.7);
      gsap.fromTo(band, { y: desktop ? lift : 0, rotation: desktop ? -5 : -4 }, {
        y: 0, rotation: 0, ease: 'none',
        scrollTrigger: { trigger: '#now', start: 'top bottom', end: desktop ? 'top 35%' : 'top 60%', scrub: true, invalidateOnRefresh: true },
      });
      // on first load it slides up into view just after the hero has assembled
      if (desktop && window.scrollY < 40) {
        gsap.from('.h-marquee', { yPercent: 160, duration: 1.3, ease: 'expo.out', delay: 1.2 });
      }
    });

    /* ---------- big names rise letter by letter ---------- */
    document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
      const chars = splitChars(el);
      gsap.from(chars, {
        yPercent: 110, opacity: 0, duration: 1.1, ease: 'power4.out', stagger: 0.035,
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
      });
    });

    /* ---------- generic reveals ---------- */
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.from(el, {
        y: 36, opacity: 0, duration: 1, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true },
      });
    });

    /* ---------- act I: Vaultt visual drift ---------- */
    gsap.to('.h-v-cards', { yPercent: -10, rotate: -1, ease: 'none', scrollTrigger: { trigger: '#mq-vaultt', start: 'top bottom', end: 'bottom top', scrub: true } });
    gsap.to('.h-v-phone', { yPercent: -26, ease: 'none', scrollTrigger: { trigger: '#mq-vaultt', start: 'top bottom', end: 'bottom top', scrub: true } });
    gsap.to('.h-planet', { rotate: 40, yPercent: 12, ease: 'none', scrollTrigger: { trigger: '#mq-vaultt', start: 'top bottom', end: 'bottom top', scrub: true } });

    /* ---------- act II: YouCook pops, tiles land ---------- */
    gsap.from('.h-yc__blob', { scale: 0.3, ease: 'none', scrollTrigger: { trigger: '#mq-youcook', start: 'top 85%', end: 'center center', scrub: 0.6 } });
    gsap.from('.h-phone--front', { rotate: -14, scale: 0.75, yPercent: 18, ease: 'none', scrollTrigger: { trigger: '#mq-youcook', start: 'top 85%', end: 'center center', scrub: 0.6 } });
    gsap.from('.h-phone--back', { rotate: 16, xPercent: 30, yPercent: 10, ease: 'none', scrollTrigger: { trigger: '#mq-youcook', start: 'top 85%', end: 'center center', scrub: 0.6 } });
    gsap.from('.h-tile', {
      y: 70, opacity: 0, rotate: (i: number) => (i % 2 ? 5 : -5), duration: 0.9, ease: 'back.out(1.4)', stagger: 0.07,
      scrollTrigger: { trigger: '.h-tiles', start: 'top 85%', once: true },
    });

    /* ---------- act III: the flow line draws itself ---------- */
    const flow = document.querySelector<HTMLElement>('.bp-flow');
    const path = document.querySelector<SVGPathElement>('.bp-flow__path');
    if (flow && path) {
      const draw = () => {
        const box = flow.getBoundingClientRect();
        const nodes = Array.from(flow.querySelectorAll<HTMLElement>('.bp-step__node')).map((n) => {
          const r = n.getBoundingClientRect();
          return [r.left - box.left + r.width / 2, r.top - box.top + r.height / 2];
        });
        if (nodes.length < 2) return;
        let d = `M ${nodes[0][0]} ${nodes[0][1]}`;
        for (let i = 1; i < nodes.length; i++) {
          const [x0, y0] = nodes[i - 1];
          const [x1, y1] = nodes[i];
          const mx = (x0 + x1) / 2;
          d += ` C ${mx} ${y0 - 40}, ${mx} ${y1 + 40}, ${x1} ${y1}`;
        }
        path.setAttribute('d', d);
        const len = path.getTotalLength();
        path.style.strokeDasharray = `${len}`;
        return len;
      };
      const len = draw() ?? 0;
      gsap.fromTo(path, { strokeDashoffset: len }, {
        strokeDashoffset: 0, ease: 'none',
        scrollTrigger: { trigger: flow, start: 'top 80%', end: 'bottom 55%', scrub: 0.6, invalidateOnRefresh: true, onRefresh: () => draw() },
      });
    }

    /* ---------- counters ---------- */
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      const dec = Number(el.dataset.decimals ?? 0);
      const pre = el.dataset.prefix ?? '';
      const suf = el.dataset.suffix ?? '';
      const obj = { v: 0 };
      gsap.to(obj, {
        v: target, duration: 1.8, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true },
        onUpdate: () => { el.textContent = pre + obj.v.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suf; },
      });
    });

    /* ---------- finale: the same headline lands again ---------- */
    const finalChars = splitChars(document.getElementById('final-h1')!);
    gsap.from(finalChars, {
      opacity: 0, y: 40, rotate: () => (Math.random() - 0.5) * 30, duration: 0.9, ease: 'power3.out', stagger: 0.015,
      scrollTrigger: { trigger: '#finale', start: 'top 70%', once: true },
    });

    syncNav();
    window.addEventListener('load', () => ScrollTrigger.refresh());
  })();
</script>
