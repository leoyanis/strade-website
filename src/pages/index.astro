<script>
  import { createSky } from '../components/space/starfield';
  import { createStardust } from '../components/space/stardust';
  import { createWheel } from '../scripts/home-wheel';
  import { mountEditor } from '../scripts/atlas-editor';
  import { createBackdrops } from '../scripts/backdrops';
  import { createReel, type Reel } from '../scripts/atlas-reel';
  import { initVaulttHome } from '../components/vaultt/vaultt-home';
  import { mountEp } from '../components/ep/ep-section';
  import { mountFreeAct } from '../components/free-act/free-act';
  import { initWest } from '../components/west/west';
  import { mountFinaleFlight, type FinaleFlight } from '../components/space/finale-flight';
  import { mountFinaleDisc, type FinaleDisc } from '../components/space/finale-disc';

  // ?still renders the page in its finished state (reduced motion), handy for screenshots
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches || new URLSearchParams(location.search).has('still');
  document.documentElement.classList.add('has-themes');

  /* ---------- infinite CSS loops run only while they can be seen ----------
     A running CSS animation keeps the whole page rendering every frame, even off screen or under a clip: the
     Atlas pill's box-shadow pulse, the portrait's crosshair and the finale's twinkle kept every section at 120
     frames a second at rest (measured: stripes and blueprint at rest 30% main thread and 180 ms/s of GPU, 6% and
     2 ms/s with them paused). home.css pauses them unless .is-onscreen is set; set here, so it works without GSAP
     and in ?still too. The west act's loops (dust, tumbleweeds, the hawk, the windows, the poster's sway; west.css)
     live in its fixed theme layer as well as in the act, so the act is what is watched and both get the class.
     (The crosshair and the finale's twinkle are gone: the poster's bullet holes and the finale's real sky replaced
     them.) */
  const westLayer = document.querySelector('.theme--west');
  const onscreen = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const el = e.target as HTMLElement;
      el.classList.toggle('is-onscreen', e.isIntersecting);
      if (el.id === 'act-west') westLayer?.classList.toggle('is-onscreen', e.isIntersecting);
    }
  });
  document.querySelectorAll('.h-a-live, #act-west').forEach((el) => onscreen.observe(el));

  /* ---------- acts far from the screen (.is-offstage, src/styles/offstage.css) ----------
     An act whose whole box is more than a screen and a half from the view is marked .is-offstage, and loses the mark
     as soon as any of its box comes within a screen: two observers, so an act between the two edges keeps what it
     had and a page resting there never flickers, and the act has everything back a screen before it can show. A
     pinned or sticky stage stays inside its act's box, so a hold never goes offstage. offstage.css takes the layers
     off such an act (will-change, infinite loops, scroll-driven animations, backdrop filters), which it otherwise
     kept for the whole visit: from Endless Pursuit down, 72 to 83 of the page's 95 to 135 layers on phone-4x were in
     acts more than a screen away (2026-11-09). The same with reduced motion and ?still. Owners can key their own
     rules on the class (free-act.css does). Set only by these callbacks: without JS no act is ever offstage. */
  const backOn = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) e.target.classList.remove('is-offstage');
  }, { rootMargin: '100% 0px 100% 0px' });
  const goneOff = new IntersectionObserver((entries) => {
    for (const e of entries) if (!e.isIntersecting) e.target.classList.add('is-offstage');
  }, { rootMargin: '150% 0px 150% 0px' });
  document.querySelectorAll('section.act').forEach((el) => {
    backOn.observe(el);
    goneOff.observe(el);
  });

  /* ---------- the night sky behind act I (the SSI sky) and the emblem made of stars ---------- */
  const themes = document.querySelector<HTMLElement>('.themes');
  const sky = themes ? createSky(themes, { reduced: reduce }) : null;
  if (sky) {
    document.documentElement.classList.add('has-sky');
    // opaque sections that hide the whole sky: stop drawing while one covers the screen
    // (west-cover is #act-west's cover, reaching a screen above the act: the sky also sleeps while the blueprint-to-
    // west edge crosses the screen, when neither act alone fills it; west.css)
    // (Atlas, Vaultt and Endless Pursuit have no covers here: their worlds are fixed layers that cross-fade, so
    // src/scripts/backdrops.ts puts the sky to sleep from where Atlas's near-black covers the screen until the stripes
    // act does)
    ['act-stripes', 'act-free', 'act-blueprint', 'west-cover'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) sky.cover(el);
    });
    /* The sky's parallax: it lifts with the page from the top (5% of the scroll), and in the finale it frames as it
       did in the hero. A screen before the finale's wipe starts (the west act still covers the sky there, so nothing
       shows it) the lift eases over to the finale's own: 0 through the wipe, then the same 5% from the finale's top,
       so the finale at the top of the screen is the hero's sky at scroll 0. The finale's place and the screen's
       height are measured on resize and when the page's height changes, never in the scroll listener. */
    const finaleEl = document.getElementById('finale');
    let finTop = Infinity;
    let skyH = window.innerHeight;
    const measureFin = () => {
      skyH = window.innerHeight;
      if (finaleEl) finTop = finaleEl.getBoundingClientRect().top + window.scrollY;
    };
    measureFin();
    new ResizeObserver(measureFin).observe(document.body);
    window.addEventListener('resize', measureFin, { passive: true });
    const lift = () => {
      const y = window.scrollY;
      const hero = Math.min(sky.limits.shiftMax, y * 0.05);
      const fin = Math.min(sky.limits.shiftMax, Math.max(0, (y - finTop) * 0.05));
      const t = Math.min(1, Math.max(0, (y - (finTop - 2 * skyH)) / skyH));
      sky.state.shift = hero + (fin - hero) * t * t * (3 - 2 * t);
    };
    lift();
    window.addEventListener('scroll', lift, { passive: true });
  }
  const dustCanvas = document.querySelector<HTMLCanvasElement>('.sx-emblem__dust');
  const dust = dustCanvas ? createStardust(dustCanvas, { reduced: reduce }) : null;
  if (dust) document.documentElement.classList.add('has-stardust');
  // the same star, faint behind the finale's headline: its own instance, which has no intro of its own. With motion it
  // is made by the finale's shooting star (flight mode, wired to the circle wipe below: finale-flight.ts), on the
  // .fin-flight canvas, fixed to the screen in its own disc. Under reduced motion it draws the finished emblem. Its
  // still image shows until it exists. On a phone it twinkles at 15 fps once nothing has moved for a few seconds (it
  // sits faint behind the held headline for as long as the visitor reads; 30 everywhere else)
  const finDustCanvas = document.querySelector<HTMLCanvasElement>('.fin-emblem__dust');
  const finFlightCanvas = document.querySelector<HTMLCanvasElement>('.fin-flight');
  const finPhone = Math.min(innerWidth, innerHeight) < 600;
  const finDust = finDustCanvas
    ? createStardust(finDustCanvas, reduce
      ? { reduced: true, seed: 20261107, density: 0.5 }
      : { reduced: false, seed: 20261107, density: 0.5, intro: false, flight: finFlightCanvas, restFps: finPhone ? 15 : 30 })
    : null;
  if (finDust) finDustCanvas?.parentElement?.classList.add('has-dust');

  /* ---------- the wheel of project cards ---------- */
  const wheelEl = document.querySelector<HTMLElement>('.wc-wheel');
  // the Atlas card's reel is built in code: the wheel says when it may play (at the front, on screen, not picked);
  // the reel itself is made once GSAP has loaded, and the flight below owns it while the card is picked
  let cardReel: Reel | null = null;
  let cardWant = false;
  let cardHeld = false;
  const wheel = wheelEl
    ? createWheel(wheelEl, {
        reduced: reduce,
        onPlayable: (slug, on) => {
          if (slug !== 'atlas') return;
          cardWant = on;
          if (!cardReel || cardHeld) return;
          if (on) cardReel.play();
          else cardReel.pause();
        },
      })
    : null;

  /* ---------- "See our work": a slow, deliberate scroll (about 1.6 s) instead of a jump.
     It ends on the Atlas card taken apart in mid-air (workY, set with the flight); any wheel, touch or key from the
     visitor takes over. ---------- */
  let workY: (() => number) | null = null;
  // The page's scroll for the Atlas flight's frames, without a layout read: taken in the scroll event (before anything
  // in the frame writes a style), and set by smoothTo() below as it scrolls, since its scroll event only comes a
  // frame later. (The flight read window.scrollY inside GSAP's tick, after other tweens had written: a forced style
  // and layout pass every frame of the hero, 2026-11-09 audit P3.)
  let pageY = window.scrollY;
  addEventListener('scroll', () => { pageY = window.scrollY; }, { passive: true });
  const smoothTo = (y: number, ms: number) => {
    // (its targets are well inside the page, so the scroll lands where it is told; the scroll event that follows
    // a frame later writes the page's own value anyway)
    const to = (top: number) => {
      window.scrollTo({ top, behavior: 'instant' as ScrollBehavior });
      pageY = Math.max(0, top);
    };
    if (reduce) return to(y);
    const y0 = window.scrollY;
    const t0 = performance.now();
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    let stopped = false;
    const stop = () => { stopped = true; };
    const opts = { passive: true, once: true } as AddEventListenerOptions;
    window.addEventListener('wheel', stop, opts);
    window.addEventListener('touchstart', stop, opts);
    window.addEventListener('keydown', stop, opts);
    const step = (now: number) => {
      if (stopped) return;
      const k = Math.min(1, (now - t0) / ms);
      to(y0 + (y - y0) * ease(k));
      if (k < 1) requestAnimationFrame(step);
      else {
        window.removeEventListener('wheel', stop);
        window.removeEventListener('touchstart', stop);
        window.removeEventListener('keydown', stop);
      }
    };
    requestAnimationFrame(step);
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-scroll-to]').forEach((a) =>
    a.addEventListener('click', (e) => {
      const el = document.querySelector<HTMLElement>(a.dataset.scrollTo!);
      if (!el) return;
      e.preventDefault();
      const y = workY && a.dataset.scrollTo === '#mq-atlas' ? workY() : el.getBoundingClientRect().top + window.scrollY - 40;
      smoothTo(y, 1600);
    }),
  );

  /** Split a headline into words and characters so it can be animated. */
  function splitChars(root: HTMLElement): HTMLElement[] {
    const chars: HTMLElement[] = [];
    const targets = root.querySelectorAll<HTMLElement>('.hero-line').length
      ? Array.from(root.querySelectorAll<HTMLElement>('.hero-line'))
      : [root];
    targets.forEach((t) => {
      // keep nested elements (e.g. the Φ span) as single units
      const parts = Array.from(t.childNodes);
      t.innerHTML = '';
      parts.forEach((node) => {
        if (node.nodeType === Node.TEXT_NODE) {
          const words = (node.textContent ?? '').split(/(\s+)/);
          words.forEach((w) => {
            if (!w) return;
            if (/^\s+$/.test(w)) { t.appendChild(document.createTextNode(' ')); return; }
            const word = document.createElement('span');
            word.className = 'word';
            word.style.display = 'inline-block';
            word.style.whiteSpace = 'nowrap';
            [...w].forEach((ch) => {
              const c = document.createElement('span');
              c.className = 'char';
              c.style.display = 'inline-block';
              c.textContent = ch;
              word.appendChild(c);
              chars.push(c);
            });
            t.appendChild(word);
          });
        } else if (node instanceof HTMLElement) {
          node.style.display = 'inline-block';
          t.appendChild(node);
          chars.push(node);
        }
      });
    });
    return chars;
  }

  (async () => {
    let gsap: typeof import('gsap').gsap;
    let ScrollTrigger: typeof import('gsap/ScrollTrigger').ScrollTrigger;
    try {
      ({ gsap } = await import('gsap'));
      ({ ScrollTrigger } = await import('gsap/ScrollTrigger'));
      gsap.registerPlugin(ScrollTrigger);
    } catch {
      document.documentElement.classList.remove('has-themes', 'hero-intro');
      return;
    }

    /* ---------- nav ink ----------
       Base.astro flips the nav whenever a [data-nav-theme] act spans its content line, on every page. Only the
       stripes wipe needs help here (below, after the wipe): its cream arrives before its act does. */

    /* ---------- theme wipes ---------- */
    /* Stripes: the original diagonal wipe, done with transforms instead of
       clip-path so it stays on the compositor and tracks the scroll 1:1.
       .wipe is rotated so its top edge is the diagonal; .wipe__inner undoes
       that transform exactly, so the stripes themselves never move. */
    const wipe = document.querySelector<HTMLElement>('.wipe')!;
    const wipeInner = document.querySelector<HTMLElement>('.wipe__inner')!;
    const wipeState = { p: 0 };
    // the screen's size from resize events (on phones every read of innerWidth/innerHeight runs a layout first),
    // and the wipe's box written only when it changed: it runs on every scroll update of the act
    let ww = window.innerWidth;
    let wh = window.innerHeight;
    let stackH = document.querySelector<HTMLElement>('.themes')?.offsetHeight ?? 0;
    let wipeBox = '';

    /* Nav ink over the wipe. The cream reaches the top-left corner well before the top-right one, and both
       long before #act-stripes' own top reaches the nav line, where Base.astro's band observer would flip the
       ink. So while the wipe crosses, each corner follows the wipe's edge on its own (body[data-nav-force-l|r],
       read by Base.astro): the logo turns light once the edge has passed above its centre on the nav line, the
       links once it has cleared Work, and Book a call once it reaches the pill's middle (body[data-nav-force-p]).
       Once the act's top has left the screen the observer already agrees (the act spans the line
       by then) and the forces are dropped, so they never outlive the stripes. Handing over at 'top top' rather
       than at the nav line keeps the two from disagreeing for the frame an IntersectionObserver lags behind.
       Arithmetic only per update: the edge's y at x is yL + x * tan(theta) (paintWipe), and the corners' x are
       measured at start and on resize (the nav is fixed, so they never move with the scroll). */
    const stripesAct = document.getElementById('act-stripes');
    const stripesTone = stripesAct?.dataset.navTheme === 'dark' ? 'dark' : 'light';
    const NAV_LINE = 32; // Base.astro's nav line: the centre of the 64px nav row
    // Where each part of the nav turns on the nav line: the logo's centre; the right end of Work, the first link
    // (at the middle of the link row instead, Work sat in light ink on the cream for 60px of scroll); and the
    // middle of Book a call, which carries its own fill and keeps the tone it had until the edge reaches it
    // (body[data-nav-force-p], Base.astro). Measured at start and on resize: the nav is fixed.
    let navCorners = [60, ww - 330, ww - 100];
    const measureNavCorners = () => {
      const box = (sel: string) => {
        const r = document.querySelector(sel)?.getBoundingClientRect();
        return r && r.width ? r : null;
      };
      const brand = box('.nav-brand');
      const work = box('.nav-links a');
      const book = box('.nav-links .nav-book');
      navCorners = [brand ? brand.left + brand.width / 2 : 60, work ? work.right : ww - 330, book ? book.left + book.width / 2 : ww - 100];
    };
    measureNavCorners();
    let wipeHandedOver = false;
    const setNavForce = (key: 'navForceL' | 'navForceR' | 'navForceP', v: string | null) => {
      const d = document.body.dataset;
      if ((d[key] ?? null) === v) return;
      if (v) d[key] = v;
      else delete d[key];
    };
    // What the wipe paints under the nav (Base.astro, nav.toneAt and 'nav:paint'), as surfaces under the page's
    // bands: below the edge the stripes act's own cream (its declared paper colour, so the corners there show no pool
    // and knock out in it), above it Endless Pursuit's black as a plain field (#nav-paint-night: no pool, no
    // knockout). Its phone and sound pill are dark bands (navBands, above), which win over the paint, so a dark pool
    // still backs the links over them on either side of the edge. Each link takes the tone under it, split where the diagonal runs through it.
    // Before, the wipe only said 'light' or 'dark' there, and the pools showed on both sides: a frosted patch over the
    // blue stripes behind the logo, a white band behind Book a call, a grey smear along the diagonal (2026-11-09
    // re-check, real-time scroll). (Tried telling the nav where the phone and pill were from their document boxes:
    // they move with the section's own motion, and in reduced motion a dark pool sat on the cream after they had
    // gone.)
    const navEl = document.getElementById('site-nav') as (HTMLElement & { toneAt?: ((x: number, y: number) => string | Element | null) | null }) | null;
    const wipedTone = stripesTone === 'light' ? 'dark' : 'light';
    const paintNight = document.getElementById('nav-paint-night');
    let edgeY0 = 0;
    let edgeK = 0;
    const wipeToneAt = (x: number, y: number): string | Element => {
      if (y > edgeY0 + x * edgeK) return stripesAct ?? stripesTone;
      return paintNight ?? wipedTone;
    };
    let wipePainting = false;
    const syncWipeNav = () => {
      let l: string | null = null;
      let r: string | null = null;
      let p: string | null = null;
      const painting = !wipeHandedOver && wipeState.p > 0;
      if (painting) {
        // the screen the wipe is drawn on: paintWipe's own height (.themes is 100lvh, taller than innerHeight on a
        // phone while its toolbar shows), or the nav's edge ran below the painted one there
        const h = Math.max(wh, stackH);
        const yL = h * (1 - 1.3 * wipeState.p);
        const k = (h * 0.3) / ww;
        edgeY0 = yL;
        edgeK = k;
        if (yL + navCorners[0] * k < NAV_LINE) l = stripesTone;
        if (yL + navCorners[1] * k < NAV_LINE) r = stripesTone;
        // the pill would follow its corner's force: hold it on the tone being wiped away until the edge reaches it
        if (r) p = yL + navCorners[2] * k < NAV_LINE ? stripesTone : wipedTone;
      }
      setNavForce('navForceL', l);
      setNavForce('navForceR', r);
      setNavForce('navForceP', p);
      if (navEl && (painting || wipePainting)) {
        wipePainting = painting;
        navEl.toneAt = painting ? wipeToneAt : null;
        navEl.dispatchEvent(new Event('nav:paint'));
      }
    };

    const paintWipe = () => {
      const w = ww;
      // the large screen (.themes is 100lvh): the wipe covers all of it and parks below all of it (sized from
      // innerHeight it parked just under the visible area, which a phone's collapsing toolbar uncovers)
      const h = Math.max(wh, stackH);
      const theta = Math.atan2(h * 0.3, w);
      // left end of the edge travels from the bottom to 30% above the top
      const yL = h * (1 - 1.3 * wipeState.p);
      // oversized on purpose: it must still cover the bottom-right corner once
      // the edge has passed the top of the screen
      if (wipeBox !== `${w}x${h}`) {
        wipeBox = `${w}x${h}`;
        wipe.style.width = `${w + h}px`;
        wipe.style.height = `${h * 2}px`;
        wipeInner.style.width = `${w}px`;
        wipeInner.style.height = `${h}px`;
      }
      wipe.style.transform = `translate3d(0, ${yL}px, 0) rotate(${theta}rad)`;
      wipeInner.style.transform = `rotate(${-theta}rad) translate3d(0, ${-yL}px, 0)`;
      // Reduced motion: the cream comes in at once, after the act's heading is already up over Endless Pursuit's
      // black, and the knockout round the letters (home.css .knock) drew them as cream outlines there. It waits for
      // the cream (with motion the diagonal is always behind the heading before it shows).
      if (reduce) stripesAct?.classList.toggle('is-bare', wipeState.p < 1);
      syncWipeNav();
    };
    paintWipe();
    if (reduce) {
      ScrollTrigger.create({
        trigger: '#act-stripes', start: 'top 55%',
        onToggle: (self) => { wipeState.p = self.isActive || self.progress === 1 ? 1 : 0; paintWipe(); },
        end: 'bottom top',
      });
    } else {
      gsap.to(wipeState, {
        p: 1, ease: 'none', onUpdate: paintWipe,
        scrollTrigger: { trigger: '#act-stripes', start: 'top bottom', end: 'top 12%', scrub: true, onRefresh: paintWipe },
      });
    }
    // the hand-over point for the nav (see syncWipeNav above); progress is current by the time onRefresh runs
    if (stripesAct) {
      ScrollTrigger.create({
        trigger: stripesAct, start: 'top top', end: 'max',
        onEnter: () => { wipeHandedOver = true; syncWipeNav(); },
        onLeaveBack: () => { wipeHandedOver = false; syncWipeNav(); },
        onRefresh: (self) => { wipeHandedOver = self.progress > 0; syncWipeNav(); },
      });
    }
    window.addEventListener('resize', () => {
      ww = window.innerWidth;
      wh = window.innerHeight;
      stackH = document.querySelector<HTMLElement>('.themes')?.offsetHeight ?? 0;
      measureNavCorners();
      paintWipe();
    });

    /* The blueprint's sheet (home.css .bp-sheet, .bp-paper, .theme--blueprint). Its leading part is in the act's own
       flow (.bp-paper: the act's top edge down 1.5 large screens, the paper fixed to the screen inside it), so its
       edge is moved by the page's scrolling itself and can never trail the act's words. Until 2026-11-09 the whole
       sheet was the fixed layer, its edge a clip-path inset written here on every ScrollTrigger update: on a phone the
       page scrolled ahead of that write, and the black hole showed under Kleus in that gap (sys-01, measured up to
       254px with 40ms main-thread stalls; sys-07: the clip also repainted the 3 Mpx sheet every frame). The layer now
       covers what is below the leading part: a transform pair whose edge runs BP_LEAD below the act's top, inside the
       leading part, so wherever it is late it is out of sight (it is never above the act's edge, and never past the
       part's bottom, for lags up to 0.75 of a screen). Where the browser has scroll-driven animations the pair moves
       itself (home.css bp-wipe) over the range written here, in px of the page's scroll; without them the same
       transforms are written from the trigger's updates, in whole px. Layout is read on refreshes, resizes and page
       height changes (fonts, images), never per frame; vh is the large screen (.themes is 100lvh), where the layer
       parks: innerHeight parked it just under the visible area, which a phone's collapsing toolbar uncovered
       (Mobile Safari, iOS 26.3). */
    const themesBox = document.querySelector<HTMLElement>('.themes');
    let vh = Math.max(window.innerHeight, themesBox?.offsetHeight ?? 0);
    const docTop = (el: Element) => el.getBoundingClientRect().top + window.scrollY;
    const bpLayer = document.querySelector<HTMLElement>('.theme--blueprint')!;
    const bpWipe = bpLayer.querySelector<HTMLElement>('.bp-wipe');
    const bpWipeIn = bpLayer.querySelector<HTMLElement>('.bp-wipe__in');
    const bpAct = document.getElementById('act-blueprint')!;
    const bpPaper = bpAct.querySelector<HTMLElement>('.bp-paper');
    const bpTimeline = typeof CSS !== 'undefined' && !!CSS.supports?.('animation-timeline: scroll()');
    if (bpTimeline) {
      bpLayer.classList.add('is-timeline');
      bpPaper?.classList.add('is-timeline');
    }
    // how far below the act's top the layer's edge runs (share of the large screen): half the leading part's 1.5
    const BP_LEAD = 0.75;
    const bp = { top: docTop(bpAct), lead: 0, a: 0, b: 1 };
    let bpEdge = NaN;
    const setBpVar = (el: HTMLElement, k: string, v: string) => {
      if (el.style.getPropertyValue(k) !== v) el.style.setProperty(k, v);
    };
    /** Layout reads: the act's place and the large screen; the layer's range (and the scan line's, below) from them. */
    // Chromium resolves a scroll-driven px range against the page's length when the range is written, and kept that
    // when the length changed later (a refresh's passing layout, the page growing): the animation then sat tens of px
    // off for good (found on the free act's dome, free-act.ts writeRanges()). So every write is followed, a frame later
    // and after every ScrollTrigger refresh, by the same ranges a thousandth of a pixel off (both ends together, so
    // nothing moves), which the browser resolves against the page as it then is
    let bpNudge = 0;
    let bpKick = 0;
    let bpScanWrite: (() => void) | null = null;
    const bpPx = (v: number) => `${(v + bpNudge).toFixed(3)}px`;
    const writeBp = () => {
      if (!bpTimeline) return;
      setBpVar(bpLayer, '--bpw-a', bpPx(bp.a));
      setBpVar(bpLayer, '--bpw-b', bpPx(bp.b));
      bpScanWrite?.();
    };
    const rekickBp = () => {
      if (!bpTimeline || bpKick) return;
      bpKick = requestAnimationFrame(() => {
        bpKick = 0;
        bpNudge = bpNudge ? 0 : 0.001;
        writeBp();
      });
    };
    ScrollTrigger.addEventListener('refresh', rekickBp);
    const measureBp = () => {
      vh = Math.max(window.innerHeight, themesBox?.offsetHeight ?? 0);
      bp.top = docTop(bpAct);
      const T = Math.round(bp.top);
      const park = Math.round(vh);
      bp.lead = Math.round(BP_LEAD * park);
      bp.a = T + bp.lead - park;
      bp.b = T + bp.lead;
      writeBp();
      rekickBp();
      bpEdge = NaN;
    };
    /** Without scroll-driven animations: the pair at its edge for this scroll, whole px, written when it changes. */
    const paintBlueprint = (scroll: number) => {
      if (bpTimeline || !bpWipe || !bpWipeIn) return;
      const e = Math.min(Math.max(Math.round(bp.top) + bp.lead - Math.round(scroll), 0), Math.round(vh));
      if (e === bpEdge) return;
      bpEdge = e;
      bpWipe.style.transform = `translate3d(0, ${e}px, 0)`;
      bpWipeIn.style.transform = `translate3d(0, ${-e}px, 0)`;
    };
    measureBp();
    const bpFromST = (self: ScrollTrigger) => paintBlueprint(self.scroll());
    ScrollTrigger.create({
      start: () => {
        measureBp();
        return bp.a;
      },
      end: () => bp.b,
      onUpdate: bpFromST, onLeave: bpFromST, onLeaveBack: bpFromST, onRefresh: bpFromST,
    });
    addEventListener('resize', () => {
      measureBp();
      paintBlueprint(window.scrollY);
    }, { passive: true });
    new ResizeObserver(() => {
      measureBp();
      paintBlueprint(window.scrollY);
    }).observe(document.body);
    paintBlueprint(window.scrollY);
    // The leading part's paper is a full-screen layer clipped to the part: hidden while the part is more than two
    // screens below the screen or one above it (an observer, never the scroll), so it is drawn only round the
    // hand-over. Two screens ahead, because an observer's answer can come a few frames late in a fling, and the part
    // must have its paper before it arrives or the hole would show in it
    if (bpPaper) {
      new IntersectionObserver((es) => {
        for (const e of es) bpPaper.classList.toggle('is-far', !e.isIntersecting);
      }, { rootMargin: '100% 0px 200% 0px' }).observe(bpPaper);
    }
    /* The finale opens on the hero's own night sky. With motion the circle wipe (from the bottom centre) is the
       finale's disc (finale-disc.ts, .fin-disc): the WebGL sky canvas moves into it from .themes while the night
       shows, with the finale's faint tint drawn under it, and the disc grows on the compositor with the scroll (no
       clips: before, a circle() was rewritten on the sky and on the tint every frame, audit B04). No second WebGL
       context, no regenerated stars; before the wipe the sky sleeps under the west act's cover (sky.cover, above).
       body.dataset.navForce = 'dark' from the moment the circle covers the screen's top corners (the nav reads it):
       they are hypot(w/2, h) from the circle's centre.
       The west act's foreground (#about: the label, the headline, the poster, the ledger and the telegram slip) sits
       in main, above every theme layer; the disc lies in the finale's section, which stacks above it, so the night
       covers the cards by compositing, exactly where it covers the scene. (Before, #about was clipped to outside the
       circle by a path() rewritten every frame, a mask over a 1686 px layer on a phone, whose cut edge trailed the
       sky's on iOS, audit B03.) Once the circle holds all of #about, it is hidden and gives up its nav bands
       (.is-gone, west.css). While the circle opens, it also tells the nav that it paints the night inside it
       (nav.toneAt, Base.astro), so a link over the black takes light ink with no light pool even where a card's band
       still lies under it. (Before that, the foreground faded as the circle's edge swept over it: the telegram slip at
       the top of the screen stayed opaque over the circle's crown, and a faint ghost of it was left on the black,
       2026-11-09.) Reduced motion keeps its cross-fade on the theme stack (paintFade, below). */
    const finLayer = document.querySelector<HTMLElement>('.theme--finale');
    const skyCanvas = sky?.canvas ?? null;
    const westFg = document.querySelector<HTMLElement>('#about .bp-about__grid');
    const westAbout = document.getElementById('about');
    // #about's box in document pixels: measured on refresh and when the page's height changes, never per frame
    const fgBox = { t: 0, b: 0, l: 0, r: 0 };
    const measureFg = () => {
      if (!westAbout) return;
      const r = westAbout.getBoundingClientRect();
      fgBox.t = r.top + window.scrollY;
      fgBox.b = r.bottom + window.scrollY;
      fgBox.l = r.left;
      fgBox.r = r.right;
    };
    measureFg();
    ScrollTrigger.addEventListener('refresh', measureFg);
    new ResizeObserver(measureFg).observe(document.body);
    /* #about under the night's disc: covered by compositing while the circle opens over it (no clip), and hidden
       once the circle holds all of it, its box from the cached measure and the given scroll (with a margin for the
       poster's sway and the cards' shadows, and 40 px more, so on the way back up it shows again a little before the
       disc, which runs a frame ahead of the script on the compositor, uncovers it). Arithmetic only per update. */
    let westHidden = false;
    const westHandOff = (R: number, scroll: number) => {
      if (!westAbout) return;
      const hc = Math.max(wh, stackH);
      const m = 60;
      const top = fgBox.t - scroll - m;
      const l = fgBox.l - m;
      const r = fgBox.r + m;
      const cx = ww / 2;
      const far = Math.hypot(Math.max(cx - l, r - cx), hc - top);
      const hidden = R >= far + 40;
      if (hidden !== westHidden) {
        westHidden = hidden;
        westAbout.style.visibility = hidden ? 'hidden' : '';
        westFg?.classList.toggle('is-gone', hidden);
      }
    };
    // While the circle opens, the night it paints, for the nav: dark inside the circle, the bands outside, until the
    // circle has the screen's top corners and the whole-nav force (setNavDark, below) takes over. Given to the nav once
    // per layout as the circle's geometry (Base.astro nav.paintCircle: its centre on the screen and its radius as a
    // function of the scroll, then a 'nav:circle' event; layoutDisc, below), which the nav works out on its own scroll
    // frame from the scroll it already has. It was a toneAt paint this script kept current from every scroll update,
    // with a 'nav:paint' whenever the circle's edge moved inside the nav's strip (audit B13)
    const finNavEl = document.getElementById('site-nav') as (HTMLElement & { paintCircle?: { cx: number; cy: number; r: (scrollY: number) => number } | null }) | null;
    // the foreground's opacity (written only when it changed by a hundredth). .is-fading gives it a compositor layer
    // only while it is see-through, so the fade never repaints it; .is-gone takes its nav bands off once it has all but
    // gone: the nav reads each paper as it shows through the fade over the dusk (Base.astro: a faded band's tone and
    // knockout are the mix with the dusk under it, #act-west's "plain #141234"). Off below half, the papers still showed
    // at a third as a murky grey under the night's cyan Free stuff (1440 at 13700 to 13830, 2026-11-09 final check)
    let fgO = 1;
    const setFg = (o: number) => {
      if (!westFg) return;
      const v = Math.round(Math.min(1, Math.max(0, o)) * 100) / 100;
      if (v === fgO) return;
      fgO = v;
      westFg.style.opacity = v >= 1 ? '' : String(v);
      westFg.classList.toggle('is-fading', v < 1);
      westFg.classList.toggle('is-gone', v < 0.04);
    };
    const ease3 = (t: number) => t * t * (3 - 2 * t);
    let finST: ScrollTrigger | undefined;
    // the shooting star and the headline (finale-flight.ts), mounted with the wipe's trigger below (motion only)
    let finFlight: FinaleFlight | null = null;
    // the night's disc (finale-disc.ts), mounted with the wipe's trigger below (motion only)
    let finDisc: FinaleDisc | null = null;
    let navForced = false;
    const setNavDark = (force: boolean) => {
      if (force === navForced) return;
      navForced = force;
      if (force) document.body.dataset.navForce = 'dark';
      else delete document.body.dataset.navForce;
    };
    // The circle's unit as a circle() radius in % had it: hypot(w, h) / √2 of the theme stack (.themes: 100lvh, so on
    // a phone with its toolbar showing it reaches below the visible bottom, and the circle's centre with it); the
    // wipe's circle is 150% of that once it is fully open
    const stackHeight = () => Math.max(wh, stackH);
    const circleUnit = () => Math.hypot(ww, stackHeight()) / Math.SQRT2;
    const paintFinale = (p: number) => {
      // ScrollTrigger's scroll, read once per scroll event (its cache), so this reads no layout
      const sc = finST ? finST.scroll() : window.scrollY;
      // The circle's radius: straight with the scroll, from finale-flight.ts when it runs (which draws the star, the
      // spray and the stage from the same scroll, in this same task), from the trigger's progress without it
      const R = finFlight && finST ? finFlight.paint(p * (finST.end - finST.start), ww, wh, stackHeight()) : 1.5 * p * circleUnit();
      finDisc?.paint(R);
      // the screen's top corners are hypot(w/2, stack height) from the circle's centre (the disc's centre when it
      // runs, the one the nav is given, so the force comes on exactly where the nav's circle paint goes off)
      const corners = finDisc ? Math.hypot(finDisc.geo.cx, finDisc.geo.cy) : Math.hypot(ww / 2, stackHeight());
      setNavDark(R >= corners);
      westHandOff(R, sc);
    };
    // the disc's geometry and its stretch of scroll, from the plan's circle (the same formula without the flight), and
    // the same circle for the nav: radius(s) = rk x clamp(s / sWipe), s px of scroll past the wipe's start, as
    // finale-flight.ts draws it
    const layoutDisc = (self: ScrollTrigger) => {
      const c = finFlight ? finFlight.circle() : { rk: 1.5 * circleUnit(), sWipe: 0.88 * wh };
      finDisc?.layout({ start: self.start, rk: c.rk, sWipe: c.sWipe });
      if (!finNavEl) return;
      const start = self.start;
      finNavEl.paintCircle = {
        cx: finDisc ? finDisc.geo.cx : ww / 2,
        cy: finDisc ? finDisc.geo.cy : stackHeight(),
        r: (y: number) => c.rk * Math.min(1, Math.max(0, (y - start) / c.sWipe)),
      };
      finNavEl.dispatchEvent(new Event('nav:circle'));
    };
    /* Reduced motion and ?still: the same stretch of scroll, as a cross-fade instead of the moving circle. The sky and
       the tint come up with opacity (the lifted sky holds its one still frame) while the west act's foreground fades
       out, and the finale's words (its star and headline among them) stay hidden until the sky is nearly on, then
       come up over its last quarter: before, a snap at 'top 55%' cut the whole screen to stars in one frame, and for
       the 300px before it the star and the white headline sat on the boardwalk. Tried holding back only the head: the
       words and buttons under it then showed first, under an empty gap. A button that keyboard focus scrolls to still
       shows (home.css, .fin-inner:focus-within).
       In sequence, so the west and the finale's words never show together: the cards go first (by 40% of the stretch),
       the night is fully on by 65%, nothing changes until 72%, then the words come up to the end. (The night used to
       take the whole stretch and the words its last quarter, so the town still showed through at a quarter while the
       headline and the buttons came up over it, 2026-11-09.) The nav goes dark once the night is 60% on, after the
       cards' bands have gone. */
    const finInner = document.querySelector<HTMLElement>('#finale .fin-inner');
    let fadeWas = -1;
    const paintFade = (f: number) => {
      const v = Math.round(Math.min(1, Math.max(0, f)) * 1000) / 1000;
      if (v === fadeWas) return;
      fadeWas = v;
      const night = Math.round(ease3(Math.min(1, v / 0.65)) * 1000) / 1000;
      if (finLayer) finLayer.style.opacity = String(night);
      if (skyCanvas) {
        skyCanvas.classList.toggle('is-lifted', night > 0);
        // see-through only while lifted: at 0 it is the hero's own sky again, under the other worlds, and must show
        skyCanvas.style.opacity = night >= 1 || night <= 0 ? '' : String(night);
      }
      setFg(1 - ease3(Math.min(1, v / 0.4)));
      if (finInner) finInner.style.opacity = String(ease3(Math.min(1, Math.max(0, (v - 0.72) / 0.28))));
      setNavDark(night >= 0.6);
    };
    if (reduce) {
      if (finLayer) finLayer.style.clipPath = 'none';
      paintFade(0);
      ScrollTrigger.create({
        trigger: '#finale', start: 'top bottom', end: 'top 12%',
        onUpdate: (self) => paintFade(self.progress),
        onRefresh: (self) => paintFade(self.progress),
        onLeave: () => paintFade(1),
        onLeaveBack: () => paintFade(0),
      });
    } else {
      const finSection = document.getElementById('finale');
      // the night's disc (finale-disc.ts): the sky and the tint move into it, and the tint's layer in the theme stack
      // (reduced motion's) is kept down by the layer manager (backdrops.ts: data-layer-off, a world its owner no longer
      // draws in)
      const finDiscs = finSection ? Array.from(finSection.querySelectorAll<HTMLElement>('.fin-disc')) : [];
      const finTint = finSection?.querySelector<HTMLCanvasElement>('.fin-tint') ?? null;
      if (finSection && finDiscs.length === 2 && finTint && themes) {
        finDisc = mountFinaleDisc({ section: finSection, discs: finDiscs, tint: finTint, sky: skyCanvas, themes });
        if (finLayer) {
          finLayer.setAttribute('data-layer-off', '');
          finLayer.style.visibility = 'hidden';
        }
      }
      paintFinale(0);
      // The finale is pinned (home.css .is-pinned: a sticky stage in a section a screen plus the held stretch tall;
      // finale-flight.ts writes the lengths), only with the flight that drives it
      const finStage = finSection?.querySelector<HTMLElement>('.fin-stage') ?? null;
      const finH1 = document.getElementById('final-h1');
      const finBox = finDustCanvas?.parentElement ?? null;
      const finHead = finSection?.querySelector<HTMLElement>('.fin-head') ?? null;
      const pinned = !!(finDust && finDustCanvas && finFlightCanvas && finBox && finHead && finSection && finStage && finH1);
      if (pinned) finSection!.classList.add('is-pinned');
      // No scrub: the circle, the star, the spray, the stop and the letters follow the scroll exactly, in one task per
      // scroll update. (Scrubbed at 0.5, the progress lagged a fast scroll and caught up in a rush, and the emblem,
      // drawn from it, trailed the headline.) The circle still opens over 'top bottom' to 'top 12%'; pinned, the
      // trigger runs on to the section's bottom at the screen's top, past the stage letting go (finale-flight.ts)
      finST = ScrollTrigger.create({
        trigger: '#finale', start: 'top bottom', end: pinned ? 'bottom top' : 'top 12%',
        onUpdate: (self) => paintFinale(self.progress),
        onRefresh: (self) => {
          layoutDisc(self);
          paintFinale(self.progress);
        },
      });
      /* The finale (finale-flight.ts): a shooting star is in the night from the moment the circle opens (nothing of it
         shows outside the circle), crosses the screen's middle and flies out, dropping a spray of the emblem's stars
         that hangs a moment and is then drawn down into the emblem as the stage slows to a stop in the middle; held
         still, the letters rise in from below, each at its own pace, then the buttons and the socials, and the emblem
         fades to its faint rest; a grace, then the stage lets go. All of it scrubbed by the scroll, both ways. */
      if (pinned && finST) {
        finFlight = mountFinaleFlight({
          ScrollTrigger, st: finST, emblem: finDust!, section: finSection!, stage: finStage!, head: finHead!, emblemBox: finBox!,
          homeCanvas: finDustCanvas!, flightCanvas: finFlightCanvas!, h1: finH1!,
          chars: splitChars(finH1!),
          followers: Array.from(finSection!.querySelectorAll<HTMLElement>('[data-fin-in]')),
        });
        paintFinale(finST.progress);
      }
    }

    // the west act: the blueprint sheet tears away from its top edge, and as it scrolls the camera tilts up from the
    // town at sundown to the first stars (src/components/west); it handles reduced motion itself. Wired here, next to
    // the other layer wipes and before the sections' own mounts, so an error in one of those cannot leave its world
    // hidden behind the blueprint sheet.
    initWest({ gsap, ScrollTrigger, reduced: reduce });
    const scan = bpPaper?.querySelector<HTMLElement>('.bp-scan');
    if (!reduce) {
      // The scan line rides the top of the paper's leading part, which is the act's own edge, so it never needs
      // moving (it was a transform written every update, rounded to whole px). It fades out over the sheet's rise, as
      // the act's top goes from the screen's bottom to its top: an animation on the scroll where there are those
      // (home.css bp-scan; its range, the same two points, written on every measure), else the scrubbed tween
      if (bpPaper && scan) {
        bpPaper.classList.add('is-scan');
        if (bpTimeline) {
          // written with the layer's range (writeBp(): on every measure and its re-resolve a frame later)
          const scanRange = () => {
            setBpVar(bpPaper, '--bps-a', bpPx(Math.round(bp.top - window.innerHeight)));
            setBpVar(bpPaper, '--bps-b', bpPx(Math.round(bp.top)));
          };
          bpScanWrite = scanRange;
          scanRange();
        } else {
          gsap.fromTo(scan, { opacity: 1 }, {
            opacity: 0, ease: 'none',
            scrollTrigger: { trigger: bpAct, start: 'top bottom', end: 'top top', scrub: true },
          });
        }
      }
      document.querySelectorAll<HTMLElement>('.shape').forEach((el) => {
        const sp = Number(el.dataset.speed ?? 1);
        gsap.to(el, {
          y: -sp * 260, rotate: sp * 50, ease: 'none',
          scrollTrigger: { trigger: '#act-stripes', start: 'top bottom', end: 'bottom top', scrub: true },
        });
      });
      gsap.to('.stripe-field', {
        yPercent: -14, xPercent: 5, ease: 'none',
        scrollTrigger: { trigger: '#act-stripes', start: 'top bottom', end: 'bottom top', scrub: true },
      });
    }

    // Endless Pursuit's black world is a fixed layer (.theme--ep): it fades in over Vaultt's as soon as the jobs have
    // unfolded (src/scripts/backdrops.ts, below) and stays under the page, so the stripes wipe over it on one clean
    // diagonal.
    const epSec = document.getElementById('mq-endless-pursuit');
    // the section itself: the working Today screen, its sounds and the star ∞ (src/components/ep); it handles
    // reduced motion and ?still itself. The backdrops below tell it where its world's switch is and when it shows
    const epWorld = epSec ? mountEp(epSec, { gsap, ScrollTrigger }) : null;

    // Vaultt's scene (its world's network, the intro and the three numbers); it handles reduced motion itself
    const vxWorld = initVaulttHome({ gsap, ScrollTrigger, reduced: reduce });

    // The work's backdrops (src/scripts/backdrops.ts): Atlas's, Vaultt's and Endless Pursuit's worlds cross-fade in
    // place at their switch points while the content scrolls over them (at once, without the fade, under reduced
    // motion), and the sky sleeps under them
    createBackdrops({ ScrollTrigger, sky, reduced: reduce, vaultt: vxWorld, ep: epWorld });

    // the free stuff act: the dome hand-over from the stripes, the black hole, the words held until the dark
    // covers the screen and the band's tilt (src/components/free-act); it handles reduced motion itself
    mountFreeAct({ gsap, ScrollTrigger, reduced: reduce });

    if (reduce) return;

    /* ---------- hero: the stars gather into the emblem, the name lands, the cards are dealt ---------- */
    const cardIns = gsap.utils.toArray<HTMLElement>('.wc').map((c) => c.querySelector('.wc__in'));
    // deal from the middle outwards
    const dealOrder = [...cardIns].sort((x, y) => {
      const d = (el: Element | null) => Math.abs(parseFloat((el?.parentElement as HTMLElement)?.style.transform.match(/rotate\(([-\d.]+)/)?.[1] ?? '0'));
      return d(x) - d(y);
    });
    // lift the intro gate first: from() tweens read the resting state as their end point
    document.documentElement.classList.remove('hero-intro');
    // The cards come first (Yanis, 2026-11-08: "have the cards of the projects appear sooner"): dealt from 0.4 s, the
    // name blurs in over them from 0.9 s, the line and the buttons follow from 1.25 s (they were the name at 1.35 s,
    // the deal at 1.5 s and the line at 1.75 s). A card's inner box has a CSS transition on transform (its hover lift,
    // home-wheel.css): it turned the deal's from-state into a 0.6 s slide down, which GSAP then read back as a stray
    // 491px offset, so the deal ended with the cards still below the screen and they only came up when clearProps
    // dropped the transform, at about 4.4 s after load. The transition is off for the deal and comes back with
    // clearProps.
    gsap.set(dealOrder, { transition: 'none' });
    const heroLite = matchMedia('(max-width: 767px), (hover: none) and (pointer: coarse)').matches;
    gsap.timeline({ delay: 0.15 })
      .from(dealOrder, { yPercent: 120, duration: 1.3, ease: 'expo.out', stagger: 0.07, clearProps: 'transform,transition' }, 0.4)
      // (phones and touch screens: the name rises and fades in without the blur, which WebKit re-rasterized for every
      // frame of its 1.4 s, the hero's first and costliest frames on a phone; audit P3)
      .fromTo('.sx-word', heroLite ? { opacity: 0, y: 18 } : { opacity: 0, y: 18, filter: 'blur(10px)' }, heroLite ? { opacity: 1, y: 0, duration: 1.4, ease: 'power3.out' } : { opacity: 1, y: 0, filter: 'blur(0px)', duration: 1.4, ease: 'power3.out', clearProps: 'filter' }, 0.9)
      .from('[data-hero-in]', { opacity: 0, y: 16, duration: 0.9, ease: 'power2.out', stagger: 0.08 }, 1.25);
    // scrolling away: the name drifts up. Its fade belongs to the Atlas flight below: it clears exactly as the picked
    // card rises towards it, so the card never crosses words or buttons that are still showing. Without the flight
    // it fades with the scroll instead (headFadeByScroll, further down).
    const heroHead = document.querySelector<HTMLElement>('.sx-hero__head');
    gsap.fromTo('.sx-hero__head', { y: 0 }, {
      y: -120, ease: 'none', immediateRender: false,
      scrollTrigger: { trigger: '#hero', start: 'top top', end: '34% top', scrub: 0.5 },
    });
    const headFadeByScroll = () =>
      gsap.fromTo('.sx-hero__head', { opacity: 1 }, {
        opacity: 0, ease: 'none', immediateRender: false,
        scrollTrigger: { trigger: '#hero', start: 'top top', end: '34% top', scrub: 0.5 },
      });

    /* ---------- the Atlas card gets picked. The first scroll turns the wheel until Atlas is at the front; the card
       lifts out of the hand (the hero's words clear as it rises to them), its video slides up out of the card, and in
       mid-air it turns and comes apart into its layers, each one named in plain words, from the bottom up: the idea,
       the script, your take, the edit (its cut clips close up), the words, the post. The layers fold back together
       and it glides over to wait right above the editor's preview, at the preview's size. Then the editor rises round
       it and the card drops into the preview from the front, and lands as the preview, moving with the page at the
       hand-over so nothing jumps. The editor's title bar has no text while the card is over it: the file name, the
       status and the length appear as the card clears them, so the card never covers words (the take arriving is
       what opens the file).
       Scrubbed both ways: scrolling back runs it backwards, and every scroll position is a finished frame. ---------- */
    const editorEl = document.querySelector<HTMLElement>('#mq-atlas .ae');
    const editor = editorEl ? mountEditor(editorEl, { gsap, ScrollTrigger, mode: 'loop', reduced: reduce }) : null;
    const flyer = document.querySelector<HTMLElement>('.wc-flyer');
    const flyEl = flyer?.querySelector<HTMLElement>('[data-reel]') ?? null;
    const mon = document.querySelector<HTMLElement>('#mq-atlas [data-ae-mon]');
    const atlasCard = wheel?.card('atlas') ?? null;
    const atlasFace = atlasCard?.querySelector<HTMLElement>('.wc__face') ?? null;
    const cardReelEl = atlasCard?.querySelector<HTMLElement>('[data-reel]') ?? null;
    if (cardReelEl) {
      cardReel = createReel(cardReelEl, gsap);
      if (cardWant) cardReel.play();
    }
    if (wheel && flyer && flyEl && mon && atlasCard && atlasFace) {
      const flyReel = createReel(flyEl, gsap);
      const edReel = editor?.reel ?? null;

      // the first scroll turns Atlas round to the front, from wherever the wheel happens to be
      ScrollTrigger.create({
        trigger: '#hero', start: 'top+=4 top', end: 'bottom top',
        onEnter: () => {
          wheel.hold(true);
          wheel.goTo('atlas', 0.9);
        },
        onLeaveBack: () => wheel.hold(false),
      });

      // Layout that only changes on a resize, read once per refresh instead of every frame (so the scrub forces no
      // layout of its own): the card's size, the preview's place on the page, its size and corners, the strip of the
      // editor window above the preview, how far above the preview the title bar's text ends, the flyer's size, and
      // where the hero's buttons end.
      // The flyer is laid out at the biggest size it is ever shown at and only scaled down, so it stays sharp.
      const heroCtas = document.querySelector<HTMLElement>('.sx-ctas');
      const edStatus = editorEl?.querySelector<HTMLElement>('.ae-status') ?? null;
      const L = { cw: 1, ch: 1, mx: 0, my: 0, mw: 1, mh: 1, mr: 0, band: 0, tbB: 12, fw: 1, fh: 1, hs: 1, phone: false, dock: 0, pm: 0.7, ctaB: 0, gap0: 1, sx: 0 };
      let flightST: ScrollTrigger | undefined;
      const measure = () => {
        const vh = window.innerHeight;
        L.cw = atlasCard.offsetWidth || 1;
        L.ch = atlasCard.offsetHeight || 1;
        const r = mon.getBoundingClientRect();
        L.sx = window.scrollX;
        L.mx = r.left + r.width / 2 + L.sx;
        L.my = r.top + r.height / 2 + window.scrollY;
        L.mw = r.width || 1;
        L.mh = r.height || 1;
        L.mr = parseFloat(getComputedStyle(mon).borderTopLeftRadius) || r.width * 0.071;
        // the editor window's top bar and the gap under it (the editor's top edge reaches the waiting card this far
        // before the preview does), and how far above the preview the title bar's text ends (its tallest piece is
        // the status pill): the text shows only once the card's top edge has passed below that line
        L.band = editorEl ? Math.max(0, r.top - editorEl.getBoundingClientRect().top) : 0;
        // (from the bar's middle and the pill's layout height: the pill itself is moved by --tb, so its rect is not used)
        const bar = edStatus?.parentElement?.getBoundingClientRect();
        L.tbB = edStatus && bar ? Math.max(4, r.top - ((bar.top + bar.bottom) / 2 + edStatus.offsetHeight / 2)) : 12;
        L.phone = window.innerWidth < 768;
        // Phones: held at 55% of the screen's width at least, below 62% of its height (2026-11-09 phone audit, V-07: at
        // 0.96 of a phone's 156px card it hung at 38% of the width in an empty black screen, its layers' names about
        // 10px; atlas-reel.css sizes the names for this, about 13px)
        L.hs = L.phone
          ? Math.min(Math.max((window.innerWidth * 0.55) / L.cw, Math.min(0.96, (vh * 0.56) / L.ch)), (vh * 0.62) / L.ch)
          : Math.min(1.04, (vh * 0.56) / L.ch);
        L.fw = Math.ceil(Math.max(L.cw * L.hs, L.mw, L.cw) * 1.02);
        L.fh = (L.fw * 16) / 9;
        // where the card waits for the editor (this far above the middle, its top clear of the nav), and the share of
        // the scroll at which the editor's top edge reaches the waiting card: from there it only settles in
        L.dock = Math.max(0, Math.min(vh * 0.15, vh / 2 - L.mh / 2 - 76));
        // (up to 0.9: since the flight is longer, 2026-11-08, it is 0.76 at 1440x900 and 0.87 at 2560x1440, and the old
        // 0.8 cap set the card settling in before the editor reached it; the editor's rise is the same scroll as ever,
        // so the extra length all goes to the card's time in the air)
        if (flightST) {
          const len = Math.max(1, flightST.end - flightST.start);
          L.pm = Math.min(0.9, Math.max(0.5, 1 - (L.mh + L.band - L.dock) / len));
        }
        // the hero's buttons: their bottom edge on the page without the drift, and how far below it the card rests
        // (--top is read here, not once: short screens set a smaller one)
        if (heroHead && heroCtas && wheelEl) {
          const drift = Number(gsap.getProperty(heroHead, 'y')) || 0;
          const wheelTop = parseFloat(getComputedStyle(wheelEl).getPropertyValue('--top')) || 70;
          L.ctaB = heroCtas.getBoundingClientRect().bottom + window.scrollY - drift;
          L.gap0 = Math.max(24, wheelEl.getBoundingClientRect().top + window.scrollY + wheelTop - 16 - L.ctaB);
        }
        flyer.style.setProperty('--fw', `${L.fw}px`);
        flyer.style.setProperty('--fk', (L.fw / L.cw).toFixed(4));
        // where the card sits in the hand, for the lift (wheel.faceOf in place())
        wheel.remeasure();
      };
      measure();

      const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
      const seg = (p: number, a: number, b: number) => clamp01((p - a) / (b - a));
      const easeIO = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
      const easeSine = (t: number) => -(Math.cos(Math.PI * t) - 1) / 2;
      const smooth = (t: number) => t * t * (3 - 2 * t);
      // The beats, as shares of the card's time in the air (u, 0 to 1). The air time ends where the editor's top
      // edge reaches the waiting card (L.pm of the scroll); the rest of the scroll is the editor rising round it.
      // The split comes early (Yanis: "the splitting should happen faster"): lift, slide-out, split and strip moved up
      // together (they were A 0.27, M 0.13 to 0.37, X 0.3 to 0.6, C 0.5 to 0.66). Measured (2026-11-07, scrollY): fully
      // apart at 300 instead of 480 at 1440x900, 240 instead of 420 at 390x844; all six names up from about 250 to 586
      // on desktop (was 420 to 586). The fold, the glide and the landing are where they were. Tried A 0.2, X 0.2 to
      // 0.42 first: only about 120px sooner. X0 stays at A: the lift's turn and the split's sideways move would fight.
      // (Those scroll positions predate the longer flight, 2026-11-08: see airU below.)
      const A = 0.15; // lifted out of the hand and held in the middle
      const M0 = 0.04, M1 = 0.2; // the video slides up out of the card; the card's name and frame fade
      const X0 = 0.15, X1 = 0.34; // it turns and comes apart; the names arrive from the bottom layer up
      const C0 = 0.29, C1 = 0.42; // the edit layer's film strip: the cut clips close up, right after its name arrives
      const F0 = 0.7, F1 = 0.9; // it folds back together
      const G0 = 0.76; // from here it glides over to wait above the editor's preview, at the preview's size and corners
      // The card's way out of the hand and its way into the editor take 1.5 times their old scroll, the held state in
      // between (every name showing, u 0.316 to F0) its old scroll (Yanis, 2026-11-08: the card placement's in and out
      // animations "50% longer"; stretched evenly, the hold grew to about 460px of scroll that only moved a label's
      // highlight, full-site check). airU maps the share of the scroll in the air (v) onto the beats above, which are
      // untouched; home.css .sx-hero__flight adds the scroll this needs (0.31 of the old air time). The landing, the
      // editor rising round the card, is the page's own scroll and stays as long as it was
      const OUT_U = 0.316; // the sixth name is in
      const OUT_W = 1.5 * OUT_U, HOLD_W = F0 - OUT_U, IN_W = 1.5 * (1 - F0);
      const V1 = OUT_W / (OUT_W + HOLD_W + IN_W), V2 = (OUT_W + HOLD_W) / (OUT_W + HOLD_W + IN_W);
      const airU = (v: number) =>
        v < V1 ? (v / V1) * OUT_U : v < V2 ? OUT_U + ((v - V1) / (V2 - V1)) * HOLD_W : F0 + ((v - V2) / (1 - V2)) * (1 - F0);

      let state: 'rest' | 'flying' | 'landed' = 'rest';
      // what the wheel's own sum (wheel.faceOf) leaves out of where the face really is (a hover lift still easing on
      // it, say): read once per flight, as it starts, and added through the lift
      let faceDX = 0;
      let faceDY = 0;
      // the playhead of whichever copy of the reel is showing, so the next one picks up on the same frame
      const shownTime = () => (state === 'rest' ? cardReel?.time() : state === 'flying' ? flyReel.time() : edReel?.time()) ?? 0;
      // the scrub calls place() every frame: each style is written only when its value changed
      const was: Record<string, string> = {};
      const put = (el: HTMLElement, key: string, prop: string, v: string) => {
        if (was[key] === v) return;
        was[key] = v;
        el.style.setProperty(prop, v);
      };
      // the hero's words (opacity 0 also hides them, so the invisible buttons cannot be clicked)
      const headTo = (o: number) => {
        if (!heroHead) return;
        put(heroHead, 'ho', 'opacity', o.toFixed(3));
        put(heroHead, 'hv', 'visibility', o < 0.005 ? 'hidden' : '');
      };
      // the editor's title bar text (file name, status, length; atlas-editor.css reads --tb): none while the card is
      // in the air or over it, all of it once the card has landed
      const tbTo = (v: number) => {
        if (editorEl) put(editorEl, 'tb', '--tb', v.toFixed(3));
      };
      // The flying copy's look: words, music, post and colour (the editor drives the same four on its copy). When the
      // card leaves the editor mid-edit (scrolling back up while the editor shows the raw take), the flying copy first
      // takes the editor's look as it is, then finishes itself on the way up, so the hand-back shows no jump from the
      // grey raw take to the finished video. The punch-ins come back with the words, like a cut in the video.
      const LOOK = ['--ow', '--om', '--op', '--grade'];
      // where the editor keeps each of them on its copy: the colour on the graded picture and the music pill's on the
      // pill (each on the smallest element that reads it, so a frame of the edit restyles one element, not the whole
      // reel: atlas-editor.ts), the words and the post, switched in one step, on the reel itself
      const lookOn = (src: HTMLElement, k: string) =>
        (k === '--grade' ? src.querySelector<HTMLElement>('.ar-pic') : k === '--om' ? src.querySelector<HTMLElement>('.ar-music') : null) ?? src;
      let lookTween: gsap.core.Tween | null = null;
      const finishLook = () => {
        lookTween?.kill();
        lookTween = null;
        gsap.set(flyEl, { '--ow': 1, '--om': 1, '--op': 1, '--grade': 1 });
        flyEl.classList.remove('is-raw');
      };
      // `fin`: the editor was showing the real finished video (atlas-final.ts), which carries its own small captions
      // and none of the reel's hook card, music pill or post chips. The flying copy then starts bare (the graded
      // take, nothing on it) and its words, music and post come in on the way up, as from the raw take: the video
      // cannot fly (one decoder, no video in the card or the flyer), and a reel that kept its full look jumped from
      // the video's frame to a hook card and captions the moment the card lifted
      const takeLook = (src: HTMLElement, fin = false) => {
        const from: Record<string, number> = {};
        let done = !fin;
        for (const k of LOOK) {
          const v = fin ? (k === '--grade' ? 1 : 0) : parseFloat(lookOn(src, k).style.getPropertyValue(k));
          from[k] = Number.isFinite(v) ? v : 1;
          if (from[k] < 0.999) done = false;
        }
        // (bare also means wide, no punch-in, like the video's own framing: is-raw holds the camera still)
        const raw = fin || src.classList.contains('is-raw');
        if (done && !raw) return finishLook();
        lookTween?.kill();
        gsap.set(flyEl, from);
        flyEl.classList.toggle('is-raw', raw);
        // the colour and the music pill come up; the words and the post come back in one step with the punch-ins
        // (switched, like the editor's own: a half faded hook over the face read as a ghost)
        lookTween = gsap.to(flyEl, {
          '--om': 1, '--grade': 1, duration: 0.7, delay: 0.2, ease: 'power2.inOut',
          onStart: () => {
            flyEl.classList.remove('is-raw');
            gsap.set(flyEl, { '--ow': 1, '--op': 1 });
          },
        });
      };
      const place = (p: number) => {
        if (p <= 0.001) {
          if (state !== 'rest') {
            const t = shownTime();
            if (state === 'landed') editor?.stop();
            flyReel.pause();
            state = 'rest';
            cardHeld = false;
            finishLook();
            flyer.classList.remove('is-on');
            atlasCard.classList.remove('is-flying');
            mon.classList.remove('is-waiting');
            if (cardReel) {
              cardReel.seek(t);
              if (cardWant) cardReel.play();
            }
          }
          headTo(1);
          tbTo(0);
          wheel.setSelection(0, 'atlas');
          return;
        }
        if (p >= 0.999) {
          if (state !== 'landed') {
            const t = shownTime();
            flyReel.pause();
            cardReel?.pause();
            cardHeld = true;
            state = 'landed';
            finishLook();
            flyer.classList.remove('is-on');
            atlasCard.classList.add('is-flying');
            mon.classList.remove('is-waiting');
            edReel?.seek(t);
            editor?.seek0();
            editor?.start();
          }
          headTo(0);
          tbTo(1);
          wheel.setSelection(1, 'atlas');
          return;
        }
        if (state !== 'flying') {
          const fr = atlasFace.getBoundingClientRect();
          const f0 = wheel.faceOf('atlas', L.sx, pageY);
          faceDX = fr.left + fr.width / 2 - f0.x;
          faceDY = fr.top + fr.height / 2 - f0.y;
          const t = shownTime();
          const fromEditor = state === 'landed';
          const finWas = fromEditor && (editor?.finShowing() ?? false);
          if (fromEditor) editor?.stop();
          cardReel?.pause();
          cardHeld = true;
          state = 'flying';
          flyReel.seek(t);
          if (fromEditor && edReel) takeLook(edReel.el, finWas);
          else finishLook();
          flyReel.play();
          atlasCard.classList.add('is-flying');
          mon.classList.add('is-waiting');
          flyer.classList.add('is-on');
        }
        const { cw, ch, fw, fh } = L;
        // the screen's size from resize events (ww/wh above): on phones every read of innerWidth/innerHeight runs
        // a layout first, and this runs inside GSAP's tick after other tweens have written styles. The scroll is the
        // page's own for this frame (pageY: the scroll event's, or the one smoothTo() just set; ScrollTrigger's cached
        // value is a frame behind the page during the scripted "See our work" scroll, and the card must sit exactly
        // on the preview at the hand-over). The horizontal scroll is always 0 here; it comes from the last measure()
        const vw = ww;
        const vh = wh;
        const scrollNow = pageY;
        // the card's time in the air (1 from the moment the editor's top edge reaches it)
        const u = airU(Math.min(1, p / L.pm));
        // how far apart the layers are: in on the way up, out on the way down (0 flat, 1 every name showing)
        const xa = easeSine(seg(u, X0, X1)) * (1 - easeSine(seg(u, F0, F1)));
        // held a little above the middle; while it is apart it moves left, so the stack and its names sit centred.
        // It gets there by half way open, before the long names arrive
        // (phones: a little further since the card is held larger and the names sized up, V-07)
        const hx = vw / 2 - (L.phone ? vw * 0.245 : Math.min(96, vw * 0.066)) * easeSine(Math.min(1, xa / 0.55));
        const hy = vh * (L.phone ? 0.45 : 0.47);
        // where it lands: the editor's preview (from the layout read at refresh, moved by the scroll)
        const ex = L.mx - L.sx;
        const ey = L.my - scrollNow;
        const es = L.mw / cw;
        const yd = vh / 2 - L.dock; // where it waits for the editor, right above the preview's final place
        let x: number, y: number, s: number;
        let rot = 0, rx = 0, ry = 0;
        let tb = 0; // the editor's title bar text, 0 until the card has cleared it
        if (u < A) {
          // picked: it pops up out of the hand, the rest of the hand drops back, and it rises to the middle.
          // Where the card sits in the hand (it moves with the page, and may still be turning): the wheel's own sum
          // for its transform, from layout read on refresh, no read here (the face's getBoundingClientRect, read
          // every frame, cost a forced layout per frame; audit P3)
          const ang = wheel.angleOf('atlas');
          const rad = (ang * Math.PI) / 180;
          const f = wheel.faceOf('atlas', L.sx, scrollNow);
          // (its scale as the face's box gives it: the turned box's width over the card's, unrounded over rounded)
          const sc = (Math.abs(Math.cos(rad)) * f.w + Math.abs(Math.sin(rad)) * f.h) / (Math.abs(Math.cos(rad)) * cw + Math.abs(Math.sin(rad)) * ch) || 1;
          const sx = f.x + faceDX;
          const sy = f.y + faceDY;
          const k = u / A;
          const e = easeIO(k);
          const base = sy - 34 * easeOut(Math.min(1, k / 0.35));
          x = sx + (hx - sx) * e;
          y = base + (hy - base) * e;
          s = sc + (L.hs - sc) * e;
          rot = ang * (1 - e);
          rx = Math.sin(e * Math.PI) * -10;
          wheel.setSelection(easeOut(Math.min(1, k / 0.6)), 'atlas');
          // the hero's words clear as the card comes up to them: gone the moment its top edge reaches the buttons
          const ctaBottom = L.ctaB - scrollNow + (heroHead ? Number(gsap.getProperty(heroHead, 'y')) || 0 : 0);
          headTo(smooth(clamp01((y - (s * ch) / 2 - ctaBottom) / L.gap0)));
        } else if (u < G0) {
          // held while it comes apart
          x = hx;
          y = hy;
          s = L.hs;
          headTo(0);
          wheel.setSelection(1, 'atlas');
        } else if (u < 1) {
          // folded, it glides over to wait right above the editor's preview, at the preview's size, flat again
          const e = easeIO(seg(u, G0, 1));
          x = hx + (ex - hx) * e;
          y = hy + (yd - hy) * e;
          s = L.hs + (es - L.hs) * e;
          ry = Math.sin(e * Math.PI) * -10;
          rx = Math.sin(e * Math.PI) * 3;
          headTo(0);
          wheel.setSelection(1, 'atlas');
        } else {
          // the editor rises round it and the card drops into the preview from the front: a blend from where it waits
          // to the preview, so it starts from rest and ends moving with the page (no jump at the hand-over).
          // Tried first: the card behind the window, seen through the preview, with the strip above the preview
          // clipped away. It read as one card cut in two by the title bar (its top above the window, its bottom in
          // the preview), so it stays in front, and the title bar has no text under it instead.
          // d: how far above its place the card still is. The text fades in once the card's top edge is below the
          // text's bottom edge (L.tbB above the preview), so the card never covers it
          const w = smooth(seg(p, L.pm, 1));
          x = ex;
          y = yd + (ey - yd) * w;
          s = es;
          const d = Math.max(0, ey - y);
          tb = smooth(clamp01((L.tbB - d) / L.tbB));
          headTo(0);
          wheel.setSelection(1, 'atlas');
        }
        const m = easeIO(seg(u, M0, M1));
        // a slow turn while it hangs apart, gone again once it is flat
        const tz = (seg(u, X0, F1) - 0.5) * 9 * xa;
        // the film strip's cut clips close up (and open again only if you scroll back)
        const cut = easeIO(seg(u, C0, C1));
        // the corners: the card's, then the preview's before it settles in (in the flyer's own, unscaled pixels)
        const land = easeIO(seg(u, 0.84, 1));
        const r0 = fw * 0.09;
        const r1 = (L.mr * fw) / L.mw;
        put(flyer, 'tf', 'transform', `translate3d(${(x - fw / 2).toFixed(1)}px, ${(y - fh / 2).toFixed(1)}px, 0) perspective(1100px) rotate(${rot.toFixed(2)}deg) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale(${((s * cw) / fw).toFixed(4)})`);
        tbTo(tb);
        put(flyer, 'm', '--m', m.toFixed(3));
        put(flyer, 'fr', '--fr', `${(r0 + (r1 - r0) * land).toFixed(2)}px`);
        put(flyer, 'xa', '--xa', xa.toFixed(4));
        put(flyEl, 'em', '--m', m.toFixed(3));
        put(flyEl, 'x', '--x', xa.toFixed(4));
        put(flyEl, 'tz', '--tz', `${tz.toFixed(2)}deg`);
        put(flyEl, 'cut', '--cut', cut.toFixed(3));
      };
      const flight = { p: 0 };
      const flightTween = gsap.to(flight, {
        p: 1, ease: 'none',
        scrollTrigger: {
          // no invalidateOnRefresh: nothing in this tween comes from layout, and invalidating reverted it to 0 for
          // the length of every refresh, so onRefresh ran place(0) on a landed card: the editor loop restarted and
          // the reels were re-seeded on every resize (and every refresh another section asks for)
          trigger: '#hero', start: 'top+=40 top', endTrigger: mon, end: 'center center', scrub: 0.35,
          onRefresh: () => {
            measure();
            place(flight.p);
          },
        },
        onUpdate: () => place(flight.p),
      });
      flightST = flightTween.scrollTrigger;
      measure(); // again, now that the trigger knows where it ends (L.pm)
      // "See our work" ends in the middle of the dissected card, every layer named (Yanis, 2026-11-08: "it should just
      // scroll to this here where you dissect the video"; it went all the way to the landed card). Halfway between the
      // sixth name and the fold, from the same shares as the flight itself (airU), so it follows the hold wherever the
      // layout puts it
      if (flightST) {
        const st = flightST;
        workY = () => st.start + ((V1 + V2) / 2) * L.pm * (st.end - st.start);
      }
      // between a resize and ScrollTrigger's own refresh (debounced, it runs onRefresh above), keep the flyer on the
      // new layout: once per frame at most, since a drag-resize fires many events a frame. Also covers a phone's
      // address bar showing or hiding, which can change the height without a refresh
      let resizeRaf = 0;
      window.addEventListener('resize', () => {
        if (resizeRaf) return;
        resizeRaf = requestAnimationFrame(() => {
          resizeRaf = 0;
          measure();
          place(flight.p);
        });
      });
    } else {
      headFadeByScroll();
      editor?.start();
    }

    /* ---------- big names rise letter by letter ---------- */
    document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
      const chars = splitChars(el);
      gsap.from(chars, {
        yPercent: 110, opacity: 0, duration: 1.1, ease: 'power4.out', stagger: 0.035,
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
      });
    });

    /* ---------- generic reveals ---------- */
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.from(el, {
        y: 36, opacity: 0, duration: 1, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true },
      });
    });

    // The tiles' CSS transition (transform and box-shadow, there for hover) restarted on every frame GSAP wrote during
    // the reveal, so the reveal was eased twice and trailed behind. It is off from the moment GSAP sets the reveal's
    // start state until that tile's own part of the reveal ends, then the stylesheet's transition is back for hover
    // (Yanis, 2026-11-07, Q4). The stagger object's onComplete runs once per tile.
    const tiles = gsap.utils.toArray<HTMLElement>('.h-tile');
    tiles.forEach((t) => (t.style.transition = 'none'));
    gsap.from(tiles, {
      y: 70, opacity: 0, rotate: (i: number) => (i % 2 ? 5 : -5), duration: 0.9, ease: 'back.out(1.4)',
      stagger: {
        each: 0.07,
        onComplete(this: gsap.core.Tween) {
          const tile = this.targets()[0] as HTMLElement;
          tile.style.transition = '';
          // GSAP's end state (translate(0px, 0px), opacity 1) is the stylesheet's own, but left inline it beat the
          // .h-tile:hover transform, so the hover lift never ran (only its shadow did). Cleared, nothing moves and
          // the hover rule applies again; a tile already under the pointer lifts in through the restored transition.
          gsap.set(tile, { clearProps: 'transform,opacity' });
        },
      },
      scrollTrigger: { trigger: '.h-tiles', start: 'top 85%', once: true },
    });

    /* ---------- act III: the flow line draws itself ---------- */
    const flow = document.querySelector<HTMLElement>('.bp-flow');
    const path = document.querySelector<SVGPathElement>('.bp-flow__path');
    if (flow && path) {
      const draw = () => {
        const box = flow.getBoundingClientRect();
        const nodes = Array.from(flow.querySelectorAll<HTMLElement>('.bp-step__node')).map((n) => {
          const r = n.getBoundingClientRect();
          return [r.left - box.left + r.width / 2, r.top - box.top + r.height / 2];
        });
        if (nodes.length < 2) return;
        let d = `M ${nodes[0][0]} ${nodes[0][1]}`;
        for (let i = 1; i < nodes.length; i++) {
          const [x0, y0] = nodes[i - 1];
          const [x1, y1] = nodes[i];
          const mx = (x0 + x1) / 2;
          d += ` C ${mx} ${y0 - 40}, ${mx} ${y1 + 40}, ${x1} ${y1}`;
        }
        path.setAttribute('d', d);
        const len = path.getTotalLength();
        path.style.strokeDasharray = `${len}`;
        return len;
      };
      const len = draw() ?? 0;
      gsap.fromTo(path, { strokeDashoffset: len }, {
        strokeDashoffset: 0, ease: 'none',
        scrollTrigger: { trigger: flow, start: 'top 80%', end: 'bottom 55%', scrub: 0.6, invalidateOnRefresh: true, onRefresh: () => draw() },
      });
    }

    /* ---------- act III: Kleus's figures and the cut follow the scroll ----------
       One scrubbed trigger each sets the variable its drawing reads (home.css .bp-kx and .bp-cut): the path's source,
       arrows and lessons, the check's ring, score and notes, the commit grid inking in week by week, and the cut
       drawing out from its bubble. Scroll back and they undo; nothing plays on its own. (Under reduced motion this
       never runs and the CSS keeps every drawing finished.) */
    const scrubVar = (el: HTMLElement | null, name: string, start: string, end: string, onP?: (p: number) => void) => {
      if (!el) return;
      const set = (p: number) => {
        el.style.setProperty(name, p.toFixed(4));
        onP?.(p);
      };
      ScrollTrigger.create({ trigger: el, start, end, scrub: true, onUpdate: (self) => set(self.progress), onRefresh: (self) => set(self.progress) });
    };
    const kx = document.querySelector<HTMLElement>('[data-kx]');
    if (kx) {
      scrubVar(kx.querySelector<HTMLElement>('[data-kx-fig="path"]'), '--kp', 'top 88%', 'bottom 62%');
      // the score counts up with its ring (the ring fills in the first 62% of the figure's scroll, home.css)
      const score = kx.querySelector<HTMLElement>('[data-kx-score]');
      let shown = -1;
      scrubVar(kx.querySelector<HTMLElement>('[data-kx-fig="check"]'), '--kc', 'top 88%', 'bottom 70%', (p) => {
        const n = Math.round(93 * Math.min(1, p * 1.6));
        if (score && n !== shown) {
          shown = n;
          score.textContent = String(n);
        }
      });
      // the grid inks in whole weeks at a time: a cut through a column left a sliver of its squares at the edge
      const commits = kx.querySelector<HTMLElement>('[data-kx-fig="commits"]');
      const weeks = Number(commits?.querySelector<HTMLElement>('.cg__grid')?.style.getPropertyValue('--weeks')) || 18;
      scrubVar(commits, '--kgp', 'top 88%', 'bottom 72%', (p) => commits?.style.setProperty('--kg', (Math.ceil(p * weeks - 0.001) / weeks).toFixed(4)));
    }
    scrubVar(document.querySelector<HTMLElement>('[data-bp-cut]'), '--cut', 'top 92%', 'top 50%');

    /* ---------- counters ---------- */
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      const dec = Number(el.dataset.decimals ?? 0);
      const pre = el.dataset.prefix ?? '';
      const suf = el.dataset.suffix ?? '';
      const obj = { v: 0 };
      // The first frame writes textContent as before; after that the same text node takes the new string, and only
      // when the string changed. textContent on every frame removed and inserted a text node each time (560 times
      // a pass in blueprint) and re-laid out the line even on frames where the number had not moved.
      let node: Text | null = null;
      gsap.to(obj, {
        v: target, duration: 1.8, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true },
        onUpdate: () => {
          const s = pre + obj.v.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suf;
          if (node && node.parentNode === el) {
            if (node.data !== s) node.data = s;
          } else {
            el.textContent = s;
            node = el.firstChild instanceof Text ? el.firstChild : null;
          }
        },
      });
    });

    /* ---------- finale: the headline lands with the shooting star's emblem, every pass (finale-flight.ts, mounted with
       the circle wipe above; it used to land once, here) ---------- */

    window.addEventListener('load', () => ScrollTrigger.refresh());
  })();
</script>
