<!-- ================================================================
     HERO: LOAD ANIMATION + SCROLL SCATTER
     ================================================================ -->
<script>
  (async () => {
    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      const label = document.getElementById('hero-label') as HTMLElement;
      const h1 = document.getElementById('hero-h1') as HTMLElement;
      const body = document.getElementById('hero-body') as HTMLElement;
      const scrollInd = document.getElementById('hero-scroll-ind') as HTMLElement;

      // Split h1 into chars.
      // In dev mode Astro adds data attributes to <br> tags, so normalize first.
      const allChars: HTMLElement[] = [];
      const normalized = h1.innerHTML.replace(/<br\b[^>]*>/gi, '[[BR]]');
      const lines = normalized.split('[[BR]]');
      h1.innerHTML = lines.map(line =>
        line.split('').map(ch => {
          const c = ch === ' ' ? '&nbsp;' : ch;
          return `<span class="char">${c}</span>`;
        }).join('')
      ).join('<br>');
      h1.querySelectorAll<HTMLElement>('.char').forEach(c => {
        c.dataset.rx = String((Math.random() - 0.5) * 120);
        c.dataset.ry = String((Math.random() - 0.5) * 80 - 20);
        c.dataset.rr = String((Math.random() - 0.5) * 30);
        allChars.push(c);
      });

      // Set hidden
      gsap.set([label, body, scrollInd], { opacity: 0 });
      gsap.set(allChars, { opacity: 0, y: 10 });

      // Load entrance animation
      const loadTl = gsap.timeline({ delay: 0.15 });
      loadTl
        .to(label, { opacity: 1, duration: 0.4, ease: 'power2.out' }, 0)
        .to(allChars, { opacity: 1, y: 0, duration: 0.6, stagger: 0.018, ease: 'power3.out' }, 0.2)
        .to(body, { opacity: 1, duration: 0.5, ease: 'power2.out' }, 0.65)
        .to(scrollInd, { opacity: 1, duration: 0.4 }, 0.95);

      // Scroll scatter
      ScrollTrigger.create({
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 0.6,
        onUpdate: (self) => {
          const p = self.progress;
          const ease = Math.pow(p, 1.4);
          allChars.forEach(c => {
            gsap.set(c, {
              x: parseFloat(c.dataset.rx!) * ease,
              y: parseFloat(c.dataset.ry!) * ease,
              rotation: parseFloat(c.dataset.rr!) * ease,
              opacity: Math.max(0, 1 - ease * 1.8),
            });
          });
          if (label) label.style.opacity = String(Math.max(0, 1 - p * 3));
          if (body) body.style.opacity = String(Math.max(0, 1 - p * 2.5));
          if (scrollInd) scrollInd.style.opacity = String(Math.max(0, 1 - p * 6));
          const glow = document.querySelector<HTMLElement>('.hero-glow');
          if (glow) glow.style.transform = `translate(-50%,-50%) scale(${1 + p * 1.2})`;
        }
      });

    } catch {
      const h1 = document.getElementById('hero-h1');
      if (h1) { h1.style.opacity = '1'; h1.style.transform = 'none'; }
    }
  })();
</script>

<!-- ================================================================
     STUDENTVENTURE SCROLL ANIMATION
     3 separate step labels (no .call text-swap = fully reversible).
     CTA enters from bottom, scatters on exit like hero headline.
     ================================================================ -->
<script>
  (async () => {
    const isMobile = window.innerWidth < 768;
    if (isMobile) return;

    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      // ---- initial states ----
      // Entry is visible at top. Label + h2 stay as persistent header.
      gsap.set('#sv-entry', { opacity: 1 });
      gsap.set('#sv-entry-desc', { opacity: 1 });
      gsap.set(['#sv-label-1','#sv-label-2','#sv-label-3'], { opacity: 0, y: 20 });
      gsap.set('#sv-cta', { zIndex: 20 });

      // CTA children: hidden, enter from below
      gsap.set('.sv-cta-stat', { opacity: 0, y: 40 });
      gsap.set('.sv-cta-text', { opacity: 0, y: 24 });
      gsap.set('.sv-cta-punch', { opacity: 0, y: 20 });
      gsap.set('.sv-cta-sub', { opacity: 0, y: 16 });

      // Split CTA stat into chars for scatter effect
      const ctaStat = document.querySelector('.sv-cta-stat') as HTMLElement;
      const ctaChars: HTMLElement[] = [];
      if (ctaStat) {
        const txt = ctaStat.textContent || '';
        ctaStat.innerHTML = txt.split('').map(ch =>
          `<span class="sv-cta-char">${ch}</span>`
        ).join('');
        ctaStat.querySelectorAll<HTMLElement>('.sv-cta-char').forEach(c => {
          c.dataset.rx = String((Math.random() - 0.5) * 180);
          c.dataset.ry = String((Math.random() - 0.5) * 120 - 30);
          c.dataset.rr = String((Math.random() - 0.5) * 45);
          ctaChars.push(c);
        });
      }

      // Clear pre-populated mobile fallback text for desktop animation
      const userMsgEl = document.getElementById('sv-msg-user');
      if (userMsgEl) userMsgEl.textContent = '';

      const USER_TEXT = 'I need an entry-level marketing specialist who can write copy and run basic analytics';
      let typingInterval: ReturnType<typeof setInterval> | null = null;
      function typeMessage(el: HTMLElement, text: string, ms: number) {
        if (typingInterval) clearInterval(typingInterval);
        el.textContent = '';
        const words = text.split(' ');
        let i = 0;
        typingInterval = setInterval(() => {
          if (i >= words.length) { clearInterval(typingInterval!); return; }
          el.textContent = words.slice(0, i + 1).join(' ');
          i++;
        }, ms / words.length);
      }

      // ---- master timeline ----
      const m = gsap.timeline({
        scrollTrigger: {
          trigger: '#sv-scroll-space',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1,
        }
      });

      // -- Description fades out (0 to 3%), label 1 appears below header (3 to 6%) --
      // Entry label + h2 STAY visible throughout (they ARE the persistent header).
      m.to('#sv-entry-desc', { opacity: 0, y: -8, duration: 0.03 }, 0);
      m.to('#sv-label-1', { opacity: 1, y: 0, duration: 0.04 }, 0.03);

      // -- Phase 1: Chat (6 to 30%) --
      m.to('#sv-msg-user', { opacity: 1, y: 0, duration: 0.04 }, 0.07)
       .call(() => typeMessage(document.getElementById('sv-msg-user')!, USER_TEXT, 800), undefined, 0.07)
       .call(() => { document.getElementById('sv-msg-user')!.textContent = USER_TEXT; }, undefined, 0.14)
       .to('#sv-msg-ai1', { opacity: 1, y: 0, duration: 0.04 }, 0.16)
       .to('#sv-chips-1', { opacity: 1, y: 0, duration: 0.04 }, 0.19)
       .call(() => { document.getElementById('sv-chip-pt')?.classList.add('selected'); }, undefined, 0.23)
       .to('#sv-msg-ai2', { opacity: 1, y: 0, duration: 0.04 }, 0.25)
       .to('#sv-chips-2', { opacity: 1, y: 0, duration: 0.04 }, 0.28)
       .call(() => { document.getElementById('sv-chip-s2')?.classList.add('selected'); }, undefined, 0.30);

      // -- Label 1 out, label 2 in (31%) --
      m.to('#sv-label-1', { opacity: 0, y: -12, duration: 0.03 }, 0.31);
      m.to('#sv-label-2', { opacity: 1, y: 0, duration: 0.04 }, 0.33);

      // -- Phase 2: Brief (31 to 54%) --
      m.to('#sv-chat', { opacity: 0.35, duration: 0.06 }, 0.31)
       .to('#sv-brief', { opacity: 1, x: 0, duration: 0.06 }, 0.33)
       .to('#sv-bc-title', { opacity: 1, duration: 0.04 }, 0.37)
       .to('#sv-bc-overview', { opacity: 1, duration: 0.04 }, 0.40)
       .to('#sv-bc-signals-label', { opacity: 1, duration: 0.03 }, 0.42)
       .to('#sv-bs1', { opacity: 1, y: 0, duration: 0.04 }, 0.44)
       .to('#sv-bs2', { opacity: 1, y: 0, duration: 0.04 }, 0.46)
       .to('#sv-bs3', { opacity: 1, y: 0, duration: 0.04 }, 0.48)
       .to('#sv-bs4', { opacity: 1, y: 0, duration: 0.04 }, 0.50)
       .to('#sv-bs1-cal', { opacity: 1, duration: 0.04 }, 0.52);

      // -- Label 2 out, label 3 in (55%) --
      m.to('#sv-label-2', { opacity: 0, y: -12, duration: 0.03 }, 0.55);
      m.to('#sv-label-3', { opacity: 1, y: 0, duration: 0.04 }, 0.57);

      // -- Phase 3: Results (55 to 68%) --
      m.to(['#sv-chat','#sv-brief'], { opacity: 0, duration: 0.04 }, 0.56)
       .to('#sv-results', { opacity: 1, zIndex: 5, pointerEvents: 'auto', duration: 0.03 }, 0.58)
       .to('#sv-card-1', { opacity: 1, y: 0, duration: 0.04 }, 0.60)
       .call(() => { document.getElementById('sv-match-count')!.textContent = 'Showing 1 of 40 matches'; }, undefined, 0.60)
       .to('#sv-card-2', { opacity: 1, y: 0, duration: 0.04 }, 0.63)
       .call(() => { document.getElementById('sv-match-count')!.textContent = 'Showing 2 of 40 matches'; }, undefined, 0.63)
       .to('#sv-card-3', { opacity: 0.4, y: 0, duration: 0.03 }, 0.65)
       .call(() => {
         document.getElementById('sv-card-1')?.classList.add('highlighted');
         document.getElementById('sv-chip-tooltip-wrap')?.classList.add('show-tooltip');
       }, undefined, 0.66)
       .to('#sv-tooltip-1', { opacity: 1, y: 0, duration: 0.03 }, 0.67);

      // -- Label 3 out, results fade, entry header fades for CTA (68 to 72%) --
      m.to('#sv-label-3', { opacity: 0, duration: 0.03 }, 0.68);
      m.to('#sv-entry-label', { opacity: 0, duration: 0.03 }, 0.68);
      m.to('#sv-entry-title', { opacity: 0, duration: 0.03 }, 0.68);
      m.to('#sv-results', { opacity: 0.08, duration: 0.04 }, 0.68);

      // -- Phase 4: CTA rises from bottom (72 to 80%) --
      m.to('#sv-cta', { opacity: 1, duration: 0.01 }, 0.72);
      m.to('.sv-cta-stat', { opacity: 1, y: 0, duration: 0.05 }, 0.72);
      m.to('.sv-cta-text', { opacity: 1, y: 0, duration: 0.04 }, 0.76);
      m.to('.sv-cta-punch', { opacity: 1, y: 0, duration: 0.04 }, 0.78);
      m.to('.sv-cta-sub', { opacity: 1, y: 0, duration: 0.03 }, 0.80);

      // -- CTA scatter: chars fly out (86 to 100%). No hold after. --
      if (ctaChars.length) {
        m.to('.sv-cta-text', { opacity: 0, y: -16, duration: 0.04 }, 0.86);
        m.to('.sv-cta-punch', { opacity: 0, y: -16, duration: 0.04 }, 0.87);
        m.to('.sv-cta-sub', { opacity: 0, duration: 0.03 }, 0.88);
        ctaChars.forEach((c, i) => {
          m.to(c, {
            x: parseFloat(c.dataset.rx!),
            y: parseFloat(c.dataset.ry!),
            rotation: parseFloat(c.dataset.rr!),
            opacity: 0,
            duration: 0.12,
          }, 0.86 + i * 0.005);
        });
      }

    } catch { /* silent */ }
  })();
</script>

<!-- ================================================================
     PROCESS: PINNED SCROLL ANIMATION
     Section pins to viewport center. Line draws 1-2-3 while pinned.
     When animation completes, scroll continues normally.
     ================================================================ -->
<script>
  (async () => {
    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      const isMobile = window.innerWidth < 768;

      if (isMobile) {
        // On mobile: staggered reveal with scale + glow. No pinning.
        // Don't set initial opacity via GSAP — CSS !important handles visibility.
        // Instead, use CSS classes for a nice entrance.
        const steps = document.querySelectorAll<HTMLElement>('.process-step');
        steps.forEach((step, i) => {
          step.style.opacity = '0';
          step.style.transform = 'translateY(40px)';
          step.style.transition = 'none';
        });
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              const el = e.target as HTMLElement;
              const idx = Array.from(steps).indexOf(el);
              setTimeout(() => {
                el.style.transition = 'opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1)';
                el.style.opacity = '1';
                el.style.transform = 'translateY(0)';
                el.classList.add('lit');
              }, idx * 150);
              observer.unobserve(el);
            }
          });
        }, { threshold: 0.15 });
        steps.forEach(s => observer.observe(s));
        return;
      }

      // Initial hidden state for steps + SVG elements
      gsap.set(['#proc-step-1','#proc-step-2','#proc-step-3'], { opacity: 0, y: 32 });
      gsap.set('#proc-line-fill', { strokeDashoffset: 666 });
      gsap.set(['#proc-ring-1','#proc-dot-1','#proc-ring-2','#proc-dot-2','#proc-ring-3','#proc-dot-3'], { opacity: 0 });

      // Desktop: pin the section while animation plays
      // The section pins when its center hits the viewport center.
      // Pin lasts for 1600px of scroll, giving the animation room to breathe.
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#process',
          start: 'center center',
          end: '+=1600',
          pin: true,
          anticipatePin: 1,
          scrub: 1,
        }
      });

      // Step 1 rises + node 1 lights (0 to 20%)
      tl.to('#proc-step-1', { opacity: 1, y: 0, duration: 0.18, ease: 'power3.out' }, 0);
      tl.to(['#proc-ring-1','#proc-dot-1'], { opacity: 1, duration: 0.1 }, 0.1);
      tl.call(() => document.querySelector<HTMLElement>('#proc-step-1')?.classList.add('lit'), undefined, 0.14);

      // Line draws 1 to 2 (20 to 45%)
      tl.to('#proc-line-fill', { strokeDashoffset: 333, duration: 0.22, ease: 'power2.inOut' }, 0.2);

      // Step 2 rises + node 2 lights (38 to 55%)
      tl.to('#proc-step-2', { opacity: 1, y: 0, duration: 0.18, ease: 'power3.out' }, 0.38);
      tl.to(['#proc-ring-2','#proc-dot-2'], { opacity: 1, duration: 0.1 }, 0.44);
      tl.call(() => document.querySelector<HTMLElement>('#proc-step-2')?.classList.add('lit'), undefined, 0.48);

      // Line draws 2 to 3 (52 to 76%)
      tl.to('#proc-line-fill', { strokeDashoffset: 0, duration: 0.22, ease: 'power2.inOut' }, 0.52);

      // Step 3 rises + node 3 lights (68 to 85%)
      tl.to('#proc-step-3', { opacity: 1, y: 0, duration: 0.18, ease: 'power3.out' }, 0.68);
      tl.to(['#proc-ring-3','#proc-dot-3'], { opacity: 1, duration: 0.1 }, 0.76);
      tl.call(() => document.querySelector<HTMLElement>('#proc-step-3')?.classList.add('lit'), undefined, 0.80);

      // Hold: all steps visible, nothing changes (85 to 100%)
      tl.to({}, { duration: 0.15 }, 0.85);

    } catch {
      ['#proc-step-1','#proc-step-2','#proc-step-3'].forEach(s => {
        const el = document.querySelector<HTMLElement>(s);
        if (el) { el.style.opacity = '1'; el.style.transform = 'none'; }
      });
    }
  })();
</script>

