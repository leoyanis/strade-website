<!-- ================================================================
     MOBILE SCROLL ANIMATIONS
     Staggered reveals + subtle parallax for mobile.
     ================================================================ -->
<script>
  (async () => {
    const isMobile = window.innerWidth < 768;
    if (!isMobile) return;

    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      // ---- SV section: staggered card reveals ----
      const svCards = document.querySelectorAll<HTMLElement>('.sv-card');
      svCards.forEach((card, i) => {
        gsap.from(card, {
          y: 30, opacity: 0, duration: 0.6,
          delay: i * 0.1,
          ease: 'power3.out',
          scrollTrigger: { trigger: card, start: 'top 85%' }
        });
      });

      // ---- SV CTA phase: dramatic entrance ----
      const svCta = document.getElementById('sv-cta');
      if (svCta) {
        gsap.from('.sv-cta-stat', {
          scale: 0.8, opacity: 0, y: 30, duration: 0.8, ease: 'power3.out',
          scrollTrigger: { trigger: svCta, start: 'top 80%' }
        });
        gsap.from('.sv-cta-text', {
          y: 20, opacity: 0, duration: 0.6, delay: 0.2, ease: 'power3.out',
          scrollTrigger: { trigger: svCta, start: 'top 80%' }
        });
        gsap.from('.sv-cta-punch', {
          y: 16, opacity: 0, duration: 0.6, delay: 0.35, ease: 'power3.out',
          scrollTrigger: { trigger: svCta, start: 'top 80%' }
        });
      }

      // ---- YC mockup: subtle parallax float ----
      const ycImg = document.querySelector<HTMLElement>('.yc-mockup-img');
      if (ycImg) {
        gsap.to(ycImg, {
          yPercent: -8, ease: 'none',
          scrollTrigger: { trigger: '#youcook', start: 'top bottom', end: 'bottom top', scrub: true }
        });
      }

      // ---- Noteless image: slight scale on scroll ----
      const nlImg = document.querySelector<HTMLElement>('.nl-mockup-img');
      if (nlImg) {
        gsap.from(nlImg, {
          scale: 0.92, opacity: 0.5, duration: 0.8, ease: 'power2.out',
          scrollTrigger: { trigger: nlImg, start: 'top 85%' }
        });
      }

      // ---- CTA section: animate heading ----
      const ctaH2 = document.querySelector<HTMLElement>('#cta h2');
      if (ctaH2) {
        gsap.from(ctaH2, {
          y: 24, opacity: 0, duration: 0.7, ease: 'power3.out',
          scrollTrigger: { trigger: '#cta', start: 'top 75%' }
        });
      }

    } catch { /* silent */ }
  })();
</script>
