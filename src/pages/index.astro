---
import Base from '../layouts/Base.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "Strade",
      "url": "https://strade.tech",
      "logo": "https://strade.tech/images/logo.svg",
      "description": "AI consulting and custom development for startups.",
      "founder": { "@type": "Person", "name": "Yanis Schweizer" },
    },
    {
      "@type": "Person",
      "name": "Yanis Schweizer",
      "jobTitle": "Founder and AI Consultant",
      "worksFor": { "@type": "Organization", "name": "Strade" },
      "knowsLanguage": ["en", "de", "es", "ro"],
    },
    {
      "@type": "Service",
      "name": "AI Consulting",
      "provider": { "@type": "Organization", "name": "Strade" },
      "description": "Knowledge transfer and AI architecture consulting for startup teams.",
    },
    {
      "@type": "Service",
      "name": "Custom AI Development",
      "provider": { "@type": "Organization", "name": "Strade" },
      "description": "Custom mobile, web, and AI-powered applications for startups.",
    },
  ]
};
