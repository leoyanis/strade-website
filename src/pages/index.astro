---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { getProject, SIDE_QUESTS, STATS } from '../data/work';
import FreeAct from '../components/free-act/FreeAct.astro';
import HoleWorld from '../components/free-act/HoleWorld.astro';
import WheelCard from '../components/home/WheelCard.astro';
import type { WheelItem } from '../components/home/wheel-types';
import Editor from '../components/atlas/Editor.astro';
import AtlasReel from '../components/atlas/AtlasReel.astro';
import EpSection from '../components/ep/EpSection.astro';
import VaulttHome from '../components/vaultt/VaulttHome.astro';
import VaulttWorld from '../components/vaultt/VaulttWorld.astro';
import WestWorld from '../components/west/WestWorld.astro';
import WantedPoster from '../components/west/WantedPoster.astro';
import KlCommits from '../components/case/kleus/KlCommits.astro';
import { VAULTT_NUMBERS } from '../data/work';
import '../styles/home.css';
import '../styles/home-wheel.css';
// after home.css: the west act overrides a few of its shared rules (.theme's clip-path among them)
import '../styles/west.css';
// what an act far from the screen gives up (.is-offstage, set in the script below; the global performance pass's)
import '../styles/offstage.css';

const atlas = getProject('atlas')!;
const vaultt = getProject('vaultt')!;
const ep = getProject('endless-pursuit')!;

// The hero's wheel: every project, in ring order. Atlas starts at the front; the cards next to it are the
// strongest, and the ring gets quieter towards its back (slightly mixed, so it never reads as a ranking).
const wheel: WheelItem[] = [
  { slug: 'atlas', name: 'Atlas', kind: 'Client · Idea to posted video', bg: '#0B0B0D', ink: '#fff', accent: '#A795FF', art: { t: 'reel' } },
  { slug: 'endless-pursuit', name: 'Endless Pursuit', kind: 'Client · iOS + Android', bg: '#0A0A0A', ink: '#F4F4F2', accent: '#E3C588', glow: 'rgba(227, 197, 136, 0.3)', art: { t: 'phone', src: '/images/cards/ep.webp' } },
  { slug: 'fallow', name: 'Fallow', kind: 'Our product · iOS', bg: '#0F0C08', ink: '#EDE3D1', accent: '#C9A24A', glow: 'rgba(201, 162, 74, 0.32)', art: { t: 'phone', src: '/images/cards/fallow.webp' } },
  { slug: 'youcook', name: 'YouCook', kind: 'Our product · App Store', bg: '#FFF1EC', ink: '#2B1E1A', accent: '#F26B4F', light: true, art: { t: 'video-contain', src: '/images/cards/youcook.mp4', poster: '/images/cards/youcook.webp' } },
  { slug: 'outreach-crm', name: 'Outreach & CRM', kind: 'Client · white label', bg: '#F7F5F3', ink: '#1F1B18', accent: '#5B5BF6', light: true, art: { t: 'crm' } },
  { slug: 'playivity', name: 'Playivity', kind: 'Client · design system', bg: '#F2F9E6', ink: '#1D2340', accent: '#85D015', light: true, glow: 'rgba(133, 208, 21, 0.25)', art: { t: 'phone', src: '/images/cards/playivity.webp', pal: '/images/work/playivity/poses/movi-celebrate.webp' } },
  { slug: 'noteless', name: 'Noteless', kind: 'Our product · AI notes', bg: '#0E0E10', ink: '#E8E8ED', accent: '#D4A574', glow: 'rgba(212, 165, 116, 0.22)', art: { t: 'window', src: '/images/cards/noteless.webp' } },
  { slug: 'sequenced', name: 'Sequenced', kind: 'Client · AI design tool', bg: '#050505', ink: '#fff', accent: '#FFBD59', glow: 'rgba(255, 189, 89, 0.22)', art: { t: 'stories' } },
  { slug: 'kleus', name: 'Kleus', kind: 'Our product · learning', bg: '#F0EEE9', ink: '#1B1A18', accent: '#B87A1F', light: true, art: { t: 'contain', src: '/images/cards/kleus.webp' } },
  { slug: 'vaultt', name: 'Vaultt', kind: `Client · ${VAULTT_NUMBERS.builders.display} builders`, bg: '#0C2748', ink: '#E8F1FF', accent: '#6FA8FF', glow: 'rgba(111, 168, 255, 0.38)', art: { t: 'phone', src: '/images/cards/vaultt-network.webp' } },
];
// the card that gets picked and flies into the Atlas editor (its name and colours, for the flying copy)
const atlasItem = wheel.find((w) => w.slug === 'atlas')!;

const stat = (i: number) => STATS[i];
const fmt = (n: number, d: number) => n.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });

// Dark or light ink for a coloured tile.
const inkFor = (hex: string) => {
  const n = parseInt(hex.replace('#', ''), 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? '#111' : '#fff';
};

// Act II decoration: stark palette, scattered at random (seeded so it's stable
// between builds). Stripes are spaced far apart so they never stack into bands.
let seed = 23;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const PALETTE = ['#FF4F1F', '#1F3BFF', '#C8F23A', '#111111', '#FFB000'];
const stripes: { top: number; h: number; color: string; twin: boolean }[] = [];
for (let y = 3, last = -1; y < 97; y += 10 + rand() * 13) {
  let ci = Math.floor(rand() * PALETTE.length);
  if (ci === last) ci = (ci + 2) % PALETTE.length;
  last = ci;
  stripes.push({ top: y, h: [5, 9, 16, 30, 52][Math.floor(rand() * 5)], color: PALETTE[ci], twin: rand() < 0.3 });
}
const shapes = [
  { kind: 'ring', x: 4, y: 16, size: 150, color: '#111111', speed: 0.6 },
  { kind: 'dot', x: 86, y: 12, size: 74, color: '#C8F23A', speed: 1.4 },
  { kind: 'half', x: 80, y: 70, size: 170, color: '#1F3BFF', speed: 0.9 },
  { kind: 'squiggle', x: 3, y: 74, size: 200, color: '#FF4F1F', speed: 1.2 },
  { kind: 'plus', x: 46, y: 6, size: 40, color: '#FFB000', speed: 1.8 },
  { kind: 'tri', x: 93, y: 44, size: 56, color: '#111111', speed: 0.7 },
  { kind: 'dot', x: 24, y: 90, size: 24, color: '#1F3BFF', speed: 2 },
  { kind: 'ring', x: 62, y: 88, size: 60, color: '#FF4F1F', speed: 1.5 },
];

// Kleus's figures under its drawing (Yanis, 2026-11-08: "get some more elements over" from the case study): the path
// from the case study's KlPath, its six real lessons for the Napoleon documentary, fanned on a loose arc in a
// 1100 x 250 stage (KlPath's geometry, smaller)
const KL_LESSONS = [
  { t: 'How revolutionaries crowned an emperor', m: 5 },
  { t: 'Brumaire: the coup that ended the Republic', m: 6 },
  { t: 'The Concordat: peace with the Church', m: 5 },
  { t: 'The Civil Code that outlived him', m: 6 },
  { t: 'Austerlitz and the empire at its peak', m: 5 },
  { t: 'Moscow, 1812: where it broke', m: 6 },
];
const KL_JIT: [number, number, number][] = [[3, 4, -1.5], [-4, -3, 1.2], [2, 5, -0.6], [-3, -2, 1.8], [4, 3, -1.1], [-2, 6, 0.9]];
const klFan = KL_LESSONS.map((l, i) => {
  const W = 150, GAP = 26, CX = 550, TOP = 96, ARC = 22, TILT = 4;
  const u = (i / (KL_LESSONS.length - 1)) * 2 - 1;
  const x = CX - (KL_LESSONS.length * W + (KL_LESSONS.length - 1) * GAP) / 2 + i * (W + GAP) + W / 2 + KL_JIT[i][0];
  const y = TOP + ARC * (1 - u * u) + KL_JIT[i][1];
  const Y = y - 8;
  return {
    ...l, x, y, r: -TILT * u + KL_JIT[i][2],
    d: `M${CX} 0 C ${CX} ${(Y * 0.55).toFixed(1)}, ${x.toFixed(1)} ${(Y * 0.4).toFixed(1)}, ${x.toFixed(1)} ${Y.toFixed(1)}`,
    head: `M${(x - 4.5).toFixed(1)} ${(Y - 6).toFixed(1)} L${x.toFixed(1)} ${Y.toFixed(1)} L${(x + 4.5).toFixed(1)} ${(Y - 6).toFixed(1)}`,
  };
});
// the check's ring: the case study's KlCheck result, 93 out of 100
const KL_CIRC = 2 * Math.PI * 60;

---

<Base
  title="Strade: we build apps, automations and AI tools"
  description="Strade builds apps, automations and AI tools for founders and teams. The studio behind Atlas, Vaultt and Kleus."
  locale="en"
  path="/"
  pageType="profile"
  bare
  navBands={{
    // each side quest tile takes the tone of its own colour: on a phone a tile spans the screen under the links,
    // and the cream act's light pool laid a pale fog over the saturated blue ones
    '.h-tile': 'auto',
    // the blueprint's black callout labels: a link over one takes light ink without a pool, as over any dark card
    // (the light pool washed the label out under Results, 2026-11-08 scripted nav sweep)
    '.bp-callout': 'dark',
    // the method's black "02" node: on a phone it passes right under the logo
    '.bp-step--me .bp-step__node': 'dark',
    // the white mock card with Kleus's screen on the blueprint: its own white, flat (no pool, a knockout in white).
    // Untagged, the knockout wore the blueprint's paper on it, a beige outline round each word at 1440 (10140 to 10270)
    // and a faint square round the logo on a phone (11331, 2026-11-09 re-check)
    '.bp-drawing__img': { tone: 'light', surface: 'auto' },
    // the quests' "Open the case study" pills (Atlas's pale one, Endless Pursuit's gold one), light by their own
    // colour: a link over one takes dark ink, as over any light card (on a phone they pass right under the links,
    // and Endless Pursuit's under Results when scrolling back up on a laptop)
    '.h-a-btn--main': 'auto',
    '.ep3__btn--gold': 'auto',
    // Atlas's editor screen plays its reel (dark sheets, the video, a pale post card): no one tone holds for it, so
    // it only makes the pool stronger while it passes under the links, as any picture does
    '.ae-mon': 'busy',
    // the poster's photo: sepia, light and dark in places, a picture like any other
    '.w-poster__photo': 'busy',
    // Endless Pursuit's phone and the sound pill under it: dark objects with a busy screen, so a link over them takes
    // light ink on a dark pool, also while the stripes wipe tells the nav the rest is plain night or cream (a page
    // band wins over what a script paints under the bands, Base.astro toneIn). Tagged 'busy' instead, they kept the
    // cream's tone, and the light pool blurred the dark pill on the cream in reduced motion (2026-11-09 re-check).
    '.ep3-phone': 'dark',
    '.ep3-sound': 'dark',
    // the phone's body layer carries its drop shadow (90px of blur, 60px down): tagged so the nav keeps every knockout
    // off the shade it casts on the stripes act's cream (Base.astro castReach), where the paper-coloured patch showed as a
    // paler square (390, reduced motion, 2026-11-09 re-check)
    '.ep3-ly--body': 'dark',
    // and the darkest of that shade, its first 35px under the phone (about half black there, by its two shadows): dark
    // and plain, so a link over it takes light ink where the shade has turned the cream grey. With the knockout gone
    // from the shade, the links' dark ink sat on it barely readable (390, reduced motion, 6500 to 6530, WebKit). Phones
    // only: at 1440 the links pass beside the phone, where its shade is pale, and "Resu" took pale light ink on it
    // (reduced motion, 6368 to 6411, 2026-11-09 re-check); there the knockout takes the shade's own grey (koShade)
    '.ep3-phone .ep3-ly--body': { tone: 'dark', inset: '100% 0 -35px 0', surface: 'plain', media: '(max-width: 600px)' },
    // the west act's label and headline, light type on the dusk sky (a plain surface, #act-west: no pool there), get
    // the pool back while they pass under a corner. The label is inline, so its box is its words; the headline is a
    // block as wide as the container, and its words reach under the links only up to 1245px wide (from 1250 its first
    // line breaks shorter: measured at 1190 to 1279 and 1440, Chromium); wider, its box alone laid a pool behind
    // Results with nothing under it
    '#act-west .bp-fig': 'busy',
    '#about-h': { tone: 'busy', media: '(max-width: 1245px)' },
    // the finale's night once its stage lets go and the white headline scrolls up under the links: a flat dark surface
    // in the night's own near-black (measured under the corners: 3 3 4 at 1440, 7 7 7 on a phone), so the links wear a
    // knockout in it and the headline's letters are cut away round them (Base.astro keeps that knockout under the
    // circle's whole-nav force, whose tone it shares). Before, the night was only forced dark: white letters ran
    // straight through the white links (2026-11-09 re-check). The section's top reaches the nav line only after the
    // circle has opened, so it never overrides the wipe's paint.
    '#finale': { tone: 'dark', surface: '#050506' },
    // and its white Book a call pill, light by its own colour: once the corner follows the flat night (no pool), a link
    // passing over the pill takes dark ink and a white knockout on it, as over any white card (the dark pool had turned
    // it chrome grey, 390 at 18350 to 18450, 2026-11-09 final check)
    '#finale .sx-btn--primary': { tone: 'light', surface: 'auto' },
    // and the black disc of its arrow, inside the pill: as the pill's white, Results' knockout laid a white blob on it
    // (390 at 18140, WebKit, 2026-11-09 final check)
    '#finale .sx-btn--primary .sx-btn__go': { tone: 'dark', surface: 'auto' },
  }}
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&family=Geist:wght@400;500;600;700;800&display=swap" />
  <!-- Vaultt's section speaks vaultt.io's type, Bricolage Grotesque and Hanken Grotesk: self-hosted subsets defined in
       src/components/vaultt/vaultt-home.css (scripts/fonts/subset-vaultt.sh), no Google stylesheet for them -->
  <!-- intro gate: hide the hero's parts until the motion takes over (failsafe if JS never arrives). hero-flight stays:
       the Atlas card's flight will run, so the hero carries its extra stretch of sky (home.css .sx-hero__flight), set
       before the first paint so nothing below moves -->
  <script slot="head" is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && location.search.indexOf('still') < 0) {
      var hh = document.documentElement;
      hh.classList.add('hero-intro', 'hero-flight');
      setTimeout(function () { hh.classList.remove('hero-intro'); }, 4500);
    }
  </script>

  <!-- Fixed theme layers that wipe in act by act -->
  <div class="themes" aria-hidden="true">
    <!-- the work's worlds (src/scripts/backdrops.ts): Atlas's near-black under the act, then Vaultt's navy and network,
         then Endless Pursuit's black; each fades in over the one before when the scroll passes its switch point -->
    <div class="theme theme--atlas"></div>
    <VaulttWorld />
    <div class="theme theme--ep"><div class="theme--ep__grain"></div></div>
    <div class="theme theme--stripes">
      <div class="wipe"><div class="wipe__inner">
      <div class="stripe-field">
        <div class="stripe-rot">
          {stripes.map((st) => (
            <span class="stripe" style={`top:${st.top.toFixed(2)}%;height:${st.h}px;background:${st.color}`}>
              {st.twin && <i style={`background:${st.color}`}></i>}
            </span>
          ))}
        </div>
      </div>
      {shapes.map((sh) => (
        <span class={`shape shape--${sh.kind}`} data-speed={sh.speed} style={`left:${sh.x}vw;top:${sh.y}vh;width:${sh.size}px;color:${sh.color}`}>
          {sh.kind === 'squiggle' && (
            <svg viewBox="0 0 200 40" fill="none"><path d="M2 20 Q 14 2 27 20 T 52 20 T 77 20 T 102 20 T 127 20 T 152 20 T 177 20 T 198 20" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg>
          )}
        </span>
      ))}
      </div></div>
    </div>
    <!-- the free stuff act's black hole (src/components/free-act): it rises as a dome over the stripes, and the
         blueprint's sheet paints over it with its own edge and scan line -->
    <HoleWorld />
    <!-- the blueprint's paper below its leading part (which is in the act itself, .bp-paper): a transform pair, the
         wipe moving down to its edge and the paper inside moving back up, so the paper never moves (home.css) -->
    <div class="theme theme--blueprint">
      <div class="bp-wipe"><div class="bp-wipe__in bp-sheet">
        <span class="bp-mark bp-mark--tl"></span><span class="bp-mark bp-mark--tr"></span>
        <span class="bp-mark bp-mark--bl"></span><span class="bp-mark bp-mark--br"></span>
      </div></div>
    </div>
    <!-- act IV: the Wild West town at sundown behind #about (src/components/west) -->
    <WestWorld />
    <!-- the finale: a faint tint over the hero's own sky, which is lifted above the other worlds during its wipe -->
    <div class="theme theme--finale"></div>
  </div>

  <!-- ============================================================
       ACT I: ASTRAL
       ============================================================ -->
  <section id="hero" class="act sx-hero" data-sky-live aria-labelledby="hero-h1">
    <div class="sx-hero__head">
      <div class="sx-emblem" aria-hidden="true">
        <img class="sx-emblem__still" src="/images/space/emblem-star.svg" alt="" width="380" height="484" />
        <canvas class="sx-emblem__dust"></canvas>
      </div>
      <h1 class="sx-word" id="hero-h1">
        <span class="sr-only">Strade, a studio that builds apps, automations and AI tools</span>
        <img src="/images/space/strade-wordmark.png" alt="" width="748" height="72" />
      </h1>
      <p class="sx-kicker" data-hero-in>Product studio</p>
      <p class="sx-line" data-hero-in>We build apps, automations and AI tools. Fixed price, no matter how ambitious.</p>
      <div class="sx-ctas" data-hero-in>
        <a class="sx-btn sx-btn--primary" href={SITE.booking} target="_blank" rel="noopener">
          Book a call
          <span class="sx-btn__go" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
        <a class="sx-btn sx-btn--ghost" href="#mq-atlas" data-scroll-to="#mq-atlas">See our work</a>
      </div>
    </div>

    <!-- every project on one slowly turning wheel: drag it or scroll sideways to turn it, click a card to open it -->
    <div class="wc-wheel" tabindex="0" role="group" aria-label="Our work: every project on a slowly turning wheel of cards. Drag it, or scroll sideways, to turn it.">
      {wheel.map((item, i) => <WheelCard item={item} index={i} total={wheel.length} />)}
    </div>
    <!-- the extra sky the Atlas card flies through: its ways out of the hand and into the editor take 1.5 times their old
         scroll (home.css .sx-hero__flight, airU in the script; none without the flight) -->
    <div class="sx-hero__flight" aria-hidden="true"></div>
    <!-- the picked card: a copy of the Atlas card that lifts out of the wheel, comes apart into its layers in
         mid-air (each one named) and folds back together as it lands in the Atlas editor below -->
    <div class="wc-flyer" aria-hidden="true" style={`--bg:${atlasItem.bg};--ink:${atlasItem.ink};--accent:${atlasItem.accent}`}>
      <span class="wc-flyer__pool"></span>
      <span class="wc__face wc-flyer__face"><span class="wc__art"></span><span class="wc__head"><strong>{atlasItem.name}</strong><small>{atlasItem.kind}</small></span></span>
      <AtlasReel variant="flyer" />
    </div>
  </section>

  <!-- ============================================================
       THE WORK, straight after the wheel: Atlas, Vaultt, Endless Pursuit, then the rest
       ============================================================ -->
  <!-- Atlas, in Atlas's own world (getatlas.site): near-black, a faint grid, a purple glow where the AI works.
       It rises out of the space sky at its top edge while the card lands; its bottom edge is plain near-black. -->
  <section id="mq-atlas" class="act act--astral h-mq h-mq--atlas" style={`--accent:${atlas.accent}`} aria-labelledby="mq-atlas-h">
    <div class="h-aw" aria-hidden="true">
      <div class="h-aw__base" id="mq-atlas-world"></div>
      <div class="h-aw__grid"></div>
      <div class="h-aw__glow"></div>
    </div>
    <div class="container h-mq__grid h-mq__grid--atlas">
      <div class="h-mq__text">
        <span class="h-a-live" data-reveal><i></i>Live since 1 October 2026</span>
        <h2 class="h-mq__name h-split" id="mq-atlas-h" data-split>Atlas</h2>
        <p class="h-a-tag" data-reveal>You film it. Atlas does the <em>rest</em>.</p>
        <p class="h-mq__line" data-reveal>It finds an idea that worked, writes it in your voice, edits the video, posts it and shows you what did well.</p>
        <div class="h-a-ctas" data-reveal>
          <a class="h-a-btn h-a-btn--main" href="/work/atlas">Open the case study<span class="h-a-btn__go" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span></a>
          <a class="h-a-link" href={atlas.links?.[0]?.href ?? 'https://getatlas.site'} target="_blank" rel="noopener">getatlas.site <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="h-a-editor">
        <Editor variant="compact" />
        <!-- the editor's loop will run (JS on, motion allowed, no ?still): reserve the room its playback bar hangs into
             under the window on narrow screens (home.css .h-a-editor.has-bar). Set here, before the first paint, so
             nothing below moves once the bar appears; without the loop there is no bar and no extra gap -->
        <script is:inline>
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !new URLSearchParams(location.search).has('still')) document.currentScript.parentElement.classList.add('has-bar');
        </script>
      </div>
    </div>
  </section>

  <!-- Vaultt, on vaultt.io's navy with its living network (src/components/vaultt). Its world is a fixed theme layer
       (VaulttWorld) that fades in over Atlas's as the intro arrives and never moves; in front of it a stage holds
       still while the scroll moves the intro and the three numbers through it, one at a time (switches scrubbed by
       the scroll, nothing timed), and the jobs leave with the page. -->
  <VaulttHome />

  <!-- ============================================================
       CASE STUDY 03 · ENDLESS PURSUIT: a working slice of the app, built from
       its own design system (src/components/ep). Its background is a fixed
       theme layer (.theme--ep), so the stripes below wipe over it on one
       clean diagonal.
       ============================================================ -->
  <EpSection slug={ep.slug} />

  <!-- ============================================================
       ACT II: STRIPES
       ============================================================ -->
  <!-- for the nav only, never shown: the plain night a script tells it it paints (Base.astro nav.toneAt): Endless
       Pursuit's black beyond the stripes wipe's edge and the inside of the free act's rising dome, where the nav
       shows no pool and no knockout (data-nav-surface="plain") -->
  <i id="nav-paint-night" data-nav-theme="dark" data-nav-surface="plain" hidden aria-hidden="true"></i>
  <section id="act-stripes" class="act act--stripes" data-nav-theme="light" data-nav-surface="#F4F0E7">
    <div class="container h-side" id="side">
      <div class="h-side__head">
        <h2 class="knock h-split" data-split>Side quests.</h2>
        <p class="knock" data-reveal>Client builds, design systems and my own apps. Shipped, shipping or in the forge right now.</p>
      </div>
      <div class="h-tiles">
        {SIDE_QUESTS.map((p) => (
          <a href={`/work/${p.slug}`} class="h-tile" style={`--tile:${p.accent};--ink:${inkFor(p.accent)}`}>
            <span class="h-tile__status">{p.status}</span>
            <span class="h-tile__arrow" aria-hidden="true">↗</span>
            <h3>{p.name}</h3>
            <p>{p.summary}</p>
          </a>
        ))}
      </div>
      <div class="h-tiles__all"><a href="/work">See all results →</a></div>
    </div>
  </section>

  <!-- ============================================================
       FREE STUFF: the free Claude skills on a tilted band, over a black hole
       (src/components/free-act). The playful stripes give way to a hard sci-fi world.
       ============================================================ -->
  <FreeAct />

  <!-- ============================================================
       ACT III: BLUEPRINT
       ============================================================ -->
