---
import Base from '../layouts/Base.astro';
---

<Base
  title="Lost quest | Yanis Schweizer"
  description="This page does not exist."
  locale="en"
  path="/404"
  noindex
>
  <!-- the night sky behind it is the site's (Base.astro); its own falling dot grid went with the old atmosphere -->
  <section class="not-found">
    <div class="container nf-content">
      <span class="label">404 · quest not found</span>
      <h1>This page wandered off.</h1>
      <p style="color:var(--text-secondary);margin:16px 0 32px">
        Probably a link from an old post. Here's where the good stuff lives:
      </p>
      <div class="hero-actions" style="justify-content:flex-start">
        <a href="/" class="btn-primary hero-cta">Go home &#8594;</a>
        <a href="/free" class="btn-ghost">Free stuff</a>
        <a href="/work" class="btn-ghost">Results</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    min-height: 100vh; display: flex; align-items: center;
    position: relative; overflow: hidden;
  }
  .nf-content { position: relative; z-index: 1; }
  .nf-content h1 { margin: 12px 0; }
  /* Phones (2026-11-09): centred in the first screen below the 64px fixed nav, not in the whole screen (it sat 32px
     high at 390x844): the section's top 64px stand under the nav, and it is one small viewport tall (svh, the height
     with Safari's toolbars showing, where 100vh is the height with them hidden; 100vh above where svh is unknown). */
  @media (max-width: 767px) {
    .not-found { min-height: 100svh; padding-top: 64px; }
  }
</style>
