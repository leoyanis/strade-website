---
// Headlight lab: the Star Car's star headlight as a rendered model, to look at and tune before it goes on
// the landing page. Private: no site nav or footer, not indexed.
// Scene + UI: components/vision/ssi/hl-lab.ts. Parametric headlight + slider schema: hl-model.ts.
import Base from '../../../layouts/Base.astro';
---

<Base
  title="Headlight lab | Strade Space Industries"
  description="Private lab for the Star Car's star headlight."
  path="/vision/ssi/headlight"
  bare
  noindex
  hideFooter
>
  <meta slot="head" name="theme-color" content="#000000" />
  <div class="hl">
    <canvas id="hl-canvas" class="hl-canvas" aria-label="The Star Car's star headlight, rendered"></canvas>
    <div class="hl-views" role="group" aria-label="Camera views">
      <button type="button" data-view="front">Front</button>
      <button type="button" data-view="3/4">3/4</button>
      <button type="button" data-view="side">Side</button>
      <button type="button" data-view="star">Star close-up</button>
    </div>
    <div id="hl-gui" class="hl-gui"></div>
    <div id="hl-toast" class="hl-toast" aria-live="polite"></div>
  </div>
</Base>

<script>
  import { initHeadlightLab } from '../../../components/vision/ssi/hl-lab';
  initHeadlightLab();
</script>

<style is:global>
  body.is-bare { background: #000; }
  body.is-bare #site-nav, body.is-bare #scroll-progress { display: none; }
  .hl { position: fixed; inset: 0; background: #000; overflow: hidden; }
  .hl-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
  .hl-views { position: absolute; left: 16px; bottom: 16px; display: flex; gap: 6px; flex-wrap: wrap; z-index: 2; }
  .hl-views button {
    font: 500 12px/1 ui-monospace, Menlo, monospace; letter-spacing: 0.04em; color: #eee;
    background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 9px 12px; border-radius: 999px; cursor: pointer;
  }
  .hl-views button:hover { background: rgba(255, 255, 255, 0.14); }
  .hl-gui { position: absolute; top: 0; right: 0; max-height: 100%; overflow-y: auto; z-index: 3; }
  .hl-gui .lil-gui.root { --width: 300px; --font-size: 11.5px; --widget-height: 22px; }
  @media (max-width: 700px) {
    .hl-gui { left: 0; right: 0; top: auto; bottom: 0; max-height: 46%; }
    .hl-gui .lil-gui.root { --width: 100%; width: 100%; }
    .hl-views { bottom: auto; top: 12px; }
  }
  .hl-toast {
    position: absolute; left: 50%; top: 18px; transform: translateX(-50%); z-index: 4;
    font: 500 12px ui-monospace, Menlo, monospace; color: #000; background: #eee; padding: 8px 12px; border-radius: 6px;
    opacity: 0; transition: opacity 0.2s; pointer-events: none;
  }
  .hl-toast.on { opacity: 1; }
</style>
