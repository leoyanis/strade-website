---
// Star Car SC-1: the car's own page. A 3D presentation of the car; visitors watch it, they don't drive the camera.
// Private like /vision/ssi: no site nav or footer, not indexed. White and greys; cyan only on a few tiny details in the model.
import Base from '../../../layouts/Base.astro';

const FONTS =
  'https://fonts.googleapis.com/css2?family=Michroma&family=IBM+Plex+Mono:wght@400;500&display=swap';

---

<Base
  title="Star Car SC-1 | Strade Space Industries"
  description="Star Car SC-1 by Strade Space Industries."
  path="/vision/ssi/star-car"
  pageType="article"
  bare
  noindex
  hideFooter
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href={FONTS} />
  <meta slot="head" name="theme-color" content="#000000" />

  <div class="scp" id="scp">
    <section class="scp-hero" aria-label="Star Car SC-1">
      <header class="scp-top scp-wrap">
        <a href="/vision/ssi" class="scp-back"><span class="arw">←</span> Strade Space Industries</a>
        <h1 class="scp-h1">Star Car</h1>
      </header>

      <div class="scp-stage" id="scp-stage">
        <canvas class="scp-canvas" role="img" aria-label="The Star Car SC-1, a full-body lunar car with a closed cabin and star headlights."></canvas>
        <p class="scp-fallback" hidden>The Star Car needs WebGL, which is switched off in this browser.</p>
        <noscript><p class="scp-fallback">The Star Car needs JavaScript.</p></noscript>
      </div>
    </section>
  </div>
</Base>

<script>
  import { initStarCar } from '../../../components/vision/ssi/star-car-motion';
  initStarCar();
</script>

<style is:global>
  body.is-bare { background: #000; }
  body.is-bare #site-nav, body.is-bare #scroll-progress { display: none; }

  .scp {
    --bg: #000;
    --ink: #f5f5f5;
    --soft: rgba(245, 245, 245, 0.66);
    --faint: rgba(245, 245, 245, 0.4);
    --line: rgba(245, 245, 245, 0.1);
    --sans: 'Michroma', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    --out: cubic-bezier(0.16, 1, 0.3, 1);

    position: relative; z-index: 2; overflow-x: clip;
    background: var(--bg); color: var(--ink); font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  .scp ::selection { background: rgba(255, 255, 255, 0.85); color: #000; }
  .scp-wrap { position: relative; max-width: 1240px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 768px) { .scp-wrap { padding: 0 40px; } }

  .scp-tag {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--mono); font-size: 11.5px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink);
  }
  .scp-tag .no { color: var(--faint); }
  .scp-lede { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.6; color: var(--soft); max-width: 640px; }
  .scp-h2 {
    font-weight: 700; font-stretch: 118%; text-transform: uppercase; text-wrap: balance;
    font-size: clamp(30px, 4.4vw, 60px); line-height: 0.98; letter-spacing: -0.02em; margin: 18px 0 32px;
  }

  .scp-back {
    display: inline-flex; gap: 8px; align-items: center; width: fit-content;
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--faint); text-decoration: none; transition: color 0.2s;
  }
  .scp-back .arw { transition: transform 0.25s var(--out); }
  .scp-back:hover { color: var(--ink); }
  .scp-back:hover .arw { transform: translateX(-4px); }

  /* ------------------------------------------------------------ hero: the 3D draft */
  .scp-hero { position: relative; }
  .scp-stage { position: relative; height: clamp(620px, 100svh, 1100px); background: #000; overflow: hidden; }
  .scp-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; outline: none; -webkit-tap-highlight-color: transparent; }
  .scp-canvas:active { cursor: grabbing; }
  .scp-fallback {
    position: absolute; left: 50%; top: 56%; transform: translate(-50%, -50%); width: min(420px, calc(100% - 32px));
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; line-height: 1.6; text-align: center; color: var(--faint);
  }

  .scp-top { display: flex; flex-direction: column; gap: 18px; padding-top: 40px; padding-bottom: clamp(24px, 4vw, 48px); }
  .scp-top .scp-back { margin-bottom: clamp(16px, 4vw, 48px); }
  .scp-hero .scp-top { position: absolute; top: 0; left: 0; right: 0; z-index: 3; pointer-events: none; }
  .scp-hero .scp-top a { pointer-events: auto; }
  .scp-h1 { font-weight: 400; text-transform: uppercase; font-size: clamp(28px, 4.6vw, 64px); line-height: 1; letter-spacing: 0.08em; }

  .scp-hud {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 3;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 32px;
    padding-bottom: clamp(20px, 3.4vw, 40px); pointer-events: none;
  }
  .scp-hero-lede { max-width: 440px; font-size: 16px; }
  .scp-ctl { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; pointer-events: auto; }
  .scp-hint { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  .scp-hint .coarse { display: none; }
  @media (pointer: coarse) { .scp-hint .fine { display: none; } .scp-hint .coarse { display: inline; } }
  .scp-views { display: flex; gap: 2px; margin-right: -8px; }
  .scp-views button {
    font-family: var(--mono); font-size: 11.5px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--faint); background: none; border: 0; padding: 10px 8px; cursor: pointer; transition: color 0.2s;
  }
  .scp-views button:hover, .scp-views button:focus-visible, .scp-views button[aria-pressed='true'] { color: var(--ink); }
  .scp-views button:focus-visible { outline: 1px solid var(--soft); outline-offset: -2px; }
  .scp-stage.is-nogl ~ .scp-hud .scp-ctl { display: none; }

  /* hotspots: placed by the viewer, white mono, no boxes */
  .scp-spots { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .scp-spot {
    position: absolute; left: 0; top: 0; width: 0; height: 0; padding: 0; border: 0; background: none;
    opacity: 0; color: var(--ink); cursor: pointer; pointer-events: none; will-change: transform, opacity;
  }
  .scp-spot .d {
    position: absolute; left: -12px; top: -12px; width: 24px; height: 24px; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.75); background: rgba(0, 0, 0, 0.28); transition: transform 0.25s var(--out), background 0.2s;
  }
  .scp-spot .d::after { content: ''; position: absolute; left: 50%; top: 50%; width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 50%; background: #fff; }
  .scp-spot:hover .d, .scp-spot.is-open .d, .scp-spot:focus-visible .d { transform: scale(1.15); background: rgba(255, 255, 255, 0.14); }
  .scp-spot:focus-visible { outline: none; }
  .scp-spot .l {
    position: absolute; left: 34px; top: -14px; white-space: nowrap; text-align: left;
    padding: 7px 10px 8px; border-radius: 2px; background: rgba(0, 0, 0, 0.62);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    font-family: var(--mono); font-size: 11px; line-height: 1.35; letter-spacing: 0.14em; text-transform: uppercase;
    opacity: 0; transform: translateX(-4px); transition: opacity 0.2s, transform 0.3s var(--out); pointer-events: none;
  }
  /* leader from the ring to the label */
  .scp-spot .l::before { content: ''; position: absolute; top: 14px; left: -22px; width: 22px; height: 1px; background: rgba(255, 255, 255, 0.6); }
  .scp-spot .l b { font-weight: 500; }
  .scp-spot .l span { display: block; margin-top: 3px; font-size: 11.5px; letter-spacing: 0.02em; text-transform: none; color: var(--soft); }
  .scp-spot:hover .l, .scp-spot:focus-visible .l, .scp-spot.is-open .l { opacity: 1; transform: none; }
  .scp-spot.is-flip .l { left: auto; right: 34px; text-align: right; transform: translateX(4px); }
  .scp-spot.is-flip .l::before { left: auto; right: -22px; }
  .scp-spot.is-flip:hover .l, .scp-spot.is-flip.is-open .l, .scp-spot.is-flip:focus-visible .l { transform: none; }
  /* a slow ring so people know the dots do something */
  @media (prefers-reduced-motion: no-preference) {
    .scp-spot .d::before {
      content: ''; position: absolute; inset: -1px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.5);
      animation: scp-ping 2.8s var(--out) infinite;
    }
    .scp-spot:nth-child(2) .d::before { animation-delay: 0.4s; }
    .scp-spot:nth-child(3) .d::before { animation-delay: 0.8s; }
    .scp-spot:nth-child(4) .d::before { animation-delay: 1.2s; }
    .scp-spot:nth-child(5) .d::before { animation-delay: 1.6s; }
    .scp-spot:nth-child(6) .d::before { animation-delay: 2s; }
    .scp-spot:nth-child(7) .d::before { animation-delay: 2.4s; }
  }
  @keyframes scp-ping { 0% { transform: scale(1); opacity: 0.7; } 70%, 100% { transform: scale(2.1); opacity: 0; } }

  .scp-lede-m { display: none; }
  @media (max-width: 767px) {
    .scp-stage { height: clamp(520px, 82svh, 700px); }
    .scp-hero-lede { display: none; }
    .scp-lede-m { display: block; padding-top: 28px; padding-bottom: 8px; }
    .scp-hud { justify-content: center; }
    .scp-ctl { align-items: center; }
    .scp-views { margin-right: 0; }
    .scp-spot .d { left: -9px; top: -9px; width: 18px; height: 18px; }
    .scp-spot .l { left: 26px; top: -15px; }
    .scp-spot .l::before { left: -17px; width: 17px; }
    .scp-spot.is-flip .l { right: 26px; }
    .scp-spot.is-flip .l::before { right: -17px; }
  }

  /* ------------------------------------------------------------ sections */
  .scp-sec { padding-top: clamp(64px, 9vw, 120px); padding-bottom: clamp(32px, 4vw, 48px); border-top: 1px solid var(--line); }
  .scp-hero + .scp-sec, .scp-lede-m + .scp-sec { margin-top: clamp(24px, 4vw, 48px); }

  .scp-mix {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; margin-bottom: 28px;
    font-weight: 600; font-stretch: 112%; font-size: clamp(20px, 2.6vw, 34px); text-transform: uppercase;
  }
  .scp-mix i { font-style: normal; color: var(--faint); font-weight: 300; }

  .scp-spec { margin: 0; }
  .scp-spec .row {
    display: grid; grid-template-columns: 1fr; gap: 4px; padding: 18px 0; border-bottom: 1px solid var(--line);
  }
  .scp-spec dt { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  .scp-spec dd { margin: 0; font-size: 18px; line-height: 1.5; color: var(--ink); }
  @media (min-width: 768px) { .scp-spec .row { grid-template-columns: 220px 1fr; gap: 24px; align-items: baseline; } }

  .scp-open { list-style: none; margin: 0; padding: 0; }
  .scp-open li { display: grid; grid-template-columns: 52px 1fr; gap: 4px 16px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .scp-open .n { font-family: var(--mono); font-size: 13px; color: var(--faint); grid-row: span 2; padding-top: 6px; }
  .scp-open h3 { font-weight: 700; font-stretch: 118%; text-transform: uppercase; font-size: clamp(22px, 2.6vw, 34px); line-height: 1.05; }
  .scp-open p { font-size: 17px; line-height: 1.6; color: var(--soft); }

  .scp-end { padding-top: 80px; padding-bottom: 80px; }
</style>
