---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/utils';
import TechMarquee from '../components/TechMarquee.astro';
import CTABlock from '../components/CTABlock.astro';
import ProjectCard from '../components/ProjectCard.astro';

const locale = 'en';
const CALENDLY = 'https://calendly.com/yanis-schweizer';
---

<Base
  title="Development | Strade"
  description="Flutter mobile apps, full-stack web applications, and AI-powered features. Built and shipped in weeks."
  locale={locale}
  path="/development"
>
  <!-- Hero -->
  <section class="dev-hero">
    <div class="hero-glow-purple" aria-hidden="true"></div>
    <div class="container" style="position:relative;z-index:1;padding-top:96px;padding-bottom:64px">
      <span class="label" style="color:var(--purple)" id="d-label">{t(locale, 'development.label')}</span>
      <h1 id="d-h1">
        {t(locale, 'development.h1_line1')}<br/>
        <span style="color:var(--purple)">{t(locale, 'development.h1_line2')}</span>
      </h1>
      <p style="max-width:520px;color:var(--text-secondary);font-size:18px;margin:16px 0 0" id="d-body">
        {t(locale, 'development.body')}
      </p>
      <a href={CALENDLY} target="_blank" rel="noopener" class="btn-primary" style="margin-top:32px;display:inline-flex;gap:8px;background:var(--purple)">
        {t(locale, 'development.cta')} <span>&#8594;</span>
      </a>
    </div>
  </section>

  <!-- Capabilities Grid -->
  <section class="dev-caps">
    <div class="container">
      <span class="label">{t(locale, 'development.cap_label')}</span>
      <div class="caps-grid">
        <!-- Card 1 -->
        <div class="cap-card reveal-section" style="--reveal-delay:0s">
          <svg class="cap-icon" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.5" width="40" height="40" aria-hidden="true">
            <rect x="5" y="2" width="14" height="20" rx="2"/>
            <line x1="12" y1="18" x2="12.01" y2="18"/>
          </svg>
          <h3>{t(locale, 'development.cap1_h3')}</h3>
          <p class="cap-body">{t(locale, 'development.cap1_body')}</p>
        </div>
        <!-- Card 2 -->
        <div class="cap-card reveal-section" style="--reveal-delay:0.15s">
          <svg class="cap-icon" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.5" width="40" height="40" aria-hidden="true">
            <rect x="2" y="3" width="20" height="15" rx="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="18" x2="12" y2="21"/>
          </svg>
          <h3>{t(locale, 'development.cap2_h3')}</h3>
          <p class="cap-body">{t(locale, 'development.cap2_body')}</p>
        </div>
        <!-- Card 3 -->
        <div class="cap-card reveal-section" style="--reveal-delay:0.3s">
          <svg class="cap-icon" viewBox="0 0 24 24" fill="none" stroke="var(--purple)" stroke-width="1.5" width="40" height="40" aria-hidden="true">
            <path d="M12 2a10 10 0 1 0 10 10"/>
            <path d="M12 6v6l4 2"/>
            <circle cx="19" cy="5" r="3"/>
          </svg>
          <h3>{t(locale, 'development.cap3_h3')}</h3>
          <p class="cap-body">{t(locale, 'development.cap3_body')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="dev-projects">
    <div class="container">
      <span class="label">{t(locale, 'development.projects_label')}</span>
      <ProjectCard
        title="StudentVenture"
        tagline="AI-powered recruitment marketplace. Semantic search over 10,000+ profiles."
        tags={['Flutter', 'Firebase', 'pgvector', 'OpenAI', 'Google Cloud']}
        caseStudyUrl="/case-studies/studentventure"
      />
      <ProjectCard
        title="YouCook"
        tagline="AI-powered cooking app. Recipe generation and meal planning."
        tags={['Flutter', 'Firebase', 'OpenAI', 'RevenueCat']}
        caseStudyUrl="/case-studies/youcook"
        reverse={true}
      />
    </div>
  </section>

  <TechMarquee />
  <CTABlock locale={locale} />
</Base>

<style>
  .dev-hero { min-height: 80vh; display: flex; align-items: center; position: relative; overflow: hidden; }
  .hero-glow-purple {
    position: absolute; top: 50%; left: 50%;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(123,47,255,0.15) 0%, transparent 65%);
    transform: translate(-50%, -55%); pointer-events: none;
    animation: pulse-hero 4s ease-in-out infinite;
  }
  #d-label, #d-h1, #d-body { opacity: 0; transform: translateY(16px); }
  .dev-caps { padding: 96px 0; }
  .caps-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; margin-top: 32px; }
  .cap-card {
    background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: 8px; padding: 40px;
    transition: transform 0.4s var(--ease-out-expo), border-color 0.4s;
  }
  .cap-card:hover { transform: translateY(-2px); border-color: var(--border-hover); }
  .cap-icon { margin-bottom: 20px; }
  .cap-card h3 { margin-bottom: 12px; }
  .cap-body { color: var(--text-secondary); }
  .dev-projects { padding: 64px 0; }
  .dev-projects .label { margin-bottom: 32px; }

  @media (max-width: 768px) { .caps-grid { grid-template-columns: 1fr; } }
</style>

<script>
  (async () => {
    const gsap = (await import('gsap')).gsap;
    const tl = gsap.timeline({ delay: 0.1 });
    tl.to('#d-label', { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' });
    tl.to('#d-h1', { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, '-=0.1');
    tl.to('#d-body', { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.3');
  })();
</script>
