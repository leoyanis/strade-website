    background:
      radial-gradient(circle at 3.5px 3.5px, transparent 2px, var(--faint) 2.1px, var(--faint) 3.3px, transparent 3.4px) left center / 7px 7px no-repeat,
      radial-gradient(circle at 3.5px 3.5px, transparent 2px, var(--faint) 2.1px, var(--faint) 3.3px, transparent 3.4px) right center / 7px 7px no-repeat,
      linear-gradient(rgb(27 26 24 / 0.13), rgb(27 26 24 / 0.13)) center / calc(100% - 26px) 1px no-repeat;
    opacity: 0.85;
  }
  .why__item:first-child { padding-top: 6px; }
  .why__n { font-family: var(--num); font-weight: 300; font-size: 44px; line-height: 1; color: var(--amber); letter-spacing: 0.01em; padding-top: 2px; }
  .why__h { margin: 0; font-size: clamp(23px, 2.2vw, 29px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; color: var(--ink); text-wrap: balance; }
  .why__p { margin: 14px 0 0; max-width: 56ch; font-size: 17px; line-height: 1.65; color: var(--ink-mid); }
  .why__receipt { margin-top: 22px; }
  .rc { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .rc__note { font-size: 13.5px; color: var(--faint); }
  .chip {
    display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 13px 0 10px; border-radius: 999px;
    font-size: 13.5px; font-weight: 500; color: var(--ink); background: var(--key-grad); box-shadow: var(--key); text-shadow: var(--emboss);
  }
  .chip svg { width: 17px; height: 17px; }
  .ramp { display: inline-flex; align-items: flex-start; gap: 8px; }
  .ramp__col { display: flex; flex-direction: column; align-items: center; gap: 7px; }
  .ramp__well { display: flex; align-items: flex-end; width: 44px; height: 58px; padding: 4px; border-radius: 12px; background: var(--sunk); box-shadow: var(--well); }
  .ramp__well i { display: block; width: 100%; height: calc(var(--h) * 100%); border-radius: 8px; background: var(--key-grad); box-shadow: var(--key); }
  .ramp__col--first .ramp__well i { background: var(--brass); box-shadow: var(--brass-shadow); }
  .ramp small { font-size: 11.5px; font-weight: 500; color: var(--faint); white-space: nowrap; }
  .ramp__col--first small { color: var(--amber); font-weight: 600; }
  .ramp__col:last-child small { color: var(--ink); font-weight: 600; }
  .mini-score { display: inline-flex; align-items: baseline; gap: 2px; padding: 7px 12px; border-radius: 12px; background: var(--key-grad); box-shadow: var(--key); }
  .mini-score b { font-size: 22px; font-weight: 600; color: var(--olive); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .mini-score small { font-size: 12px; color: var(--faint); }
  .rc__quote { flex: 1; min-width: 220px; font-family: 'Newsreader', Georgia, serif; font-style: italic; font-size: 16px; line-height: 1.45; color: var(--ink-mid); }
  .rc--week { gap: 8px; }
  .day { display: inline-flex; flex-direction: column; align-items: center; gap: 5px; }
  .day__dot { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(180deg, #5C7B53, #4A6741); color: #fff; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2), 0 1px 2px rgb(52 40 24 / 0.25); }
