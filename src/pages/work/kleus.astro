    --brass-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22), inset 0 -1px 0 rgb(0 0 0 / 0.1), 0 0 0 1px rgb(110 62 10 / 0.18), 0 1px 2px rgb(110 62 10 / 0.21), 0 4px 13px -3px rgb(184 116 27 / 0.21);
    --emboss: 0 1px 0 rgb(255 255 255 / 0.56);

    position: relative;
    font-family: var(--sans);
    color: var(--ink);
