  @keyframes kl-bead { 50% { box-shadow: 0 0 0 5px rgb(74 103 65 / 0.06); } }
  .hero__title { margin: 28px 0 0; line-height: 1; }
  .hero__title :global(.hero__logo) { width: clamp(270px, 36vw, 520px); height: auto; color: var(--ink); }
  .hero__motto { display: flex; align-items: center; gap: 9px; width: min(460px, 100%); margin: 24px 0 0; }
  .hero__motto i { flex: none; width: 7px; height: 7px; border-radius: 50%; border: 1.5px solid var(--faint); }
  .hero__motto span { flex: 1; height: 1px; background: rgb(27 26 24 / 0.13); box-shadow: var(--emboss); }
  .hero__motto em { flex: none; padding: 0 4px; font-style: normal; font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mid); text-shadow: var(--emboss); }
