---
// Kleus: a branded case study in Kleus's own register. Warm paper, ink, one thing in amber,
// the phi mark, DM Sans with Fraunces numerals. Product moments are rebuilt in HTML from
// kleus.ai (the ring of saved material, the lesson path, the WhatsApp day, the scored check).
import Base from '../../layouts/Base.astro';
import CaseNext from '../../components/CaseNext.astro';
import { getProject } from '../../data/work';
import KlLogo from '../../components/case/kleus/KlLogo.astro';
import KlRing from '../../components/case/kleus/KlRing.astro';
import KlMark from '../../components/case/kleus/KlMark.astro';
import KlCapital from '../../components/case/kleus/KlCapital.astro';
import KlPath from '../../components/case/kleus/KlPath.astro';
import KlChat from '../../components/case/kleus/KlChat.astro';
import KlCheck from '../../components/case/kleus/KlCheck.astro';
import KlCommits from '../../components/case/kleus/KlCommits.astro';

const p = getProject('kleus')!;
const SITE_URL = p.links?.[0]?.href ?? 'https://www.kleus.ai';
const FONTS =
  'https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=DM+Sans:opsz,wght@9..40,300..700&family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,400&family=Newsreader:ital,opsz,wght@0,6..72,400..500;1,6..72,400&display=swap';

const words = (s: string) => s.split(' ');

const WHY = [
  {
    n: 'I',
    h: 'WhatsApp, not another app.',
    p: 'An app you have to remember to open is one more thing to quit. Nobody abandons WhatsApp. So the lesson, the reminders and the feedback all arrive in a chat you already live in, on WhatsApp or Telegram.',
    r: 'chat',
  },
  {
    n: 'II',
    h: 'Fifteen minutes, on purpose.',
    p: 'A plan that opens with your biggest commitment gets abandoned in week one. So every plan starts at fifteen minutes, and only ramps up to the time you picked over the first three lessons.',
    r: 'ramp',
  },
  {
    n: 'III',
    h: 'Graded on what you write.',
    p: 'Picking an answer from a list tests whether you recognise it. Writing it tests whether you know it. So every lesson ends in your own words, scored out of 100, and the ideas you missed come back in later lessons.',
    r: 'score',
  },
  {
    n: 'IV',
    h: 'Miss a day, keep the path.',
    p: 'No streak to lose and nothing to restart. A missed day is logged without comment and the plan bends around your week. Shame is what makes people quit, so I designed it out.',
    r: 'week',
  },
  {
    n: 'V',
    h: 'Code makes the calls. AI writes the words.',
    p: "The AI never decides when to message you, how long a lesson runs or when an idea comes back. That's code and SQL, with tests. The AI writes the lessons, the questions and the feedback, and if it's ever down, the reminders still go out from lines I wrote myself.",
    r: 'split',
  },
];

const STATS = [
  { v: 1400, text: '1,400+', suffix: '+', label: 'commits since June 2026' },
  { v: 5500, text: '5,500+', suffix: '+', label: 'automated tests that gate every deploy' },
  { v: 6, text: '6', suffix: '', label: 'book and document formats it reads' },
];

const STACK = [
  ['App', 'Next.js 16, React 19, TypeScript'],
  ['Data', 'Supabase: Postgres with row-level security, scheduled jobs in pg_cron'],
  ['Messages', 'WhatsApp Cloud API and a Telegram bot, mirrored to email and the web app'],
  ['Billing', 'Stripe subscriptions'],
  ['Tests', 'Vitest on every push in GitHub Actions, plus Playwright end to end'],
  ['Hosting', 'Vercel, two apps: kleus.ai and app.kleus.ai'],
];

const RAILS = [
  'The engine never imports from the screens.',
  'No import cycles, anywhere.',
  'Each database table has one door in the code, and the exceptions can only shrink.',
  'Every bug fix ships with the test that would have caught it.',
  'Main only deploys when every check is green.',
];
---

<Base
  title={`${p.name}: case study | Yanis Schweizer`}
  description={p.summary}
  path="/work/kleus"
  noAlternates
  bare
  navTheme={p.brand.light ? 'light' : 'dark'}
  ogImage="/og/work-kleus.png"
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href={FONTS} />

  <div class="kl">
    <!-- ============================== HERO ============================== -->
    <section class="hero" id="kl-top">
      <div class="hero__glow" aria-hidden="true"><i></i><i></i></div>
      <div class="kl-wrap hero__inner">
        <p class="hero__meta" data-hero-in>
          <span class="kicker">Main quest · My product</span>
          <span class="pill"><i class="bead" aria-hidden="true"></i>{p.status}</span>
          <span class="pill">{p.year}</span>
        </p>
        <h1 class="hero__title">
          <span class="kl-sr">Kleus</span>
          <KlLogo class="hero__logo" />
        </h1>
        <p class="hero__motto" data-hero-in>
          <i aria-hidden="true"></i><span aria-hidden="true"></span>
          <em>Mastery by relentless action</em>
          <span aria-hidden="true"></span><i aria-hidden="true"></i>
        </p>
        <p class="hero__lead" data-hero-in>
          I built Kleus, an AI coach that turns the books, videos and podcasts you keep saving into
          <b>15-minute daily lessons</b>. It checks in on WhatsApp, grades what you write, and keeps you going
          after the motivation runs out.
        </p>
        <div class="hero__actions" data-hero-in>
          <a class="btn btn--amber" href={SITE_URL} target="_blank" rel="noopener">
            Try a free lesson
            <svg class="btn__arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="btn btn--key" href={SITE_URL} target="_blank" rel="noopener">
            kleus.ai
            <span class="btn__ext" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17 17 7M8.5 7H17v8.5" /></svg></span>
          </a>
        </div>
      </div>

      <div class="hero__ring" data-hero-ring>
        <KlRing />
      </div>

      <div class="kl-wrap">
        <dl class="facts" data-kl-reveal>
          <div><dt>Started</dt><dd>June 2026</dd></div>
          <div><dt>Live</dt><dd>at kleus.ai</dd></div>
          <div><dt>Commits</dt><dd>1,400+</dd></div>
          <div><dt>Built on</dt><dd>Next.js, Supabase, Stripe</dd></div>
        </dl>
      </div>
    </section>

    <!-- ============================== I. THE PROBLEM ============================== -->
    <section class="prob" id="kl-problem">
      <div class="kl-wrap">
        <KlMark n="I" label="The problem" />
        <h2 class="prob__statement" data-kl-words>
          <span class="prob__line prob__line--soft">{words("Most people don't").map((w) => <span class="w">{w} </span>)}</span>
          <span class="prob__line prob__line--soft">{words('fail to start.').map((w) => <span class="w">{w} </span>)}</span>
          <span class="prob__line">{words('They fail to').map((w) => <span class="w">{w} </span>)}</span>
          <span class="prob__line"><span class="w prob__amber">continue.</span></span>
        </h2>
        <div class="prob__cols">
          <div class="prob__col" data-kl-reveal>
            <span class="kicker">What goes wrong</span>
            <p>
              Courses are passive and coaches are expensive, and both fail at the same point: the gap between
              knowing and doing, repeated every day. Meanwhile the video you saved stays saved, and the book
              stops at chapter three.
            </p>
          </div>
          <div class="prob__col" data-kl-reveal>
            <span class="kicker">The idea</span>
            <p>
              <b>Accountability is the product.</b> Everything else in Kleus, the plans, the lessons, the learning
              science, is there for one job: getting you to show up again tomorrow.
            </p>
          </div>
        </div>
        <KlCapital class="prob__cap" />
      </div>
    </section>

    <!-- ============================== II. HOW IT WORKS ============================== -->
    <section class="how" id="kl-how">
      <div class="kl-wrap">
        <KlMark n="II" label="How it works" />
        <div class="how__head">
          <h2 class="h2" data-kl-reveal>Bring anything. <span>Kleus builds the path.</span></h2>
          <div class="how__intro">
            <p class="lead" data-kl-reveal>
              Paste a YouTube or Apple Podcasts link, upload a book or a PDF, or just name a topic. Kleus reads
              the whole thing, splits it into core concepts and teaches them one short lesson a day.
            </p>
            <ul class="doors" aria-label="What you can bring" data-kl-reveal>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13.5a4.5 4.5 0 0 0 6.4.4l3-3a4.5 4.5 0 0 0-6.4-6.4l-1.4 1.4" /><path d="M14 10.5a4.5 4.5 0 0 0-6.4-.4l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.4-1.4" /></svg>
                YouTube link
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.6 11.6a6.4 6.4 0 0 0 12.8 0M12 18v3" /></svg>
                Apple Podcasts
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5.5A2 2 0 0 1 7 3.5h12v14H7a2 2 0 0 0-2 2v-14z" /><path d="M5 19.5a2 2 0 0 0 2 2h12v-4" /></svg>
                Book or PDF
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
                Any topic
              </li>
            </ul>
          </div>
        </div>
        <KlPath />
      </div>
    </section>

    <!-- ============================== III. THE CHECK-IN ============================== -->
    <KlChat />

    <!-- ============================== IV. THE CHECK ============================== -->
    <section class="chk" id="kl-check">
      <div class="kl-wrap">
        <KlMark n="IV" label="The check" dark />
        <div class="chk__head">
          <h2 class="h2 h2--dark" data-kl-reveal>Every lesson ends in something <span>you write.</span></h2>
          <p class="lead lead--dark" data-kl-reveal>
            Reading feels like learning. Writing proves it. Each lesson asks for a guess before it explains, then
            closes with a few questions answered in your own words. Kleus scores them out of 100, quotes your
            answer back, names what landed and what was missing, and writes tomorrow from the result.
          </p>
        </div>
        <KlCheck />
        <ul class="bands" aria-label="What a score does next">
          <li data-band>
            <span class="band band--solid"><i aria-hidden="true"></i>Solid</span>
            <span class="bands__range">above 80</span>
            <p>The plan moves on. Nothing is repeated for the sake of it.</p>
          </li>
          <li data-band>
            <span class="band band--flaky"><i aria-hidden="true"></i>Flaky</span>
            <span class="bands__range">50 to 80</span>
            <p>It counts as done, and the weak ideas come back inside the rest of the chapter.</p>
          </li>
          <li data-band>
            <span class="band band--lack"><i aria-hidden="true"></i>Lacking</span>
            <span class="bands__range">below 50</span>
            <p>A focused redo, spaced a lesson away. No lecture.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ============================== V. DECISIONS ============================== -->
    <section class="why" id="kl-why">
      <div class="kl-wrap why__grid">
        <div class="why__side">
          <div class="why__sticky">
            <KlMark n="V" label="Decisions" />
            <h2 class="h2 h2--nobal" data-kl-reveal>Why I built it<br /> <span>this way.</span></h2>
            <p class="lead" data-kl-reveal>Five calls that shaped Kleus. None of them were the AI's to make.</p>
          </div>
        </div>
        <ol class="why__list">
          {WHY.map((w) => (
            <li class="why__item" data-why>
              <span class="why__n" aria-hidden="true">{w.n}</span>
              <div class="why__body">
                <h3 class="why__h">{w.h}</h3>
                <p class="why__p">{w.p}</p>
                <div class="why__receipt" aria-hidden="true">
                  {w.r === 'chat' && (
                    <span class="rc rc--row">
                      <span class="chip">
                        <svg viewBox="0 0 24 24" fill="#25d366"><path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.45 9.45 0 01-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.4 9.4 0 01-1.45-5.03c0-5.2 4.24-9.43 9.45-9.43 2.52 0 4.89.98 6.67 2.77a9.37 9.37 0 012.76 6.67c0 5.2-4.24 9.43-9.44 9.43z" /></svg>
                        WhatsApp
                      </span>
                      <span class="chip">
                        <svg viewBox="0 0 24 24" fill="#229ed9"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z" /></svg>
                        Telegram
                      </span>
                      <span class="rc__note">Nothing to install</span>
                    </span>
                  )}
                  {w.r === 'ramp' && (
                    <span class="rc rc--ramp">
                      <span class="ramp">
                        <span class="ramp__col ramp__col--first"><span class="ramp__well"><i style="--h:.34"></i></span><small>15 min</small></span>
                        <span class="ramp__col"><span class="ramp__well"><i style="--h:.55"></i></span><small></small></span>
                        <span class="ramp__col"><span class="ramp__well"><i style="--h:.76"></i></span><small></small></span>
                        <span class="ramp__col"><span class="ramp__well"><i style="--h:1"></i></span><small>your pace</small></span>
                      </span>
                    </span>
                  )}
                  {w.r === 'score' && (
                    <span class="rc rc--score">
                      <span class="mini-score"><b>82</b><small>/100</small></span>
                      <span class="rc__quote">“Strong on the money problem, thin on why the nobles wouldn't budge.”</span>
                    </span>
                  )}
                  {w.r === 'week' && (
                    <span class="rc rc--week">
                      {['M', 'T', 'W', 'T', 'F'].map((d, i) => (
                        <span class:list={['day', i === 2 && 'day--off']}>
                          <span class="day__dot">
                            {i === 2 ? <svg viewBox="0 0 24 24"><path d="M7 12h10" /></svg> : <svg viewBox="0 0 24 24"><path d="M5 12.5 10 17l9-10" /></svg>}
                          </span>
                          <span class="day__l">{d}</span>
                        </span>
                      ))}
                      <span class="rc__note">No streak to lose.</span>
                    </span>
                  )}
                  {w.r === 'split' && (
                    <span class="rc rc--split">
                      <span class="plate">
                        <span class="plate__k">Code decides</span>
                        <span class="plate__v">When to message · how long a lesson runs · when an idea comes back</span>
                      </span>
                      <span class="plate plate--ai">
                        <span class="plate__k">AI writes</span>
                        <span class="plate__v">The lessons · the questions · the feedback</span>
                      </span>
                    </span>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============================== VI. UNDER THE HOOD ============================== -->
    <section class="hood" id="kl-hood">
      <div class="kl-wrap">
        <KlMark n="VI" label="Under the hood" dark />
        <div class="hood__head">
          <h2 class="h2 h2--dark" data-kl-reveal>Built human&#8209;steered.</h2>
          <p class="lead lead--dark" data-kl-reveal>
            I made the product calls: what the coach says, when it speaks, what counts as learned. AI did most
            of the typing, inside rules I wrote down and enforced with tests.
          </p>
        </div>
        <div class="pulse">
          <div class="pulse__text" data-kl-reveal>
            <span class="kicker kicker--dark">Mastery by relentless action</span>
            <p class="pulse__big"><span data-countup data-count="97">97</span><small>of 120 days</small></p>
            <p class="pulse__p">
              Kleus's tagline is a promise about consistency, so I held the build to it. Since the first commit on
              10 June, 97 of the 120 days to 7 October 2026 have at least one.
            </p>
          </div>
          <div class="pulse__graph" data-kl-reveal>
            <KlCommits />
          </div>
        </div>
        <dl class="stats">
          {STATS.map((s) => (
            <div class="stat" data-stat>
              <dt class="stat__l">{s.label}</dt>
              <dd class="stat__v" data-countup data-count={s.v} data-suffix={s.suffix}>{s.text}</dd>
            </div>
          ))}
        </dl>
        <div class="hood__cols">
          <div class="hood__col" data-kl-reveal>
            <h3 class="kicker kicker--dark">The stack</h3>
            <dl class="spec">
              {STACK.map(([k, v]) => (
                <div class="spec__row"><dt>{k}</dt><dd>{v}</dd></div>
              ))}
            </dl>
          </div>
          <div class="hood__col" data-kl-reveal>
            <h3 class="kicker kicker--dark">Rules the AI works inside</h3>
            <ul class="rails">
              {RAILS.map((r, i) => (
                <li><span class="rails__n">{String(i + 1).padStart(2, '0')}</span>{r}</li>
              ))}
            </ul>
            <p class="rails__foot">Most of them fail the build in CI, so they can't quietly drift.</p>
          </div>
        </div>
        <p class="quote" data-kl-reveal>
          AI can write a lesson in seconds. Deciding when to speak, when to stay quiet and how to grade someone
          honestly is the real work. <span>That part was mine.</span>
        </p>
      </div>
    </section>

    <!-- ============================== BRING YOUR OWN THING ============================== -->
    <section class="cta" id="kl-try">
      <div class="cta__glow" aria-hidden="true"></div>
      <div class="kl-wrap cta__inner">
        <span class="cta__phi" aria-hidden="true"><KlLogo variant="phi" /></span>
        <h2 class="cta__title" data-kl-reveal>Bring your own thing.</h2>
        <p class="cta__sub" data-kl-reveal>
          The book you haven't finished, the video you saved, or the topic you keep coming back to. Kleus is
          live, and you can try a sample lesson for free, with no account.
        </p>
        <div class="cta__doors" data-kl-reveal>
          <a class="btn btn--amber btn--lg" href={SITE_URL} target="_blank" rel="noopener">
            <svg class="btn__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13.5a4.5 4.5 0 0 0 6.4.4l3-3a4.5 4.5 0 0 0-6.4-6.4l-1.4 1.4" /><path d="M14 10.5a4.5 4.5 0 0 0-6.4-.4l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.4-1.4" /></svg>
            <span class="only-wide">Paste a YouTube or Apple Podcasts link</span>
            <span class="only-narrow">Paste a YouTube link</span>
          </a>
          <div class="cta__row">
            <a class="btn btn--key" href={SITE_URL} target="_blank" rel="noopener">
              <svg class="btn__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M7.5 8.5 12 4l4.5 4.5" /><path d="M4.5 15v3.5a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V15" /></svg>
              Upload a book or document
            </a>
            <a class="btn btn--key" href={SITE_URL} target="_blank" rel="noopener">
              <svg class="btn__ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
              Choose a topic
            </a>
          </div>
        </div>
        <a class="cta__site" href={SITE_URL} target="_blank" rel="noopener">
          Visit kleus.ai
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8.5 7H17v8.5" /></svg>
        </a>
      </div>
    </section>
  </div>

  <CaseNext current="kleus" />
</Base>

<script>
  // Motion is an enhancement. Skip it for reduced motion, and on viewports so tall the whole page
  // is on screen at once (full-page captures), where a scroll reveal would only hide things.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.innerHeight > 1500;

  (async () => {
    if (reduce) return;
    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);
      const q = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<T>(s));

      /* ---------- hero: the mark arrives, then the page ---------- */
      const intro = gsap.timeline({ delay: 0.1 });
      intro
        .from('.hero__logo', { opacity: 0, y: 14, filter: 'blur(10px)', duration: 1.2, ease: 'expo.out' }, 0)
        .from('.hero__logo .kl-logo__phi', { rotate: -14, scale: 0.84, duration: 1.4, ease: 'expo.out' }, 0)
        .from('.hero__logo .kl-logo__word', { x: -16, duration: 1.1, ease: 'expo.out' }, 0.12)
        .from('[data-hero-in]', { opacity: 0, y: 16, duration: 0.8, ease: 'power3.out', stagger: 0.07 }, 0.2)
        .from('[data-hero-ring]', { opacity: 0, y: 48, duration: 1.3, ease: 'expo.out' }, 0.35);

      const mm = gsap.matchMedia();
      mm.add('(min-width: 768px)', () => {
        gsap.to('[data-hero-ring]', {
          yPercent: -10, ease: 'none',
          scrollTrigger: { trigger: '#kl-top', start: 'top top', end: 'bottom top', scrub: true },
        });
      });

      /* ---------- generic reveals ---------- */
      q('[data-kl-reveal]').forEach((el) => {
        gsap.from(el, {
          opacity: 0, y: 26, duration: 0.95, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        });
      });
      q('.mk__rule').forEach((el) => {
        gsap.from(el, { scaleX: 0, duration: 1.4, ease: 'expo.out', scrollTrigger: { trigger: el, start: 'top 90%', once: true } });
      });

      /* ---------- I. the statement inks in as you read it ---------- */
      const statement = document.querySelector('[data-kl-words]');
      if (statement) {
        gsap.fromTo(q('.w', statement), { opacity: 0.13 }, {
          opacity: 1, ease: 'none', stagger: 0.12,
          scrollTrigger: { trigger: statement, start: 'top 80%', end: 'bottom 45%', scrub: 0.5 },
        });
      }

      /* ---------- the capital: drawn from the middle outwards ---------- */
      q('[data-kl-capital]').forEach((cap) => {
        gsap.timeline({ scrollTrigger: { trigger: cap, start: 'top 88%', once: true } })
          .from(q('[data-cap-line]', cap), { scaleX: 0, duration: 1.3, ease: 'expo.inOut', stagger: 0.12 })
          .fromTo(q('[data-cap-curl]', cap), { strokeDashoffset: -1 }, { strokeDashoffset: 0, duration: 1, ease: 'power2.out' }, 0.85);
      });

      /* ---------- II. the source splits into a path ---------- */
      const path = document.querySelector('[data-kl-path]');
      if (path) {
        const lead = () =>
          gsap.timeline({ scrollTrigger: { trigger: path, start: 'top 72%', once: true } })
            .from('[data-path-media]', { y: 34, opacity: 0, duration: 1, ease: 'expo.out' })
            .from('.path__hand', { opacity: 0, y: 8, rotate: -9, duration: 0.6, ease: 'power2.out' }, 0.35)
            .fromTo('[data-path-scrawl]', { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.55, ease: 'power2.inOut', stagger: 0.35 }, 0.5)
            .from('[data-path-stem]', { scaleY: 0, duration: 0.6, ease: 'power2.inOut' }, 0.7)
            .from('[data-path-label]', { opacity: 0, y: 12, duration: 0.6, ease: 'power3.out' }, 1.05);

        mm.add('(min-width: 860px)', () => {
          lead()
            .fromTo('.path__curve', { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.75, ease: 'power2.out', stagger: 0.09 }, 1.25)
            .from('.path__head', { opacity: 0, duration: 0.25, stagger: 0.09 }, 1.8)
            .from('[data-path-card]', { y: 40, scale: 0.9, opacity: 0, duration: 0.95, ease: 'back.out(1.6)', stagger: 0.09 }, 1.75);
        });
        mm.add('(max-width: 859px)', () => {
          lead().from('[data-path-card]', { y: 22, opacity: 0, duration: 0.7, ease: 'power3.out', stagger: 0.08 }, 1.2);
        });
      }

      /* ---------- IV. two sheets land, the score counts up ---------- */
      const check = document.querySelector<HTMLElement>('[data-kl-check]');
      if (check) {
        const sheets = q('[data-sheet]', check);
        const ring = check.querySelector<SVGCircleElement>('[data-ring]');
        const nums = q<HTMLElement>('[data-count]', check);
        const C = Number(ring?.dataset.ring ?? 377);
        const tl = gsap.timeline({ scrollTrigger: { trigger: check, start: 'top 72%', once: true } });
        tl.from(sheets, { y: 90, opacity: 0, rotate: (i) => (i ? 6 : -7), duration: 1.2, ease: 'expo.out', stagger: 0.18 });
        if (ring) tl.fromTo(ring, { strokeDashoffset: C }, { strokeDashoffset: C * (1 - 0.93), duration: 1.6, ease: 'power3.out' }, 0.55);
        nums.forEach((el) => {
          const end = Number(el.dataset.count);
          const o = { v: 0 };
          tl.to(o, { v: end, duration: 1.6, ease: 'power3.out', onUpdate: () => { el.textContent = String(Math.round(o.v)); } }, 0.55);
        });
        tl.from(q('[data-row]', check), { y: 16, opacity: 0, duration: 0.7, ease: 'power3.out', stagger: 0.12 }, 0.75)
          .from(q('[data-fb]', check), { x: -10, opacity: 0, duration: 0.6, ease: 'power3.out', stagger: 0.15 }, 1.3);
      }
      const bands = q('[data-band]');
      if (bands.length) {
        gsap.from(bands, { y: 24, opacity: 0, duration: 0.8, ease: 'power3.out', stagger: 0.1, scrollTrigger: { trigger: bands[0], start: 'top 90%', once: true } });
      }

      /* ---------- V. decisions ---------- */
      q('[data-why]').forEach((item) => {
        gsap.timeline({ scrollTrigger: { trigger: item, start: 'top 82%', once: true } })
          .from(item.querySelector('.why__n'), { opacity: 0, y: 20, scale: 0.86, duration: 1, ease: 'expo.out' })
          .from(item.querySelector('.why__body'), { opacity: 0, y: 26, duration: 0.9, ease: 'power3.out' }, 0.08)
          .from(item.querySelectorAll('.rc > *'), { opacity: 0, y: 10, duration: 0.5, ease: 'power2.out', stagger: 0.06 }, 0.35);
      });

      /* ---------- VI. numbers count up, the days fill in ---------- */
      q<HTMLElement>('[data-countup]').forEach((el) => {
        const end = Number(el.dataset.count);
        const suf = el.dataset.suffix ?? '';
        const o = { v: 0 };
        el.textContent = '0' + suf;
        gsap.to(o, {
          v: end, duration: 1.8, ease: 'power3.out',
          onUpdate: () => { el.textContent = Math.round(o.v).toLocaleString('en-US') + suf; },
          scrollTrigger: { trigger: el, start: 'top 90%', once: true },
        });
      });
      const statEls = q('[data-stat]');
      if (statEls.length) {
        gsap.from(statEls, { opacity: 0, y: 20, duration: 0.8, ease: 'power3.out', stagger: 0.1, scrollTrigger: { trigger: statEls[0], start: 'top 88%', once: true } });
      }
      const graph = document.querySelector('[data-kl-commits]');
      if (graph) {
        gsap.from(q('[data-cg-cell]:not(.cg__c--out)', graph), {
          scale: 0.2, opacity: 0, duration: 0.45, ease: 'back.out(2)', stagger: 0.006,
          scrollTrigger: { trigger: graph, start: 'top 82%', once: true },
        });
      }

      window.addEventListener('load', () => ScrollTrigger.refresh());
    } catch {
      /* every section is already visible without motion */
    }
  })();
</script>

<style>
  :global(body) { background: #F0EEE9; }

  .kl {
