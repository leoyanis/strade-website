    --key-lift: inset 0 1px 0 rgb(255 255 255 / 0.68), inset 0 -1px 0 rgb(52 40 24 / 0.064), 0 0 0 1px rgb(52 40 24 / 0.048), 0 2px 3px rgb(52 40 24 / 0.072), 0 14px 28px -11px rgb(52 40 24 / 0.16);
    --well: inset 0 1px 3.5px rgb(52 40 24 / 0.085), inset 0 0 0 1px rgb(52 40 24 / 0.025), 0 1px 0 rgb(255 255 255 / 0.54);
