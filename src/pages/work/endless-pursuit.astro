  }
  @media (max-width: 767px) {
    .ep-wrap { padding: 0 20px; }
    .ep-hero { padding: 104px 0 40px; min-height: 0; }
    .ep-loop { top: 70%; width: 190vw; }
    .ep-h1 { font-size: clamp(54px, 16vw, 72px); }
    .ep-lede { font-size: 16.5px; }
    .ep-chips li, .ep-chips > span { height: 30px; font-size: 12.5px; padding: 0 12px; }
    .ep-hero__halo { width: 320px; height: 320px; }
    .ep-hero__phone { width: min(250px, 66vw); }
    .ep-pill { height: 36px; font-size: 12px; padding: 0 12px; gap: 6px; }
    .ep-pill--live { top: 6%; left: 0; }
    .ep-pill--run { top: 30%; right: 0; }
    .ep-pill--nudge { bottom: 26%; left: 0; }
    .ep-pill--focus { bottom: 6%; right: 0; }
    .ep-numbers { padding: 16px 0 72px; }
    .ep-stats { grid-template-columns: 1fr 1fr; row-gap: 28px; }
    .ep-stat { padding: 0 12px 0 0; }
    .ep-stat + .ep-stat { padding-left: 0; border-left: 0; }
    .ep-stat:nth-child(even) { padding-left: 16px; border-left: 1px solid var(--line); }
    .ep-stat__v { font-size: 24px; white-space: normal; }
    .ep-stat__l { font-size: 12.5px; align-items: flex-start; }
    .ep-stat__l i { margin-top: 5px; }
    .ep-problem { padding: 80px 0; }
    .ep-problem__grid { grid-template-columns: 1fr; gap: 18px; }
