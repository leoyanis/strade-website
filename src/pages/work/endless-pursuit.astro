    .ep-built { padding: 84px 0 56px; }
    .ep-sechead { margin-bottom: 36px; }
    .ep-moment-row { padding: 44px 0; }
    .ep-moment-row__text p { font-size: 16px; }
    .ep-onb-phones { height: 440px; }
    .ep-onb-phones > div { width: 54%; max-width: 220px; }
