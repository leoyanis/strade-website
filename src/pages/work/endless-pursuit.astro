  .ep-qrow .ep-sub { font-size: 12.5px; }
  .ep-nudge {
    height: 34px; padding: 0 14px; border-radius: 999px; background: var(--s3); border: 0; color: var(--text);
    font: 500 13px var(--sans); display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    transition: transform .28s var(--spring), color .2s;
  }
  .ep-nudge svg { width: 15px; height: 15px; fill: none; stroke: var(--gold); stroke-width: 2; }
  .ep-nudge.is-sent { color: var(--gold); }
  .ep-nudge.is-press { transform: scale(.94); }

  .ep-around { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; margin-top: 40px; padding-top: 48px; border-top: 1px solid var(--line); }
  .ep-around__k { font-size: 17px; font-weight: 600; margin-bottom: 8px; color: var(--text); }
  .ep-around__item p:not(.ep-around__k) { font-size: 15px; line-height: 1.6; color: var(--sub); }
  .ep-around__item { padding-left: 18px; border-left: 2px solid var(--gold); }

  /* ============================== DESIGN SYSTEM ============================== */
  .ep-glasssec { padding: 110px 0; background: var(--bg-deep); border-top: 1px solid #1c1a17; border-bottom: 1px solid #1c1a17; }
  .ep-glasssec__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 64px; align-items: center; }
  .ep-glasssec__text > p:not(.ep-over) { margin-top: 22px; font-size: 17px; line-height: 1.65; color: var(--sub); max-width: 470px; }
  .ep-rules { list-style: none; padding: 0; margin: 30px 0 0; border-top: 1px solid var(--line); }
  .ep-rules li { display: flex; gap: 18px; align-items: baseline; padding: 13px 0; border-bottom: 1px solid var(--line); font-size: 16px; font-weight: 500; }
  .ep-rules .ep-mono { color: var(--gold); font-size: 12px; font-weight: 400; }

  .ep-lab {
    position: relative; overflow: hidden; border-radius: 32px; min-height: 520px; background: #0b0a09;
    border: 1px solid var(--line); display: flex; flex-direction: column; align-items: center; justify-content: space-between;
    padding: 28px 22px 26px;
  }
  .ep-lab__blobs { position: absolute; inset: 0; }
  .ep-lab__blobs i { position: absolute; border-radius: 50%; filter: blur(2px); }
  .ep-lab__blobs .b1 { width: 52%; aspect-ratio: 1; left: -6%; top: 26%; background: radial-gradient(circle at 40% 40%, #ec8a5c, #DE7546 55%, #9b3f17); animation: ep-drift1 14s ease-in-out infinite alternate; }
  .ep-lab__blobs .b2 { width: 46%; aspect-ratio: 1; right: -8%; top: 8%; background: radial-gradient(circle at 40% 40%, #b3abf5, #948AEA 55%, #5c51b8); animation: ep-drift2 16s ease-in-out infinite alternate; }
  .ep-lab__blobs .b3 { width: 34%; aspect-ratio: 1; left: 38%; bottom: -10%; background: radial-gradient(circle at 40% 40%, #a7d897, #84BE71 55%, #4d7d3d); animation: ep-drift3 12s ease-in-out infinite alternate; }
  .ep-lab__blobs .b4 { width: 22%; aspect-ratio: 1; left: 30%; top: 4%; background: radial-gradient(circle at 40% 40%, #f6e6c2, #E3C588 55%, #a8853f); animation: ep-drift2 11s ease-in-out infinite alternate-reverse; }
  @keyframes ep-drift1 { to { transform: translate(38%, -14%) scale(1.08); } }
  @keyframes ep-drift2 { to { transform: translate(-30%, 22%) scale(.92); } }
  @keyframes ep-drift3 { to { transform: translate(-46%, -30%) scale(1.12); } }
  .ep-lab__line {
    position: relative; z-index: 1; align-self: flex-start; font-size: clamp(34px, 4vw, 48px); line-height: 1; font-weight: 600;
    letter-spacing: -0.035em; color: #fff; text-shadow: 0 2px 30px rgba(0,0,0,.35);
  }
  .ep-lab__line .ep-mono { display: block; font-size: clamp(76px, 9vw, 112px); line-height: .9; font-weight: 500; letter-spacing: -0.06em; }
  .ep-lab__line em { display: block; margin-top: 6px; font-weight: 400; font-size: .72em; }
  .ep-lab__seg {
    position: relative; z-index: 2; display: flex; gap: 4px; padding: 4px; border-radius: 999px;
    background: rgba(10,10,10,.55); border: 1px solid rgba(255,255,255,.1);
