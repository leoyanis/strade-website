  .ep-reel__item { width: 210px; flex: none; }
  .ep-reel__item :global(.sd-phone) { --ph-bezel: #0e0d0c; --ph-shadow: 0 30px 60px -30px rgba(0,0,0,.9); }
  .ep-reel__cap { display: block; margin-top: 14px; text-align: center; font-size: 12.5px; color: var(--sub); }
  @keyframes ep-reel { to { transform: translateX(-50%); } }

  .ep-how__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: 56px; margin-top: 64px; align-items: start; }
  .ep-decisions { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .ep-decisions li { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 8px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .ep-decisions .ep-num { margin: 3px 0 0; }
  .ep-decisions h3 { font-size: 19px; font-weight: 600; letter-spacing: -0.015em; }
  .ep-decisions p { margin-top: 6px; font-size: 15.5px; line-height: 1.6; color: var(--sub); }
  .ep-config { border-radius: 22px; background: #141414; border: 1px solid #262626; padding: 18px; position: sticky; top: 96px; }
  .ep-config__head { display: flex; justify-content: space-between; align-items: center; font-size: 12px; padding-bottom: 12px; border-bottom: 1px solid #262626; }
  .ep-config__head .ep-mono { color: var(--gold); font-size: 13px; }
