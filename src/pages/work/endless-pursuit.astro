  .ep-config__foot { margin-top: 12px; font-size: 12.5px; color: var(--sub); }
  .ep-stack { list-style: none; padding: 0; margin: 56px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .ep-stack li {
    height: 34px; padding: 0 14px; display: inline-flex; align-items: center; border-radius: 999px;
    border: 1px solid var(--line); background: var(--s1); color: var(--sub); font: 500 13px var(--mono); letter-spacing: -0.01em;
  }

  /* ============================== CLOSE ============================== */
  .ep-close {
    padding: 130px 0 140px; text-align: center; position: relative;
    background: radial-gradient(700px 360px at 50% 100%, rgba(227,197,136,.12), transparent 70%), var(--bg);
  }
  .ep-close__inner { display: flex; flex-direction: column; align-items: center; }
  .ep-close__inf { width: 64px; height: 64px; fill: none; stroke: var(--gold); stroke-width: 1.6; }
  .ep-close__line { margin-top: 24px; font-size: clamp(42px, 7vw, 92px); line-height: 1; color: var(--text); max-width: 14ch; }
  .ep-close__status { margin-top: 44px; display: flex; flex-direction: column; align-items: center; gap: 14px; font-size: 16px; color: var(--sub); }
  .ep-close__status .ep-chips { margin: 0; }

  /* ============================== RESPONSIVE ============================== */
  @media (max-width: 1023px) {
    .ep-hero__grid { grid-template-columns: 1fr; gap: 40px; }
    .ep-hero__stage { min-height: 0; padding: 30px 0 10px; }
    .ep-moment-row, .ep-glasssec__grid, .ep-how__grid { grid-template-columns: 1fr; gap: 44px; }
    .ep-moment-row--flip .ep-moment-row__text { order: 0; }
    .ep-sechead--split { grid-template-columns: 1fr; gap: 20px; }
    .ep-config { position: static; }
    .ep-stats { grid-template-columns: 1fr 1fr; row-gap: 32px; }
    .ep-stat + .ep-stat { padding-left: 0; border-left: 0; }
