</style>

<script>
  (async () => {
    const root = document.querySelector<HTMLElement>('.ep');
    if (!root) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---------- Liquid Glass / fallback switch (works without GSAP) ----------
    const lab = root.querySelector<HTMLElement>('.ep-lab');
    const note = root.querySelector<HTMLElement>('[data-mat-note]');
    root.querySelectorAll<HTMLButtonElement>('[data-mat-btn]').forEach((b) => {
      b.addEventListener('click', () => {
        const mat = b.dataset.matBtn!;
        lab?.setAttribute('data-mat', mat);
        root.querySelectorAll<HTMLButtonElement>('[data-mat-btn]').forEach((x) => {
          x.classList.toggle('is-on', x === b);
          x.setAttribute('aria-pressed', String(x === b));
        });
        if (note) {
          note.textContent =
            mat === 'glass'
              ? 'iOS 26 and later: native glass, with lensing and a specular edge.'
              : 'Android and older iOS: a plain frosted surface. No fake refraction.';
        }
      });
    });

    if (reduce) return;

    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      // ---------- hero entrance ----------
      const heroIn = root.querySelectorAll('[data-hero-in]');
      gsap.from(heroIn, { opacity: 0, y: 24, duration: 0.9, stagger: 0.08, ease: 'power3.out', delay: 0.1 });
      gsap.from('[data-hero-phone]', { opacity: 0, y: 70, rotate: 4, duration: 1.3, ease: 'expo.out', delay: 0.25 });
      gsap.from('[data-pill]', { opacity: 0, scale: 0.6, duration: 0.8, stagger: 0.14, ease: 'back.out(1.8)', delay: 0.85 });

      // pills drift slowly on scroll
      root.querySelectorAll<HTMLElement>('[data-pill]').forEach((el, i) => {
        gsap.to(el, {
          y: (i % 2 ? -1 : 1) * 46,
          ease: 'none',
          scrollTrigger: { trigger: '.ep-hero', start: 'top top', end: 'bottom top', scrub: 0.6 },
        });
      });
      gsap.to('[data-hero-phone]', {
        y: -40, rotate: -1, ease: 'none',
        scrollTrigger: { trigger: '.ep-hero', start: 'top top', end: 'bottom top', scrub: 0.6 },
      });

      // ---------- generic reveals ----------
      root.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        gsap.from(el, {
          opacity: 0, y: 26, duration: 0.9, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        });
      });

      // ---------- number band: blocks grow, counts roll ----------
      const bandBlocks = root.querySelectorAll('.ep-daybar .b, .ep-daybar .d');
      gsap.from(bandBlocks, {
        scaleX: 0, opacity: 0, duration: 0.6, stagger: 0.07, ease: 'power2.out',
        scrollTrigger: { trigger: '.ep-daybar', start: 'top 90%', once: true },
      });
      gsap.from('.ep-daybar .now', {
        left: '0%', duration: 1.4, ease: 'power2.inOut',
        scrollTrigger: { trigger: '.ep-daybar', start: 'top 90%', once: true },
      });
      root.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const to = Number(el.dataset.count);
        const o = { v: 0 };
        gsap.to(o, {
          v: to, duration: 1.2, ease: 'power2.out',
          onUpdate: () => { el.textContent = String(Math.round(o.v)); },
          scrollTrigger: { trigger: el, start: 'top 92%', once: true },
        });
      });

      // ---------- onboarding phones float ----------
      root.querySelectorAll<HTMLElement>('[data-float]').forEach((el) => {
        const dir = Number(el.dataset.float);
        gsap.fromTo(el, { y: 60 * -dir }, {
          y: 60 * dir, ease: 'none',
          scrollTrigger: { trigger: '.ep-moment-row--onb', start: 'top bottom', end: 'bottom top', scrub: 0.8 },
        });
      });

      // ---------- transient UI (toasts, tap ripples) is only revealed under JS ----------
      root.querySelectorAll<HTMLElement>('.ep-toast, .ep-tapdot').forEach((el) => {
        gsap.set(el, { opacity: 0 });
        el.removeAttribute('hidden');
      });

      // ---------- shared helpers for the two recreations ----------
      const fmtH = (m: number) => `${Math.floor(m / 60)}h ${String(Math.round(m % 60)).padStart(2, '0')}m`;
      const tapAt = (app: HTMLElement, target: HTMLElement) => {
        const dot = app.querySelector<HTMLElement>('[data-tapdot]');
        target.classList.add('is-press');
        setTimeout(() => target.classList.remove('is-press'), 220);
        if (!dot) return;
        const a = app.getBoundingClientRect();
        const r = target.getBoundingClientRect();
        gsap.set(dot, { left: r.left - a.left + r.width / 2, top: r.top - a.top + r.height / 2 });
        gsap.fromTo(dot, { opacity: 0.9, scale: 0.4 }, { opacity: 0, scale: 1.5, duration: 0.6, ease: 'power2.out' });
      };
      const toast = (el: HTMLElement | null) => {
        if (!el) return;
        gsap.killTweensOf(el);
        gsap.fromTo(el, { opacity: 0, y: 16, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.45, ease: 'back.out(1.7)' });
        gsap.to(el, { opacity: 0, y: 8, duration: 0.4, delay: 1.9, ease: 'power2.in' });
      };

      // ---------- 02: one-tap logging ----------
      const logRow = root.querySelector<HTMLElement>('#ep-log');
      if (logRow) {
        const app = logRow.querySelector<HTMLElement>('.ep-app')!;
        const blk = (k: string) => app.querySelector<HTMLElement>(`[data-blk="${k}"]`)!;
        const tile = (k: string) => app.querySelector<HTMLElement>(`[data-tile="${k}"]`)!;
        const btn = (k: string) => app.querySelector<HTMLElement>(`[data-tap="${k}"]`)!;
        const now = app.querySelector<HTMLElement>('[data-now]')!;
        const logToast = app.querySelector<HTMLElement>('[data-toast="log"]');
        const final = { focus: 145, vol: 6004, pro: 68 };
        const state = { focus: 0, vol: 0, pro: 0 };
        const paint = () => {
          tile('focus').textContent = fmtH(state.focus);
          tile('vol').textContent = Math.round(state.vol).toLocaleString('en-GB');
          tile('pro').textContent = String(Math.round(state.pro));
        };
        let tl: gsap.core.Timeline | null = null;
        const reset = () => {
          tl?.kill();
          Object.assign(state, { focus: 0, vol: 0, pro: 0 });
          paint();
          gsap.set(['train', 'meal', 'focus', 'read'].map(blk), { scaleX: 0, opacity: 0 });
          gsap.set(now, { left: '9%' });
        };
        reset();
        const play = () => {
          reset();
          tl = gsap.timeline({ delay: 0.3 });
          tl.call(() => { tapAt(app, btn('train')); toast(logToast); })
            .to(blk('train'), { scaleX: 1, opacity: 1, duration: 0.7, ease: 'power2.out' }, '+=0.15')
            .to(state, { vol: final.vol, duration: 1, ease: 'power2.out', onUpdate: paint }, '<')
            .to(now, { left: '13%', duration: 0.6, ease: 'power2.inOut' }, '<')
            .call(() => tapAt(app, btn('meal')), [], '+=0.35')
            .to(blk('meal'), { scaleX: 1, opacity: 1, duration: 0.35, ease: 'back.out(3)' }, '+=0.15')
            .to(state, { pro: final.pro, duration: 0.9, ease: 'power2.out', onUpdate: paint }, '<')
            .call(() => tapAt(app, btn('focus')), [], '+=0.35')
            .to(blk('focus'), { scaleX: 1, opacity: 1, duration: 1.2, ease: 'power1.inOut' }, '+=0.15')
            .to(state, { focus: final.focus, duration: 1.2, ease: 'power1.inOut', onUpdate: paint }, '<')
            .to(now, { left: '30%', duration: 1.2, ease: 'power1.inOut' }, '<')
            .call(() => tapAt(app, btn('read')), [], '+=0.35')
            .to(blk('read'), { scaleX: 1, opacity: 1, duration: 0.6, ease: 'power2.out' }, '+=0.15')
            .to(now, { left: '38%', duration: 0.6, ease: 'power2.inOut' }, '<');
        };
        ScrollTrigger.create({ trigger: app, start: 'top 70%', once: true, onEnter: play });
        logRow.querySelector('[data-replay="log"]')?.addEventListener('click', play);

        // the widgets are tappable by hand too
        const manual: Record<string, () => void> = {
          train: () => gsap.to(blk('train'), { scaleX: 1, opacity: 1, duration: 0.5 }),
          meal: () => gsap.to(blk('meal'), { scaleX: 1, opacity: 1, duration: 0.3 }),
          focus: () => gsap.to(blk('focus'), { scaleX: 1, opacity: 1, duration: 0.6 }),
          read: () => gsap.to(blk('read'), { scaleX: 1, opacity: 1, duration: 0.5 }),
          tasks: () => {},
        };
        app.querySelectorAll<HTMLElement>('[data-tap]').forEach((b) => {
          b.addEventListener('click', () => {
            tapAt(app, b);
            manual[b.dataset.tap!]?.();
            toast(logToast);
          });
        });
      }

      // ---------- 03: who showed up + nudge ----------
      const tribeRow = root.querySelector<HTMLElement>('#ep-tribe');
      if (tribeRow) {
        const app = tribeRow.querySelector<HTMLElement>('.ep-app')!;
        const avs = Array.from(app.querySelectorAll<HTMLElement>('[data-strip] .ep-av'));
        const showed = app.querySelector<HTMLElement>('[data-showed]')!;
        const quiet = app.querySelector<HTMLElement>('[data-quiet]')!;
        const bar = app.querySelector<HTMLElement>('[data-pbar]')!;
        const nudge = app.querySelector<HTMLElement>('[data-nudge]')!;
        const nudgeLabel = nudge.querySelector('span')!;
        const tomLine = app.querySelector<HTMLElement>('[data-tom-line]')!;
        const tomAv = app.querySelector<HTMLElement>('[data-tom] .ep-av')!;
        const tribeToast = app.querySelector<HTMLElement>('[data-toast="tribe"]');
        const setCount = (n: number) => {
          showed.textContent = String(n);
          quiet.textContent = String(16 - n);
          bar.style.width = `${(n / 16) * 100}%`;
        };
        const light = (el: HTMLElement) => {
          el.classList.remove('is-quiet');
          el.classList.add('is-done');
          gsap.fromTo(el, { scale: 0.7 }, { scale: 1, duration: 0.6, ease: 'back.out(3)' });
        };
        let tl: gsap.core.Timeline | null = null;
        let sent = false;
        const reset = () => {
          tl?.kill();
          sent = false;
          nudge.classList.remove('is-sent');
          nudgeLabel.textContent = 'Nudge';
          tomLine.textContent = 'Last log yesterday 21:40';
          tomAv.classList.add('is-quiet');
          tomAv.classList.remove('is-done');
          avs.forEach((a, i) => {
            a.classList.toggle('is-done', i < 6);
            a.classList.toggle('is-quiet', i >= 6);
          });
          setCount(6);
        };
        const doNudge = () => {
          if (sent) {
            nudgeLabel.textContent = 'Nudged';
            return;
          }
          sent = true;
          tapAt(app, nudge);
          nudge.classList.add('is-sent');
          nudgeLabel.textContent = 'Nudged';
          toast(tribeToast);
        };
        const play = () => {
          reset();
          tl = gsap.timeline({ delay: 0.4 });
          for (let i = 6; i < 11; i++) {
            tl.call(() => { light(avs[i]); setCount(i + 1); }, [], i === 6 ? 0 : '+=0.42');
          }
          tl.call(doNudge, [], '+=0.9')
            .call(() => {
              tomLine.textContent = 'Logging now · focus';
              light(tomAv);
              light(avs[11]);
              setCount(12);
            }, [], '+=2.2');
        };
        reset();
        ScrollTrigger.create({ trigger: app, start: 'top 70%', once: true, onEnter: play });
        tribeRow.querySelector('[data-replay="tribe"]')?.addEventListener('click', play);
        nudge.addEventListener('click', doNudge);
      }

      window.addEventListener('load', () => ScrollTrigger.refresh());
    } catch {
      /* motion is decoration; the page is complete without it */
    }
  })();
</script>
