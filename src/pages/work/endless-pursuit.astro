  .ep-lab[data-mat='fallback'] .ep-lab__ind { background: #242424; box-shadow: none; }
  .ep-mat { transition: background .35s, box-shadow .35s, border-color .35s; }

  /* ============================== HOW ============================== */
  .ep-how { padding: 120px 0 100px; }
  .ep-sechead--split { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 48px; align-items: end; margin-bottom: 56px; }
