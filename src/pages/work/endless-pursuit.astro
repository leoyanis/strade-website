  .ep-lab__tab {
    position: relative; z-index: 1; flex: 1; height: 52px; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 2px; font-size: 10.5px; font-weight: 500; color: rgba(255,255,255,.72);
  }
  .ep-lab__tab.is-on { color: #fff; }
  .ep-lab__tab svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ep-lab__me { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-size: 9px; font-weight: 600; background: linear-gradient(135deg, #E3C588, #948AEA); color: #fff; }
  .ep-lab__inf { width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; color: var(--gold); flex: none; }
  .ep-lab__inf svg { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 2; }
  .ep-lab__note { position: relative; z-index: 2; font-size: 12.5px; color: rgba(255,255,255,.75); text-align: center; text-shadow: 0 1px 6px rgba(0,0,0,.6); min-height: 2.6em; }
  /* the two materials */
  .ep-lab[data-mat='glass'] .ep-mat {
    background: linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.04));
    -webkit-backdrop-filter: blur(6px) saturate(190%) brightness(1.08); backdrop-filter: blur(6px) saturate(190%) brightness(1.08);
    box-shadow: inset 0 1px .5px rgba(255,255,255,.4), inset 0 -1px 1px rgba(255,255,255,.1), inset 0 0 18px rgba(255,255,255,.06), 0 10px 30px rgba(0,0,0,.35);
    border: 1px solid rgba(255,255,255,.18);
  }
  .ep-lab[data-mat='fallback'] .ep-mat {
    background: rgba(20,20,20,.84); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
    box-shadow: 0 8px 24px rgba(0,0,0,.45); border: 1px solid #262626;
