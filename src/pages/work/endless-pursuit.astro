---
import { projectSchema, projectCrumbs } from '../../data/seo';
// Endless Pursuit: branded main-quest case study. Not published yet.
// Look and feel follow the app's own design system (docs/DESIGN.md in the client repo):
// warm near-black, Geist + Geist Mono + Instrument Serif, rare gold, Liquid Glass chrome.
import Base from '../../layouts/Base.astro';
import CaseNext from '../../components/CaseNext.astro';
import Phone from '../../components/case/side-dark/Phone.astro';
import { getProject } from '../../data/work';

const p = getProject('endless-pursuit')!;
const img = (f: string) => `/images/work/endless-pursuit/${f}`;
const fonts =
  'https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap';

// The lemniscate behind the hero, generated once (x = a·cos t / (1 + sin²t), y = a·sin t·cos t / (1 + sin²t)).
const loop = (() => {
  const a = 500;
  const n = 160;
  let d = '';
  for (let i = 0; i <= n; i++) {
    const t = (i / n) * Math.PI * 2;
    const s = Math.sin(t);
    const c = Math.cos(t);
    const den = 1 + s * s;
    d += `${i ? 'L' : 'M'}${((a * c) / den).toFixed(1)} ${(((a * s * c) / den) * 1.18).toFixed(1)} `;
  }
  return d.trim() + 'Z';
})();

// Circle members, colours from the prototype.
const members = [
  ['M', '#948AEA,#DE7546'], ['R', '#E3C588,#DE7546'], ['A', '#E3C588,#948AEA'], ['S', '#DE7546,#E3C588'],
  ['A', '#84BE71,#E3C588'], ['L', '#84BE71,#948AEA'], ['I', '#E3C588,#84BE71'], ['F', '#948AEA,#9C9C97'],
  ['Z', '#DE7546,#9C9C97'], ['J', '#948AEA,#E3C588'], ['K', '#DE7546,#84BE71'], ['T', '#5E5E5A,#9C9C97'],
  ['E', '#948AEA,#84BE71'], ['L', '#DE7546,#948AEA'], ['N', '#84BE71,#DE7546'], ['O', '#9C9C97,#E3C588'],
];

const proto = [
  { src: 'onboarding.webp', cap: 'Pick a direction' },
  { src: 'circle-step.webp', cap: 'Get into a circle' },
  { src: 'today.webp', cap: 'Today' },
  { src: 'day.webp', cap: 'Day detail' },
  { src: 'feed.webp', cap: 'Circle feed' },
  { src: 'profile.webp', cap: 'Profile' },
  { src: 'tribe.webp', cap: 'Tribe' },
  { src: 'share.webp', cap: 'Share your day' },
  { src: 'workspaces.webp', cap: 'Workspaces' },
];

const decisions = [
  ['One codebase, its own look', 'Flutter for iOS and Android, with a design system of its own instead of Material or Cupertino.'],
  ['The rules are plain code', 'What counts as showing up, streaks and circle runs live in plain Dart, and every rule is unit-tested.'],
  ['Privacy the database enforces', 'Row-level security on every table, so even a modified app can’t read around it.'],
  ['Live by default', 'Supabase Realtime pushes your day to your circle the moment you log something.'],
  ['Nothing hard-coded', 'Circle size and limits live in an admin-editable config, with safe defaults if it can’t load.'],
];
---

<Base
  title={`${p.name}: case study | Yanis Schweizer`}
  description={p.summary}
  path="/work/endless-pursuit"
  pageType="article"
  schema={projectSchema(p)}
  crumbs={projectCrumbs(p)}
  bare
  navTheme={p.brand.light ? 'light' : 'dark'}
  ogImage="/og/work-endless-pursuit.png"
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href={fonts} />

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <symbol id="ep-i-inf" viewBox="0 0 24 24"><path d="M9.828 9.172a4 4 0 1 0 0 5.656a10 10 0 0 0 2.172 -2.828a10 10 0 0 1 2.172 -2.828a4 4 0 1 1 0 5.656a10 10 0 0 1 -2.172 -2.828a10 10 0 0 0 -2.172 -2.828"></path></symbol>
      <symbol id="ep-i-flame" viewBox="0 0 24 24"><path d="M12 21c-3.4 0-6-2.3-6-5.5c0-2.4 1.5-4.1 2.9-5.7c.3.9.9 1.6 1.7 2.1c-.1-2.6.5-5.6 2.9-7.4c-.1 2.4 1 3.9 2.3 5.4c1.3 1.5 2.7 3.1 2.7 5.6c0 3.2-2.6 5.5-6 5.5z"></path><path d="M12 21c-1.4 0-2.4-.9-2.4-2.2c0-1.3 1-2.2 2.4-3.6c1.4 1.4 2.4 2.3 2.4 3.6c0 1.3-1 2.2-2.4 2.2z"></path></symbol>
      <symbol id="ep-i-bolt" viewBox="0 0 24 24"><path d="M13 3.5L5.5 13.5h6l-1 7l7.5-10h-6z"></path></symbol>
      <symbol id="ep-i-camera" viewBox="0 0 24 24"><path d="M5 7.5h1.8l1.5-2.2h7.4l1.5 2.2H19a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9.5a2 2 0 0 1 2-2z"></path><circle cx="12" cy="13.2" r="3.1"></circle></symbol>
      <symbol id="ep-i-barbell" viewBox="0 0 24 24"><path d="M2.5 12h2"></path><path d="M19.5 12h2"></path><path d="M8.5 12h7"></path><path d="M5.5 8v8"></path><path d="M8.5 6.5v11"></path><path d="M15.5 6.5v11"></path><path d="M18.5 8v8"></path></symbol>
      <symbol id="ep-i-flag" viewBox="0 0 24 24"><path d="M6 20V4"></path><path d="M6 4.5h11l-2.5 4l2.5 4H6"></path></symbol>
      <symbol id="ep-i-book" viewBox="0 0 24 24"><path d="M4.5 5.5a2 2 0 0 1 2-2H11v16H6.5a2 2 0 0 0-2 2z"></path><path d="M19.5 5.5a2 2 0 0 0-2-2H13v16h4.5a2 2 0 0 1 2 2z"></path></symbol>
      <symbol id="ep-i-play" viewBox="0 0 24 24"><path d="M7.5 5.2v13.6a.6.6 0 0 0 .9.5l10.8-6.8a.6.6 0 0 0 0-1L8.4 4.7a.6.6 0 0 0-.9.5z" fill="currentColor" stroke="none"></path></symbol>
      <symbol id="ep-i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.4 4.4L19 7.5"></path></symbol>
      <symbol id="ep-i-share" viewBox="0 0 24 24"><circle cx="6" cy="12" r="2.4"></circle><circle cx="18" cy="6" r="2.4"></circle><circle cx="18" cy="18" r="2.4"></circle><path d="M8.2 10.9l7.6-3.8"></path><path d="M8.2 13.1l7.6 3.8"></path></symbol>
      <symbol id="ep-i-users" viewBox="0 0 24 24"><circle cx="9" cy="7.5" r="3.2"></circle><path d="M3.5 20c.3-3 2.6-5 5.5-5s5.2 2 5.5 5"></path><path d="M15.8 4.6a3.2 3.2 0 0 1 0 5.8"></path><path d="M17.4 15.3c1.9.7 3 2.4 3.1 4.7"></path></symbol>
      <symbol id="ep-i-today" viewBox="0 0 24 24"><path d="M4.5 16.5a7.5 7.5 0 0 1 15 0"></path><path d="M2.5 20h19"></path><path d="M12 4v3.2"></path><path d="M5.4 7.4L7 9"></path><path d="M18.6 7.4L17 9"></path></symbol>
      <symbol id="ep-i-replay" viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 0 2.3-5.6"></path><path d="M4 4v4.5h4.5"></path></symbol>
    </defs>
  </svg>

  <div class="ep">
    <!-- ============================== HERO ============================== -->
    <section class="ep-hero" aria-labelledby="ep-title">
      <div class="ep-hero__wash" aria-hidden="true"></div>
      <svg class="ep-loop" viewBox="-560 -290 1120 580" aria-hidden="true">
        <defs>
          <linearGradient id="ep-loop-grad" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#F0DCAF"></stop>
            <stop offset="1" stop-color="#D9B678"></stop>
          </linearGradient>
          <filter id="ep-loop-glow" x="-20%" y="-50%" width="140%" height="200%">
            <feGaussianBlur stdDeviation="9"></feGaussianBlur>
          </filter>
        </defs>
        <path class="ep-loop__track" d={loop} pathLength="1000"></path>
        <path class="ep-loop__glow" d={loop} pathLength="1000" filter="url(#ep-loop-glow)"></path>
        <path class="ep-loop__comet" d={loop} pathLength="1000"></path>
      </svg>

      <div class="ep-wrap ep-hero__grid">
        <div class="ep-hero__copy">
          <p class="ep-wordmark" data-hero-in>
            <svg aria-hidden="true"><use href="#ep-i-inf"></use></svg>
            Main quest · client app
          </p>
          <h1 id="ep-title" class="ep-h1" data-hero-in>
            {p.name}
          </h1>
          <p class="ep-moment ep-hero__moment" data-hero-in>Show up. They’ll see it.</p>
          <p class="ep-lede" data-hero-in>{p.summary}</p>
          <ul class="ep-chips" data-hero-in>
            <li>For {p.client.replace(', Founder', ', founder')}</li>
            <li class="ep-mono">{p.year}</li>
            <li class="is-status"><i aria-hidden="true"></i>{p.status}</li>
            <li>Not published yet</li>
          </ul>
        </div>

        <div class="ep-hero__stage">
          <div class="ep-hero__halo" aria-hidden="true"></div>
          <div class="ep-hero__phone" data-hero-phone>
            <Phone
              src={img('today.webp')}
              alt="The Today screen: your day card live to the circle, a gold Start focus button and one-tap widgets"
              priority
            />
          </div>
          <span class="ep-glass ep-pill ep-pill--live" data-pill aria-hidden="true"><i class="ep-livedot"></i>Live to <b>Dawn Patrol</b></span>
          <span class="ep-glass ep-pill ep-pill--run" data-pill aria-hidden="true"><svg><use href="#ep-i-flame"></use></svg><b class="ep-mono">24</b> day run</span>
          <span class="ep-glass ep-pill ep-pill--nudge" data-pill aria-hidden="true"><svg><use href="#ep-i-bolt"></use></svg>Nudged Tom</span>
          <span class="ep-glass ep-pill ep-pill--focus" data-pill aria-hidden="true"><i class="ep-sq"></i>Focusing · <b class="ep-mono">24:10</b></span>
        </div>
      </div>
    </section>

    <!-- ============================== NUMBERS ============================== -->
    <section class="ep-numbers" aria-label="Key facts">
      <div class="ep-wrap">
        <div class="ep-daybar" aria-hidden="true">
          <div class="ep-abar">
            <span class="b body" style="left:2%;width:7%"></span>
            <span class="d body" style="left:11%"></span>
            <span class="b work" style="left:15%;width:16%"></span>
            <span class="b work" style="left:33%;width:8%"></span>
            <span class="b mind" style="left:45%;width:5%"></span>
            <span class="d body" style="left:53%"></span>
            <span class="b work" style="left:57%;width:12%"></span>
            <span class="b body" style="left:73%;width:6%"></span>
            <span class="b mind" style="left:84%;width:7%"></span>
            <span class="now" style="left:93%"></span>
          </div>
          <div class="ep-hours"><span>06</span><span>09</span><span>12</span><span>15</span><span>18</span><span>21</span><span>24</span></div>
        </div>
        <dl class="ep-stats">
          <div class="ep-stat">
            <dt class="ep-stat__v">iOS + Android</dt>
            <dd class="ep-stat__l"><i class="gold"></i>one codebase</dd>
          </div>
          <div class="ep-stat">
            <dt class="ep-stat__v" data-count="20">20</dt>
            <dd class="ep-stat__l"><i class="work"></i>people per circle, changeable without a release</dd>
          </div>
          <div class="ep-stat">
            <dt class="ep-stat__v" data-count="3">3</dt>
            <dd class="ep-stat__l"><i class="body"></i><i class="work"></i><i class="mind"></i>modes: Body, Work, Mind</dd>
          </div>
          <div class="ep-stat">
            <dt class="ep-stat__v">Fixed scope</dt>
            <dd class="ep-stat__l"><i class="gold"></i>fixed price, fixed date</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- ============================== PROBLEM ============================== -->
    <section class="ep-problem">
      <div class="ep-wrap ep-problem__grid">
        <p class="ep-over" data-reveal>The problem</p>
        <div>
          <h2 class="ep-statement" data-reveal>
            Nickolas wanted an app for people who say they’ll work on themselves, <em class="ep-moment">and then don’t.</em>
          </h2>
          <div class="ep-problem__body">
            <p data-reveal>
              Tracking apps are lonely, and accountability groups live in messy group chats. The idea only works if two
              things are true:
            </p>
            <ul class="ep-musts">
              <li data-reveal><span class="ep-tick"><svg><use href="#ep-i-check"></use></svg></span>Logging takes seconds.</li>
              <li data-reveal><span class="ep-tick"><svg><use href="#ep-i-check"></use></svg></span>Your group can see whether you showed up.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== WHAT I BUILT ============================== -->
    <section class="ep-built" aria-labelledby="ep-built-h">
      <div class="ep-wrap">
        <header class="ep-sechead">
          <p class="ep-over" data-reveal>What I built</p>
          <h2 id="ep-built-h" class="ep-h2" data-reveal>Log it in one tap. <em class="ep-moment">Your circle sees it live.</em></h2>
        </header>

        <!-- 01 onboarding -->
        <article class="ep-moment-row ep-moment-row--onb">
          <div class="ep-moment-row__text">
            <span class="ep-num ep-mono">01</span>
            <h3 class="ep-h3" data-reveal>Straight into your tribe</h3>
            <p data-reveal>
              Onboarding starts with one question: what are you pursuing? Body, Work or Mind. Then it puts you in a
              circle of up to 20 people who see your day as it happens.
            </p>
            <p class="ep-quote" data-reveal>Solo tracking isn’t what this is. This step can’t be skipped.<span>From the circle screen</span></p>
          </div>
          <div class="ep-onb-phones">
            <div class="ep-onb-phones__a" data-float="-1">
              <Phone src={img('onboarding.webp')} alt="Onboarding: What are you pursuing? Train & fuel, Build & ship, Read & reflect" />
            </div>
            <div class="ep-onb-phones__b" data-float="1">
              <Phone src={img('circle-step.webp')} alt="Onboarding: Get into a circle. Start a circle, join with a code, or find one" />
            </div>
          </div>
        </article>

        <!-- 02 one-tap logging (live recreation) -->
        <article class="ep-moment-row ep-moment-row--flip" id="ep-log">
          <div class="ep-moment-row__text">
            <span class="ep-num ep-mono">02</span>
            <h3 class="ep-h3" data-reveal>One tap, and your day goes live</h3>
            <p data-reveal>
              Every tracker is a one-tap widget on Today: a focus block, a meal, a training session, pages read. Your day
              card fills itself in, and the activity bar shows the whole day from 6:00 to midnight. There is no post
              button. Logging is posting.
            </p>
            <button class="ep-replay" type="button" data-replay="log">
              <svg aria-hidden="true"><use href="#ep-i-replay"></use></svg>Replay
            </button>
          </div>

          <div class="ep-device" role="group" aria-label="A recreation of the Today screen. Tapping a widget logs it and the day card updates.">
            <div class="ep-app">
              <div class="ep-app__head">
                <div>
                  <p class="ep-app__date">Thursday · 24 September</p>
                  <p class="ep-app__title">Today</p>
                </div>
                <span class="ep-flame"><svg aria-hidden="true"><use href="#ep-i-flame"></use></svg><b class="ep-mono" data-streak>9</b></span>
              </div>

              <div class="ep-card ep-daycard">
                <div class="ep-daycard__top">
                  <span><i class="ep-livedot"></i>Live to <b>Dawn Patrol</b></span>
                  <span class="ep-sub"><svg aria-hidden="true"><use href="#ep-i-share"></use></svg>Share</span>
                </div>
                <div class="ep-abar ep-abar--big" data-abar>
                  <span class="b body" data-blk="train" style="left:3%;width:7%"></span>
                  <span class="d body" data-blk="meal" style="left:12%"></span>
                  <span class="b work" data-blk="focus" style="left:16%;width:13%"></span>
                  <span class="b mind" data-blk="read" style="left:31%;width:5%"></span>
                  <span class="now" data-now style="left:38%"></span>
                </div>
                <div class="ep-hours"><span>06</span><span>09</span><span>12</span><span>15</span><span>18</span><span>21</span><span>24</span></div>
                <div class="ep-tiles">
                  <div class="ep-tile ep-tile--hero">
                    <p class="v ep-mono" data-tile="focus">2h 25m</p>
                    <p class="l"><i class="work"></i>Focus</p>
                  </div>
                  <div class="ep-tile">
                    <p class="v ep-mono"><span data-tile="vol">6,004</span><small>kg</small></p>
                    <p class="l"><i class="body"></i>Volume</p>
                  </div>
                  <div class="ep-tile">
                    <p class="v ep-mono"><span data-tile="pro">68</span><small>/160g</small></p>
                    <p class="l"><i class="body"></i>Protein</p>
                  </div>
                </div>
              </div>

              <button class="ep-goldbtn" type="button" data-tap="focus">
                <svg aria-hidden="true"><use href="#ep-i-play"></use></svg>Start focus · Northwind
              </button>

              <div class="ep-widgets">
                <button type="button" class="ep-wdg" data-tap="meal">
                  <span class="ic body"><svg aria-hidden="true"><use href="#ep-i-camera"></use></svg></span>
                  <span class="lab">Snap a meal</span><span class="val ep-mono">64g left</span>
                </button>
                <button type="button" class="ep-wdg" data-tap="train">
                  <span class="ic body"><svg aria-hidden="true"><use href="#ep-i-barbell"></use></svg></span>
                  <span class="lab">Push B</span><span class="val ep-mono">Start session</span>
                </button>
                <button type="button" class="ep-wdg" data-tap="tasks">
                  <span class="ic work"><svg aria-hidden="true"><use href="#ep-i-flag"></use></svg></span>
                  <span class="lab">Tasks</span><span class="val ep-mono">4 open · 1 starred</span>
                </button>
                <button type="button" class="ep-wdg" data-tap="read">
                  <span class="ic mind"><svg aria-hidden="true"><use href="#ep-i-book"></use></svg></span>
                  <span class="lab">Log pages</span><span class="val ep-mono">p. 212 / 304</span>
                </button>
              </div>

              <div class="ep-glass ep-toast" data-toast="log" aria-live="polite" hidden><i class="ep-livedot"></i><span>Live to Dawn Patrol</span></div>
              <span class="ep-tapdot" data-tapdot aria-hidden="true" hidden></span>
            </div>
          </div>
        </article>

        <!-- 03 who showed up (live recreation) -->
        <article class="ep-moment-row" id="ep-tribe">
          <div class="ep-moment-row__text">
            <span class="ep-num ep-mono">03</span>
            <h3 class="ep-h3" data-reveal>Who showed up today</h3>
            <p data-reveal>
              The circle card shows who has logged today, the circle run (days in a row when everyone showed up) and who
              is still quiet. One tap nudges them. It’s allowed once per person per day, and the database itself
              enforces that.
            </p>
            <button class="ep-replay" type="button" data-replay="tribe">
              <svg aria-hidden="true"><use href="#ep-i-replay"></use></svg>Replay
            </button>
          </div>

          <div class="ep-device" role="group" aria-label="A recreation of the circle card: who showed up today, the circle run, and a nudge for a quiet member.">
            <div class="ep-app ep-app--tribe">
              <div class="ep-app__head">
                <p class="ep-app__title">Tribe</p>
              </div>
              <div class="ep-card ep-circle">
                <div class="ep-circle__top">
                  <div>
                    <p class="ep-circle__name">Dawn Patrol</p>
                    <p class="ep-sub">16 of 20 · together since July</p>
                  </div>
                </div>
                <div class="ep-circle__run">
                  <span class="ep-mono">24</span>
                  <span class="ep-sub">day circle run · best 31</span>
                </div>
                <div class="ep-circle__prog">
                  <div class="ep-circle__progtop"><span class="ep-sub">Showed up today</span><span class="ep-mono"><b data-showed>11</b> / 16</span></div>
                  <div class="ep-pbar"><i data-pbar style="width:68.75%"></i></div>
                </div>
                <div class="ep-strip" data-strip>
                  {members.map(([n, g], i) => (
                    <span
                      class:list={['ep-av', i < 11 ? 'is-done' : 'is-quiet', i === 1 && 'is-active']}
                      style={`--g:linear-gradient(135deg,${g})`}
                      data-i={i}
                    >{n}</span>
                  ))}
                </div>
              </div>

              <p class="ep-quietlabel"><span>Quiet · <b data-quiet>5</b></span><span>Run ends at midnight</span></p>
              <div class="ep-card ep-qrow" data-tom>
                <span class="ep-av is-quiet" style="--g:linear-gradient(135deg,#5E5E5A,#9C9C97)">T</span>
                <div class="ep-qrow__who">
                  <p class="ep-qrow__name">Tom</p>
                  <p class="ep-sub" data-tom-line>Last log yesterday 21:40</p>
                </div>
                <button type="button" class="ep-nudge" data-nudge>
                  <svg aria-hidden="true"><use href="#ep-i-bolt"></use></svg><span>Nudge</span>
                </button>
              </div>

              <div class="ep-glass ep-toast" data-toast="tribe" aria-live="polite" hidden><svg aria-hidden="true"><use href="#ep-i-bolt"></use></svg><span>Nudged Tom</span></div>
            </div>
          </div>
        </article>

        <!-- around the loop -->
        <div class="ep-around">
          <div class="ep-around__item" data-reveal>
            <p class="ep-around__k">Privacy, per circle</p>
            <p>You choose which numbers flow to each circle. Weight is off by default. The fact that you showed up always flows.</p>
          </div>
          <div class="ep-around__item" data-reveal>
            <p class="ep-around__k">A feed that stays short</p>
            <p>One living card per person per day. Your circle comes first, then the people you follow.</p>
          </div>
          <div class="ep-around__item" data-reveal>
            <p class="ep-around__k">Settings without a release</p>
            <p>Circle size and limits live in the database, so Nickolas can change them without shipping a new version.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== DESIGN SYSTEM ============================== -->
    <section class="ep-glasssec" aria-labelledby="ep-glass-h">
      <div class="ep-wrap ep-glasssec__grid">
        <div class="ep-glasssec__text">
          <p class="ep-over" data-reveal>Design system</p>
          <h2 id="ep-glass-h" class="ep-h2" data-reveal>Liquid Glass, <em class="ep-moment">with an honest fallback.</em></h2>
          <p data-reveal>
            I gave the app its own design system. On iOS 26 the tab bar, pills and round buttons use Apple’s native
            Liquid Glass. On Android and older iPhones they switch to a frosted look that doesn’t pretend to be glass.
          </p>
