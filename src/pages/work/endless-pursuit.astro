    display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px; border-radius: 999px;
    font-size: 13.5px; color: #fff; white-space: nowrap; pointer-events: none;
  }
  .ep-toast[hidden], .ep-tapdot[hidden] { display: none; }
  .ep-toast svg { width: 15px; height: 15px; fill: none; stroke: var(--gold); stroke-width: 2; }
  .ep-tapdot {
    position: absolute; z-index: 6; width: 46px; height: 46px; margin: -23px 0 0 -23px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,.55), rgba(255,255,255,.12) 60%, transparent 70%);
    pointer-events: none; left: 0; top: 0;
  }

  /* tribe */
  .ep-app--tribe { padding-bottom: 70px; }
  .ep-circle { padding: 18px; display: flex; flex-direction: column; gap: 14px; }
  .ep-circle__name { font-size: 18px; font-weight: 600; }
  .ep-circle__top .ep-sub { font-size: 13px; }
  .ep-circle__run { display: flex; align-items: flex-end; gap: 10px; }
  .ep-circle__run .ep-mono { font-size: 46px; line-height: 1; color: var(--gold); font-weight: 400; }
  .ep-circle__run .ep-sub { font-size: 13px; padding-bottom: 6px; }
  .ep-circle__progtop { display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 8px; }
  .ep-circle__progtop b { font-weight: 500; }
  .ep-pbar { height: 6px; border-radius: 3px; background: var(--s3); overflow: hidden; }
  .ep-pbar i { display: block; height: 100%; background: var(--gold); border-radius: 3px; transition: width .5s var(--spring); }
  .ep-strip { display: grid; grid-template-columns: repeat(8, 1fr); gap: 8px; padding-top: 4px; }
  .ep-av {
    position: relative; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center;
    font-size: 12px; font-weight: 600; color: #fff; background: var(--g);
    transition: filter .4s, opacity .4s, box-shadow .4s;
  }
  .ep-av.is-quiet { filter: grayscale(1); opacity: .32; }
  .ep-av.is-done { box-shadow: 0 0 0 2px #141414, 0 0 0 3.5px var(--gold); }
  .ep-av.is-active::after {
    content: ""; position: absolute; right: -2px; bottom: -2px; width: 11px; height: 11px; border-radius: 50%;
    background: var(--gold); border: 2.5px solid #141414;
  }
  .ep-quietlabel {
    display: flex; justify-content: space-between; padding: 8px 4px 0; font-size: 11px; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase; color: var(--mut);
  }
  .ep-quietlabel b { font-weight: 600; }
  .ep-qrow { display: flex; align-items: center; gap: 12px; padding: 12px 14px; }
  .ep-qrow .ep-av { width: 38px; flex: none; }
  .ep-qrow__who { flex: 1; min-width: 0; }
