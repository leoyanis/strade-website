---
import { projectSchema, projectCrumbs } from '../../data/seo';
// Outreach & CRM System: white-label build with Matteo Caruso.
// Strictly anonymous: no client name, branding, staff, screenshots or real lead data.
// Every UI below is recreated in HTML with neutral demo data and a neutral indigo accent.
import Base from '../../layouts/Base.astro';
import CaseNext from '../../components/CaseNext.astro';
import { getProject } from '../../data/work';

const p = getProject('outreach-crm')!;

const leads = [
  { n: 'Dana Whitfield', c: 'Northwind', r: 'Head of Marketing', e: 'dana@northwind.co', v: 'Valid' },
  { n: 'Luis Ortega', c: 'Acme Studio', r: 'Founder', e: 'luis@acmestudio.com', v: 'Valid' },
  { n: 'Priya Raman', c: 'Fieldnote', r: 'Operations Lead', e: 'priya@fieldnote.io', v: 'Catch-all' },
  { n: 'Tom Becker', c: 'Bluebird Labs', r: 'CEO', e: 'tom@bluebirdlabs.com', v: 'Valid' },
  { n: 'Ana Costa', c: 'Lumen & Co', r: 'Events Manager', e: 'ana@lumen.co', v: 'Invalid' },
  { n: 'Kenji Mori', c: 'Harbor Supply', r: 'Office Manager', e: 'kenji@harborsupply.com', v: 'Valid' },
];

const ramp = Array.from({ length: 14 }, (_, i) => {
  const day = i + 1;
  return { day, v: Math.min(50, 20 + Math.max(0, day - 7) * 5) };
});

const tests = [
  'sends inside the window on a weekday, never outside it',
  'follows the ramp: 20 a day for the first week, then +5 a day',
  'sends at most one email per mailbox per round and spaces them out',
  'sends follow-ups after their delay, from the same mailbox, in the same thread',
  'never sends a half-filled email: a lead missing {{company}} is skipped once, with a note',
  'a reply in the thread stops the sequence and shows as New reply',
  'an out-of-office answer is logged and the sequence carries on',
  'a bounce marks the email bounced, puts the address on do-not-contact and stops the sequence',
  'a timeout after Microsoft accepted the email counts as sent (no second send)',
  'a database error after a successful send never sends the same step twice',
  'an outage spreads its failures over different leads instead of using up one lead',
  'a wrong app secret pauses every mailbox and uses up no lead; after Resume the email goes out',
  'daylight saving day (25 hours): the limit holds and the window follows local time',
  'never verify the same address twice (each check costs a credit)',
  'HTML and header injection in lead data is escaped / flattened',
  'only the owner sets or removes a key, and nobody signed in can read it back',
  'the team always keeps an owner',
];

const decisions = [
  { t: 'Failures that aren’t the lead’s fault never cost the lead its email.', b: 'A full mailbox or a wrong secret pauses sending with Microsoft’s reason, and throttling just waits. The lead keeps its place.' },
  { t: 'An email Microsoft didn’t confirm is never retried.', b: 'If a send can’t be confirmed, it is skipped, not repeated. Nobody gets the same email twice.' },
  { t: 'No open tracking. People set the status.', b: 'The app only marks New reply when an answer arrives. Interested, Ready for a call and the rest are a person’s call.' },
  { t: 'Catch-all addresses are capped at 20%.', b: 'Addresses that can’t be fully verified still go out, but never more than a fifth of a mailbox’s sends.' },
];

const I = {
  leads: 'M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM20 20l-4.6-4.6',
  send: 'M21 3 10 14M21 3l-7 18-4-7-7-4 18-7z',
  crm: 'M4 5h16v14H4zM4 10h16M10 10v9',
  mail: 'M3 6h18v12H3zM3 7l9 6 9-6',
  inbox: 'M3 13l3-8h12l3 8v6H3zM3 13h5l1 2h6l1-2h5',
  gear: 'M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z',
};
---

<Base
  title={`${p.name}: case study | Yanis Schweizer`}
  description={p.summary}
  path="/work/outreach-crm"
  pageType="article"
  schema={projectSchema(p)}
  crumbs={projectCrumbs(p)}
  bare
  navTheme="light"
  ogImage="/og/work-outreach-crm.png"
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" />

  <div class="oc">
    <!-- ============================== HERO ============================== -->
    <header class="oc-hero">
      <div class="oc-wrap oc-hero__top">
        <ul class="oc-chips" aria-label="Project facts">
          <li><span class="oc-chips__dot"></span>White-label · built with Matteo Caruso</li>
          <li>{p.year}</li>
          <li class="oc-chips__status"><span class="oc-pulse" aria-hidden="true"></span>{p.status}</li>
        </ul>
        <h1 class="oc-h1">Find them. Email them. <span>Catch every reply.</span></h1>
        <p class="oc-lede">A marketing team was running outreach from spreadsheets. I replaced it with one app: a lead finder, campaigns sent from the team’s own Microsoft 365 mailboxes, and a CRM where no reply gets lost.</p>
      </div>

      <div class="oc-wrap">
        <div class="oc-stage">
        <div class="oc-sat oc-sat--toast" aria-hidden="true">
          <span class="oc-ava" style="--h:248">DW</span>
          <div><b>New reply · Dana Whitfield</b><span>Sequence stopped for this lead</span></div>
        </div>
        <div class="oc-sat oc-sat--box" aria-hidden="true">
          <span class="oc-pulse"></span>
          <div><b>sam@yourcompany.com</b><span>Ramping up · 25 a day</span></div>
          <i class="oc-sat__gauge"><s></s></i>
        </div>
        <div class="oc-app" id="oc-app" aria-label="The campaign overview, recreated with demo data">
          <div class="oc-app__chrome" aria-hidden="true">
            <span class="oc-app__lights"><i></i><i></i><i></i></span>
            <span class="oc-app__path">Workspace <em>/</em> Campaigns <em>/</em> <b>Spring outreach</b></span>
            <span class="oc-app__search"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={I.leads}/></svg>Search<kbd>⌘K</kbd></span>
          </div>
          <div class="oc-app__body">
            <aside class="oc-side" aria-hidden="true">
              <div class="oc-side__brand"><span class="oc-logo"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={I.send}/></svg></span><b>Outreach</b></div>
              <nav class="oc-side__nav">
                <span><svg viewBox="0 0 24 24"><path d={I.leads}/></svg>Leads</span>
                <span class="is-on"><svg viewBox="0 0 24 24"><path d={I.send}/></svg>Campaigns</span>
                <span><svg viewBox="0 0 24 24"><path d={I.crm}/></svg>CRM</span>
                <span><svg viewBox="0 0 24 24"><path d={I.mail}/></svg>Email accounts</span>
                <span><svg viewBox="0 0 24 24"><path d={I.inbox}/></svg>Unibox<em class="oc-badge" data-badge>3</em></span>
              </nav>
              <div class="oc-side__foot"><span><svg viewBox="0 0 24 24"><path d={I.gear}/></svg>Settings</span></div>
            </aside>
            <div class="oc-main">
              <div class="oc-camp">
                <div>
                  <p class="oc-camp__name">Spring outreach</p>
                  <p class="oc-camp__meta"><span class="oc-tag">Sending</span>240 leads · 3 emails · 2 senders</p>
                </div>
                <div class="oc-live">
                  <span class="oc-pulse" aria-hidden="true"></span>
                  <div><b>Sending now</b><small>09:00–17:00 local time · next in 4 min</small></div>
                </div>
              </div>
              <div class="oc-tiles">
                <div class="oc-tile"><span>Sent</span><b data-roll="412">412</b><small>of 720 planned</small></div>
                <div class="oc-tile"><span>Replied</span><b data-roll="37">37</b><small>9% of sent</small></div>
                <div class="oc-tile"><span>Interested</span><b data-roll="12">12</b><small>set by the team</small></div>
                <div class="oc-tile oc-tile--hide-s"><span>Bounced</span><b data-roll="4">4</b><small>moved to do-not-contact</small></div>
              </div>
              <div class="oc-cols">
                <div class="oc-seqprog">
                  <p class="oc-sectt">Sequence progress</p>
                  <div class="oc-gauge"><div><b>1</b><span>Quick question, {'{{first_name}}'}</span><em>100%</em></div><i><s style="--w:100%"></s></i></div>
                  <div class="oc-gauge is-live"><div><b>2</b><span>Re: Quick question</span><em>64%</em></div><i><s style="--w:64%"></s></i></div>
                  <div class="oc-gauge"><div><b>3</b><span>Last nudge</span><em>22%</em></div><i><s style="--w:22%"></s></i></div>
                </div>
                <div class="oc-feed">
                  <p class="oc-sectt">Latest replies</p>
                  <ul class="oc-feed__list" id="oc-feed">
                    <li><span class="oc-ava" style="--h:248">DW</span><div><b>Dana Whitfield</b><span>Sounds interesting, can you send times?</span></div><span class="oc-pill oc-pill--new">New reply</span></li>
                    <li><span class="oc-ava" style="--h:160">LO</span><div><b>Luis Ortega</b><span>What does this cost for a team of 5?</span></div><span class="oc-pill oc-pill--q">Asked a question</span></li>
                    <li><span class="oc-ava" style="--h:30">TB</span><div><b>Tom Becker</b><span>Yes, let’s talk next week.</span></div><span class="oc-pill oc-pill--call">✦ Ready for a call</span></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
        </div>
        <p class="oc-demo">Recreated in HTML with demo data. The real app stays private.</p>
      </div>

      <div class="oc-wrap">
        <div class="oc-partner">
          <span class="oc-partner__ava" aria-hidden="true">MC</span>
          <p><b>Built with Matteo Caruso.</b> Matteo runs the client relationship. I designed and built the system under his name, so the client stays private.</p>
        </div>
      </div>
    </header>

    <!-- ============================== NUMBERS ============================== -->
    <section class="oc-nums" aria-label="Project in numbers">
      <div class="oc-wrap oc-nums__row">
        {p.metrics!.map((m, i) => (
          <div class="oc-num">
            <b data-num={i === 0 ? '130' : i === 2 ? '0' : ''}>{m.value}</b>
            <span>{m.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ============================== PROBLEM ============================== -->
    <section class="oc-sec oc-problem">
      <div class="oc-wrap oc-problem__grid">
        <div class="oc-problem__copy">
          <p class="oc-kicker">The problem</p>
          <h2 class="oc-h2">Outreach lived in a spreadsheet.</h2>
          <p class="oc-p">Leads were found by hand, emails were copy-pasted one at a time, and replies got lost across inboxes. Matteo brought me in to build one system for all of it, under his name.</p>
        </div>
        <div class="oc-swap" id="oc-swap">
          <div class="oc-sheet" aria-label="Before: a spreadsheet">
            <div class="oc-sheet__bar"><span>outreach_FINAL_v3.xlsx</span></div>
            <div class="oc-sheet__grid">
              <span class="h"></span><span class="h">A</span><span class="h">B</span><span class="h">C</span><span class="h">D</span>
              <span class="n">1</span><span class="b">Name</span><span class="b">Company</span><span class="b">Sent?</span><span class="b">Replied?</span>
              <span class="n">2</span><span>Dana W.</span><span>Northwind</span><span>yes</span><span class="y">?? check inbox</span>
              <span class="n">3</span><span>Luis O</span><span>acme studio</span><span>y (2x?)</span><span></span>
              <span class="n">4</span><span>Priya</span><span>Fieldnote</span><span class="r">#N/A</span><span>no</span>
              <span class="n">5</span><span>Tom Becker</span><span>Bluebird</span><span>sent</span><span class="y">replied to Sam??</span>
              <span class="n">6</span><span>ana costa</span><span>Lumen</span><span></span><span class="r">bounced</span>
            </div>
          </div>
          <div class="oc-swap__arrow" aria-hidden="true"><svg viewBox="0 0 60 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h54M46 3l10 9-10 9"/></svg></div>
          <div class="oc-clean" aria-label="After: one lead list">
            <div class="oc-clean__head"><span>Lead</span><span>Status</span></div>
            <div class="oc-clean__row"><span class="oc-ava" style="--h:248">DW</span><div><b>Dana Whitfield</b><small>Northwind · step 2 of 3</small></div><span class="oc-pill oc-pill--new">New reply</span></div>
            <div class="oc-clean__row"><span class="oc-ava" style="--h:160">LO</span><div><b>Luis Ortega</b><small>Acme Studio · step 1 of 3</small></div><span class="oc-pill oc-pill--q">Asked a question</span></div>
            <div class="oc-clean__row"><span class="oc-ava" style="--h:80">PR</span><div><b>Priya Raman</b><small>Fieldnote · step 3 of 3</small></div><span class="oc-pill">Not replied</span></div>
            <div class="oc-clean__row"><span class="oc-ava" style="--h:30">TB</span><div><b>Tom Becker</b><small>Bluebird Labs · replied</small></div><span class="oc-pill oc-pill--call">✦ Ready for a call</span></div>
            <div class="oc-clean__row"><span class="oc-ava" style="--h:0">AC</span><div><b>Ana Costa</b><small>Lumen &amp; Co · bounced</small></div><span class="oc-pill oc-pill--dnc">Do not contact</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== 01 FIND ============================== -->
    <section class="oc-sec oc-step oc-find">
      <div class="oc-wrap oc-step__grid">
        <div class="oc-step__copy">
          <p class="oc-step__n">01 · Find</p>
          <h2 class="oc-h2">Leads, without the copy-paste.</h2>
          <p class="oc-p">Filters, one search bar, saved searches or the team’s own CSV. One search runs every chosen source, merges what it finds, drops anyone already in the CRM and ranks the rest. Every address is verified before anything is sent.</p>
        </div>
        <div class="oc-finder" id="oc-finder" aria-label="The lead finder, recreated with demo data">
          <div class="oc-finder__rail" aria-hidden="true">
            <p class="oc-sectt">Who</p>
            <div class="oc-chipset"><span class="is-on">Marketing</span><span class="is-on">Founders</span><span>Operations</span><span>Events</span></div>
            <p class="oc-sectt">Where</p>
            <span class="oc-field">Region <i>▾</i></span>
            <p class="oc-sectt">Size</p>
            <div class="oc-chipset"><span>1–10</span><span class="is-on">11–50</span><span>51–200</span></div>
            <span class="oc-go">Find leads</span>
            <div class="oc-finder__save"><span>Load</span><span>Save</span><span>CSV</span></div>
          </div>
          <div class="oc-finder__view">
            <div class="oc-search">
              <div class="oc-search__top"><b>Searching</b><span id="oc-left">Almost done</span></div>
              <div class="oc-search__bar"><i id="oc-sbar"></i><s></s></div>
              <div class="oc-search__meta"><span>Web, directories, your CSV…</span><span id="oc-found">29 found so far</span></div>
              <ul class="oc-log" id="oc-log">
                <li>09:41:02 · Sources started · 3 running</li>
                <li>09:41:20 · Directory search · 18 people so far</li>
                <li>09:41:37 · Website emails · 11 found</li>
                <li>09:41:52 · Duplicates removed · 3 already in the CRM</li>
                <li class="is-new">09:42:05 · Ranked by relevance · 29 new leads</li>
              </ul>
            </div>
            <table class="oc-table">
              <thead><tr><th></th><th>Name</th><th class="oc-hide-s">Company</th><th>Email check</th></tr></thead>
              <tbody>
                {leads.map((l) => (
                  <tr>
                    <td><span class:list={['oc-check', l.v !== 'Invalid' && 'is-on']} aria-hidden="true"></span></td>
                    <td><b>{l.n}</b><small>{l.r}</small></td>
                    <td class="oc-hide-s">{l.c}</td>
                    <td><span class:list={['oc-ver', `oc-ver--${l.v.toLowerCase().replace('-', '')}`]}>{l.v}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== 02 SEND ============================== -->
    <section class="oc-sec oc-step oc-send">
      <div class="oc-wrap">
        <div class="oc-step__copy oc-step__copy--wide">
          <p class="oc-step__n">02 · Send</p>
          <h2 class="oc-h2">Campaigns that send themselves, carefully.</h2>
          <p class="oc-p">A campaign is a lead list, a sequence of emails and a schedule. It sends from the team’s own Microsoft 365 mailboxes, follow-ups land in the same thread, and a reply stops the sequence for that person.</p>
        </div>

        <div class="oc-flow" id="oc-flow" aria-label="Leads moving through a three-step sequence">
          <div class="oc-flow__list"><b>240</b><span>leads in the list</span></div>
          <div class="oc-flow__track">
            <div class="oc-flow__line" aria-hidden="true"><i></i></div>
            <div class="oc-flow__step" style="--x:0">
              <span class="oc-flow__node">1</span>
              <div class="oc-mailcard"><small>Day 0 · 09:00–17:00</small><b>Quick question, {'{{first_name}}'}</b></div>
            </div>
            <div class="oc-flow__step" style="--x:1">
              <span class="oc-flow__node">2</span>
              <div class="oc-mailcard"><small>+2 days · same thread</small><b>Re: Quick question</b></div>
            </div>
            <div class="oc-flow__step" style="--x:2">
              <span class="oc-flow__node">3</span>
              <div class="oc-mailcard"><small>+4 days · same thread</small><b>Last nudge</b></div>
            </div>
            <div class="oc-flow__lane" aria-hidden="true"><span class="oc-pill oc-pill--new">Replied · sequence stops</span></div>
            <div class="oc-flow__dots" aria-hidden="true">
              {Array.from({ length: 9 }).map((_, i) => <i class="oc-dot" style={`--h:${(i * 47) % 360}`}></i>)}
            </div>
          </div>
        </div>

        <div class="oc-send__grid">
          <div class="oc-ramp" id="oc-ramp">
            <div class="oc-ramp__head">
              <p class="oc-sectt">Daily limit per mailbox</p>
              <span class="oc-switch" aria-hidden="true"><i></i>Ramp up new mailboxes</span>
            </div>
            <div class="oc-ramp__nums">
              <div><b>20</b><span>Start at, a day</span></div>
              <div><b>+5</b><span>Then add, a day</span></div>
              <div><b>50</b><span>Max, a day</span></div>
            </div>
            <div class="oc-ramp__chart" aria-label="Daily sending limit over the first 14 sending days">
              <span class="oc-ramp__cap" aria-hidden="true"><em>Max 50</em></span>
              {ramp.map((r) => (
                <div class:list={['oc-ramp__col', r.day <= 7 && 'is-flat']} style={`--v:${r.v}`}>
                  <span class="oc-ramp__v">{r.v}</span>
                  <i class="oc-ramp__bar"></i>
                  <span class="oc-ramp__d">{r.day}</span>
                </div>
              ))}
            </div>
            <p class="oc-ramp__foot"><span>First week: 20 a day</span><span>Then +5 a day, up to 50</span></p>
          </div>

          <div class="oc-tpl" id="oc-tpl">
            <div class="oc-tpl__editor">
              <p class="oc-sectt">Template</p>
              <p class="oc-tpl__subj">Quick question, <code>{'{{first_name}}'}</code></p>
              <p class="oc-tpl__body">Hi <code>{'{{first_name}}'}</code>, I came across <code>{'{{company}}'}</code> and loved what your team is building. Would a short call next week be useful?</p>
              <p class="oc-tpl__sig"><code>{'{{sender_name}}'}</code></p>
            </div>
            <div class="oc-tpl__preview">
              <p class="oc-sectt">Live preview <span id="oc-tpl-who">for Dana · Northwind</span></p>
              <div class="oc-sheet2">
                <p><span>From</span><span>Sam Taylor</span></p>
                <p><span>To</span><span><em data-k="email">dana@northwind.co</em></span></p>
                <p><span>Subject</span><span>Quick question, <em data-k="first">Dana</em></span></p>
                <div class="oc-sheet2__body">Hi <em data-k="first">Dana</em>, I came across <em data-k="company">Northwind</em> and loved what your team is building. Would a short call next week be useful?<br /><br />Sam</div>
              </div>
              <p class="oc-tpl__warn"><span aria-hidden="true">!</span>A lead missing a variable is skipped with a note. Nothing goes out half-filled.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== 03 CATCH ============================== -->
    <section class="oc-sec oc-step oc-catch">
      <div class="oc-wrap oc-step__grid oc-step__grid--flip">
        <div class="oc-step__copy">
          <p class="oc-step__n">03 · Catch</p>
          <h2 class="oc-h2">Every reply, in one inbox.</h2>
          <p class="oc-p">The engine reads every mailbox each minute. A real reply stops the sequence and lands in the Unibox as New reply. An out-of-office is logged and the sequence carries on. A bounce goes straight to do-not-contact.</p>
          <ul class="oc-legend" aria-label="What the app does with each answer">
            <li><span class="oc-pill oc-pill--new">New reply</span>sequence stops</li>
            <li><span class="oc-pill oc-pill--ooo">Out of office</span>sequence carries on</li>
            <li><span class="oc-pill oc-pill--dnc">Bounced</span>do-not-contact</li>
          </ul>
        </div>
        <div class="oc-unibox" id="oc-unibox" aria-label="The Unibox, recreated with demo data">
          <div class="oc-unibox__list">
            <div class="oc-unibox__head"><b>All replies</b><span class="oc-badge" data-badge>3</span></div>
            <div class="oc-ub is-on">
              <span class="oc-ava" style="--h:248">DW</span>
              <div><b>Dana Whitfield <i>2m</i></b><span>Sounds interesting, can you send times?</span></div>
              <span class="oc-pill oc-pill--new">New reply</span>
            </div>
            <div class="oc-ub">
