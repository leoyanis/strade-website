---
// Playivity: branded side-quest case study.
// Brand from Playivity's own guidelines (Fredoka + Inter, their colour tokens, chunky 3D CTAs).
// The Pals are real delivered loops, flattened onto white so they play the same in every browser.
import Base from '../../layouts/Base.astro';
import CaseNext from '../../components/CaseNext.astro';
import { getProject } from '../../data/work';

const p = getProject('playivity')!;
const I = '/images/work/playivity';

const pals = [
  { id: 'movi', name: 'Movi', verb: 'Move', domain: 'Physical', line: 'An energetic explorer who loves to move.', state: 'Encourage' },
  { id: 'lexi', name: 'Lexi', verb: 'Think', domain: 'Cognitive', line: 'A curious thinker who explains and discovers.', state: 'Celebrate' },
  { id: 'emmi', name: 'Emmi', verb: 'Feel', domain: 'Affective', line: 'A kind encourager who looks after wellbeing.', state: 'Ready' },
  { id: 'nexo', name: 'Nexo', verb: 'Connect', domain: 'Social', line: 'A team motivator who brings everyone together.', state: 'Celebrate' },
];
const states = [
  { id: 'celebrate', label: 'Celebrate', note: 'jump, bounce, cheer' },
  { id: 'ready', label: 'Ready', note: 'breathe, blink, sway' },
  { id: 'encourage', label: 'Encourage', note: 'wave, nod, beckon' },
];
const doodles = ['sun', 'lightning', 'rainbow', 'footprints', 'flame', 'chair', 'people', 'flag', 'sparkle', 'star', 'flower', 'watch', 'chart', 'wand', 'house', 'head'];
const week = [
  { d: 'Mon', s: 58, l: 34, m: 8 },
  { d: 'Tue', s: 50, l: 38, m: 12 },
  { d: 'Wed', s: 60, l: 32, m: 8 },
  { d: 'Thu', s: 50, l: 34, m: 8 },
  { d: 'Fri', s: 50, l: 34, m: 8 },
];
const energy = [
  { d: 'Mon', v: 72 }, { d: 'Tue', v: 85 }, { d: 'Wed', v: 64 }, { d: 'Thu', v: 92 }, { d: 'Fri', v: 78 },
];
const decisions = [
  { icon: 'chart', t: 'Wire to tokens, never to hex.', b: 'Every colour carries a light and a dark value. Bind a component to the token and both themes come for free.' },
  { icon: 'flower', t: 'The wording never shames.', b: 'Progress reads as how far there is to go. Sitting still gets a gentle nudge, never a red fail.' },
  { icon: 'sparkle', t: 'The chunky button means action.', b: 'The raised 3D style is kept for real moments like Start game and How did we do? Everything else stays flat.' },
  { icon: 'lightning', t: 'Auto Play has no start button.', b: 'It runs whenever Playposts are connected, so a teacher never has to remember to switch it on.' },
  { icon: 'house', t: 'The top bar stays for teachers.', b: 'Overview, Classes and Let’s Play. Admin lives in the avatar menu, out of the way.' },
];
---

<Base
  title={`${p.name}: case study | Yanis Schweizer`}
  description={p.summary}
  path="/work/playivity"
  noAlternates
  bare
  navTheme="light"
  ogImage="/og/work-playivity.png"
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" />

  <div class="pv">
    <!-- ============================== HERO ============================== -->
    <header class="pv-hero" id="pv-hero">
      <div class="pv-hero__doodles" aria-hidden="true">
        <i class="dd dd--sun" style={`--m:url(${I}/doodles/sun.webp)`}></i>
        <i class="dd dd--sparkle" style={`--m:url(${I}/doodles/sparkle.webp)`}></i>
        <i class="dd dd--rainbow" style={`--m:url(${I}/doodles/rainbow.webp)`}></i>
        <i class="dd dd--bolt" style={`--m:url(${I}/doodles/lightning.webp)`}></i>
        <i class="dd dd--star" style={`--m:url(${I}/doodles/star.webp)`}></i>
        <i class="dd dd--flower" style={`--m:url(${I}/doodles/flower.webp)`}></i>
      </div>

      <div class="pv-wrap pv-hero__grid">
        <div class="pv-hero__meta">
          <img class="pv-hero__logo" src={`${I}/logo.webp`} alt="Playivity" width="520" height="268" />
          <ul class="pv-chips" aria-label="Project facts">
            <li class="pv-chip">Client: Playivity</li>
            <li class="pv-chip">{p.year}</li>
            <li class="pv-chip pv-chip--met"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M8 12.5l2.6 2.6L16 9.6"/></svg>{p.status}</li>
          </ul>
        </div>

        <div class="pv-lineup" aria-label="The four Playivity Pals">
          {pals.map((pal, i) => (
            <figure class={`pv-pal pv-pal--${pal.id}`} style={`--i:${i}`}>
              <div class="pv-pal__stage">
                <div class="pv-pal__body">
                  <video class="pv-pal__vid" autoplay muted loop playsinline preload="auto" width="480" height="480" poster={`${I}/pals/${pal.id}.webp`} aria-label={`${pal.name}, animated`}>
                    <source src={`${I}/pals/${pal.id}.webm`} type="video/webm" />
                    <source src={`${I}/pals/${pal.id}.mp4`} type="video/mp4" />
                  </video>
                </div>
                <span class="pv-pal__shadow" aria-hidden="true"></span>
              </div>
              <figcaption>
                <strong>{pal.name}</strong>
                <span>{pal.verb}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="pv-hero__copy">
          <p class="pv-eyebrow">UI/UX design · Design system · Character animation</p>
          <h1 class="pv-h1">Movement data that feels like <span class="pv-play" aria-label="play"><b>p</b><b>l</b><b>a</b><b>y</b></span>.</h1>
          <p class="pv-lede">Playivity measures how children aged 3 to 11 move at school. I gave its platform one design system, four animated Pals and its five core screens, ready for its engineers to build.</p>
          <div class="pv-ctas">
            <a class="pv-btn pv-btn--cta" href="#pv-deck-sec"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5c.7 4.6 2.9 6.8 7.5 7.5-4.6.7-6.8 2.9-7.5 7.5-.7-4.6-2.9-6.8-7.5-7.5 4.6-.7 6.8-2.9 7.5-7.5z"/></svg>How did we do?</a>
            <a class="pv-btn pv-btn--ghost" href="#pv-screens">See the screens</a>
          </div>
        </div>
      </div>
    </header>

    <!-- ============================== NUMBERS ============================== -->
    <section class="pv-nums" aria-label="Project in numbers">
      <div class="pv-wrap pv-nums__row">
        <div class="pv-num pv-num--green">
          <span class="pv-num__kicker">The cast</span>
          <span class="pv-num__val"><b data-count="4">4</b><i>Pals</i></span>
          <span class="pv-num__lbl">characters, animated and placed across the platform</span>
          <span class="pv-pill pv-pill--success">Move · Think · Feel · Connect</span>
        </div>
        <div class="pv-num pv-num--blue">
          <span class="pv-num__kicker">The motion</span>
          <span class="pv-num__val"><b data-count="12">12</b><i>loops</i></span>
          <span class="pv-num__lbl">every Pal in three states, as video ready to embed</span>
          <span class="pv-pill pv-pill--steps">Celebrate · Ready · Encourage</span>
        </div>
        <div class="pv-num pv-num--pink">
          <span class="pv-num__kicker">The system</span>
          <span class="pv-num__val"><b data-count="1">1</b><i>system</i></span>
          <span class="pv-num__lbl">one set of tokens for every screen, light and dark</span>
          <span class="pv-pill pv-pill--pupils">Dashboard + admin, together</span>
        </div>
      </div>
    </section>

    <!-- ============================== PROBLEM ============================== -->
    <section class="pv-problem">
      <div class="pv-wrap pv-problem__grid">
        <div class="pv-problem__copy">
          <p class="pv-kicker">The problem</p>
          <h2 class="pv-h2">It worked. It just didn’t feel like <em>play</em> yet.</h2>
          <p>Playivity’s wearables and Playposts were already sending live data into a working React app. But the teacher dashboard and the admin area had grown into two different looks, and the interface didn’t feel playful or made for children.</p>
          <p>Their engineers needed one source of truth to build from. The children needed something that celebrates moving and never shames sitting still.</p>
        </div>
        <ul class="pv-notes" aria-label="What the design had to handle">
          <li class="pv-note pv-note--green"><i class="dd" style={`--m:url(${I}/doodles/people.webp)`} aria-hidden="true"></i><strong>Ages 3 to 11</strong><span>Big, clear and friendly, without talking down.</span></li>
          <li class="pv-note pv-note--blue"><i class="dd" style={`--m:url(${I}/doodles/watch.webp)`} aria-hidden="true"></i><strong>Live data</strong><span>Streaming in from wearables and Playpost stations.</span></li>
          <li class="pv-note pv-note--pink"><i class="dd" style={`--m:url(${I}/doodles/rainbow.webp)`} aria-hidden="true"></i><strong>Two rooms</strong><span>A teacher’s laptop and a whole-school assembly screen.</span></li>
          <li class="pv-note pv-note--yellow"><i class="dd" style={`--m:url(${I}/doodles/flower.webp)`} aria-hidden="true"></i><strong>No shaming</strong><span>Celebrate moving. Nudge sitting still, gently.</span></li>
        </ul>
      </div>
    </section>

    <!-- ============================== PALS ============================== -->
    <section class="pv-cast" id="pv-cast">
      <div class="pv-wrap">
        <div class="pv-sechead">
          <p class="pv-kicker">The Pals</p>
          <h2 class="pv-h2">Four Pals, four ways to grow.</h2>
          <p class="pv-sechead__p">Each Pal stands for one domain of physical literacy, and each one has three looping states. They turn up where they help: dashboard headers, Let’s Play, the Playpost screen and the assembly summary.</p>
        </div>

        <div class="pv-cast__grid">
          <div class="pv-cast__states" aria-hidden="true">
            <span></span>
            {states.map((s) => <span><b>{s.label}</b><i>{s.note}</i></span>)}
          </div>
          {pals.map((pal) => (
            <article class={`pv-castrow pv-castrow--${pal.id}`}>
              <header class="pv-castrow__id">
                <h3>{pal.name}</h3>
                <span class="pv-castrow__dom">{pal.domain}</span>
                <p>{pal.line}</p>
              </header>
              <ul class="pv-castrow__poses">
                {states.map((s) => (
                  <li>
                    <img src={`${I}/poses/${pal.id}-${s.id}.webp`} alt={`${pal.name}, ${s.label} pose`} width="240" height="240" loading="lazy" decoding="async" />
                    <span>{s.label}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================== DECK ============================== -->
    <section class="pv-decksec" id="pv-deck-sec">
      <div class="pv-wrap">
        <div class="pv-sechead pv-sechead--center">
          <p class="pv-kicker">The big moment</p>
          <h2 class="pv-h2">One pink button turns a week of data into an assembly.</h2>
          <p class="pv-sechead__p">“How did we do?” walks the whole class through its week, one big number at a time, with a Pal for each win. Figma can’t play motion, so I also handed over a runnable reference for every entrance, count-up and confetti burst.</p>
        </div>

        <div class="pv-deck" id="pv-deck" aria-roledescription="carousel" aria-label="How did we do? assembly view">
          <div class="pv-deck__stage">
            <canvas class="pv-deck__confetti" aria-hidden="true"></canvas>

            <div class="pv-slide is-live" data-tint="none" aria-label="Slide 1 of 7">
              <div class="pv-slide__row">
                {['lexi', 'movi', 'emmi', 'nexo'].map((id) => (
                  <span class="pv-slot pv-slot--sm"><img src={`${I}/poses/${id}-celebrate.webp`} alt="" width="240" height="240" loading="lazy" /></span>
                ))}
              </div>
              <p class="pv-slide__title">How did we do?</p>
              <p class="pv-slide__sub">Owls school · Class C · this week</p>
              <button class="pv-btn pv-btn--start" type="button" data-go="1">✦ Start</button>
            </div>

            <div class="pv-slide" data-tint="green" data-confetti aria-label="Slide 2 of 7">
              <span class="pv-slot"><video muted loop playsinline preload="none" width="480" height="480" poster={`${I}/pals/movi.webp`} data-src={`${I}/pals/movi`}></video></span>
              <p class="pv-slide__kicker">Movi · Power Play</p>
              <p class="pv-slide__metric" data-tint="green"><b data-to="42">42</b><i>min</i></p>
              <p class="pv-slide__head">We smashed Power Play!</p>
              <span class="pv-pill pv-pill--success">+12 over goal</span>
            </div>

            <div class="pv-slide" data-tint="blue" aria-label="Slide 3 of 7">
              <span class="pv-slot"><video muted loop playsinline preload="none" width="480" height="480" poster={`${I}/pals/movi.webp`} data-src={`${I}/pals/movi`}></video></span>
              <p class="pv-slide__kicker">Movi · Steps</p>
              <p class="pv-slide__metric" data-tint="blue"><b data-to="6842">6,842</b><i>steps</i></p>
              <p class="pv-slide__head">Look how far we walked!</p>
              <span class="pv-pill pv-pill--steps">+842 past goal</span>
            </div>

            <div class="pv-slide" data-tint="pink" aria-label="Slide 4 of 7">
              <span class="pv-slot"><video muted loop playsinline preload="none" width="480" height="480" poster={`${I}/pals/emmi.webp`} data-src={`${I}/pals/emmi`}></video></span>
              <p class="pv-slide__kicker">Emmi · Feeling good</p>
              <p class="pv-slide__metric" data-tint="pink"><b data-to="46">46</b><i>%</i></p>
              <p class="pv-slide__head">A brilliant balance!</p>
              <p class="pv-slide__sub">Almost half our day was active, and we rested too!</p>
            </div>

            <div class="pv-slide" data-tint="pink" data-confetti aria-label="Slide 5 of 7">
              <span class="pv-slot"><video muted loop playsinline preload="none" width="480" height="480" poster={`${I}/pals/nexo.webp`} data-src={`${I}/pals/nexo`}></video></span>
              <p class="pv-slide__kicker">Nexo · Together</p>
              <p class="pv-slide__metric" data-tint="pink"><b data-to="80">80</b><i>%</i></p>
              <p class="pv-slide__head">We did it as a team!</p>
              <span class="pv-pill pv-pill--pupils">Whole-class win</span>
            </div>

            <div class="pv-slide" data-tint="blue" aria-label="Slide 6 of 7">
              <span class="pv-slot"><video muted loop playsinline preload="none" width="480" height="480" poster={`${I}/pals/lexi.webp`} data-src={`${I}/pals/lexi`}></video></span>
              <p class="pv-slide__kicker">Lexi · Did you know?</p>
              <p class="pv-slide__head pv-slide__head--big">Class C led the whole school in Power Play!</p>
              <span class="pv-pill pv-pill--steps">Top of the school</span>
            </div>

            <div class="pv-slide" data-tint="none" data-confetti aria-label="Slide 7 of 7">
              <div class="pv-slide__row">
                {['lexi', 'movi', 'emmi', 'nexo'].map((id) => (
                  <span class="pv-slot pv-slot--sm"><img src={`${I}/poses/${id}-celebrate.webp`} alt="" width="240" height="240" loading="lazy" /></span>
                ))}
              </div>
              <p class="pv-slide__title">Brilliant week, Owls!</p>
              <p class="pv-slide__sub">See you again next week 👋</p>
              <div class="pv-slide__btns">
                <button class="pv-btn pv-btn--start pv-btn--blue" type="button" data-go="0">✦ Watch again</button>
              </div>
            </div>

            <button class="pv-deck__nav pv-deck__nav--prev" type="button" aria-label="Previous slide" data-step="-1"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button class="pv-deck__nav pv-deck__nav--next" type="button" aria-label="Next slide" data-step="1"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
            <div class="pv-deck__dots" role="tablist" aria-label="Choose a slide">
              {Array.from({ length: 7 }).map((_, i) => (
                <button type="button" role="tab" class={i === 0 ? 'is-on' : ''} aria-label={`Slide ${i + 1}`} data-go={i}></button>
              ))}
            </div>
          </div>
          <p class="pv-deck__note">Rebuilt here from the delivered design and motion reference, with its demo data.</p>
        </div>
      </div>
    </section>

    <!-- ============================== SYSTEM ============================== -->
    <section class="pv-system" id="pv-system">
      <div class="pv-wrap">
        <div class="pv-sechead">
          <p class="pv-kicker">The system</p>
          <h2 class="pv-h2">One system, from the laptop to the assembly hall.</h2>
          <p class="pv-sechead__p">The dashboard and the admin area now share one set of tokens for colour, type, spacing and radius. Every colour has one job everywhere, so a chart reads the same way on every screen.</p>
        </div>

        <div class="pv-sys">
          <!-- colour language -->
          <div class="pv-card pv-card--colour">
            <h3 class="pv-card__t">Every colour has one job</h3>
            <ul class="pv-legend">
              <li style="--c:#A4A7AE"><i class="dd" style={`--m:url(${I}/doodles/chair.webp)`} aria-hidden="true"></i><b>Sedentary</b><span>sitting still</span></li>
              <li style="--c:#FEC84B"><i class="dd" style={`--m:url(${I}/doodles/footprints.webp)`} aria-hidden="true"></i><b>Light activity</b><span>moving about</span></li>
              <li style="--c:#85D015"><i class="dd" style={`--m:url(${I}/doodles/flame.webp)`} aria-hidden="true"></i><b>Power Play</b><span>heart pumping</span></li>
              <li style="--c:#53B1FD"><i class="dd" style={`--m:url(${I}/doodles/footprints.webp)`} aria-hidden="true"></i><b>Steps</b><span>every one counts</span></li>
              <li style="--c:#F670C7"><i class="dd" style={`--m:url(${I}/doodles/people.webp)`} aria-hidden="true"></i><b>Pupils</b><span>who’s on target</span></li>
            </ul>
            <div class="pv-week" aria-label="Weekly activity composition, demo data">
              {week.map((w) => (
                <div class="pv-week__col">
                  <div class="pv-week__bar">
                    <span class="seg seg--m" style={`--h:${w.m}`}>{w.m}%</span>
                    <span class="seg seg--l" style={`--h:${w.l}`}>{w.l}%</span>
                    <span class="seg seg--s" style={`--h:${w.s}`}>{w.s}%</span>
                  </div>
                  <span class="pv-week__d">{w.d}</span>
                </div>
              ))}
            </div>
            <p class="pv-card__foot">Red is reserved for real errors. Sitting still is a calm grey, never a fail. <span>Charts here use the design’s demo data.</span></p>
          </div>

          <!-- charts a child can read -->
          <div class="pv-card pv-card--charts">
            <h3 class="pv-card__t">Charts a child can read</h3>
            <p class="pv-card__p">Standard charts became things you get at a glance: buckets that fill up as the day adds up, and thermometers that warm up towards the goal.</p>
            <div class="pv-buckets">
              <div class="pv-movisays">
                <img src={`${I}/poses/movi-celebrate.webp`} alt="" width="240" height="240" loading="lazy" />
                <p><b>Movi says:</b> Awesome! Both goals are met today! 🎉</p>
              </div>
              <div class="pv-bucket pv-bucket--green" style="--fill:100">
                <div class="pv-bucket__tank"><span class="pv-bucket__fill"></span><span class="pv-bucket__goal"></span><span class="pv-bucket__val"><b>35</b><i>/ 30 min</i></span></div>
                <strong>MVPA time</strong><em>+5 over goal</em>
              </div>
              <div class="pv-bucket pv-bucket--blue" style="--fill:100">
                <div class="pv-bucket__tank"><span class="pv-bucket__fill"></span><span class="pv-bucket__goal"></span><span class="pv-bucket__val"><b>6,480</b><i>/ 6k</i></span></div>
                <strong>Daily steps</strong><em>+480 over goal</em>
              </div>
            </div>
            <div class="pv-thermo" aria-label="This week's energy, demo data">
              <div class="pv-thermo__head"><b>This week’s energy</b><span class="pv-thermo__key">Warming up → Goal!</span></div>
              <div class="pv-thermo__row">
                {energy.map((e) => (
                  <div class="pv-thermo__col" style={`--v:${e.v}`}>
                    <span class="pv-thermo__pct">{e.v}%</span>
                    <span class="pv-thermo__tube"><span class="pv-thermo__fill"></span></span>
                    <span class="pv-thermo__d">{e.d}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- type, shape, icons -->
          <div class="pv-card pv-card--type">
            <div class="pv-type">
              <div class="pv-type__spec">
                <span class="pv-type__metric">8,420</span>
                <span class="pv-type__title">School Overview</span>
                <span class="pv-type__body">Average MVPA across all pupils this week.</span>
                <span class="pv-type__cap">Mon–Fri · Weekly average</span>
              </div>
              <div class="pv-type__notes">
                <p><b>Fredoka</b> for titles and numbers, big enough to read across a hall. <b>Inter</b> for everything a teacher reads up close.</p>
                <div class="pv-type__btns">
                  <button class="pv-btn pv-btn--cta pv-btn--sm" type="button" tabindex="-1">✦ How did we do?</button>
                  <button class="pv-btn pv-btn--start pv-btn--sm" type="button" tabindex="-1">✦ Start game</button>
                  <span class="pv-chip pv-chip--met">Met</span>
                  <span class="pv-chip pv-chip--track">On track</span>
                </div>
                <p class="pv-type__small">Generous corners and chunky pills on an 8-point grid.</p>
              </div>
            </div>
            <div class="pv-icons">
              <p class="pv-icons__t">A hand-drawn icon set that matches the Pals’ ink lines</p>
              <ul class="pv-icons__grid">
                {doodles.map((d, i) => <li style={`--k:${i % 4}`}><i class="dd" style={`--m:url(${I}/doodles/${d}.webp)`} aria-hidden="true"></i></li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== SCREENS ============================== -->
    <section class="pv-screens" id="pv-screens">
      <div class="pv-wrap">
        <div class="pv-sechead">
          <p class="pv-kicker">The screens</p>
          <h2 class="pv-h2">Every key screen, down to the empty state.</h2>
          <p class="pv-sechead__p">School view, class view, Let’s Play, the 3.5-inch Playpost screen and the “How did we do?” summary, each with its default, hover, active, disabled and empty states, in one clickable Figma prototype.</p>
        </div>

