  .pv-slide__metric b { font-weight: 500; font-size: clamp(72px, 12vw, 148px); font-variant-numeric: tabular-nums; }
  .pv-slide__metric i { font-style: normal; font-size: clamp(22px, 3vw, 38px); }
  .pv-slide__metric[data-tint='green'] i { color: var(--green600); }
  .pv-slide__metric[data-tint='blue'] i { color: var(--blue500); }
  .pv-slide__metric[data-tint='pink'] i { color: var(--pink500); }
  .pv-slide__head { font: 600 clamp(22px, 3.2vw, 36px)/1.15 var(--display); margin-top: 8px; }
  .pv-slide__head--big { font-size: clamp(28px, 4.4vw, 50px); max-width: 720px; margin-top: 14px; }
  .pv-slide .pv-pill { margin-top: 16px; }
  .pv-slide .pv-btn { margin-top: 26px; }
  .pv-slide__btns { display: flex; gap: 12px; }

  .pv-deck__nav {
    position: absolute; top: 50%; z-index: 5; width: 56px; height: 56px; margin-top: -28px; border-radius: 50%;
    display: grid; place-items: center; border: 0; cursor: pointer; background: #fff; color: var(--ink);
    box-shadow: 0 4px 18px rgba(12, 14, 20, 0.14); transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .pv-deck__nav:hover { transform: scale(1.06); box-shadow: 0 6px 22px rgba(12, 14, 20, 0.18); }
  .pv-deck__nav--prev { left: 20px; }
  .pv-deck__nav--next { right: 20px; }
  .pv-deck__dots { position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); display: flex; gap: 8px; z-index: 5; }
  .pv-deck__dots button { width: 11px; height: 11px; padding: 0; border: 0; border-radius: 999px; background: var(--g300); cursor: pointer; transition: width 0.25s ease, background 0.25s ease; }
  .pv-deck__dots button.is-on { width: 30px; background: var(--pink500); }
  .pv-deck__note { text-align: center; font-size: 13px; color: var(--ink-3); margin-top: 16px; }

  /* motion-reference keyframes, applied by JS when a slide goes live */
  .pv-slide.is-anim .pv-slot { animation: pv-jump 0.8s cubic-bezier(0.2, 1.3, 0.4, 1) both; transform-origin: 50% 100%; }
  .pv-slide.is-anim .pv-slot--sm:nth-child(2) { animation-delay: 0.12s; }
  .pv-slide.is-anim .pv-slot--sm:nth-child(3) { animation-delay: 0.24s; }
  .pv-slide.is-anim .pv-slot--sm:nth-child(4) { animation-delay: 0.36s; }
  .pv-slide.is-anim .pv-slide__kicker { animation: pv-rise 0.5s ease 0.5s both; }
  .pv-slide.is-anim .pv-slide__metric { animation: pv-pop 0.55s cubic-bezier(0.2, 1.4, 0.4, 1) 0.62s both; }
  .pv-slide.is-anim .pv-slide__title { animation: pv-pop 0.55s cubic-bezier(0.2, 1.4, 0.4, 1) 0.5s both; }
  .pv-slide.is-anim .pv-slide__head { animation: pv-rise 0.5s ease 0.85s both; }
  .pv-slide.is-anim .pv-slide__sub { animation: pv-rise 0.5s ease 1s both; }
  .pv-slide.is-anim .pv-pill, .pv-slide.is-anim .pv-btn { animation: pv-pop 0.5s cubic-bezier(0.2, 1.4, 0.4, 1) 1.15s both; }
  @keyframes pv-jump {
    0% { transform: translateY(70%) scale(0.6, 1.25); opacity: 0; }
    40% { opacity: 1; }
    55% { transform: translateY(-8%) scale(1.1, 0.9); }
    72% { transform: translateY(0) scale(0.95, 1.06); }
    100% { transform: translateY(0) scale(1, 1); }
  }
  @keyframes pv-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes pv-pop { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: scale(1); } }

  /* ------------------------------------------------------------------ system */
  .pv-system { padding: clamp(80px, 10vw, 140px) 0; background: var(--g50); border-top: 1.5px solid var(--g200); }
  .pv-sys { display: grid; grid-template-columns: 1.1fr 1fr; gap: 20px; }
  .pv-card {
    background: #fff; border-radius: 28px; padding: clamp(22px, 3vw, 34px); border: 1.5px solid var(--g200);
    box-shadow: 0 1px 0 rgba(12, 14, 20, 0.03), 0 24px 50px -36px rgba(12, 14, 20, 0.25);
  }
  .pv-card__t { font: 600 26px/1.1 var(--display); }
  .pv-card__p { font-size: 15px; line-height: 1.6; color: var(--ink-2); margin-top: 10px; max-width: 440px; }
  .pv-card__foot { font-size: 14px; line-height: 1.5; color: var(--ink-2); margin-top: 18px; }
  .pv-card__foot span { display: block; margin-top: 4px; font-size: 12.5px; color: var(--ink-3); }
  .pv-card--type { grid-column: 1 / -1; }
  .pv-type { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(24px, 4vw, 56px); }

  .pv-legend { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .pv-legend li {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px 7px 8px; border-radius: 999px;
    background: color-mix(in srgb, var(--c) 16%, #fff); border: 1.5px solid color-mix(in srgb, var(--c) 45%, #fff);
  }
  .pv-legend .dd { width: 26px; height: 26px; color: color-mix(in srgb, var(--c) 70%, #181d27); }
  .pv-legend b { font: 600 15px/1 var(--display); }
  .pv-legend span { font-size: 12px; color: var(--ink-3); }

  .pv-week { display: flex; gap: clamp(10px, 2vw, 22px); align-items: flex-end; justify-content: space-between; margin-top: 26px; height: 250px; padding: 0 4px; }
  .pv-week__col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10px; height: 100%; }
  .pv-week__bar { flex: 1; width: 100%; max-width: 64px; display: flex; flex-direction: column; border-radius: 16px; overflow: hidden; transform-origin: 50% 100%; }
  .pv-week__bar .seg { display: grid; place-items: center; font: 600 12px/1 var(--ui); color: rgba(24, 29, 39, 0.78); flex: var(--h) 0 0; min-height: 0; }
  .seg--m { background: var(--green500); }
  .seg--l { background: var(--yellow300); }
  .seg--s { background: var(--g300); }
  .pv-week__d { font: 500 14px/1 var(--ui); color: var(--ink-3); }

  .pv-buckets { display: grid; grid-template-columns: 1.05fr 1fr 1fr; gap: 14px; align-items: end; margin-top: 22px; }
  .pv-movisays {
    align-self: stretch; border-radius: 18px; background: var(--green50); border: 2px solid var(--green200);
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 4px; padding: 12px 10px;
  }
  .pv-movisays img { width: 64px; height: 64px; }
  .pv-movisays p { font: 500 14px/1.35 var(--display); color: var(--g700); }
  .pv-movisays b { display: block; font-weight: 600; }
  .pv-bucket { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; }
  .pv-bucket__tank {
    --c: var(--green500); --c2: var(--green600);
    position: relative; width: 100%; max-width: 132px; height: 150px; border-radius: 16px 16px 22px 22px; overflow: hidden;
    background: color-mix(in srgb, var(--c) 10%, #fff); border: 3px solid var(--c2);
  }
  .pv-bucket--blue .pv-bucket__tank { --c: var(--blue400); --c2: var(--blue500); }
  .pv-bucket__fill { position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--fill) * 1%); background: var(--c); transform-origin: 50% 100%; }
  .pv-bucket__goal { position: absolute; left: 0; right: 0; top: 18%; border-top: 2.5px dashed rgba(255, 255, 255, 0.95); }
  .pv-bucket__val { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; }
  .pv-bucket__val b { font: 600 34px/1 var(--display); }
  .pv-bucket__val i { font: 600 13px/1.4 var(--ui); font-style: normal; opacity: 0.9; }
  .pv-bucket strong { font: 600 16px/1.2 var(--display); margin-top: 6px; }
  .pv-bucket em { font: 600 13px/1 var(--ui); font-style: normal; color: var(--green600); }
  .pv-bucket--blue em { color: var(--blue500); }

  .pv-thermo { margin-top: 26px; padding-top: 22px; border-top: 2px dashed var(--g200); }
  .pv-thermo__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .pv-thermo__head b { font: 600 18px/1 var(--display); }
  .pv-thermo__key { font: 600 12px/1 var(--ui); color: var(--ink-2); display: inline-flex; align-items: center; gap: 8px; }
  .pv-thermo__key::before { content: ''; width: 46px; height: 8px; border-radius: 9px; background: linear-gradient(90deg, var(--yellow500), var(--yellow300), var(--green500)); }
  .pv-thermo__row { display: flex; justify-content: space-between; gap: 10px; margin-top: 16px; }
  .pv-thermo__col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .pv-thermo__pct { font: 600 13px/1 var(--ui); color: var(--ink-2); }
  .pv-thermo__tube { position: relative; width: 22px; height: 120px; border-radius: 999px; background: var(--g100); border: 2px solid var(--g200); overflow: hidden; }
  .pv-thermo__fill { position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--v) * 1%); border-radius: 999px; background: linear-gradient(0deg, var(--yellow500) 0%, var(--yellow300) 45%, var(--green500) 100%); transform-origin: 50% 100%; }
  .pv-thermo__d { font: 500 13px/1 var(--ui); color: var(--ink-3); }

  .pv-type__spec { display: flex; flex-direction: column; gap: 10px; padding: 26px; border-radius: 22px; background: var(--g50); border: 1.5px solid var(--g200); }
  .pv-type__metric { font: 500 clamp(64px, 8vw, 104px)/0.95 var(--display); }
  .pv-type__title { font: 500 clamp(28px, 3vw, 36px)/1.1 var(--display); }
  .pv-type__body { font: 600 17px/1.45 var(--ui); }
  .pv-type__cap { font: 600 12px/1.3 var(--ui); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  .pv-type__notes { display: flex; flex-direction: column; justify-content: center; gap: 18px; }
  .pv-type__notes > p { font-size: 17px; line-height: 1.6; color: var(--ink-2); }
  .pv-type__notes b { color: var(--ink); }
  .pv-type__btns { display: flex; flex-wrap: wrap; gap: 14px 12px; align-items: center; padding-bottom: 6px; }
  .pv-type__small { font-size: 14px !important; color: var(--ink-3) !important; }
  .pv-icons { border-top: 2px dashed var(--g200); padding-top: 22px; margin-top: 26px; }
  .pv-icons__t { font: 600 18px/1.3 var(--display); }
  .pv-icons__grid { list-style: none; display: grid; grid-template-columns: repeat(16, 1fr); gap: 10px; margin-top: 16px; }
  .pv-icons__grid li { aspect-ratio: 1; display: grid; place-items: center; border-radius: 16px; background: var(--g50); transition: background 0.25s ease; }
  .pv-icons__grid .dd { width: 62%; height: 62%; color: var(--g700); transition: color 0.25s ease, transform 0.35s cubic-bezier(0.2, 1.4, 0.4, 1); }
  .pv-icons__grid li:hover .dd { transform: translateY(-3px) rotate(-8deg) scale(1.08); }
  .pv-icons__grid li[style*='--k:0']:hover { background: var(--green100); } .pv-icons__grid li[style*='--k:0']:hover .dd { color: var(--green800); }
  .pv-icons__grid li[style*='--k:1']:hover { background: var(--blue100); } .pv-icons__grid li[style*='--k:1']:hover .dd { color: var(--blue700); }
  .pv-icons__grid li[style*='--k:2']:hover { background: var(--pink100); } .pv-icons__grid li[style*='--k:2']:hover .dd { color: var(--pink700); }
  .pv-icons__grid li[style*='--k:3']:hover { background: #fef0c7; } .pv-icons__grid li[style*='--k:3']:hover .dd { color: var(--orange700); }

  /* ------------------------------------------------------------------ screens */
  .pv-screens { padding: clamp(80px, 10vw, 140px) 0; background: #fff; }
  .pv-shot { margin: 0; }
  .pv-shot__bar { display: flex; align-items: center; gap: 14px; padding: 12px 14px 12px 18px; background: var(--g100); border: 1.5px solid var(--g200); border-bottom: 0; border-radius: 22px 22px 0 0; }
  .pv-shot__dots { display: flex; gap: 6px; }
  .pv-shot__dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--g300); }
  .pv-shot__url { flex: 1; font: 600 14px/1 var(--ui); color: var(--ink-3); }
  .pv-seg { display: inline-flex; padding: 4px; border-radius: 999px; background: var(--g200); gap: 2px; }
  .pv-seg button { font: 600 14px/1 var(--display); border: 0; background: transparent; color: var(--ink-2); padding: 9px 14px; border-radius: 999px; cursor: pointer; transition: background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease; }
  .pv-seg button.is-on { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(12, 14, 20, 0.12); }
  .pv-shot__frame { position: relative; border: 1.5px solid var(--g200); border-radius: 0 0 22px 22px; overflow: hidden; background: var(--g50); aspect-ratio: 1280 / 1215; }
  .pv-shot__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: opacity 0.7s ease; }
  .pv-shot__dark { opacity: 0; }
  #pv-theme[data-mode='dark'] .pv-shot__dark { opacity: 1; }
  .pv-shot__cap { margin-top: 14px; font-size: 15px; line-height: 1.5; color: var(--ink-3); }
  .pv-shot__cap b { color: var(--ink); font-family: var(--display); font-weight: 600; font-size: 17px; }
  #pv-theme .pv-shot__frame { max-height: 760px; aspect-ratio: auto; height: min(62vw, 760px); }

  .pv-shots2 { display: grid; grid-template-columns: 1fr 300px; gap: 28px; margin-top: 44px; align-items: start; }
  .pv-shot--class .pv-shot__frame { border-radius: 22px; border: 1.5px solid var(--g200); aspect-ratio: 1280 / 1216; }
  .pv-shots2 figcaption { margin-top: 12px; font-size: 14px; line-height: 1.55; color: var(--ink-3); max-width: 560px; }
  .pv-phone { margin: 0; }
  .pv-phone__body { border-radius: 40px; padding: 10px; background: #0c0e14; box-shadow: 0 30px 60px -30px rgba(12, 14, 20, 0.45); }
  .pv-phone__body img { display: block; width: 100%; height: auto; border-radius: 31px; aspect-ratio: 440 / 1160; object-fit: cover; object-position: top; max-height: 620px; }

  /* ------------------------------------------------------------------ how */
  .pv-how { padding: clamp(80px, 10vw, 140px) 0 clamp(64px, 8vw, 110px); background: var(--g50); border-top: 1.5px solid var(--g200); }
  .pv-how__grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(36px, 6vw, 80px); align-items: start; }
  .pv-how__copy > p:not(.pv-kicker) { margin-top: 18px; font-size: 18px; line-height: 1.65; color: var(--ink-2); max-width: 560px; }
  .pv-decisions { list-style: none; margin-top: 30px; display: flex; flex-direction: column; gap: 14px; counter-reset: d; }
  .pv-decisions li { display: flex; gap: 16px; align-items: flex-start; padding: 18px 20px; border-radius: 20px; background: #fff; border: 1.5px solid var(--g200); }
  .pv-decisions__n { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font: 600 17px/1 var(--display); color: #fff; }
  .pv-decisions li:nth-child(4n+1) .pv-decisions__n { background: var(--green500); }
  .pv-decisions li:nth-child(4n+2) .pv-decisions__n { background: var(--blue500); }
  .pv-decisions li:nth-child(4n+3) .pv-decisions__n { background: var(--pink500); }
  .pv-decisions li:nth-child(4n+4) .pv-decisions__n { background: var(--yellow500); }
  .pv-decisions b { display: block; font: 600 19px/1.25 var(--display); }
  .pv-decisions div > span { display: block; font-size: 15px; line-height: 1.55; color: var(--ink-2); margin-top: 4px; }

  .pv-how__side { display: flex; flex-direction: column; gap: 18px; position: sticky; top: 96px; }
  .pv-tree, .pv-pipe { background: #fff; border-radius: 24px; border: 1.5px solid var(--g200); padding: 24px; }
  .pv-tree__t { font: 600 20px/1.1 var(--display); margin-bottom: 14px; }
  .pv-tree ul { list-style: none; display: flex; flex-direction: column; gap: 4px; }
  .pv-tree li { display: grid; grid-template-columns: 34px 1fr; column-gap: 10px; align-items: center; padding: 8px 0; border-bottom: 1.5px dashed var(--g200); }
  .pv-tree li:last-child { border-bottom: 0; }
  .pv-tree .dd { grid-row: span 2; width: 30px; height: 30px; color: var(--g700); }
  .pv-tree b { font: 600 14px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--ink); word-break: break-word; }
  .pv-tree span { font-size: 13.5px; color: var(--ink-3); line-height: 1.4; }
  .pv-pipe p:not(.pv-tree__t) { font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .pv-pipe code { display: block; margin-top: 14px; padding: 12px 14px; border-radius: 14px; background: var(--g950); color: #e7fdd5; font: 500 13px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; white-space: normal; overflow-wrap: anywhere; }
  .pv-stack { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .pv-stack li { font: 600 13px/1 var(--ui); padding: 9px 13px; border-radius: 999px; background: #fff; border: 1.5px solid var(--g200); color: var(--g700); }

  .pv-outcome { margin-top: clamp(64px, 8vw, 110px); text-align: center; display: flex; flex-direction: column; align-items: center; }
  .pv-outcome__pals { display: flex; gap: 4px; }
  .pv-outcome__pals img { width: clamp(64px, 9vw, 110px); height: auto; }
  .pv-outcome__t { font: 600 clamp(56px, 9vw, 120px)/0.95 var(--display); margin-top: 8px; letter-spacing: -0.015em; }
  .pv-outcome__p { margin-top: 18px; font-size: 19px; line-height: 1.6; color: var(--ink-2); max-width: 640px; }

  /* ------------------------------------------------------------------ responsive */
  @media (max-width: 1180px) {
    .dd--rainbow, .dd--bolt { display: none; }
  }
  @media (max-width: 1023px) {
    .pv-sys { grid-template-columns: minmax(0, 1fr); }
    .pv-num .pv-pill { font-size: 13px; padding: 8px 12px; }
    .pv-type { grid-template-columns: minmax(0, 1fr); }
    .pv-icons__grid { grid-template-columns: repeat(8, 1fr); }
    .pv-cast__grid { grid-template-columns: 220px repeat(3, 1fr); }
    .pv-how__grid { grid-template-columns: minmax(0, 1fr); }
    .pv-how__side { position: static; }
  }
  @media (max-width: 767px) {
    .pv-wrap { padding: 0 20px; }
    .pv-hero { padding: 92px 0 56px; }
    .pv-hero__grid { display: grid; grid-template-columns: 100%; justify-items: center; }
    .pv-hero__meta { order: 1; }
    .pv-hero__copy { display: contents; }
    .pv-eyebrow { order: 2; margin-top: 22px; }
    .pv-h1 { order: 3; font-size: clamp(40px, 11.6vw, 52px); }
    .pv-lineup { order: 4; flex-wrap: wrap; max-width: 340px; gap: 0 4px; margin: 18px auto 0; }
    .pv-pal { width: calc(50% - 2px); }
    .pv-pal__stage { width: 100%; max-width: 160px; }
    .pv-pal figcaption strong { font-size: 22px; }
    .pv-lede { order: 5; font-size: 17px; margin-top: 18px; }
    .pv-ctas { order: 6; width: 100%; }
    .pv-ctas .pv-btn { flex: 1 1 100%; }
    .pv-hero__logo { width: 104px; }
    .dd--sun { width: 48px; height: 48px; left: 3%; top: 96px; }
    .dd--sparkle { width: 30px; height: 30px; right: 5%; top: 104px; }
    .dd--rainbow, .dd--bolt { display: none; }
    .dd--star { width: 40px; height: 36px; right: 4%; bottom: 3%; }
    .dd--flower { width: 32px; height: 34px; left: 4%; bottom: 3%; }

    .pv-nums__row { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .pv-num { padding: 26px 0; }
    .pv-num + .pv-num { border-left: 0; border-top: 2px dashed var(--g300); }

    .pv-problem__grid { grid-template-columns: minmax(0, 1fr); }
    .pv-notes { gap: 12px; }
    .pv-note { min-height: 0; padding: 18px 16px; }
    .pv-note strong { font-size: 19px; }
    .pv-note span { font-size: 14px; }
    .pv-note--blue, .pv-note--yellow { transform: rotate(1.4deg) translateY(10px); }

    .pv-cast__grid { display: flex; flex-direction: column; gap: 14px; }
    .pv-cast__states { display: none; }
    .pv-castrow { display: block; background: #fff; border-radius: 24px; border: 1.5px solid var(--g200); padding: 20px 16px 14px; }
    .pv-castrow__id { padding: 0 4px; border: 0; }
    .pv-castrow__id h3 { font-size: 36px; }
    .pv-castrow__poses { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin-top: 8px; }
    .pv-castrow__poses li { border: 0; padding: 4px 0 0; }
    .pv-castrow__poses img { width: 100%; max-width: 108px; }
    .pv-castrow__poses span { display: block; font: 600 12px/1 var(--ui); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); margin-top: 2px; }

    .pv-deck__stage { height: 560px; border-radius: 28px; }
    .pv-slide { padding: 24px 18px 76px; }
    .pv-deck__nav { top: auto; bottom: 14px; margin-top: 0; width: 44px; height: 44px; }
    .pv-deck__nav--prev { left: 14px; }
    .pv-deck__nav--next { right: 14px; }
    .pv-deck__dots { bottom: 30px; gap: 6px; }
    .pv-deck__dots button { width: 9px; height: 9px; }
    .pv-deck__dots button.is-on { width: 22px; }

    .pv-buckets { grid-template-columns: 1fr 1fr; }
    .pv-movisays { grid-column: 1 / -1; flex-direction: row; text-align: left; justify-content: flex-start; padding: 10px 14px; }
    .pv-movisays img { width: 52px; height: 52px; }
    .pv-thermo__tube { height: 100px; }
    .pv-week { height: 220px; }
    .pv-week__bar .seg { font-size: 10px; }
    .pv-icons__grid { grid-template-columns: repeat(4, 1fr); }

    .pv-shot__bar { padding: 10px 10px 10px 14px; gap: 8px; }
    .pv-shot__dots { display: none; }
    .pv-shot__url { font-size: 13px; }
    .pv-seg button { padding: 8px 10px; font-size: 13px; }
    #pv-theme .pv-shot__frame { height: auto; aspect-ratio: 1280 / 1215; }
    .pv-shots2 { grid-template-columns: minmax(0, 1fr); }
    .pv-phone { max-width: 280px; margin: 0 auto; }

    .pv-decisions li { padding: 16px; gap: 12px; }
    .pv-btn { font-size: 17px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-slide.is-anim * { animation: none !important; }
  }
</style>

<script>
  (async () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---------- hero videos: pause when off-screen, respect reduced motion ---------- */
    const heroVids = Array.from(document.querySelectorAll<HTMLVideoElement>('.pv-pal__vid'));
    if (reduce) heroVids.forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
    else {
      const vio = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
        });
      }, { threshold: 0.05 });
      heroVids.forEach((v) => vio.observe(v));
    }

    /* ---------- theme toggle (light / dark school overview) ---------- */
    const theme = document.getElementById('pv-theme');
    let themeTimer: number | undefined;
    let themeTouched = false;
    const setMode = (m: string) => {
      if (!theme) return;
      theme.dataset.mode = m;
      theme.querySelectorAll<HTMLButtonElement>('.pv-seg button').forEach((b) => {
        const on = b.dataset.mode === m;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      });
    };
    theme?.querySelectorAll<HTMLButtonElement>('.pv-seg button').forEach((b) =>
      b.addEventListener('click', () => { themeTouched = true; window.clearInterval(themeTimer); setMode(b.dataset.mode || 'light'); })
    );
    // Auto-play only starts once the visitor has scrolled (keeps static captures and anchor jumps calm).
    let scrolled = false;
    const kicks: (() => void)[] = [];
    window.addEventListener('scroll', () => { if (scrolled) return; scrolled = true; kicks.forEach((k) => k()); }, { passive: true });

    let themeInView = false;
    const themeAuto = () => {
      window.clearInterval(themeTimer);
      if (theme && themeInView && scrolled && !themeTouched) {
        themeTimer = window.setInterval(() => setMode(theme.dataset.mode === 'light' ? 'dark' : 'light'), 3200);
      }
    };
    if (theme && !reduce) {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => { themeInView = e.isIntersecting; themeAuto(); });
      }, { threshold: 0.35 }).observe(theme);
      kicks.push(themeAuto);
    }

    /* ---------- the "How did we do?" deck ---------- */
    const deck = document.getElementById('pv-deck');
    deck?.querySelector('.pv-deck__stage')?.classList.add('is-js');
    const slides = deck ? Array.from(deck.querySelectorAll<HTMLElement>('.pv-slide')) : [];
    const dots = deck ? Array.from(deck.querySelectorAll<HTMLButtonElement>('.pv-deck__dots button')) : [];
    const canvas = deck?.querySelector<HTMLCanvasElement>('.pv-deck__confetti') || null;
    let idx = 0;
    let auto: number | undefined;
    let userDriven = false;
    let inView = false;

    const loadVideo = (v: HTMLVideoElement) => {
      if (v.dataset.loaded) return;
      const base = v.dataset.src;
      if (!base) return;
      v.innerHTML = `<source src="${base}.webm" type="video/webm"><source src="${base}.mp4" type="video/mp4">`;
      v.preload = 'auto';
      v.load();
      v.dataset.loaded = '1';
    };

    const countUp = (b: HTMLElement) => {
      const to = Number(b.dataset.to || 0);
      if (!to || reduce) return;
      const t0 = performance.now();
      const dur = 1100;
      const fmt = (n: number) => n.toLocaleString('en-GB');
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / dur);
        const e = 1 - Math.pow(1 - p, 3);
        b.textContent = fmt(Math.round(to * e));
        if (p < 1) requestAnimationFrame(tick);
      };
      b.textContent = '0';
      requestAnimationFrame(tick);
    };

    /* confetti, from the motion reference */
    type Part = { x: number; y: number; vx: number; vy: number; r: number; c: string; a: number; rot: number; vr: number };
    let parts: Part[] = [];
    let running = false;
    const ctx = canvas?.getContext('2d') || null;
    const sizeCanvas = () => {
      if (!canvas) return;
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(r.width * dpr);
      canvas.height = Math.round(r.height * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const burst = () => {
      if (!canvas || !ctx || reduce) return;
      sizeCanvas();
      const r = canvas.getBoundingClientRect();
      const cols = ['#EE46BC', '#85D015', '#2E90FA', '#F79009', '#FEC84B', '#FAA7E0'];
      for (let i = 0; i < 110; i++) {
        parts.push({ x: r.width / 2, y: r.height * 0.36, vx: (Math.random() - 0.5) * 13, vy: Math.random() * -13 - 3, r: Math.random() * 7 + 4, c: cols[i % cols.length], a: 1, rot: Math.random() * 6, vr: (Math.random() - 0.5) * 0.4 });
      }
      if (running) return;
      running = true;
      const frame = () => {
        const w = r.width, h = r.height;
        ctx.clearRect(0, 0, w, h);
        parts.forEach((p) => {
          p.vy += 0.38; p.x += p.vx; p.y += p.vy; p.rot += p.vr; p.a -= 0.009;
          ctx.save(); ctx.globalAlpha = Math.max(0, p.a); ctx.translate(p.x, p.y); ctx.rotate(p.rot); ctx.fillStyle = p.c; ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 0.6); ctx.restore();
        });
        parts = parts.filter((p) => p.a > 0 && p.y < h + 40);
        if (parts.length) requestAnimationFrame(frame);
        else { running = false; ctx.clearRect(0, 0, w, h); }
      };
      requestAnimationFrame(frame);
    };

    const go = (n: number) => {
      if (!slides.length) return;
      const next = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const live = i === next;
        s.classList.toggle('is-live', live);
        s.classList.remove('is-anim');
        s.querySelectorAll('video').forEach((v) => { if (!live) v.pause(); });
      });
      idx = next;
      const s = slides[idx];
      void s.offsetWidth;
      if (!reduce) s.classList.add('is-anim');
      s.querySelectorAll<HTMLVideoElement>('video').forEach((v) => { loadVideo(v); if (!reduce) v.play().catch(() => {}); });
      s.querySelectorAll<HTMLElement>('[data-to]').forEach(countUp);
      if (s.hasAttribute('data-confetti')) window.setTimeout(burst, 650);
      dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
      slides.forEach((sl, i) => sl.setAttribute('aria-hidden', String(i !== idx)));
      schedule();
    };
    const schedule = () => {
      window.clearTimeout(auto);
      if (userDriven || !inView || reduce || !scrolled) return;
      auto = window.setTimeout(() => go(idx + 1), idx === 0 ? 3000 : 4200);
    };
    deck?.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) =>
      b.addEventListener('click', () => { userDriven = true; if (deck) deck.dataset.started = '1'; go(Number(b.dataset.go)); })
    );
    deck?.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => { userDriven = true; if (deck) deck.dataset.started = '1'; go(idx + Number(b.dataset.step)); })
    );
    const deckKick = () => {
      if (!deck || !inView || !scrolled) return;
      if (!deck.dataset.started) { deck.dataset.started = '1'; go(0); } else schedule();
    };
    if (deck) {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          inView = e.isIntersecting;
          if (inView) deckKick();
          else { window.clearTimeout(auto); slides[idx]?.querySelectorAll('video').forEach((v) => v.pause()); }
        });
      }, { threshold: 0.45 }).observe(deck);
      kicks.push(deckKick);
    }

    /* ---------- GSAP: entrances and scroll reveals ---------- */
    if (reduce) return;
    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      // Hero: the Pals jump in, exactly like the brand's motion reference
      const bodies = gsap.utils.toArray<HTMLElement>('.pv-pal__body');
      const shadows = gsap.utils.toArray<HTMLElement>('.pv-pal__shadow');
      const tl = gsap.timeline({ delay: 0.15 });
      bodies.forEach((b, i) => {
        const at = 0.1 + i * 0.13;
        tl.fromTo(b, { yPercent: 70, scaleX: 0.6, scaleY: 1.25, autoAlpha: 0 }, { yPercent: -8, scaleX: 1.1, scaleY: 0.9, autoAlpha: 1, duration: 0.42, ease: 'power2.out' }, at)
          .to(b, { yPercent: 0, scaleX: 0.95, scaleY: 1.06, duration: 0.14, ease: 'power1.in' }, at + 0.42)
          .to(b, { scaleX: 1, scaleY: 1, duration: 0.3, ease: 'elastic.out(1, 0.5)' }, at + 0.56);
        tl.fromTo(shadows[i], { scale: 0.3, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, duration: 0.5, ease: 'back.out(2)' }, at + 0.3);
      });
      tl.from('.pv-pal figcaption', { y: 12, autoAlpha: 0, duration: 0.45, stagger: 0.08, ease: 'power3.out' }, 0.75)
        .from('.pv-play b', { yPercent: 60, scale: 0.4, autoAlpha: 0, duration: 0.5, stagger: 0.07, ease: 'back.out(3)' }, 0.55)
        .from('.pv-hero__doodles .dd', { scale: 0, rotate: -40, autoAlpha: 0, duration: 0.7, stagger: 0.06, ease: 'back.out(2.2)' }, 0.4);

      // Numbers: count up
      document.querySelectorAll<HTMLElement>('.pv-num__val b').forEach((b) => {
        const to = Number(b.dataset.count || 0);
        const o = { v: 0 };
        ScrollTrigger.create({
          trigger: b, start: 'top 85%', once: true,
          onEnter: () => gsap.to(o, { v: to, duration: 1.1, ease: 'power3.out', onUpdate: () => { b.textContent = String(Math.round(o.v)); } }),
        });
      });
      gsap.from('.pv-num', { y: 26, autoAlpha: 0, duration: 0.7, stagger: 0.12, ease: 'power3.out', scrollTrigger: { trigger: '.pv-nums', start: 'top 80%' } });

      // Problem: sticky notes slap down
      gsap.from('.pv-note', { y: 50, rotate: (i: number) => (i % 2 ? 14 : -14), scale: 0.85, autoAlpha: 0, duration: 0.7, stagger: 0.1, ease: 'back.out(1.8)', scrollTrigger: { trigger: '.pv-notes', start: 'top 80%' } });

      // Cast: poses pop row by row
      gsap.utils.toArray<HTMLElement>('.pv-castrow').forEach((row) => {
        gsap.from(row.querySelectorAll('.pv-castrow__poses li'), { y: 40, scale: 0.7, autoAlpha: 0, duration: 0.6, stagger: 0.08, ease: 'back.out(2)', scrollTrigger: { trigger: row, start: 'top 85%' } });
        gsap.from(row.querySelector('h3'), { x: -20, autoAlpha: 0, duration: 0.6, ease: 'power3.out', scrollTrigger: { trigger: row, start: 'top 85%' } });
      });

      // System: bars grow, buckets fill, thermometers warm up
      gsap.from('.pv-week__bar', { scaleY: 0, duration: 0.9, stagger: 0.08, ease: 'power3.out', scrollTrigger: { trigger: '.pv-week', start: 'top 85%' } });
      gsap.from('.pv-bucket__fill', { scaleY: 0, duration: 1.4, stagger: 0.2, ease: 'power2.inOut', scrollTrigger: { trigger: '.pv-buckets', start: 'top 85%' } });
      gsap.from('.pv-bucket__val', { autoAlpha: 0, y: 10, duration: 0.5, stagger: 0.2, delay: 0.9, scrollTrigger: { trigger: '.pv-buckets', start: 'top 85%' } });
      gsap.from('.pv-thermo__fill', { scaleY: 0, duration: 1.2, stagger: 0.1, ease: 'power2.out', scrollTrigger: { trigger: '.pv-thermo', start: 'top 88%' } });
      gsap.from('.pv-icons__grid li', { scale: 0.5, autoAlpha: 0, duration: 0.45, stagger: 0.03, ease: 'back.out(2.4)', scrollTrigger: { trigger: '.pv-icons__grid', start: 'top 88%' } });

      // Section heads and lists rise
      gsap.utils.toArray<HTMLElement>('.pv-sechead, .pv-problem__copy, .pv-how__copy > .pv-h2').forEach((el) => {
        gsap.from(el, { y: 30, autoAlpha: 0, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 85%' } });
      });
      gsap.from('.pv-decisions li', { x: -24, autoAlpha: 0, duration: 0.6, stagger: 0.08, ease: 'power3.out', scrollTrigger: { trigger: '.pv-decisions', start: 'top 85%' } });
      gsap.from('.pv-outcome__pals img', { yPercent: 60, scale: 0.6, autoAlpha: 0, duration: 0.7, stagger: 0.1, ease: 'back.out(2.4)', scrollTrigger: { trigger: '.pv-outcome', start: 'top 85%' } });

      window.addEventListener('load', () => ScrollTrigger.refresh());
    } catch {
      /* motion is decoration; content is already visible */
    }
  })();
</script>
