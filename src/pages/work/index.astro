---
import Base from '../../layouts/Base.astro';
import QuestPanel from '../../components/QuestPanel.astro';
import { MAIN_QUESTS, SIDE_QUESTS, STATS, HONORABLE_MENTIONS } from '../../data/work';
import { SITE } from '../../data/site';
import '../../styles/quests.css';

const mentions = HONORABLE_MENTIONS;
const fmt = (n: number, d: number) => n.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
const fills = ['92%', '78%', '34%', '64%'];
---

<Base
  title="Results | Yanis Schweizer"
  description="Everything completed: the main quests (Vaultt, Kleus, Endless Pursuit) and every side quest, plus what's still in the forge."
  path="/work"
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Results', path: '/work' }]}
  navBands={{
    // Covers are busy pictures, and stay so on phones too. Tried giving the light app screens the light pool
    // there (whole cover, then only the part clear of .qp__shade): a cover is dimmed to a mid tone (quests.css),
    // so a white pool read as a white box on it as much as the dark one reads as grey, and per part the links
    // flipped tone twice per cover.
    // Bare (2026-11-09 final check): no pool over them either, which lay as a white bar cut at a cover's right edge under
    // Results (1440 at 800 to 1230 and 1650 to 1890); the links keep full-strength ink with a tight glow.
    '.qp__media': 'bare',
    // a contained picture's words sit on a dark ground of their own (quests.css .qp--contain .qp__frame::after, laptops
    // only), which no band describes: under the links the knockout took the frame's white shaded grey, grey boxes on
    // the near-black (Playivity, 1440 at 1890 to 2000). Its colour as measured under the links (18 19 22 at 1440)
    '.qp--contain .qp__content': { tone: 'dark', inset: '0 0 0 0', surface: '#121316', media: '(min-width: 1024px)' },
  }}
  ogImage="/og/work.png"
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" />

  <section class="ql-hero">
    <div class="container">
      <span class="ql-hero__label">RESULTS // EVERYTHING COMPLETED</span>
      <h1>Results<span class="ql-hero__dot">.</span></h1>
      <p>Main quests are the big ones. Side quests are everything else: shipped, designed or in the build right now.</p>

      <div class="ql-stats" role="list">
        {STATS.map((s, i) => (
          <div class="ql-stat" role="listitem">
            <span class="ql-stat__label">{['SYS.TOKENS', 'SYS.CLAUDE_CODE', 'SYS.CODEX', 'SYS.REVENUE'][i] ?? 'SYS'}</span>
            <span class="ql-stat__value" data-count={s.static ? undefined : s.value} data-decimals={s.decimals} data-prefix={s.prefix ?? ''} data-suffix={s.suffix}>
              {s.prefix ?? ''}{fmt(s.value, s.decimals)}{s.suffix}{s.unit && <small>{'\u00a0' + s.unit}</small>}
            </span>
            <span class="ql-stat__desc">{s.label}</span>
            <span class="ql-stat__bar" style={`--fill:${fills[i] ?? '60%'}`}><i></i></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ql-section" id="main-quests">
    <div class="container">
      <div class="ql-title">
        <h2>Main quests</h2>
        <span class="ql-title__count">[{String(MAIN_QUESTS.length).padStart(2, '0')}]</span>
        <span class="ql-title__line"></span>
      </div>
      <div class="mq">
        {MAIN_QUESTS.map((p, i) => <QuestPanel project={p} index={i} variant="main" />)}
      </div>
    </div>
  </section>

  <section class="ql-section" id="side-quests">
    <div class="container">
      <div class="ql-title">
        <h2>Side quests</h2>
        <span class="ql-title__count">[{String(SIDE_QUESTS.length).padStart(2, '0')}]</span>
        <span class="ql-title__line"></span>
      </div>
      <p class="ql-sub">Client builds, design systems and my own apps. Some are live, some are still in the forge.</p>
      <div class="sq">
        {SIDE_QUESTS.map((p, i) => <QuestPanel project={p} index={i} variant="side" />)}
      </div>
    </div>
  </section>

  <!-- Built but not testable live: no links, generated art instead of screenshots (data: HONORABLE_MENTIONS).
       data-offscreen-pause stops the art's loops while the section is out of view (Base.astro, global.css). -->
  <section class="ql-section" id="honorable-mentions" data-offscreen-pause>
    <div class="container">
      <div class="ql-title">
        <h2>Honorable mentions</h2>
        <span class="ql-title__count">[{String(mentions.length).padStart(2, '0')}]</span>
        <span class="ql-title__line"></span>
      </div>
      <p class="ql-sub">You can't try these live, but they're worth a mention: private consoles, local tools and apps that aren't out.</p>
      <div class="hm">
        {mentions.map((m) => (
          <article class="hm-card" style={`--accent:${m.accent}`}>
            <div class={`hm-card__art art-${m.art}`} aria-hidden="true">
              {m.art === 'orbit' && (<><span></span><span></span><span></span></>)}
              {m.art === 'wave' && (
                <svg viewBox="0 0 300 120" preserveAspectRatio="none">
                  <path d="M0 60 Q 37 10 75 60 T 150 60 T 225 60 T 300 60" />
                  <path d="M0 70 Q 37 30 75 70 T 150 70 T 225 70 T 300 70" />
                  <path d="M0 50 Q 37 0 75 50 T 150 50 T 225 50 T 300 50" />
                </svg>
              )}
              {m.art === 'grid' && <span></span>}
              {m.art === 'pulse' && (<><span></span><span></span></>)}
              {m.art === 'bars' && <div class="art-bars__set">{[0, 1, 2, 3, 4, 5].map(() => <span></span>)}</div>}
              {m.art === 'stack' && (<><span></span><span></span><span></span></>)}
            </div>
            <div class="hm-card__body">
              <span class="hm-card__meta">{m.stage} · {m.kind}</span>
              <h3>{m.name}</h3>
              <p>{m.what}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ql-cta">
    <div class="container">
      <h2>Got a quest for me?</h2>
      <p>Want something built?</p>
      <div class="hero-actions">
        <a href={SITE.booking} class="btn-primary hero-cta" target="_blank" rel="noopener">
          Book a call
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href={SITE.instagram} class="btn-ghost" target="_blank" rel="noopener">Follow {SITE.instagramHandle}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Pointer-following glow inside each panel.
  document.querySelectorAll<HTMLElement>('[data-quest]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
      el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  });

  // Title decode on hover / focus.
  const GLYPHS = '<>/\\[]{}=+*#%01ABCDEFGHJKLMNPQRSTUVWXYZ';
  function decode(el: HTMLElement) {
    const final = el.dataset.text ?? (el.dataset.text = el.textContent ?? '');
    let frame = 0;
    const total = 16;
    cancelAnimationFrame(Number(el.dataset.raf ?? 0));
    const tick = () => {
      const done = Math.floor((frame / total) * final.length);
      el.textContent = final
        .split('')
        .map((ch, i) => (ch === ' ' || i < done ? ch : GLYPHS[Math.floor(Math.random() * GLYPHS.length)]))
        .join('');
      frame++;
      if (frame <= total) el.dataset.raf = String(requestAnimationFrame(tick));
      else el.textContent = final;
    };
    tick();
  }
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-quest]').forEach((el) => {
      const t = el.querySelector<HTMLElement>('[data-scramble]');
      if (!t) return;
      el.addEventListener('pointerenter', () => decode(t));
      el.addEventListener('focus', () => decode(t));
    });
  }

  // Count-up for the HUD stats.
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const run = (el: HTMLElement) => {
    const target = Number(el.dataset.count);
    const dec = Number(el.dataset.decimals ?? 0);
    const pre = el.dataset.prefix ?? '';
    const suf = el.dataset.suffix ?? '';
    const t0 = performance.now();
    const dur = 1600;
    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / dur);
      const eased = 1 - Math.pow(1 - k, 4);
      el.textContent = pre + (target * eased).toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suf;
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (!reduce) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        run(e.target as HTMLElement);
        io.unobserve(e.target);
      });
    }, { threshold: 0.4 });
    counters.forEach((c) => io.observe(c));
  }

  // Boot-up entrance: panels open from a scan line.
  (async () => {
    if (reduce) return;
    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);
      gsap.from('.ql-stat__bar i', { scaleX: 0, duration: 1.6, ease: 'power3.out', stagger: 0.12, delay: 0.3 });
      document.querySelectorAll<HTMLElement>('.mq, .sq').forEach((group) => {
        const items = group.querySelectorAll<HTMLElement>('.qp');
        gsap.fromTo(items, { clipPath: 'inset(48% 0% 48% 0%)', opacity: 0 }, {
          clipPath: 'inset(0% 0% 0% 0%)',
          opacity: 1,
          duration: 0.9,
          ease: 'power4.out',
          stagger: 0.12,
          clearProps: 'clipPath,opacity',
          scrollTrigger: { trigger: group, start: 'top 85%', once: true },
        });
      });
      // The honorable mentions rise and fade in instead of opening from a scan line: a clip-path tween repaints each
      // card every frame while their art runs inside it (README, performance rule 1), and on these cards it replaced
      // their own chamfered clip-path for the length of the tween, so the corners popped back at the end.
      const mentions = document.querySelector<HTMLElement>('.hm');
      if (mentions) {
        gsap.fromTo(mentions.querySelectorAll<HTMLElement>('.hm-card'), { opacity: 0, y: 28 }, {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power4.out',
          stagger: 0.08,
          clearProps: 'opacity,transform',
          scrollTrigger: { trigger: mentions, start: 'top 85%', once: true },
        });
      }
    } catch { /* content is already visible */ }
  })();
</script>
