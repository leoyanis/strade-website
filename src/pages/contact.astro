---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
const CALENDLY = SITE.booking;
const EMAIL = SITE.email;
---

<Base
  title="Contact | Yanis Schweizer"
  description="Book a call or get in touch with Yanis Schweizer."
  locale="en"
  path="/contact"
>
  <section style="min-height:80vh;display:flex;align-items:center">
    <div class="container" style="padding-top:96px">
      <span class="label">Contact</span>
      <h1 style="margin:12px 0 24px">Let's talk.</h1>
      <p style="color:var(--text-secondary);font-size:18px;max-width:480px;margin-bottom:48px">
        Book a 30-minute call or reach out directly.
      </p>
      <!-- .hero-actions for its phone rule (every button full width, as on /404); on wider screens the inline style keeps
           the row as it was: left-aligned, 16px apart, no extra space above -->
      <div class="hero-actions" style="justify-content:flex-start;gap:16px;margin-top:0">
        <a href={CALENDLY} target="_blank" rel="noopener" class="btn-primary">
          Book a call &#8594;
        </a>
        <a href={`mailto:${EMAIL}`} class="btn-ghost">
          Send an email
        </a>
        <a href={SITE.instagram} class="btn-ghost" target="_blank" rel="noopener">
          DM me on Instagram
        </a>
      </div>
    </div>
  </section>
</Base>
