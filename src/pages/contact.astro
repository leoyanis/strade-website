---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
const CALENDLY = SITE.booking;
const EMAIL = SITE.email;
---

<Base
  title="Contact | Yanis Schweizer"
  description="Book a call or get in touch with Yanis Schweizer."
  locale="en"
  path="/contact"
>
  <!-- the first screen's sizing is in the style below (it was inline), so phones can centre it under the nav -->
  <section class="contact-hero">
    <div class="container contact-body">
      <span class="label">Contact</span>
      <h1 style="margin:12px 0 24px">Let's talk.</h1>
      <p style="color:var(--text-secondary);font-size:18px;max-width:480px;margin-bottom:48px">
        Book a 30-minute call or reach out directly.
      </p>
      <!-- .hero-actions for its phone rule (every button full width, as on /404); on wider screens the inline style keeps
           the row as it was: left-aligned, 16px apart, no extra space above -->
      <div class="hero-actions" style="justify-content:flex-start;gap:16px;margin-top:0">
        <a href={CALENDLY} target="_blank" rel="noopener" class="btn-primary">
          Book a call &#8594;
        </a>
        <a href={`mailto:${EMAIL}`} class="btn-ghost">
          Send an email
        </a>
        <a href={SITE.instagram} class="btn-ghost" target="_blank" rel="noopener">
          DM me on Instagram
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Wider screens, as when these were inline styles: at least 80vh, the content centred down it under a 96px top pad */
  .contact-hero { min-height: 80vh; display: flex; align-items: center; }
  .contact-body { padding-top: 96px; }
  /* Phones (2026-11-09): the content sat high, 122px under the nav and 259px over the fold at 390x844, with the
     footer showing at the bottom of the first screen. Now it is centred in the first screen below the 64px fixed nav:
     the section is one small viewport tall (svh, the height with Safari's toolbars showing; 100vh where svh is
     unknown), its top 64px stand under the nav, and the flex centring above does the rest. */
  @media (max-width: 767px) {
    .contact-hero { min-height: 100vh; min-height: 100svh; padding-top: 64px; }
    .contact-body { padding-top: 0; }
  }
  /* (the footer keeps its Instagram and LinkedIn buttons here on phones too: hidden, LinkedIn could not be reached from
     /contact at all, and that outweighs the Instagram link doubling the page's own button; reverted 2026-11-09) */
</style>
